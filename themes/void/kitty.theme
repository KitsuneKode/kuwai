$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty
# vim:ft=kitty

## name: Void
## author: kuwai
## license: GPL-3.0-or-later
## blurb: Near-black and nothing else, one ice-blue accent. For the dark minimal wallpapers.

foreground                      #e4e4e7
background                      #0a0a0c
selection_foreground            #e4e4e7
selection_background            #26324d
cursor                          #8ab4ff
cursor_text_color               #0a0a0c
url_color                       #8ab4ff
active_tab_foreground           #0a0a0c
active_tab_background           #8ab4ff
inactive_tab_foreground         #5f5f68
inactive_tab_background         #0a0a0c

#: black
color0  #131316
color8  #5f5f68

#: red
color1  #f27c7c
color9  #ff9a9a

#: green
color2  #8fd19e
color10  #aee6ba

#: yellow
color3  #e5c27a
color11  #f3d89b

#: blue
color4  #8ab4ff
color12  #adc9ff

#: magenta
color5  #b79bf0
color13  #cdb8f7

#: cyan
color6  #7fd3d9
color14  #a2e6ea

#: white
color7  #c4c4ca
color15  #f5f5f7
