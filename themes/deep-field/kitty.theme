$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty
# vim:ft=kitty
# Made by bin/kuwai-theme-build from theme.toml. Edit that, not this.

## name: Deep Field
## author: kuwai
## license: GPL-3.0-or-later
## blurb: Nebulae and galaxies from Webb, Hubble and the darkest skies. Violet, for the far light.

foreground                      #e8e7ea
background                      #0e0e11
selection_foreground            #e8e7ea
selection_background            #383159
cursor                          #977aff
cursor_text_color               #0e0e11
url_color                       #977aff
active_tab_foreground           #0e0e11
active_tab_background           #977aff
inactive_tab_foreground         #7a797f
inactive_tab_background         #0e0e11

