$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty
# vim:ft=kitty

## name: Garage
## author: kuwai
## license: GPL-3.0-or-later
## blurb: Tail-light orange on graphite. For the cars.

foreground                      #e6e1da
background                      #121212
selection_foreground            #e6e1da
selection_background            #3a2a24
cursor                          #ff5a3c
cursor_text_color               #121212
url_color                       #ff5a3c
active_tab_foreground           #121212
active_tab_background           #ff5a3c
inactive_tab_foreground         #6a655f
inactive_tab_background         #121212

#: black
color0  #1a1a1a
color8  #6a655f

#: red
color1  #e8485a
color9  #ff6577

#: green
color2  #9bbf6a
color10  #b9d98a

#: yellow
color3  #f0b24a
color11  #ffcb6e

#: blue
color4  #ff5a3c
color12  #ff8466

#: magenta
color5  #c58fc9
color13  #dcaee0

#: cyan
color6  #6ec1b3
color14  #93d9cc

#: white
color7  #cfc9c0
color15  #f5f1ea
