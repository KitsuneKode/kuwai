$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty
# vim:ft=kitty

## name: Violet Hour
## author: kuwai
## license: GPL-3.0-or-later
## blurb: Moonlit violet over a deep indigo night. For elegant manhwa and moon-lit art.

foreground                      #e6e0f2
background                      #0e0b18
selection_foreground            #e6e0f2
selection_background            #33284f
cursor                          #b48cff
cursor_text_color               #0e0b18
url_color                       #b48cff
active_tab_foreground           #0e0b18
active_tab_background           #b48cff
inactive_tab_foreground         #716990
inactive_tab_background         #0e0b18

#: black
color0  #171226
color8  #716990

#: red
color1  #f07a96
color9  #ff9ab2

#: green
color2  #9ad9a8
color10  #b8ecc2

#: yellow
color3  #ecd08e
color11  #f7e2ac

#: blue
color4  #b48cff
color12  #cdb0ff

#: magenta
color5  #e59be8
color13  #f2b8f2

#: cyan
color6  #7fcfe0
color14  #a4e2ee

#: white
color7  #cdc6dc
color15  #f5f1fb
