{"html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>Notification center \u2014 preview &amp; reply</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    font-family: \"Inter\", ui-sans-serif, system-ui, -apple-system, sans-serif;\n    background: #0a0a0c;\n    color: rgba(255,255,255,.96);\n    padding: 28px 24px 40px;\n  }\n  h1 {\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,.45);\n    margin-bottom: 8px;\n  }\n  .intro {\n    font-size: 15px;\n    line-height: 1.45;\n    color: rgba(255,255,255,.72);\n    max-width: 920px;\n    margin-bottom: 28px;\n  }\n  .intro strong { color: rgba(255,255,255,.92); font-weight: 600; }\n  .row3 {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n    max-width: 1200px;\n  }\n  @media (max-width: 980px) {\n    .row3 { grid-template-columns: 1fr; max-width: 400px; }\n  }\n  .stage { display: flex; flex-direction: column; gap: 10px; }\n  .label {\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,.4);\n  }\n  .label span {\n    display: inline-block;\n    margin-left: 6px;\n    padding: 2px 8px;\n    border-radius: 6px;\n    background: rgba(255,255,255,.08);\n    color: rgba(255,255,255,.55);\n    text-transform: none;\n    letter-spacing: 0;\n    font-weight: 500;\n  }\n  /* Center card shell */\n  .center {\n    width: 100%;\n    border-radius: 22px;\n    background: rgba(17,17,20,.74);\n    border: 1px solid rgba(255,255,255,.08);\n    box-shadow: 0 24px 64px rgba(0,0,0,.55), 0 0 0 1px rgba(0,0,0,.3);\n    overflow: hidden;\n    backdrop-filter: blur(24px);\n  }\n  .tabs {\n    display: flex;\n    gap: 4px;\n    padding: 14px 14px 0;\n  }\n  .tab {\n    flex: 1;\n    text-align: center;\n    font-size: 12px;\n    font-weight: 500;\n    padding: 8px 6px;\n    border-radius: 10px;\n    color: rgba(255,255,255,.45);\n  }\n  .tab.on {\n    background: rgba(255,255,255,.1);\n    color: rgba(255,255,255,.95);\n  }\n  .tab .badge {\n    display: inline-block;\n    min-width: 16px;\n    height: 16px;\n    line-height: 16px;\n    padding: 0 5px;\n    margin-left: 4px;\n    border-radius: 8px;\n    background: #0a84ff;\n    font-size: 10px;\n    font-weight: 600;\n  }\n  .search {\n    margin: 12px 14px 0;\n    height: 36px;\n    border-radius: 12px;\n    border: 1px solid rgba(255,255,255,.07);\n    background: rgba(255,255,255,.07);\n    display: flex;\n    align-items: center;\n    padding: 0 12px;\n    font-size: 13px;\n    color: rgba(255,255,255,.35);\n  }\n  .list { padding: 12px 14px 14px; }\n  .group-h {\n    font-size: 11px;\n    font-weight: 600;\n    color: rgba(255,255,255,.4);\n    margin: 4px 0 8px 2px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .group-h .dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; opacity: .9; }\n  /* Notification row */\n  .notif {\n    position: relative;\n    border-radius: 18px;\n    padding: 12px 14px;\n    margin-bottom: 6px;\n    background: rgba(255,255,255,.065);\n    border: 1px solid rgba(255,255,255,.06);\n    cursor: default;\n  }\n  .notif.dim { opacity: .55; }\n  .notif.selected {\n    border-color: rgba(10,132,255,.45);\n    box-shadow: 0 0 0 1px rgba(10,132,255,.25), inset 0 0 0 1px rgba(10,132,255,.12);\n    background: rgba(10,132,255,.08);\n  }\n  .notif .hl {\n    position: absolute;\n    inset: -1px;\n    border-radius: 18px;\n    pointer-events: none;\n    border: 1px solid rgba(255,255,255,.12);\n    opacity: 0;\n  }\n  .notif.selected .hl { opacity: 1; }\n  .head {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n  }\n  .av {\n    width: 36px;\n    height: 36px;\n    border-radius: 10px;\n    flex-shrink: 0;\n    background: linear-gradient(135deg, #24292f 0%, #57606a 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n    font-weight: 700;\n    color: #fff;\n  }\n  .av.gh { background: #24292f; }\n  .av.gm { background: linear-gradient(135deg, #ea4335, #fbbc04); font-size: 11px; }\n  .meta { flex: 1; min-width: 0; }\n  .title-row {\n    display: flex;\n    justify-content: space-between;\n    gap: 8px;\n    align-items: flex-start;\n  }\n  .title {\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.25;\n    color: rgba(255,255,255,.96);\n  }\n  .time { font-size: 11px; color: rgba(255,255,255,.4); font-variant-numeric: tabular-nums; flex-shrink: 0; }\n  .app-line {\n    font-size: 11px;\n    color: rgba(255,255,255,.45);\n    margin-top: 2px;\n  }\n  .app-line .st { color: #ff9f0a; }\n  .body {\n    font-size: 13px;\n    line-height: 1.35;\n    color: rgba(255,255,255,.72);\n    margin-top: 6px;\n  }\n  .body.clamp {\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n  }\n  .actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    margin-top: 10px;\n  }\n  .chip {\n    height: 28px;\n    padding: 0 13px;\n    border-radius: 14px;\n    font-size: 12px;\n    font-weight: 600;\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    border: none;\n    background: rgba(255,255,255,.12);\n    color: rgba(255,255,255,.92);\n  }\n  .chip:hover { background: rgba(255,255,255,.18); }\n  .chip.primary {\n    background: rgba(255,255,255,.92);\n    color: #111114;\n  }\n  .chip.quiet { font-weight: 500; color: rgba(255,255,255,.75); }\n  .reply-box {\n    margin-top: 10px;\n    height: 34px;\n    border-radius: 10px;\n    border: 1px solid rgba(10,132,255,.35);\n    background: rgba(255,255,255,.08);\n    display: flex;\n    align-items: center;\n    padding: 0 12px;\n    font-size: 13px;\n    color: rgba(255,255,255,.35);\n  }\n  .reply-box.focus { color: rgba(255,255,255,.85); }\n  .caret {\n    display: inline-block;\n    width: 2px;\n    height: 14px;\n    background: #0a84ff;\n    margin-left: 2px;\n    vertical-align: middle;\n    animation: blink 1s step-end infinite;\n  }\n  @keyframes blink { 50% { opacity: 0; } }\n  .footer {\n    margin-top: 10px;\n    padding: 8px 14px 12px;\n    border-top: 1px solid rgba(255,255,255,.06);\n    font-size: 11px;\n    color: rgba(255,255,255,.38);\n    line-height: 1.4;\n  }\n  .footer kbd {\n    display: inline-block;\n    padding: 1px 5px;\n    border-radius: 4px;\n    background: rgba(255,255,255,.1);\n    font-size: 10px;\n    font-family: inherit;\n  }\n  .callout {\n    margin-top: 8px;\n    padding: 8px 10px;\n    border-radius: 10px;\n    background: rgba(255,159,10,.12);\n    border: 1px solid rgba(255,159,10,.25);\n    font-size: 11px;\n    line-height: 1.35;\n    color: rgba(255,255,255,.75);\n  }\n  .callout.bad { background: rgba(255,69,58,.1); border-color: rgba(255,69,58,.25); }\n  .arrow-note {\n    font-size: 11px;\n    color: rgba(255,255,255,.5);\n    padding: 0 4px;\n    line-height: 1.35;\n  }\n  /* Cursor for stage 2 */\n  .cursor-wrap { position: relative; }\n  .cursor {\n    position: absolute;\n    right: 24px;\n    top: 118px;\n    width: 18px;\n    height: 22px;\n    filter: drop-shadow(0 2px 4px rgba(0,0,0,.5));\n    pointer-events: none;\n  }\n</style>\n</head>\n<body>\n<h1>Proposed \u00b7 notification center</h1>\n<p class=\"intro\">\n  Three beats on the same GitHub card: <strong>today</strong> a row click opens the browser;\n  <strong>preview</strong> first click selects and shows the full snippet with explicit actions;\n  <strong>reply</strong> Reply opens an in-place field (center only, unchanged idea \u2014 just reachable without opening GitHub first).\n</p>\n\n<div class=\"row3\">\n  <!-- Stage 1: Today -->\n  <div class=\"stage\">\n    <div class=\"label\">Today <span>click row \u2192 browser</span></div>\n    <div class=\"center\">\n      <div class=\"tabs\">\n        <div class=\"tab on\">Notifications <span class=\"badge\">3</span></div>\n        <div class=\"tab\">Agents</div>\n        <div class=\"tab\">Sound</div>\n      </div>\n      <div class=\"search\">Search notifications\u2026</div>\n      <div class=\"list\">\n        <div class=\"group-h\"><span class=\"dot\"></span> GitHub \u00b7 2</div>\n        <div class=\"notif\">\n          <div class=\"head\">\n            <div class=\"av gh\">K</div>\n            <div class=\"meta\">\n              <div class=\"title-row\">\n                <div class=\"title\">Review: agent parity plan</div>\n                <div class=\"time\">4m</div>\n              </div>\n              <div class=\"app-line\">GitHub \u00b7 <span class=\"st\">Review requested</span></div>\n              <div class=\"body clamp\">rice \u00b7 #142 \u00b7 by KitsuneKode: can you look at the compaction section\u2026</div>\n            </div>\n          </div>\n        </div>\n        <div class=\"notif dim\">\n          <div class=\"head\">\n            <div class=\"av gh\">D</div>\n            <div class=\"meta\">\n              <div class=\"title-row\">\n                <div class=\"title\">CI failed on feat/notifs</div>\n                <div class=\"time\">1h</div>\n              </div>\n              <div class=\"body clamp\">rice \u00b7 main</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"footer\"><kbd>\u21b5</kbd> opens in browser \u00b7 row has no expand</div>\n    </div>\n    <p class=\"callout bad\">Whole row is one hit target \u2192 <code>xdg-open</code> + mark read. Easy to mis-click when you only wanted to read.</p>\n  </div>\n\n  <!-- Stage 2: Preview -->\n  <div class=\"stage\">\n    <div class=\"label\">Preview <span>click selects \u00b7 Open is explicit</span></div>\n    <div class=\"center cursor-wrap\">\n      <svg class=\"cursor\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 3l14 7-6 1-3 8-2-8-3-1z\" fill=\"#fff\" stroke=\"#111\" stroke-width=\"1.2\"/></svg>\n      <div class=\"tabs\">\n        <div class=\"tab on\">Notifications <span class=\"badge\">3</span></div>\n        <div class=\"tab\">Agents</div>\n        <div class=\"tab\">Sound</div>\n      </div>\n      <div class=\"search\">Search notifications\u2026</div>\n      <div class=\"list\">\n        <div class=\"group-h\">GitHub \u00b7 2</div>\n        <div class=\"notif selected\">\n          <div class=\"hl\"></div>\n          <div class=\"head\">\n            <div class=\"av gh\">K</div>\n            <div class=\"meta\">\n              <div class=\"title-row\">\n                <div class=\"title\">Review: agent parity plan</div>\n                <div class=\"time\">4m</div>\n              </div>\n              <div class=\"app-line\">GitHub \u00b7 <span class=\"st\">Review requested</span></div>\n              <div class=\"body\">rice \u00b7 #142<br/>\n                KitsuneKode: can you look at the compaction section before we merge? I trimmed the OpenCode notes but kept Codex \u2014 want a second pair of eyes on the token math.</div>\n            </div>\n          </div>\n          <div class=\"actions\">\n            <button type=\"button\" class=\"chip primary\">Open</button>\n            <button type=\"button\" class=\"chip quiet\">Mark as Read</button>\n            <button type=\"button\" class=\"chip quiet\">Reply</button>\n          </div>\n        </div>\n        <div class=\"notif dim\">\n          <div class=\"head\">\n            <div class=\"av gh\">D</div>\n            <div class=\"meta\">\n              <div class=\"title-row\"><div class=\"title\">CI failed on feat/notifs</div><div class=\"time\">1h</div></div>\n              <div class=\"body clamp\">rice \u00b7 main</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"footer\"><kbd>\u21b5</kbd> expand/select \u00b7 <kbd>\u2318\u21b5</kbd> or Open \u2192 browser</div>\n    </div>\n    <p class=\"arrow-note\">Accent ring = keyboard/hover selection (same gliding highlight the center already uses). Body uncapped while selected \u2014 still only the stored snippet (~160 chars), not a live fetch.</p>\n  </div>\n\n  <!-- Stage 3: Reply -->\n  <div class=\"stage\">\n    <div class=\"label\">Reply <span>short answer in-shell</span></div>\n    <div class=\"center\">\n      <div class=\"tabs\">\n        <div class=\"tab on\">Notifications <span class=\"badge\">3</span></div>\n        <div class=\"tab\">Agents</div>\n        <div class=\"tab\">Sound</div>\n      </div>\n      <div class=\"search\">Search notifications\u2026</div>\n      <div class=\"list\">\n        <div class=\"group-h\">GitHub \u00b7 2</div>\n        <div class=\"notif selected\">\n          <div class=\"hl\"></div>\n          <div class=\"head\">\n            <div class=\"av gh\">K</div>\n            <div class=\"meta\">\n              <div class=\"title-row\">\n                <div class=\"title\">Review: agent parity plan</div>\n                <div class=\"time\">4m</div>\n              </div>\n              <div class=\"app-line\">GitHub \u00b7 <span class=\"st\">Review requested</span></div>\n              <div class=\"body\">rice \u00b7 #142 \u00b7 KitsuneKode: can you look at the compaction section\u2026</div>\n            </div>\n          </div>\n          <div class=\"actions\">\n            <button type=\"button\" class=\"chip quiet\">Open</button>\n            <button type=\"button\" class=\"chip quiet\">Mark as Read</button>\n          </div>\n          <div class=\"reply-box focus\">LGTM on the Codex numbers \u2014 posting comment<span class=\"caret\"></span></div>\n        </div>\n      </div>\n      <div class=\"footer\"><kbd>\u21b5</kbd> send \u00b7 <kbd>Esc</kbd> dismiss reply \u00b7 posts via <code>gh</code> API</div>\n    </div>\n    <p class=\"callout\">Gmail looks the same: Reply threads over SMTP; Open still goes to Gmail in the browser for long mail.</p>\n  </div>\n</div>\n\n<!-- Toast comparison strip -->\n<h1 style=\"margin-top: 36px;\">Toast \u00b7 unchanged default</h1>\n<p class=\"intro\" style=\"margin-bottom: 16px;\">Toasts can stay <strong>tap = Open</strong>; optional long-press or a chevron could open the center on that item instead (not shown as a fourth panel \u2014 keeps Sonner simple).</p>\n<div style=\"max-width: 368px;\">\n  <div style=\"border-radius:22px;padding:15px 17px;background:rgba(17,17,20,.68);border:1px solid rgba(255,255,255,.1);box-shadow:0 12px 40px rgba(0,0,0,.45);\">\n    <div style=\"display:flex;gap:13px;\">\n      <div class=\"av gh\" style=\"width:42px;height:42px;border-radius:11px;\">K</div>\n      <div style=\"flex:1;min-width:0;\">\n        <div style=\"font-size:12px;color:rgba(255,255,255,.45);\">GitHub \u00b7 Review requested</div>\n        <div style=\"font-size:15px;font-weight:600;margin-top:3px;\">Review: agent parity plan</div>\n        <div class=\"body clamp\" style=\"margin-top:4px;\">rice \u00b7 #142 \u00b7 KitsuneKode: can you look at\u2026</div>\n        <div class=\"actions\" style=\"margin-top:8px;\">\n          <span class=\"chip quiet\" style=\"cursor:default;\">Mark as Read</span>\n        </div>\n      </div>\n    </div>\n  </div>\n  <p class=\"arrow-note\" style=\"margin-top:8px;\">Tap toast \u2192 browser (today). Center is where preview + Reply live.</p>\n</div>\n</body>\n</html>\n", "width": 1200}