#!/usr/bin/env -S python3 -I
"""Render clipboard text for the rice's preview: what it is, and HTML that Qt's
rich text can show.

    rice-render < text            prints one JSON object:
        { "kind": "markdown" | "code" | "mermaid" | "text",
          "lang": "Python",           (code, and what the code in it is)
          "html": "…",                (Qt rich text: inline styles, no scripts)
          "image": "/path.png" }      (a rendered Mermaid diagram)

Markdown via python-markdown (tables, fenced code), code via Pygments, both
coloured with one palette that sits on the rice's dark glass. Mermaid needs
mermaid-cli (`mmdc`); without it the diagram's source is shown highlighted.
Everything stays local: nothing is sent anywhere.
"""
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys

from pygments import highlight
from pygments.formatters import HtmlFormatter
from pygments.lexers import get_lexer_by_name, guess_lexer
from pygments.util import ClassNotFound

STYLE = "one-dark"
MONO = "SF Mono"
TEXT = "SF Pro"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "rice", "clip", "render")

MERMAID_START = re.compile(r"^\s*(graph|flowchart|sequenceDiagram|classDiagram|stateDiagram(-v2)?|erDiagram|gantt|pie|mindmap|journey|gitGraph|timeline|quadrantChart|xychart-beta|block-beta)\b")


def code_html(src, lexer, size=13):
    fmt = HtmlFormatter(style=STYLE, noclasses=True, nowrap=True)
    body = highlight(src.rstrip("\n"), lexer, fmt)
    bg = fmt.style.background_color or "#282c34"
    return (f'<table width="100%" cellpadding="12" style="background-color:{bg}; border-radius:10px">'
            f'<tr><td><pre style="font-family:\'{MONO}\'; font-size:{size}px; margin:0">{body}</pre></td></tr></table>')


def lexer_for(src, name=""):
    if name:
        try:
            return get_lexer_by_name(name)
        except ClassNotFound:
            pass
    first = src.lstrip().split("\n", 1)[0]
    if first.startswith("#!"):
        for k in ("python", "bash", "node", "zsh", "fish", "ruby", "perl"):
            if k in first:
                return get_lexer_by_name({"node": "javascript", "zsh": "bash"}.get(k, k))
    s = src.strip()
    if s[:1] in "{[":
        try:
            json.loads(s)
            return get_lexer_by_name("json")
        except ValueError:
            pass
    rules = [
        (r"^\s*(import|from)\s+[\w.]+(\s+import|\s*$)|^\s*def \w+\(|^\s*class \w+[:(]", "python"),
        (r"^\s*import QtQuick|^\s*\w+\s*\{\s*$[\s\S]*\bid:\s*\w+", "qml"),
        (r"^\s*(fn |let mut |impl |pub (fn|struct|enum)|use \w+::)", "rust"),
        (r"^\s*package \w+|^\s*func \w+\(|:= ", "go"),
        (r"^\s*#include\s*[<\"]", "cpp"),
        (r"\b(const|let|var)\s+\w+\s*=|=>\s*[{(]|^\s*export (default |const |function)|^\s*import .* from ['\"]", "typescript"),
        (r"^\s*(SELECT|INSERT|UPDATE|DELETE|CREATE TABLE|WITH)\b", "sql"),
        (r"^\s*<(!DOCTYPE|html|div|span|svg|\w+ [^>]*=)", "html"),
        (r"^\s*[.#]?[\w-]+\s*\{[^}]*:[^}]*;", "css"),
        (r"^\s*\[[\w.\-]+\]\s*$|^\s*\w+\s*=\s*[\"\d\[{tf]", "toml"),
        (r"^\s*[\w-]+:\s*(\S|$)[\s\S]*\n\s*[\w-]+:\s", "yaml"),
        (r"^(diff --git|--- a/|\+\+\+ b/|@@ )", "diff"),
        (r"^\s*(sudo |cd |ls |git |npm |pnpm |bun |cargo |pacman |yay |paru |systemctl |hyprctl |echo |export |curl |docker )", "bash"),
        (r"^\s*(FROM|RUN|COPY|ENTRYPOINT|CMD)\s", "docker"),
        (r"^\s*\{\s*$|^\s*(local|function)\s+\w+.*\bend\b", "lua"),
    ]
    for pattern, name in rules:
        if re.search(pattern, src, re.M | re.I if name == "sql" else re.M):
            try:
                return get_lexer_by_name(name)
            except ClassNotFound:
                continue
    return None


def looks_markdown(s):
    signals = [
        r"^#{1,6} \S", r"^\s*[-*+] \S", r"^\s*\d+\. \S", r"```", r"\*\*[^*\n]+\*\*",
        r"\[[^\]\n]+\]\([^)\s]+\)", r"^\s*> \S", r"^\|.+\|\s*$", r"^\s*- \[[ x]\] ",
    ]
    hits = sum(1 for p in signals if re.search(p, s, re.M))
    return hits >= 2 or bool(re.search(r"^#{1,3} \S", s, re.M) and "\n" in s.strip())


def mermaid(src):
    mmdc = shutil.which("mmdc")
    if not mmdc:
        return None
    os.makedirs(CACHE, exist_ok=True)
    key = hashlib.sha1(src.encode()).hexdigest()[:16]
    out = os.path.join(CACHE, f"mermaid-{key}.png")
    if not os.path.exists(out):
        src_file = os.path.join(CACHE, f"mermaid-{key}.mmd")
        with open(src_file, "w") as f:
            f.write(src)
        try:
            subprocess.run([mmdc, "-i", src_file, "-o", out, "-t", "dark", "-b", "transparent", "-w", "1400", "-s", "2"],
                           capture_output=True, timeout=30, check=True)
        except (subprocess.SubprocessError, OSError):
            return None
    return out


STYLESHEET = f"""
<style>
body {{ font-family: '{TEXT}'; font-size: 14px; color: #f2f2f7; }}
h1 {{ font-size: 24px; font-weight: 700; margin-top: 4px; margin-bottom: 10px; }}
h2 {{ font-size: 19px; font-weight: 650; margin-top: 16px; margin-bottom: 8px; }}
h3 {{ font-size: 16px; font-weight: 600; margin-top: 14px; margin-bottom: 6px; }}
p {{ margin-top: 0; margin-bottom: 10px; line-height: 145%; }}
a {{ color: #4da3ff; text-decoration: none; }}
code {{ font-family: '{MONO}'; font-size: 12px; color: #ffd60a; background-color: #2c2c32; }}
blockquote {{ color: #aeaeb2; margin-left: 12px; border-left: 3px solid #48484a; padding-left: 10px; }}
th {{ background-color: #2c2c32; font-weight: 600; padding: 6px 10px; }}
td {{ padding: 6px 10px; }}
hr {{ color: #3a3a3c; }}
li {{ margin-bottom: 4px; }}
</style>"""


def render(text):
    s = text.strip("\n")
    if not s.strip():
        return {"kind": "text"}

    fence = re.fullmatch(r"\s*```mermaid\s*\n([\s\S]*?)\n```\s*", s)
    if fence or MERMAID_START.match(s):
        src = fence.group(1) if fence else s
        img = mermaid(src)
        out = {"kind": "mermaid", "lang": "Mermaid", "html": code_html(src, lexer_for(src, "text") or get_lexer_by_name("text"))}
        if img:
            out["image"] = img
        return out

    if looks_markdown(s):
        import markdown
        body = markdown.markdown(s, extensions=["fenced_code", "tables", "sane_lists"])

        def block(m):
            lang, code = (m.group(1) or ""), html.unescape(m.group(2))
            lexer = lexer_for(code, lang) or get_lexer_by_name("text")
            return code_html(code, lexer, 12)
        body = re.sub(r'<pre><code(?: class="language-([\w+-]+)")?>([\s\S]*?)</code></pre>', block, body)
        langs = sorted(set(re.findall(r"```([\w+-]+)", s)))
        return {"kind": "markdown", "lang": ", ".join(langs), "html": STYLESHEET + body}

    lexer = lexer_for(s)
    if lexer is None and "\n" in s and len(s) > 40:
        try:
            g = guess_lexer(s)
            # Pygments guesses something for any text; only trust code-ish ones.
            if g.name not in ("Text only", "markdown", "Text output") and re.search(r"[{};()=<>]", s):
                lexer = g
        except ClassNotFound:
            pass
    if lexer is not None:
        return {"kind": "code", "lang": lexer.name, "html": code_html(s, lexer)}
    return {"kind": "text"}


if __name__ == "__main__":
    data = sys.stdin.buffer.read(262144).decode("utf-8", "replace")
    print(json.dumps(render(data)))
