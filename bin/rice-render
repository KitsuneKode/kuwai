#!/usr/bin/env -S python3 -I
"""Render clipboard text for the rice's preview: what it is, and HTML that Qt's
rich text can show.

    rice-render < text            prints one JSON object:
        { "kind": "markdown" | "code" | "mermaid" | "text",
          "lang": "Python",           (code, and what the code in it is)
          "html": "…",                (Qt rich text: inline styles, no scripts)
          "image": "/path.png" }      (a rendered Mermaid diagram)

Markdown via python-markdown (tables, fenced code), code via Pygments, both
coloured with one palette that sits on the rice's dark glass. Mermaid needs
mermaid-cli (`mmdc`); without it the diagram's source is shown highlighted.
Everything stays local: nothing is sent anywhere.
"""
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys

from pygments import highlight
from pygments.formatters import HtmlFormatter
from pygments.lexers import get_lexer_by_name, guess_lexer
from pygments.style import Style
from pygments.token import (Comment, Error, Generic, Keyword, Name, Number, Operator, Punctuation, String, Text,
                            Token)
from pygments.util import ClassNotFound

MONO = "SF Mono"
TEXT = "SF Pro Text"          # body copy: Apple's Text cut (made for 11–19px)
DISPLAY = "SF Pro Display"    # headings: the Display cut


class RiceDark(Style):
    """Xcode's dark palette, tuned for the rice's glass: pink keywords, coral strings, gold numbers, mint functions,
    lavender types, slate comments, on a near-black that sits in the glass instead of a coloured slab."""
    background_color = "#16161a"
    default_style = "#e6e6eb"
    styles = {
        Token: "#e6e6eb",
        Comment: "italic #7f8c98",
        Comment.Preproc: "#fd8f3f",
        Keyword: "bold #ff7ab2",
        Keyword.Constant: "bold #ff7ab2",
        Keyword.Type: "#dabaff",
        Name.Builtin: "#b281eb",
        Name.Function: "#67b7a4",
        Name.Class: "#5dd8ff",
        Name.Decorator: "#fd8f3f",
        Name.Tag: "#ff7ab2",
        Name.Attribute: "#67b7a4",
        Name.Variable: "#acf2e4",
        String: "#ff8170",
        String.Escape: "#d9c97c",
        Number: "#d9c97c",
        Operator: "#e6e6eb",
        Punctuation: "#a0a0a8",
        Generic.Inserted: "#30d158",
        Generic.Deleted: "#ff453a",
        Generic.Heading: "bold #5dd8ff",
        Generic.Subheading: "#5dd8ff",
        Error: "#ff453a",
        Text: "#e6e6eb",
    }


STYLE = RiceDark
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "rice", "clip", "render")

MERMAID_START = re.compile(r"^\s*(graph|flowchart|sequenceDiagram|classDiagram|stateDiagram(-v2)?|erDiagram|gantt|pie|mindmap|journey|gitGraph|timeline|quadrantChart|xychart-beta|block-beta)\b")


def code_html(src, lexer, size=13):
    fmt = HtmlFormatter(style=STYLE, noclasses=True, nowrap=True)
    body = highlight(src.rstrip("\n"), lexer, fmt)
    bg = fmt.style.background_color or "#282c34"
    return (f'<table width="100%" cellpadding="14" cellspacing="0" style="background-color:{bg}; border-radius:12px">'
            f'<tr><td><pre style="font-family:\'{MONO}\'; font-size:{size}px; margin:0; line-height:140%">{body}</pre></td></tr></table>')


def lexer_for(src, name=""):
    if name:
        try:
            return get_lexer_by_name(name)
        except ClassNotFound:
            pass
    first = src.lstrip().split("\n", 1)[0]
    if first.startswith("#!"):
        for k in ("python", "bash", "node", "zsh", "fish", "ruby", "perl"):
            if k in first:
                return get_lexer_by_name({"node": "javascript", "zsh": "bash"}.get(k, k))
    s = src.strip()
    if s[:1] in "{[":
        try:
            json.loads(s)
            return get_lexer_by_name("json")
        except ValueError:
            pass
    rules = [
        (r"^\s*(import|from)\s+[\w.]+(\s+import|\s*$)|^\s*def \w+\(|^\s*class \w+[:(]", "python"),
        (r"^\s*import QtQuick|^\s*\w+\s*\{\s*$[\s\S]*\bid:\s*\w+", "qml"),
        (r"^\s*(fn |let mut |impl |pub (fn|struct|enum)|use \w+::)", "rust"),
        (r"^\s*package \w+|^\s*func \w+\(|:= ", "go"),
        (r"^\s*#include\s*[<\"]", "cpp"),
        (r"\b(const|let|var)\s+\w+\s*=|=>\s*[{(]|^\s*export (default |const |function)|^\s*import .* from ['\"]", "typescript"),
        (r"^\s*(SELECT|INSERT|UPDATE|DELETE|CREATE TABLE|WITH)\b", "sql"),
        (r"^\s*<(!DOCTYPE|html|div|span|svg|\w+ [^>]*=)", "html"),
        (r"^\s*[.#]?[\w-]+\s*\{[^}]*:[^}]*;", "css"),
        (r"^\s*\[[\w.\-]+\]\s*$|^\s*\w+\s*=\s*[\"\d\[{tf]", "toml"),
        (r"^\s*[\w-]+:\s*(\S|$)[\s\S]*\n\s*[\w-]+:\s", "yaml"),
        (r"^(diff --git|--- a/|\+\+\+ b/|@@ )", "diff"),
        (r"^\s*(sudo |cd |ls |git |npm |pnpm |bun |cargo |pacman |yay |paru |systemctl |hyprctl |echo |export |curl |docker )", "bash"),
        (r"^\s*(FROM|RUN|COPY|ENTRYPOINT|CMD)\s", "docker"),
        (r"^\s*\{\s*$|^\s*(local|function)\s+\w+.*\bend\b", "lua"),
    ]
    for pattern, name in rules:
        if re.search(pattern, src, re.M | re.I if name == "sql" else re.M):
            try:
                return get_lexer_by_name(name)
            except ClassNotFound:
                continue
    return None


def looks_markdown(s):
    signals = [
        r"^#{1,6} \S", r"^\s*[-*+] \S", r"^\s*\d+\. \S", r"```", r"\*\*[^*\n]+\*\*",
        r"\[[^\]\n]+\]\([^)\s]+\)", r"^\s*> \S", r"^\|.+\|\s*$", r"^\s*- \[[ x]\] ",
    ]
    hits = sum(1 for p in signals if re.search(p, s, re.M))
    return hits >= 2 or bool(re.search(r"^#{1,3} \S", s, re.M) and "\n" in s.strip())


def mermaid(src):
    mmdc = shutil.which("mmdc")
    if not mmdc:
        return None
    os.makedirs(CACHE, exist_ok=True)
    key = hashlib.sha1(src.encode()).hexdigest()[:16]
    out = os.path.join(CACHE, f"mermaid-{key}.png")
    if not os.path.exists(out):
        src_file = os.path.join(CACHE, f"mermaid-{key}.mmd")
        with open(src_file, "w") as f:
            f.write(src)
        try:
            subprocess.run([mmdc, "-i", src_file, "-o", out, "-t", "dark", "-b", "transparent", "-w", "1400", "-s", "2"],
                           capture_output=True, timeout=30, check=True)
        except (subprocess.SubprocessError, OSError):
            return None
    return out


STYLESHEET = f"""
<style>
body {{ font-family: '{TEXT}'; font-size: 15px; color: #e6e6eb; }}
h1 {{ font-family: '{DISPLAY}'; font-size: 26px; font-weight: 700; color: #ffffff; margin-top: 2px; margin-bottom: 12px; }}
h2 {{ font-family: '{DISPLAY}'; font-size: 21px; font-weight: 600; color: #ffffff; margin-top: 20px; margin-bottom: 8px; }}
h3 {{ font-size: 17px; font-weight: 600; color: #ffffff; margin-top: 16px; margin-bottom: 6px; }}
h4, h5, h6 {{ font-size: 15px; font-weight: 600; color: #c7c7cc; margin-top: 12px; margin-bottom: 4px; }}
p {{ margin-top: 0; margin-bottom: 12px; line-height: 150%; }}
a {{ color: #0a84ff; text-decoration: none; }}
strong, b {{ color: #ffffff; font-weight: 600; }}
em, i {{ color: #d1d1d6; }}
code {{ font-family: '{MONO}'; font-size: 13px; color: #ff8170; background-color: #26262c; }}
blockquote {{ color: #aeaeb2; margin-left: 4px; padding-left: 14px; border-left: 3px solid #0a84ff; }}
table {{ border-collapse: collapse; }}
th {{ background-color: #26262c; color: #ffffff; font-weight: 600; padding: 7px 12px; }}
td {{ padding: 7px 12px; border-bottom: 1px solid #2c2c32; }}
hr {{ color: #3a3a3c; }}
li {{ margin-bottom: 5px; line-height: 145%; }}
</style>"""


def render(text):
    s = text.strip("\n")
    if not s.strip():
        return {"kind": "text"}

    fence = re.fullmatch(r"\s*```mermaid\s*\n([\s\S]*?)\n```\s*", s)
    if fence or MERMAID_START.match(s):
        src = fence.group(1) if fence else s
        img = mermaid(src)
        out = {"kind": "mermaid", "lang": "Mermaid", "html": code_html(src, lexer_for(src, "text") or get_lexer_by_name("text"))}
        if img:
            out["image"] = img
        return out

    if looks_markdown(s):
        import markdown
        body = markdown.markdown(s, extensions=["fenced_code", "tables", "sane_lists"])

        def block(m):
            lang, code = (m.group(1) or ""), html.unescape(m.group(2))
            lexer = lexer_for(code, lang) or get_lexer_by_name("text")
            return code_html(code, lexer, 12)
        body = re.sub(r'<pre><code(?: class="language-([\w+-]+)")?>([\s\S]*?)</code></pre>', block, body)
        langs = sorted(set(re.findall(r"```([\w+-]+)", s)))
        return {"kind": "markdown", "lang": ", ".join(langs), "html": STYLESHEET + body}

    lexer = lexer_for(s)
    if lexer is None and "\n" in s and len(s) > 40:
        try:
            g = guess_lexer(s)
            # Pygments guesses something for any text; only trust code-ish ones.
            if g.name not in ("Text only", "markdown", "Text output") and re.search(r"[{};()=<>]", s):
                lexer = g
        except ClassNotFound:
            pass
    if lexer is not None:
        return {"kind": "code", "lang": lexer.name, "html": code_html(s, lexer)}
    return {"kind": "text"}


# Chat blocks: no margins (the chat spaces its blocks), same type and colours.
BLOCK_STYLE = STYLESHEET.replace("margin-top: 2px; margin-bottom: 12px;", "margin-top: 0; margin-bottom: 0;") \
    .replace("margin-top: 20px; margin-bottom: 8px;", "margin-top: 0; margin-bottom: 0;") \
    .replace("margin-top: 16px; margin-bottom: 6px;", "margin-top: 0; margin-bottom: 0;") \
    .replace("margin-top: 12px; margin-bottom: 4px;", "margin-top: 0; margin-bottom: 0;") \
    .replace("margin-top: 0; margin-bottom: 12px; line-height: 150%;", "margin-top: 0; margin-bottom: 0; line-height: 150%;") \
    .replace("font-size: 26px; font-weight: 700;", "font-size: 20px; font-weight: 700;") \
    .replace("font-size: 21px; font-weight: 600;", "font-size: 17px; font-weight: 600;") \
    .replace("h3 {{ font-size: 17px;".replace("{{", "{"), "h3 { font-size: 15px;") \
    .replace("th { background-color: #26262c; color: #ffffff; font-weight: 600; padding: 7px 12px; }",
             "th { color: #aeaeb2; font-size: 13px; font-weight: 600; padding: 4px 12px 6px 0; }") \
    .replace("td { padding: 7px 12px; border-bottom: 1px solid #2c2c32; }", "td { padding: 6px 12px 6px 0; }") \
    .replace("</style>", "ul, ol { margin-top: 0; margin-bottom: 0; margin-left: 0; -qt-list-indent: 1; }\n</style>")

BARE_URL = re.compile(r"(?<![(<\[\"'=/])\b(https?://[^\s<>()\[\]`]+[^\s<>()\[\]`.,;:!?'\"*_])")


def autolink(text):
    """Bare URLs become links (Markdown only links <url> and [text](url)); code spans are left alone."""
    parts = re.split(r"(`[^`]*`)", text)
    return "".join(p if p.startswith("`") else BARE_URL.sub(r"<\1>", p) for p in parts)


def render_block(req):
    """One chat block: {"kind": "md"|"code", "text", "lang"} -> Qt rich text."""
    text = req.get("text") or ""
    if req.get("kind") == "code":
        lexer = lexer_for(text, req.get("lang") or "") or get_lexer_by_name("text")
        pre = re.search(r"<pre[\s\S]*</pre>", code_html(text, lexer, 12))
        return pre.group(0) if pre else html.escape(text)
    # Our own Streamdown-style renderer (bin/rice_md.py, stdlib): python-markdown went
    # missing with Python 3.14 and every block came back as raw text.
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import rice_md
    if req.get("live"):
        text = rice_md.heal(text)      # the block being written: close what's still open
    return BLOCK_STYLE + rice_md.render(text)


def serve():
    """`rice-render --serve`: one JSON request per line on stdin
    ({"id", "kind", "text", "lang"}), one {"id", "html"} per line on stdout.
    The assistant keeps one of these running, so a block renders in ~1 ms
    instead of a ~150 ms process start."""
    for line in sys.stdin:
        try:
            req = json.loads(line)
        except ValueError:
            continue
        try:
            out = {"id": req.get("id"), "html": render_block(req)}
        except Exception as e:  # one bad block mustn't stop the server; "" → the chat shows Qt's own Markdown
            out = {"id": req.get("id"), "html": "", "error": str(e)}
        sys.stdout.write(json.dumps(out) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    if sys.argv[1:] == ["--serve"]:
        serve()
        sys.exit(0)
    data = sys.stdin.buffer.read(262144).decode("utf-8", "replace")
    print(json.dumps(render(data)))
