#!/usr/bin/env python3
"""kuwai-look: single flock-serialised writer for kuwai's wallpaper and palette contract.

    kuwai-look set-wallpaper IMAGE [--mode auto|dark|light] [--output OUT] [--no-apply]
    kuwai-look restore [--output OUT] [--no-apply]
    kuwai-look focus-wallpaper [--no-apply]
    kuwai-look variant day|night [--theme NAME] [--fetch]
    kuwai-look theme NAME [--mode theme|auto|dark|light] [--no-apply]
    kuwai-look mode theme|auto|dark|light [--no-apply]
    kuwai-look install REPO [SLUG]
    kuwai-look undo [--no-apply]
    kuwai-look init [--no-apply]
    kuwai-look status [--json]
    kuwai-look list [--json] [--all]
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.join(ROOT, "lib") not in sys.path:
    sys.path.insert(0, os.path.join(ROOT, "lib"))

from look.extract import extract_image
from look.packs import installed_walls
from look.render import write_generation
from look.roles import build_palette
from look.screens import (
    apply_awww_output,
    connected_screen_walls,
    load_screen_walls,
    output_identity,
    primary_monitor,
    query_monitors,
    resolve_output,
    restore_screens,
    save_screen_walls,
    set_global_wall,
    set_screen_wall,
    wall_for_monitor,
)

HOME = os.path.expanduser("~")
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")
CACHE_HOME = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")

KUWAI_STATE = os.path.join(STATE_HOME, "kuwai")
LOOK_DIR = os.path.join(KUWAI_STATE, "look")
STATE_WALLS = os.path.join(KUWAI_STATE, "wallpapers")
WALL_LINK = os.path.join(KUWAI_STATE, "wallpaper")
PALETTE_CACHE = os.path.join(CACHE_HOME, "kuwai", "palettes")
CUSTOM_TEMPLATES = os.path.join(CONFIG_HOME, "kuwai", "custom", "templates")
CUSTOM_HOOKS = os.path.join(CONFIG_HOME, "kuwai", "custom", "hooks", "look-changed.d")
USER_THEMES = os.path.join(DATA_HOME, "kuwai-data", "themes")
_XDG_RT = os.environ.get("XDG_RUNTIME_DIR")
RUNTIME_DIR = os.path.join(_XDG_RT, "kuwai") if _XDG_RT and os.access(_XDG_RT, os.W_OK) else KUWAI_STATE
LOCK_PATH = os.path.join(RUNTIME_DIR, "look.lock")

IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".webp", ".avif", ".bmp"}
MODES = ["theme", "auto", "dark", "light"]
ALLOWED_THEME_FILES = {
    "theme.toml",
    "palette.toml",
    "kitty.theme",
    "ghostty.theme",
    "hypr.theme",
    "CREDITS.txt",
    "README.md",
    "wallpapers.tsv",
}
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")


def new_generation():
    return f"{int(time.time())}-{os.getpid()}-{time.time_ns() % 100000:05d}"


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def parse_simple_toml(path):
    out = {}
    if not os.path.isfile(path):
        return out
    section = ""
    for raw in open(path, encoding="utf-8", errors="replace"):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            k = k.strip()
            v = v.strip().strip('"').strip("'")
            full = f"{section}.{k}" if section else k
            out[full] = v
    return out


def parse_kitty_colors(path):
    vals = {}
    if not os.path.isfile(path):
        return vals
    for line in open(path, encoding="utf-8", errors="replace"):
        parts = line.strip().split()
        if len(parts) >= 2 and re.fullmatch(r"#[0-9a-fA-F]{6}", parts[1]):
            vals[parts[0]] = parts[1].lower()
    return vals


def parse_dcol(path):
    vals = {}
    if not os.path.isfile(path):
        return vals
    for line in open(path, encoding="utf-8", errors="replace"):
        m = re.match(r'^dcol_([a-z0-9]+)="([0-9A-Fa-f]{6})"$', line.strip())
        if m:
            vals[m.group(1)] = "#" + m.group(2).lower()
    return vals


def theme_meta(repo_dir):
    return parse_simple_toml(os.path.join(repo_dir, "theme.toml"))


def is_personal_theme(repo_dir):
    return theme_meta(repo_dir).get("personal", "").lower() == "true"


def theme_dirs(include_personal=True):
    out = {}
    shipped = os.path.join(ROOT, "themes")
    if os.path.isdir(shipped):
        for name in sorted(os.listdir(shipped)):
            full = os.path.join(shipped, name)
            if os.path.isdir(full) and not name.startswith("."):
                if include_personal or not is_personal_theme(full):
                    out[name] = full
    if os.path.isdir(USER_THEMES):
        for name in sorted(os.listdir(USER_THEMES)):
            full = os.path.join(USER_THEMES, name)
            if os.path.isdir(full) and not name.startswith("."):
                out[name] = full
    return out


def tsv_rows(repo_dir):
    tsv = os.path.join(repo_dir, "wallpapers.tsv")
    if not os.path.isfile(tsv):
        return []
    rows = []
    for raw in open(tsv, encoding="utf-8", errors="replace"):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        name = parts[0].strip()
        if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
            continue
        rows.append({
            "name": name,
            "url": parts[1].strip(),
            "pin": parts[2].strip() if len(parts) > 2 else "",
            "licence": parts[3].strip() if len(parts) > 3 else "",
            "variant": parts[6].strip().lower() if len(parts) > 6 else "",
        })
    return rows


def theme_wall_dirs(name, repo_dir):
    dirs = [os.path.join(repo_dir, "wallpapers")]
    user_w = os.path.join(USER_THEMES, name, "wallpapers")
    if user_w not in dirs:
        dirs.append(user_w)
    dirs.append(os.path.join(STATE_WALLS, name))
    return dirs


def find_named_wall(name, repo_dir, stem):
    search = list(theme_wall_dirs(name, repo_dir)) + [STATE_WALLS]
    for folder in search:
        if not os.path.isdir(folder):
            continue
        for ext in (".jpg", ".jpeg", ".png", ".webp", ".avif"):
            cand = os.path.join(folder, stem + ext)
            if os.path.isfile(cand):
                return os.path.realpath(cand)
    return next((item["path"] for item in installed_walls(ROOT)
                 if os.path.splitext(os.path.basename(item["path"]))[0] == stem
                 and os.path.basename(os.path.dirname(item["path"])).startswith(name + "-")), "")


def find_theme_wall(name, repo_dir):
    for d in theme_wall_dirs(name, repo_dir):
        img = first_image_in(d)
        if img:
            return img
    if os.path.isdir(STATE_WALLS):
        for row in tsv_rows(repo_dir):
            found = find_named_wall(name, repo_dir, row["name"])
            if found:
                return found
    return ""


def verify_pin(pin, data):
    m = re.fullmatch(r"(sha256):([0-9a-f]{64})|(sha1):([0-9a-f]{40})", pin or "")
    if not m:
        return False
    algo = m.group(1) or m.group(3)
    want = m.group(2) or m.group(4)
    return hashlib.new(algo, data).hexdigest() == want


def image_ext_for_bytes(data):
    if data.startswith(b"\xff\xd8\xff"):
        return ".jpg"
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return ".png"
    if len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return ".webp"
    return ""


class RejectRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def fetch_tsv_row(name, repo_dir, row):
    url = row["url"]
    pin = row["pin"]
    if not url.startswith("https://") or not pin:
        return ""
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "kuwai-look/1 (+https://github.com/KitsuneKode/kuwai)"},
        )
        with urllib.request.build_opener(RejectRedirects()).open(req, timeout=30) as resp:
            data = resp.read(40 * 1024 * 1024 + 1)
    except Exception:
        return ""
    if len(data) > 40 * 1024 * 1024 or not verify_pin(pin, data):
        return ""
    ext = image_ext_for_bytes(data)
    if not ext:
        return ""
    dest_dir = os.path.join(STATE_WALLS, name)
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, row["name"] + ext)
    tmp = os.path.join(dest_dir, f".{row['name']}-{os.getpid()}-{time.time_ns()}.tmp")
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, dest)
    credits = os.path.join(repo_dir, "CREDITS.txt")
    if os.path.isfile(credits):
        shutil.copyfile(credits, os.path.join(dest_dir, "CREDITS.txt"))
    return dest


def fetch_first_theme_wall(name, repo_dir):
    rows = tsv_rows(repo_dir)
    if not rows:
        return ""
    return fetch_tsv_row(name, repo_dir, rows[0])


def find_variant_wall(name, repo_dir, variant, fetch=False):
    want = str(variant or "").strip().lower()
    if want not in ("day", "night") or not repo_dir:
        return ""
    matching = [row for row in tsv_rows(repo_dir) if row.get("variant") == want]
    for row in matching:
        found = find_named_wall(name, repo_dir, row["name"])
        if found:
            return found
    if fetch and matching and not is_personal_theme(repo_dir):
        for row in matching:
            if not row["pin"].startswith("sha256:") or row["licence"] not in {"PD", "CC0", "CC-BY-4.0", "CC-BY-SA-4.0"}:
                continue
            got = fetch_tsv_row(name, repo_dir, row)
            if got:
                return os.path.realpath(got)
    return ""


def theme_raw_from_dir(repo_dir):
    palette_toml = os.path.join(repo_dir, "palette.toml")
    if os.path.isfile(palette_toml):
        t = parse_simple_toml(palette_toml)
        ansi = [t.get(f"ansi.color{i}") for i in range(16)]
        return {
            "bg": t.get("colors.bg") or t.get("bg"),
            "fg": t.get("colors.fg") or t.get("fg"),
            "accent": t.get("colors.accent") or t.get("accent"),
            "secondary": t.get("colors.secondary") or t.get("secondary"),
            "tertiary": t.get("colors.tertiary") or t.get("tertiary"),
            "ansi": ansi if all(ansi) else None,
            "exactBg": True,
        }, os.path.join(repo_dir, "wallpapers")
    kitty_file = os.path.join(repo_dir, "kitty.theme")
    if os.path.isfile(kitty_file):
        kv = parse_kitty_colors(kitty_file)
        ansi = [kv.get(f"color{i}") for i in range(16)]
        return {
            "bg": kv.get("background"),
            "fg": kv.get("foreground"),
            "accent": kv.get("color4") or kv.get("active_tab_background"),
            "secondary": kv.get("color2"),
            "tertiary": kv.get("color5"),
            "ansi": ansi if all(ansi) else None,
            "exactBg": True,
        }, os.path.join(repo_dir, "wallpapers")
    dcol_file = os.path.join(repo_dir, "theme.dcol")
    if os.path.isfile(dcol_file):
        dv = parse_dcol(dcol_file)
        return {
            "bg": dv.get("pry1"),
            "fg": dv.get("txt1"),
            "accent": dv.get("1xa7") or dv.get("pry3"),
            "secondary": dv.get("2xa7"),
            "tertiary": dv.get("3xa7"),
            "exactBg": True,
        }, os.path.join(repo_dir, "wallpapers")
    return None, None


def theme_raw(name):
    if "/" in name or name in ("", ".", ".."):
        return None, None
    dirs = theme_dirs()
    repo_dir = dirs.get(name)
    if not repo_dir:
        return None, None
    return theme_raw_from_dir(repo_dir)


def first_image_in(folder):
    if not folder or not os.path.isdir(folder):
        return ""
    for fn in sorted(os.listdir(folder)):
        if os.path.splitext(fn)[1].lower() in IMAGE_EXTS:
            p = os.path.join(folder, fn)
            if os.path.isfile(p):
                return p
    return ""


def set_wall_symlink(image):
    os.makedirs(KUWAI_STATE, exist_ok=True)
    tmp = os.path.join(KUWAI_STATE, f".wallpaper-{os.getpid()}-{time.time_ns()}")
    os.symlink(os.path.realpath(image), tmp)
    os.replace(tmp, WALL_LINK)


def apply_awww(image, output=None):
    return apply_awww_output(image, output=output)


def run_user_hooks(state):
    if not os.path.isdir(CUSTOM_HOOKS):
        return []
    errors = []
    env = dict(os.environ)
    env["KUWAI_LOOK_GEN"] = str((state or {}).get("generation") or "")
    env["KUWAI_LOOK_MODE"] = str((state or {}).get("mode") or "dark")
    env["KUWAI_LOOK_THEME"] = str((state or {}).get("theme") or "")
    env["KUWAI_LOOK_WALLPAPER"] = str((state or {}).get("wallpaper") or "")
    for name in sorted(os.listdir(CUSTOM_HOOKS)):
        if name.startswith("."):
            continue
        p = os.path.join(CUSTOM_HOOKS, name)
        if not os.path.isfile(p) or os.path.islink(p) or not os.access(p, os.X_OK):
            continue
        try:
            r = subprocess.run([p], env=env, stdin=subprocess.DEVNULL, capture_output=True, timeout=10)
            if r.returncode != 0:
                errors.append(f"hook:{name}:{r.returncode}")
        except (OSError, subprocess.TimeoutExpired):
            errors.append(f"hook:{name}:err")
    return errors


def reload_consumers(image=None, mode="dark", state=None, output=None):
    errors = []
    if image:
        try:
            apply_awww(image, output=output)
        except OSError as ex:
            errors.append(f"awww: {ex}")
    if shutil.which("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        r = subprocess.run(
            ["hyprctl", "eval", 'require("kuwai.look").apply_theme()'],
            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5,
        )
        if r.returncode != 0:
            errors.append("hyprctl")
    if shutil.which("qs") and os.environ.get("WAYLAND_DISPLAY"):
        shell_dir = os.path.join(ROOT, "shell")
        subprocess.run(
            ["qs", "ipc", "-p", shell_dir, "call", "look", "reload"],
            stdin=subprocess.DEVNULL, capture_output=True, timeout=5,
        )
    if shutil.which("gsettings") and os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        scheme = "prefer-light" if mode == "light" else "prefer-dark"
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme],
            stdin=subprocess.DEVNULL, capture_output=True, timeout=5,
        )
    if shutil.which("pkill"):
        subprocess.run(["pkill", "-USR1", "-x", "kitty"], stdin=subprocess.DEVNULL, capture_output=True)
    sync_bin = os.path.join(ROOT, "greeter", "sync")
    if os.path.isfile(sync_bin) and os.access(sync_bin, os.X_OK):
        subprocess.run([sync_bin], stdin=subprocess.DEVNULL, capture_output=True, timeout=10)
    errors.extend(run_user_hooks(state))
    return errors


def with_lock(fn):
    os.makedirs(RUNTIME_DIR, exist_ok=True)
    lock = open(LOCK_PATH, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return fn()
    finally:
        lock.close()


def wallpaper_palette(image, mode, prev):
    raw = extract_image(image, mode=mode, cache_dir=PALETTE_CACHE)
    palette = build_palette(
        raw,
        source={"kind": "wallpaper", "name": prev.get("theme") or "", "wallpaper": image, "mode": mode},
        generation=new_generation(),
        mode=mode,
    )
    _, state = write_generation(LOOK_DIR, palette, custom_templates_dir=CUSTOM_TEMPLATES)
    return state, palette


def cmd_set_wallpaper(image, mode="dark", apply_live=True, output=None):
    real = os.path.realpath(image)
    if not os.path.isfile(real):
        raise SystemExit(f"kuwai-look: no such image: {image}")
    prev = load_json(os.path.join(LOOK_DIR, "state.json"), {})
    if output:
        monitors = query_monitors()
        connector, ident, monitor = resolve_output(output, monitors)
        if monitor is None or not ident:
            raise SystemExit("kuwai-look: screen identity unavailable")
        if apply_live and not apply_awww(real, output=connector):
            raise SystemExit("kuwai-look: could not apply the wallpaper")
        set_screen_wall(STATE_HOME, ident, real, fallback_wall=current_wall())
        focused = primary_monitor(monitors)
        recolored = focused is not None and focused.get("name") == connector and mode != "theme"
        state, palette, errors = prev, None, []
        if recolored:
            state, palette = wallpaper_palette(real, mode, prev)
            if apply_live:
                errors = reload_consumers(mode=palette["mode"], state=state)
        if focused is not None and focused.get("name") == connector:
            set_wall_symlink(real)
        return {"ok": True, "output": connector, "outputId": ident, "wallpaper": real,
                "recolored": recolored, "state": state, "palette": palette, "reloadErrors": errors}
    state, palette = wallpaper_palette(real, mode, prev)
    set_wall_symlink(real)
    set_global_wall(STATE_HOME, real)
    errors = reload_consumers(real, mode=palette["mode"], state=state) if apply_live else []
    return {"ok": True, "recolored": True, "state": state, "palette": palette, "reloadErrors": errors}


def current_wall():
    if os.path.isfile(WALL_LINK):
        return os.path.realpath(WALL_LINK)
    hyde_wall = os.path.join(CACHE_HOME, "hyde", "wall.set")
    return os.path.realpath(hyde_wall) if os.path.isfile(hyde_wall) else ""


def cmd_focus_wallpaper(apply_live=True, wall=None, mode=None):
    if wall is None:
        data = load_screen_walls(STATE_HOME)
        if not data["screens"]:
            return
        focused = primary_monitor(query_monitors())
        if focused is None:
            return
        wall = wall_for_monitor(data, focused, current_wall())
    if not wall:
        return
    if current_wall() != wall:
        set_wall_symlink(wall)
    prev = load_json(os.path.join(LOOK_DIR, "state.json"), {})
    mode = mode or prev.get("mode")
    if mode in ("auto", "dark", "light") and (prev.get("wallpaper") != wall or prev.get("mode") != mode):
        state, palette = wallpaper_palette(wall, mode, prev)
        if apply_live:
            reload_consumers(mode=palette["mode"], state=state)


def cmd_restore(output=None, apply_live=True):
    res = restore_screens(STATE_HOME, fallback_wall=current_wall(), target_output=output, apply_live=apply_live)
    cmd_focus_wallpaper(apply_live, wall=res["primary"])
    return {"ok": all(row["ok"] for row in res["restored"]), **res}


def cmd_theme(name, mode="theme", apply_live=True, keep_wall=False):
    raw, _wall_dir = theme_raw(name)
    if raw is None:
        raise SystemExit(f"kuwai-look: unknown theme: {name}")
    repo_dir = theme_dirs(include_personal=True).get(name) or ""
    meta = theme_meta(repo_dir) if repo_dir else {}
    if meta.get("mode"):
        raw = dict(raw, mode=meta["mode"])
    wall = current_wall() if keep_wall else find_theme_wall(name, repo_dir) if repo_dir else ""
    if not wall and not keep_wall and apply_live and repo_dir and not is_personal_theme(repo_dir):
        wall = fetch_first_theme_wall(name, repo_dir)
    if not wall and os.path.exists(WALL_LINK):
        wall = os.path.realpath(WALL_LINK)
    gen = new_generation()
    palette = build_palette(
        raw,
        source={"kind": "theme", "name": name, "wallpaper": wall, "mode": mode},
        generation=gen,
        mode=mode,
    )
    _, state = write_generation(LOOK_DIR, palette, custom_templates_dir=CUSTOM_TEMPLATES)
    if wall and not keep_wall:
        set_wall_symlink(wall)
        set_global_wall(STATE_HOME, wall)
    live_mode = meta.get("mode", "dark") if palette["mode"] == "theme" else palette["mode"]
    reload_errors = reload_consumers(wall if wall and not keep_wall else None, mode=live_mode, state=state) if apply_live else []
    return {"ok": True, "state": state, "palette": palette, "reloadErrors": reload_errors}


def cmd_mode(mode, apply_live=True):
    if mode not in MODES:
        raise SystemExit(f"kuwai-look: unknown mode: {mode}")
    cur = load_json(os.path.join(LOOK_DIR, "state.json"), {})
    if mode == "theme":
        tname = cur.get("theme") or "kuwai-night"
        raw, _ = theme_raw(tname)
        if raw is not None:
            return cmd_theme(tname, mode="theme", apply_live=apply_live, keep_wall=True)
    wall = current_wall() or cur.get("wallpaper")
    if wall and os.path.isfile(wall):
        state, palette = wallpaper_palette(wall, mode, cur)
        errors = reload_consumers(mode=palette["mode"], state=state) if apply_live else []
        return {"ok": True, "state": state, "palette": palette, "reloadErrors": errors}
    return cmd_init(mode=mode, apply_live=apply_live, force=True)


def derive_slug(source, slug=None):
    cand = slug or os.path.basename(source.rstrip("/"))
    if cand.endswith(".git"):
        cand = cand[:-4]
    cand = re.sub(r"[^a-z0-9._-]+", "-", cand.lower()).strip(".-")
    if not SLUG_RE.match(cand):
        raise SystemExit(f"kuwai-look: invalid theme slug: {cand!r}")
    return cand


def validate_theme_tree(root_dir):
    safe_files = []
    for cur_dir, dirnames, filenames in os.walk(root_dir, followlinks=False):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        rel_dir = os.path.relpath(cur_dir, root_dir)
        for d in dirnames:
            full_d = os.path.join(cur_dir, d)
            if os.path.islink(full_d):
                raise SystemExit(f"kuwai-look: rejected symlink directory in theme: {d}")
            if rel_dir == "." and d != "wallpapers":
                raise SystemExit(f"kuwai-look: rejected directory in theme: {d}")
            if rel_dir != ".":
                raise SystemExit(f"kuwai-look: rejected nested directory in theme: {os.path.join(rel_dir, d)}")
        for fn in filenames:
            full_f = os.path.join(cur_dir, fn)
            rel_f = fn if rel_dir == "." else os.path.join(rel_dir, fn)
            st = os.lstat(full_f)
            if stat.S_ISLNK(st.st_mode):
                raise SystemExit(f"kuwai-look: rejected symlink in theme: {rel_f}")
            if not stat.S_ISREG(st.st_mode):
                raise SystemExit(f"kuwai-look: rejected special file in theme: {rel_f}")
            if st.st_mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH):
                raise SystemExit(f"kuwai-look: rejected executable file in theme: {rel_f}")
            if rel_dir == ".":
                if fn not in ALLOWED_THEME_FILES:
                    raise SystemExit(f"kuwai-look: rejected disallowed file in theme: {rel_f}")
            elif rel_dir == "wallpapers":
                if os.path.splitext(fn)[1].lower() not in IMAGE_EXTS:
                    raise SystemExit(f"kuwai-look: rejected non-image in wallpapers/: {rel_f}")
            else:
                raise SystemExit(f"kuwai-look: rejected file path in theme: {rel_f}")
            safe_files.append((full_f, rel_f))
    return safe_files


THEME_MAX = 200 * 1024 * 1024
THEME_FILE_MAX = 40 * 1024 * 1024


def clone_limits():
    """No file the clone writes (its one pack included) may pass THEME_MAX."""
    import resource
    resource.setrlimit(resource.RLIMIT_FSIZE, (THEME_MAX, THEME_MAX))


def cmd_install(source, slug=None):
    target_slug = derive_slug(source, slug)
    with tempfile.TemporaryDirectory(prefix="kuwai-theme-") as tmp:
        clone_dir = os.path.join(tmp, "repo")
        r = subprocess.run(
            ["git", "clone", "--depth", "1", "--single-branch", "--no-recurse-submodules",
             "--config", "core.hooksPath=/dev/null", "--", source, clone_dir],
            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60, preexec_fn=clone_limits,
        )
        if r.returncode != 0:
            too_big = r.returncode in (-25, 153) or "File size limit" in r.stderr
            raise SystemExit("kuwai-look: the theme is bigger than 200 MB; not installed" if too_big
                             else f"kuwai-look: git clone failed: {r.stderr.strip()}")
        commit = subprocess.run(["git", "-C", clone_dir, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
        safe_files = validate_theme_tree(clone_dir)
        raw, _ = theme_raw_from_dir(clone_dir)
        if raw is None or not raw.get("bg") or not raw.get("accent"):
            raise SystemExit("kuwai-look: theme must provide palette.toml, kitty.theme, or theme.dcol with bg and accent")
        os.makedirs(USER_THEMES, exist_ok=True)
        stage_dir = os.path.join(USER_THEMES, f".stage-{target_slug}-{os.getpid()}")
        dest_dir = os.path.join(USER_THEMES, target_slug)
        if os.path.exists(stage_dir):
            shutil.rmtree(stage_dir)
        os.makedirs(stage_dir, exist_ok=True)
        for src_f, rel_f in safe_files:
            if os.path.getsize(src_f) > THEME_FILE_MAX:
                shutil.rmtree(stage_dir, ignore_errors=True)
                raise SystemExit(f"kuwai-look: {rel_f} is bigger than 40 MB; not installed")
            out_f = os.path.join(stage_dir, rel_f)
            os.makedirs(os.path.dirname(out_f), exist_ok=True)
            shutil.copyfile(src_f, out_f)
            os.chmod(out_f, 0o644)
        with open(os.path.join(stage_dir, ".kuwai-source.json"), "w") as f:
            json.dump({"source": source, "commit": commit}, f)
        old_dir = None
        if os.path.exists(dest_dir):
            old_dir = os.path.join(USER_THEMES, f".old-{target_slug}-{os.getpid()}")
            os.replace(dest_dir, old_dir)
        try:
            os.replace(stage_dir, dest_dir)
        except OSError:
            if old_dir:
                os.replace(old_dir, dest_dir)
            raise
        if old_dir:
            shutil.rmtree(old_dir, ignore_errors=True)
    return {"ok": True, "slug": target_slug, "path": dest_dir, "files": len(safe_files), "commit": commit}


def cmd_undo(apply_live=True):
    state = load_json(os.path.join(LOOK_DIR, "state.json"), {})
    prev = state.get("previous")
    if not prev or "/" in prev or not os.path.isdir(os.path.join(LOOK_DIR, prev)):
        raise SystemExit("kuwai-look: no previous generation to restore")
    current_link = os.path.join(LOOK_DIR, "current")
    cur_name = os.readlink(current_link) if os.path.islink(current_link) else None
    tmp = os.path.join(LOOK_DIR, f".current-{os.getpid()}-{time.time_ns()}")
    os.symlink(prev, tmp)
    os.replace(tmp, current_link)
    pal = load_json(os.path.join(LOOK_DIR, prev, "palette.json"), {})
    wall = (pal.get("source") or {}).get("wallpaper") or ""
    if wall and os.path.isfile(wall):
        set_wall_symlink(wall)
        set_global_wall(STATE_HOME, wall)
    new_state = {
        "schema": 1,
        "generation": pal.get("generation") or prev.removeprefix("gen-"),
        "previous": cur_name if cur_name and cur_name != prev else None,
        "mode": pal.get("mode") or "dark",
        "theme": (pal.get("source") or {}).get("name") or "",
        "wallpaper": wall,
        "at": int(time.time()),
    }
    tmp_s = os.path.join(LOOK_DIR, ".state.json.tmp")
    with open(tmp_s, "w", encoding="utf-8") as f:
        json.dump(new_state, f, indent=2)
        f.write("\n")
    os.replace(tmp_s, os.path.join(LOOK_DIR, "state.json"))
    reload_errors = reload_consumers(wall if wall and os.path.isfile(wall) else None, mode=new_state["mode"], state=new_state) if apply_live else []
    return {"ok": True, "state": new_state, "palette": pal, "reloadErrors": reload_errors}


def cmd_init(mode="dark", apply_live=False, force=False):
    cur_pal = os.path.join(LOOK_DIR, "current", "palette.json")
    if not force and os.path.isfile(cur_pal):
        return {"ok": True, "already": True, "state": load_json(os.path.join(LOOK_DIR, "state.json"), {})}
    if os.path.exists(WALL_LINK):
        return cmd_set_wallpaper(os.path.realpath(WALL_LINK), mode=mode, apply_live=apply_live)
    gen = new_generation()
    palette = build_palette(
        {"bg": "#111114", "fg": "#f4f4f6", "accent": "#66c7ff", "secondary": "#86e0b4", "tertiary": "#ff7a98"},
        source={"kind": "default", "name": "Kuwai Night", "wallpaper": "", "mode": mode},
        generation=gen,
        mode="dark" if mode == "theme" else mode,
    )
    _, state = write_generation(LOOK_DIR, palette, custom_templates_dir=CUSTOM_TEMPLATES)
    reload_errors = reload_consumers(None, mode=palette["mode"], state=state) if apply_live else []
    return {"ok": True, "state": state, "palette": palette, "reloadErrors": reload_errors}


def cmd_status():
    state = load_json(os.path.join(LOOK_DIR, "state.json"), {})
    pal = load_json(os.path.join(LOOK_DIR, "current", "palette.json"), {})
    return {
        "schema": 1,
        "initialized": bool(pal),
        "wallpaper": os.path.realpath(WALL_LINK) if os.path.exists(WALL_LINK) else "",
        "state": state,
        "palette": pal,
    }


def cmd_variant(variant, theme_name=None, fetch=False):
    want = str(variant or "").strip().lower()
    if want not in ("day", "night"):
        raise SystemExit(f"kuwai-look: variant must be day or night, got {variant!r}")
    state = load_json(os.path.join(LOOK_DIR, "state.json"), {})
    tname = theme_name or state.get("theme") or ""
    all_dirs = theme_dirs(include_personal=True)
    repo_dir = all_dirs.get(tname) or ""
    if not repo_dir and tname:
        slug = re.sub(r"[^a-z0-9]+", "-", tname.lower()).strip("-")
        if slug in all_dirs:
            tname = slug
            repo_dir = all_dirs[slug]
    path = find_variant_wall(tname, repo_dir, want, fetch=fetch) if repo_dir else ""
    state_walls = load_screen_walls(STATE_HOME)
    outputs = inherited_outputs(state_walls, query_monitors())
    return {"ok": True, "theme": tname, "variant": want, "path": path, "outputs": outputs,
            "current": path == (state_walls["default"] or current_wall())}


def inherited_outputs(state_walls, monitors):
    return [m["name"] for m in monitors if isinstance(m, dict) and m.get("name")
            and output_identity(m) not in state_walls["screens"]]


def cmd_apply_variant(path, apply_live=True, mode=None):
    real = os.path.realpath(path)
    if not os.path.isfile(real):
        return 1
    data = load_screen_walls(STATE_HOME)
    monitors = query_monitors()
    outputs = inherited_outputs(data, monitors)
    if apply_live and outputs:
        if not apply_awww(real, output=",".join(outputs)):
            return 1
    data["default"] = real
    save_screen_walls(STATE_HOME, data)
    focused = primary_monitor(monitors)
    if focused is None or focused.get("name") in outputs:
        cmd_focus_wallpaper(apply_live, wall=real, mode=mode)
    return 0


def cmd_list(include_personal=False):
    state = load_json(os.path.join(LOOK_DIR, "state.json"), {})
    cur_theme = state.get("theme") or ""
    cur_wall = os.path.realpath(WALL_LINK) if os.path.exists(WALL_LINK) else ""
    cur_mode_name = state.get("mode") or "theme"
    cur_mode_idx = MODES.index(cur_mode_name) if cur_mode_name in MODES else 0

    all_dirs = theme_dirs(include_personal=True)
    shown_dirs = theme_dirs(include_personal=include_personal)
    if cur_theme and cur_theme in all_dirs and cur_theme not in shown_dirs:
        shown_dirs[cur_theme] = all_dirs[cur_theme]

    themes = []
    for name, full in sorted(shown_dirs.items(), key=lambda kv: kv[0].lower()):
        raw, _wall_dir = theme_raw_from_dir(full)
        if raw is None:
            continue
        bg = raw.get("bg") or "#111114"
        fg = raw.get("fg") or "#f4f4f6"
        accent = raw.get("accent") or "#66c7ff"
        ansi = raw.get("ansi")
        swatch = [bg, ansi[1], ansi[3], ansi[2], ansi[6], ansi[4], ansi[5], fg] if ansi and len(ansi) >= 7 else [bg, accent, raw.get("secondary") or accent, raw.get("tertiary") or accent, fg]
        thumb = find_theme_wall(name, full)
        themes.append({
            "name": name,
            "path": full,
            "thumb": thumb,
            "downloadable": bool(tsv_rows(full)),
            "current": name == cur_theme,
            "bg": bg,
            "fg": fg,
            "accent": accent,
            "palette": swatch,
        })

    walls = []
    seen = set()
    folders = [
        STATE_WALLS,
        os.path.join(HOME, "Pictures", "Wallpapers"),
        os.path.join(HOME, "Pictures", "wallpapers"),
    ]
    variant_map = {}
    if cur_theme and cur_theme in all_dirs:
        for row in tsv_rows(all_dirs[cur_theme]):
            if row.get("variant"):
                variant_map[row["name"]] = row["variant"]
        for d in reversed(theme_wall_dirs(cur_theme, all_dirs[cur_theme])):
            if d not in folders:
                folders.insert(0, d)
    for folder in folders:
        if not os.path.isdir(folder):
            continue
        for root_d, _, files in os.walk(folder):
            for fn in sorted(files):
                if os.path.splitext(fn)[1].lower() in IMAGE_EXTS:
                    p = os.path.join(root_d, fn)
                    real = os.path.realpath(p)
                    if real not in seen:
                        seen.add(real)
                        stem = os.path.splitext(fn)[0]
                        walls.append({
                            "name": stem,
                            "path": real,
                            "thumb": real,
                            "current": real == cur_wall,
                            "variant": variant_map.get(stem, ""),
                            "palette": [],
                        })
    for item in installed_walls(ROOT):
        path = os.path.realpath(item["path"])
        if path not in seen:
            seen.add(path)
            walls.append({**item, "path": path, "thumb": path, "current": path == cur_wall,
                          "variant": variant_map.get(os.path.splitext(os.path.basename(path))[0], ""),
                          "palette": []})
    if cur_wall and os.path.isfile(cur_wall) and cur_wall not in seen:
        seen.add(cur_wall)
        walls.insert(0, {
            "name": os.path.splitext(os.path.basename(cur_wall))[0],
            "path": cur_wall,
            "thumb": cur_wall,
            "current": True,
            "palette": [],
        })
    monitors, screen_walls = connected_screen_walls(STATE_HOME, fallback_wall=cur_wall)
    return {
        "schema": 1,
        "current": cur_theme,
        "mode": cur_mode_idx,
        "modes": MODES,
        "themes": themes,
        "wallpapers": walls,
        "monitors": monitors,
        "screenWallpapers": screen_walls,
    }


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    rest = argv[1:]
    apply_live = "--no-apply" not in rest
    args = [a for a in rest if a != "--no-apply"]
    mode = "dark"
    if "--mode" in args:
        idx = args.index("--mode")
        if idx + 1 >= len(args):
            raise SystemExit("kuwai-look: --mode needs a value")
        mode = args[idx + 1]
        args = args[:idx] + args[idx + 2:]
    output = None
    if "--output" in args:
        idx = args.index("--output")
        if idx + 1 >= len(args):
            raise SystemExit("kuwai-look: --output needs a value")
        output = args[idx + 1]
        args = args[:idx] + args[idx + 2:]
    fetch_variant = "--fetch" in args
    args = [a for a in args if a != "--fetch"]
    theme_arg = None
    if "--theme" in args:
        idx = args.index("--theme")
        if idx + 1 >= len(args):
            raise SystemExit("kuwai-look: --theme needs a value")
        theme_arg = args[idx + 1]
        args = args[:idx] + args[idx + 2:]

    if cmd == "set-wallpaper" and len(args) == 1:
        res = with_lock(lambda: cmd_set_wallpaper(args[0], mode=mode, apply_live=apply_live, output=output))
        print(json.dumps(res))
        return 0
    if cmd == "restore" and not args:
        res = with_lock(lambda: cmd_restore(output=output, apply_live=apply_live))
        print(json.dumps(res))
        return 0 if res["ok"] else 1
    if cmd == "focus-wallpaper" and not args:
        with_lock(lambda: cmd_focus_wallpaper(apply_live))
        return 0
    if cmd == "apply-variant" and len(args) == 1:
        return with_lock(lambda: cmd_apply_variant(args[0], apply_live, mode if "--mode" in rest else None))
    if cmd == "variant" and len(args) == 1:
        res = cmd_variant(args[0], theme_name=theme_arg, fetch=fetch_variant)
        print(json.dumps(res))
        return 0
    if cmd == "theme" and len(args) == 1:
        res = with_lock(lambda: cmd_theme(args[0], mode=mode if "--mode" in rest else "theme", apply_live=apply_live))
        print(json.dumps(res))
        return 0
    if cmd == "mode" and len(args) == 1:
        res = with_lock(lambda: cmd_mode(args[0], apply_live=apply_live))
        print(json.dumps(res))
        return 0
    if cmd == "install" and len(args) in (1, 2):
        res = with_lock(lambda: cmd_install(args[0], args[1] if len(args) == 2 else None))
        print(json.dumps(res))
        return 0
    if cmd == "undo" and not args:
        res = with_lock(lambda: cmd_undo(apply_live=apply_live))
        print(json.dumps(res))
        return 0
    if cmd == "init" and not args:
        res = with_lock(lambda: cmd_init(mode=mode, apply_live=apply_live))
        print(json.dumps(res))
        return 0
    if cmd == "status":
        print(json.dumps(cmd_status()))
        return 0
    if cmd == "list":
        print(json.dumps(cmd_list(include_personal="--all" in args)))
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
