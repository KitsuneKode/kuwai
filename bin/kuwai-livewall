#!/usr/bin/env bash
# kuwai-livewall (was ~/Scripts/live-wallpaper.sh) — picks the live wallpaper
#
# The shell plays it: shell/modules/wallpaper/LiveWallpaper.qml watches
# $XDG_STATE_HOME/live-wallpaper/last and plays that video on the background
# layer itself (one muted, looping player per screen, paused under a
# fullscreen window, the lock and, unless allowed, on battery). This script
# only chooses and records:
#
#   toggle | next | play FILE   write the pick to `last`, set `enabled`
#   stop                        empty `last` (the shell fades the video out)
#   first                       the remembered pick, else the library's first
#   resume                      at login / theme apply; does nothing while the
#                               shell is up (it already plays `last`)
#
# With mpvpaper installed, the shell still decides (when to play, pause or
# release, per screen) but mpv plays: `out-play|out-pause|out-stop SCREEN`,
# one mpvpaper per screen with its own IPC socket. Measured 2026-11-18 on a
# 1440p loop: the shell's own player held ~1 GB and 24 % CPU for two screens;
# mpv with hardware decoding is ~280 MB and 7 % a screen, outside the shell.
#
# Without the shell (it isn't running), mpvpaper is the fallback player:
# spawn() starts it with its IPC socket under $XDG_RUNTIME_DIR/kuwai/ and a
# `watch` loop that pauses it while any window is fullscreen.
#
# Library (Omarchy's per-theme convention), merged, sorted by name:
#   1. ~/.config/hyde/themes/<ACTIVE THEME>/wallpapers/live/
#   2. ~/Pictures/live-wallpapers/
# Prefix filenames 1-, 2-, 3- ... to define cycle order.
#
# State: $XDG_STATE_HOME/live-wallpaper/{last,enabled,index}.
# The fallback needs mpvpaper, socat and jq.

set -u

GLOBAL_LIB="$HOME/Pictures/live-wallpapers"
SOCK_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kuwai"   # private (0700), not a guessable /tmp path
SOCK_PREFIX="$SOCK_DIR/mpvpaper-ipc"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/live-wallpaper"   # where LiveWallpaper.qml reads it
IDX="$STATE_DIR/index"       # cycle position within current library
LAST="$STATE_DIR/last"       # last played file
ENABLED="$STATE_DIR/enabled" # flag: live walls wanted across boots/themes
MPV_OPTS="no-audio loop hwdec=auto panscan=1.0 input-ipc-server=$SOCK_PREFIX.sock"

# ── A copy the GPU can decode ───────────────────────────────────────────────
# `playable FILE` prints the file the shell should play. Many loops from the
# web are H.264 in 4:4:4 colour (yuv444p), which no GPU decodes (24 of the
# owner's 30 loops, 2026-11-18). Measured on one 1440p loop, shell memory
# while it played on two screens: 1110 MB with the 4:4:4 original, 910–935 MB
# with its 4:2:0 copy. So the copy helps (and is what a GPU can decode), but
# it is not where most of the memory is: that is the two players themselves,
# about 700 MB while they play, whatever the file. For a 4:4:4 file a 4:2:0
# copy is made once, in the background, in the cache; the original plays until
# it is ready, then `last` is written again so the shell switches to the copy.
# A file that is already fine is printed as it is, and nothing is made.
LIVE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/live"
playable() {
    local f=$1 fmt codec key out
    [ -f "$f" ] || { printf '%s\n' "$f"; return 0; }
    command -v ffprobe >/dev/null && command -v ffmpeg >/dev/null || { printf '%s\n' "$f"; return 0; }
    fmt=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of csv=p=0 -- "$f" 2>/dev/null | head -n 1)
    codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 -- "$f" 2>/dev/null | head -n 1)
    case "$codec:$fmt" in
        h264:yuv420p|h264:yuvj420p|hevc:yuv420p|hevc:yuvj420p|hevc:yuv420p10le|av1:yuv420p|av1:yuv420p10le|vp9:yuv420p) printf '%s\n' "$f"; return 0 ;;
        :*|*:) printf '%s\n' "$f"; return 0 ;;            # couldn't read it: play it as it is
    esac
    # The copy's name follows the file's path, size and date: a changed file gets a new copy.
    key=$(printf '%s|%s' "$f" "$(stat -c '%s|%Y' -- "$f" 2>/dev/null)" | sha1sum | cut -c1-20)
    out="$LIVE_CACHE/$key.mp4"
    if [ -s "$out" ]; then printf '%s\n' "$out"; return 0; fi
    printf '%s\n' "$f"
    mkdir -p "$LIVE_CACHE" || return 0
    # One at a time per file; the lock is held by the job, gone when it ends.
    (
        exec 9>"$out.lock"
        flock -n 9 || exit 0
        [ -s "$out" ] && exit 0
        enc="-c:v libx264 -preset veryfast -crf 20"
        ffmpeg -hide_banner -encoders 2>/dev/null | grep -q ' h264_nvenc ' && enc="-c:v h264_nvenc -preset p5 -rc vbr -cq 23 -b:v 0"
        # At most 1440 lines (what a wallpaper is shown at here), even sizes, no sound, starts fast.
        # shellcheck disable=SC2086  # $enc is a fixed list of options from the two lines above
        if nice -n 19 ffmpeg -nostdin -hide_banner -loglevel error -y -i "$f" -an $enc -pix_fmt yuv420p \
                -vf "scale=-2:'min(1440,ih)'" -movflags +faststart -f mp4 "$out.part" 2>/dev/null \
           && [ -s "$out.part" ]; then
            mv -f -- "$out.part" "$out"
            # Still the pick: say so again, and the shell (which watches `last`) asks once more.
            [ "$(cat "$LAST" 2>/dev/null)" = "$f" ] && printf '%s' "$f" > "$LAST"
        else
            rm -f -- "$out.part"
        fi
        rm -f -- "$out.lock"
    ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

notify() { command -v notify-send >/dev/null && notify-send -a "󰸉 Live Wallpaper" "$1" || true; }

is_video() { case "$1" in *.mp4|*.MP4|*.webm|*.mkv|*.mov) return 0;; *) return 1;; esac; }

theme_live_dir() {
    local t; t=$(sed -n 's/^HYDE_THEME="\(.*\)"/\1/p' "$HOME/.local/state/hyde/staterc" 2>/dev/null)
    [ -n "$t" ] && printf '%s' "$HOME/.config/hyde/themes/$t/wallpapers/live"
}

library() {
    local td; td=$(theme_live_dir)
    if [ -n "$td" ] && find "$td" -maxdepth 1 -type f -print0 2>/dev/null \
        | while IFS= read -r -d '' f; do is_video "$f" && printf 'x'; done | grep -q x; then
        printf '%s' "$td"
    else
        printf '%s' "$GLOBAL_LIB"
    fi
}

files() {   # theme library + global library merged (theme vids surface first by name)
    local td; td=$(theme_live_dir)
    {
        if [ -n "$td" ]; then
            find "$td" -maxdepth 1 -type f \
                \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' \) \
                2>/dev/null
        fi
        find "$GLOBAL_LIB" -maxdepth 1 -type f \
            \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' \) \
            2>/dev/null
    } | sort -V
}

is_running() { pgrep -x mpvpaper >/dev/null; }   # the player, not a command line naming it
# The shell that plays video itself: kuwai (its process is `qs`), or a
# standalone Quickshell.
shell_up() { qs list --all --json 2>/dev/null | jq -e 'any(.[]; .config_path | endswith("/shell/shell.qml"))' >/dev/null; }

mpv_pause() {   # $1 = true|false — sent to every mpvpaper ipc socket (multi-monitor safe)
    for s in "$SOCK_PREFIX"*.sock; do
        [ -S "$s" ] && printf '{ "command": ["set_property", "pause", %s] }\n' "$1" \
            | socat - "$s" >/dev/null 2>&1
    done
}

# Pause whenever any fullscreen window exists anywhere (battery + focus)
watch() {
    local sock="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
    socat -u "UNIX-CONNECT:$sock" - 2>/dev/null | while read -r _line; do
        sleep 0.15
        if hyprctl -j clients | jq -e '[.[] | select(.fullscreen > 0)] | length > 0' >/dev/null 2>&1; then
            mpv_pause true
        else
            mpv_pause false
        fi
    done
}

spawn() {   # shared start: video layer + fullscreen watcher + persist
    local file="$1"
    (umask 077; mkdir -p "$SOCK_DIR")
    setsid mpvpaper -o "$MPV_OPTS" '*' "$file" >/dev/null 2>&1 &
    setsid "$0" watch >/dev/null 2>&1 &
    mkdir -p "$STATE_DIR"
    printf '%s' "$file" > "$LAST"
}

start() {
    # Always record the pick — Quickshell's background watches $LAST live.
    mkdir -p "$STATE_DIR"
    printf '%s' "$1" > "$LAST"
    touch "$ENABLED"
    # mpvpaper is the fallback backend — only when Quickshell isn't running
    if ! shell_up; then
        command -v mpvpaper >/dev/null || { notify "mpvpaper not installed — yay -S mpvpaper"; exit 1; }
        is_running && stop_sleep
        spawn "$1"
    fi
    notify "▶ $(basename "$1")"
}

resume() {   # login / theme-apply entry point — no-op unless user opted in
    [ -f "$ENABLED" ] || exit 0
    command -v mpvpaper >/dev/null || exit 0
    # Quickshell's background layer renders video natively — never double-decode
    shell_up && exit 0
    is_running && exit 0
    local f lib; f=$(cat "$LAST" 2>/dev/null || true); lib=$(library)
    [ -n "$f" ] && [ -f "$f" ] && case "$f" in "$lib"/*) ;; *) f="";; esac
    if [ -z "${f:-}" ]; then
        mapfile -t fl < <(files); f="${fl[0]:-}"
    fi
    [ -n "$f" ] && spawn "$f" || exit 0
}

stop_sleep() { stop; sleep 0.4; }

stop() {
    pkill -x mpvpaper 2>/dev/null
    pkill -f 'kuwai-livewall watch' 2>/dev/null
    pkill -f 'live-wallpaper.sh watch' 2>/dev/null   # a watcher from before the move
    : > "$LAST"   # empty LAST = Quickshell fades video out, poster shows
    rm -f "$ENABLED" "$IDX" "$SOCK_PREFIX"*.sock
    notify "⏹ back to static wallpaper"
}

next() {
    mapfile -t f < <(files)
    [ ${#f[@]} -eq 0 ] && { notify "no videos in $(library)"; exit 1; }
    local i; i=$(cat "$IDX" 2>/dev/null || echo 0)
    i=$(( i % ${#f[@]} ))
    start "${f[$i]}"
    echo $(( i + 1 )) > "$IDX"
}

# ── One screen, played by mpv, driven by the shell ─────────────────────────
out_sock() { printf '%s/mpvpaper-%s.sock' "$SOCK_DIR" "$1"; }
out_pidf() { printf '%s/mpvpaper-%s.pid' "$SOCK_DIR" "$1"; }
out_pid() {   # the live mpvpaper for this screen, or nothing
    local p; p=$(cat "$(out_pidf "$1")" 2>/dev/null) || return 1
    [ -n "$p" ] && [ "$(cat "/proc/$p/comm" 2>/dev/null)" = mpvpaper ] && printf '%s' "$p"
}
out_cmd() {   # SCREEN JSON-command
    local s; s=$(out_sock "$1")
    [ -S "$s" ] && printf '%s\n' "$2" | socat - "$s" >/dev/null 2>&1
}
out_play() {   # SCREEN FILE [paused]: start, or switch the file, or set the pause
    local out="$1" file="$2" paused="${3:-}" pid cur pause_now=false opts
    [ "$paused" = paused ] && pause_now=true
    command -v mpvpaper >/dev/null || return 1
    (umask 077; mkdir -p "$SOCK_DIR")
    if pid=$(out_pid "$out"); then
        cur=$(cat "$SOCK_DIR/mpvpaper-$out.file" 2>/dev/null)
        if [ "$cur" = "$file" ]; then out_cmd "$out" "{ \"command\": [\"set_property\", \"pause\", $pause_now] }"; return 0; fi
        if out_cmd "$out" "$(jq -cn --arg f "$file" '{command: ["loadfile", $f, "replace"]}')"; then
            printf '%s' "$file" > "$SOCK_DIR/mpvpaper-$out.file"
            out_cmd "$out" "{ \"command\": [\"set_property\", \"pause\", $pause_now] }"
            return 0
        fi
        kill "$pid" 2>/dev/null
    fi
    rm -f "$(out_sock "$out")"
    # Its own session (it outlives a shell restart; the shell takes it over again).
    # Started paused when the screen is covered: its first frame shows, nothing decodes.
    opts="no-audio loop hwdec=auto panscan=1.0 input-ipc-server=$(out_sock "$out")"
    [ "$pause_now" = true ] && opts="$opts pause"
    setsid nice -n 5 mpvpaper -o "$opts" "$out" "$file" </dev/null >/dev/null 2>&1 &
    printf '%s' "$!" > "$(out_pidf "$out")"
    printf '%s' "$file" > "$SOCK_DIR/mpvpaper-$out.file"
}
out_stop() {   # SCREEN: the player goes, and what it held with it
    local pid
    pid=$(out_pid "$1") && kill "$pid" 2>/dev/null
    rm -f "$(out_sock "$1")" "$(out_pidf "$1")" "$SOCK_DIR/mpvpaper-$1.file"
}

case "${1:-toggle}" in
    toggle)
        if shell_up; then
            [ -f "$ENABLED" ] && stop || next
        else
            is_running && stop || next
        fi ;;
    next)    next ;;
    play)    start "${2:?usage: $0 play <file>}" ;;
    resume)  resume ;;
    stop)    stop ;;
    watch)   watch ;;
    playable) playable "${2:?usage: $0 playable <file>}" ;;
    first)   # Quickshell seed — remembered pick wins, else first of merged library
        pick=$(cat "$LAST" 2>/dev/null || true)
        if [ -n "$pick" ] && [ -f "$pick" ] && is_video "$pick"; then
            printf '%s\n' "$pick"
        else
            files | head -1
        fi ;;
    status)  is_running && echo "playing in: $(library)" || echo "off" ;;
    # Driven by the shell (LiveWallpaper.qml), one screen at a time.
    can-play) command -v mpvpaper >/dev/null && command -v socat >/dev/null && command -v jq >/dev/null ;;
    out-play)  out_play "${2:?screen}" "${3:?file}" "${4:-}" ;;   # [paused]
    out-pause) out_cmd "${2:?screen}" "{ \"command\": [\"set_property\", \"pause\", ${3:-true}] }" ;;
    out-stop)  out_stop "${2:?screen}" ;;
    *)       echo "usage: $0 {toggle|next|play <file>|resume|stop|status|playable <file>}" ;;
esac
