#!/usr/bin/env bash
# The clipboard panel's hands (shell/services/Clipboard.qml). History is
# cliphist's (the wl-paste watchers keep feeding it); pins are the rice's own
# and outlive cliphist's 750-item cap.
#
#   rice-clip list                 cliphist list, wide previews
#   rice-clip text ID              the entry's text (first 64 KiB)
#   rice-clip thumb ID EXT         decode an image entry into the cache, print its path
#   rice-clip copy ID|pin:N        put an entry (or pin) on the clipboard
#   rice-clip paste ID|pin:N       copy, then paste into the focused window
#   rice-clip open ID|pin:N        open with the default app (URL, path, image, text)
#   rice-clip delete ID            remove from history
#   rice-clip wipe                 clear history (pins stay)
#   rice-clip copy-text TEXT       put this text on the clipboard (edits, transforms)
#   rice-clip paste-text TEXT      …and paste it into the focused window
#   rice-clip render ID|pin:N      what the text is, as rich text (bin/rice-render)
#   rice-clip edit ID|pin:N        open it in your editor (nvim) in a floating kitty;
#                                  if you change it, the edit lands on the clipboard
#                                  ($RICE_EDITOR, else $EDITOR, else nvim; $RICE_TERMINAL, else kitty)
#   rice-clip ocr ID|pin:N         the text in an image (tesseract)
#   rice-clip save ID|pin:N        save to ~/Pictures/Clipboard; prints the path
#   rice-clip stamp                record when the newest entry was copied (run by
#                                  `wl-paste --watch rice-clip stamp`, hypr/rice.conf)
#   rice-clip files ID|pin:N       copied files (file:// URIs or a path): JSON with
#                                  each one's path, name, size, type, whether it still
#                                  exists, and a preview (PDF first page, the image)
#   rice-clip pin ID               save an entry as a pin; prints its pin file
#   rice-clip unpin FILE           remove a pin
set -euo pipefail

cache="${XDG_CACHE_HOME:-$HOME/.cache}/rice/clip"
pins="${XDG_DATA_HOME:-$HOME/.local/share}/rice/clipboard/pins"
mkdir -p "$cache/thumbs" "$cache/open" "$pins"

# An entry's bytes on stdout: a cliphist id, or pin:FILE.
emit() {
    case "$1" in
        pin:*) cat -- "$pins/${1#pin:}" ;;
        *)     printf '%s\t\n' "$1" | cliphist decode ;;
    esac
}

ext_of() {   # sniff the type: png, jpg, … or txt
    case "$(file -b --mime-type "$1")" in
        image/png) echo png ;; image/jpeg) echo jpg ;; image/gif) echo gif ;;
        image/webp) echo webp ;; image/bmp) echo bmp ;; image/svg+xml) echo svg ;;
        image/tiff) echo tiff ;; text/*|application/json) echo txt ;; *) echo bin ;;
    esac
}

# Copied files come back as files: a list of file:// URIs goes on the
# clipboard as text/uri-list (what file managers and upload fields take),
# without the ones that no longer exist.
uris_existing() {
    while IFS= read -r line; do
        line="${line%$'\r'}"
        case "$line" in file://*) ;; *) continue ;; esac
        path=$(printf '%s' "${line#file://}" | python3 -I -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.stdin.read()))')
        [ -e "$path" ] && printf '%s\r\n' "$line"
    done
}

copy() {
    local tmp; tmp=$(mktemp "$cache/open/.copy.XXXXXX")
    emit "$1" > "$tmp"
    local mime; mime=$(file -b --mime-type "$tmp")
    if head -c 7 "$tmp" | grep -q '^file://'; then
        local list; list=$(uris_existing < "$tmp")
        if [ -n "$list" ]; then printf '%s' "$list" | wl-copy --type text/uri-list; rm -f -- "$tmp"; return; fi
    fi
    case "$mime" in
        image/*) wl-copy --type "$mime" < "$tmp" ;;
        *)       wl-copy < "$tmp" ;;
    esac
    rm -f -- "$tmp"
}

case "${1:-}" in
    list)  cliphist list -preview-width 400 ;;
    text)  emit "$2" | head -c 65536 ;;
    thumb)
        out="$cache/thumbs/$2.${3:-png}"
        [ -s "$out" ] || emit "$2" > "$out"
        printf '%s\n' "$out" ;;
    copy)  copy "$2" ;;
    paste|paste-text)
        if [ "$1" = paste ]; then copy "$2"; else printf '%s' "$2" | wl-copy; fi
        # Let the panel hand keyboard focus back first, then paste the way
        # the window expects: terminals take Ctrl+Shift+V.
        sleep 0.08
        class=$(hyprctl activewindow -j 2>/dev/null | sed -n 's/.*"class": *"\([^"]*\)".*/\1/p' | head -1)
        case "${class,,}" in
            *kitty*|*ghostty*|*foot*|*alacritty*|*wezterm*|*konsole*|*terminal*|*terminator*|*tilix*)
                wtype -M ctrl -M shift -k v -m shift -m ctrl ;;
            *)  wtype -M ctrl -k v -m ctrl ;;
        esac ;;
    open)
        tmp=$(mktemp "$cache/open/.raw.XXXXXX")
        emit "$2" > "$tmp"
        ext=$(ext_of "$tmp")
        if [ "$ext" = txt ]; then
            text=$(head -c 4096 "$tmp" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            single=$(printf '%s' "$text" | wc -l)
            # A link, a path, or a file:// URI opens what it points at.
            if [ "$single" -eq 0 ] && [[ "$text" =~ ^(https?|ftp|mailto):[^[:space:]]+$ ]]; then
                rm -f -- "$tmp"; exec xdg-open "$text"
            fi
            path="${text#file://}"; path="${path/#\~/$HOME}"
            if [ "$single" -eq 0 ] && [ -e "$path" ]; then
                rm -f -- "$tmp"; exec xdg-open "$path"
            fi
        fi
        out="$cache/open/clip-$(date +%Y%m%d-%H%M%S).$ext"
        mv -- "$tmp" "$out"
        exec xdg-open "$out" ;;
    copy-text) printf '%s' "$2" | wl-copy ;;
    files)
        emit "$2" | head -c 65536 | THUMBS="$cache/thumbs" python3 -I -c '
import json, mimetypes, os, subprocess, sys, hashlib, urllib.parse
text = sys.stdin.read().strip()
paths = [urllib.parse.unquote(l[7:]) for l in text.splitlines() if l.startswith("file://")]
if not paths and text.startswith(("/", "~/")) and "\n" not in text:
    paths = [os.path.expanduser(text)]
out = []
for p in paths[:50]:
    e = {"path": p, "name": os.path.basename(p.rstrip("/")) or p, "exists": os.path.exists(p), "dir": os.path.isdir(p)}
    e["type"] = "folder" if e["dir"] else (mimetypes.guess_type(p)[0] or "")
    if e["exists"] and not e["dir"]:
        st = os.stat(p)
        e["size"] = st.st_size
        if e["type"] == "application/pdf" or e["type"].startswith("image/"):
            key = hashlib.sha1(f"{p}:{st.st_mtime}:110dpi".encode()).hexdigest()[:16]
            thumb = os.path.join(os.environ["THUMBS"], f"file-{key}.png")
            if not os.path.exists(thumb):
                if e["type"] == "application/pdf":
                    subprocess.run(["pdftoppm", "-png", "-r", "110", "-f", "1", "-l", "1", "-singlefile", p, thumb[:-4]], capture_output=True, timeout=10)
                else:
                    thumb = p
            if os.path.exists(thumb):
                e["preview"] = thumb
        if e["type"] == "application/pdf":
            info = subprocess.run(["pdfinfo", p], capture_output=True, text=True, timeout=5).stdout
            pages = [l.split(":", 1)[1].strip() for l in info.splitlines() if l.startswith("Pages:")]
            if pages: e["pages"] = int(pages[0])
    out.append(e)
print(json.dumps(out))
' ;;
    stamp)
        # wl-paste hands us the new contents on stdin; we only want the moment.
        cat > /dev/null
        now=$(date +%s%3N)
        # cliphist's own watcher stores the same copy; give it a moment.
        sleep 0.4
        id=$(cliphist list 2>/dev/null | head -1 | cut -f1)
        [ -n "$id" ] || exit 0
        times="$(dirname "$pins")/times.tsv"
        # Once per entry: re-copying the same thing moves it to the top with
        # the same id, which counts as copying it again.
        tail -1 "$times" 2>/dev/null | grep -q "^$id	" || printf '%s\t%s\n' "$id" "$now" >> "$times" ;;
    edit)
        dir="$cache/edit"; mkdir -p "$dir"
        tmp=$(mktemp "$dir/.raw.XXXXXX")
        emit "$2" > "$tmp"
        ext=$(ext_of "$tmp"); [ "$ext" = txt ] && head -c 4096 "$tmp" | grep -qE '^#{1,6} |^```|^\s*[-*] \S' && ext=md
        f="$dir/clip-$(date +%Y%m%d-%H%M%S).$ext"
        mv -- "$tmp" "$f"
        before=$(sha1sum < "$f")
        editor="${RICE_EDITOR:-${EDITOR:-nvim}}"
        term="${RICE_TERMINAL:-kitty}"
        # The window class lets Hyprland float and centre it (hypr/rice.conf).
        $term --class rice-edit --title "Clipboard · $(basename "$f")" -e $editor "$f"
        if [ "$(sha1sum < "$f")" != "$before" ]; then wl-copy < "$f"; fi ;;
    render) emit "$2" | head -c 262144 | "$(dirname "$0")/rice-render" ;;
    ocr)
        tmp=$(mktemp "$cache/open/.ocr.XXXXXX")
        emit "$2" > "$tmp"
        tesseract "$tmp" - 2>/dev/null | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
        rm -f -- "$tmp" ;;
    save)
        dir="$HOME/Pictures/Clipboard"; mkdir -p "$dir"
        tmp=$(mktemp "$cache/open/.save.XXXXXX")
        emit "$2" > "$tmp"
        out="$dir/clip-$(date +%Y%m%d-%H%M%S).$(ext_of "$tmp")"
        mv -- "$tmp" "$out"
        printf '%s\n' "$out" ;;
    delete) printf '%s\t\n' "$2" | cliphist delete ;;
    wipe)   cliphist wipe ;;
    pin)
        tmp=$(mktemp "$pins/.new.XXXXXX")
        emit "$2" > "$tmp"
        name="$(date +%s%N).$(ext_of "$tmp")"
        mv -- "$tmp" "$pins/$name"
        printf '%s\n' "$name" ;;
    unpin)  rm -f -- "$pins/${2##*/}" ;;
    *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
