#!/usr/bin/env bash
set -euo pipefail

usage() {
cat <<'KUWAI_USAGE'
kuwai-theme install [kuwai-night]: put a kuwai theme where HyDE (and the
island's Themes panel) find it, ~/.config/hyde/themes/<Name>.

A kuwai theme is a wallpaper set and window borders (hairlines, like the
island's rim), and, when themes/<theme>/ has them, its own terminal palette
(kitty.theme, ghostty.theme: the blue slot is the island's accent). Your GTK
theme, icons and font, and the palette of a theme without its own, are taken
from the theme you use now, so switching changes nothing else. The
wallpapers are downloaded (themes/<theme>/wallpapers.tsv: name, URL), not
shipped in the repo, and scaled to at most 3840 wide. Credits:
themes/<theme>/CREDITS.txt, copied beside them.
  kuwai-theme install            Kuwai Night
KUWAI_USAGE
}
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
[ "${1:-}" = install ] || { usage; exit 2; }
shift
apply=0; slug=kuwai-night
for a in "$@"; do case "$a" in --apply) apply=1 ;; *) slug=$a ;; esac; done
src="$ROOT/themes/$slug"
[ -d "$src" ] || { echo "no theme $slug in $ROOT/themes" >&2; exit 1; }
name=$(printf '%s' "$slug" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g')
themes="${XDG_CONFIG_HOME:-$HOME/.config}/hyde/themes"
dest="$themes/$name"
cur=$(sed -n 's/^HYDE_THEME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/staterc" 2>/dev/null | head -n1 || true)
mkdir -p "$dest/wallpapers"
if [ -n "$cur" ] && [ -f "$themes/$cur/hypr.theme" ] && [ "$cur" != "$name" ]; then
    awk -v cur="$themes/$cur/hypr.theme" 'BEGIN { while ((getline l < cur) > 0) if (l ~ /^\$(GTK_THEME|ICON_THEME|COLOR_SCHEME|FONT)/) keep[substr(l, 1, index(l, "=") - 1)] = l }
        /^\$(GTK_THEME|ICON_THEME|COLOR_SCHEME|FONT)/ { k = substr($0, 1, index($0, "=") - 1); if (k in keep) { print keep[k]; next } } { print }' "$src/hypr.theme" > "$dest/hypr.theme"
    for f in rofi.theme kitty.theme ghostty.theme; do
        if [ -f "$src/$f" ]; then cp "$src/$f" "$dest/"; elif [ -f "$themes/$cur/$f" ]; then cp "$themes/$cur/$f" "$dest/"; fi
    done
    [ -d "$themes/$cur/kvantum" ] && cp -r "$themes/$cur/kvantum" "$dest/"
else
    cp "$src/hypr.theme" "$dest/"
    for f in kitty.theme ghostty.theme; do [ -f "$src/$f" ] && cp "$src/$f" "$dest/"; done
fi
cp "$src/CREDITS.txt" "$dest/wallpapers/"
while IFS=$'\t' read -r file url _rest; do
    case $file in ''|'#'*) continue ;; esac
    out="$dest/wallpapers/$file.jpg"
    [ -s "$out" ] && continue
    tmp=$(mktemp)
    if curl -fsSL --max-time 120 -o "$tmp" "$url"; then
        if command -v magick >/dev/null; then magick "$tmp" -resize '3840x>' -quality 92 "$out"; else mv "$tmp" "$out"; fi
        echo "  $file"
    else
        echo "  couldn't fetch $file ($url)" >&2
    fi
    rm -f "$tmp"
done < "$src/wallpapers.tsv"
if [ ! -e "$dest/wall.set" ]; then
    first=$(find "$dest/wallpapers" -maxdepth 1 -type f \( -name '*.jpg' -o -name '*.png' \) | sort | head -n1)
    [ -n "$first" ] && ln -s "$first" "$dest/wall.set"
fi
echo "installed: $dest"
[ $apply = 1 ] && exec "$ROOT/bin/kuwai-themes" theme "$name" --wait
exit 0
