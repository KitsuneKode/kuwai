#!/usr/bin/env bash
set -u -o pipefail

usage() {
cat <<'KUWAI_USAGE'
kuwai-migrations: change what an earlier kuwai left on this machine (settings,
state, caches) into what this one expects, once per machine, in order.

  kuwai migrations             run the ones not run here yet, in order
  kuwai migrations --list      each one, done (when) or pending
  kuwai migrations --dry-run   what would run; runs and writes nothing

The migrations are migrations/NNNN-what.sh in this copy (README.md there says
how to write one). What has run is recorded in
$XDG_STATE_HOME/kuwai/migrations/done/, one file each, with its output in
migrations/log. The first one that fails stops the run: it and everything
after it stay pending, the reason is printed, the exit is 1.

Each runs in bash -euo pipefail, never as root, with no input, a 5-minute
limit, and the kernel (Landlock, through setpriv) refusing any write outside
the user's four XDG folders (config, state, cache, data: each must be inside
$HOME): a migration can read anything but change only those. Without Landlock
nothing runs (exit 2).

--check runs nothing: 0 when nothing is pending or what is can run here, 2
with the reason when it couldn't (kuwai promote asks this before stable moves).

It needs the rename's mover (bin/kuwai-migrate, run by kuwai-shell before the
shell starts) to have run first: a migration reads kuwai's folders, and on a
machine where ~/.local/state/rice is still a folder and kuwai's isn't there
they would find nothing and be recorded as done. It refuses then (exit 2).

Exit: 0 nothing pending or all ran · 1 one failed · 2 refused (root, no
Landlock, an XDG folder outside $HOME, the rename not moved yet, two
migrations with one number, another run going on).
KUWAI_USAGE
}

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
DIR=${KUWAI_MIGRATIONS_DIR:-$ROOT/migrations}
CFG=${XDG_CONFIG_HOME:-$HOME/.config}
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
REC=$STATE_HOME/kuwai/migrations
LIMIT=${KUWAI_MIGRATION_TIMEOUT:-300}

say()    { printf 'kuwai-migrations: %s\n' "$*"; }
refuse() { printf 'kuwai-migrations: %s\n' "$*" >&2; exit 2; }

mode=run
case ${1:-} in
    "") ;;
    --list) mode=list ;;
    --dry-run|-n) mode=dry ;;
    --check) mode=check ;;
    -h|--help) usage; exit 0 ;;
    *) echo "usage: kuwai migrations [--list|--dry-run|--check]" >&2; exit 2 ;;
esac

[ "$(id -u)" -ne 0 ] || refuse "never as root: run it as the user whose desktop this is"
[ -n "${HOME:-}" ] && [ "$HOME" != / ] && [ -d "$HOME" ] && [ -O "$HOME" ] || refuse "\$HOME ($HOME) isn't a home folder you own"

home=$(realpath -m -- "$HOME")
ROOTS=()
for r in "$CFG" "$STATE_HOME" "$CACHE" "$DATA"; do
    case $r in /*) ;; *) refuse "XDG folder '$r' isn't an absolute path" ;; esac
    rr=$(realpath -m -- "$r")
    case $rr/ in "$home"/?*) ;; *) refuse "XDG folder $r is outside \$HOME ($HOME): migrations only change what's in your home" ;; esac
    ROOTS+=("$rr")
done

names=()
if [ -d "$DIR" ]; then
    while IFS= read -r f; do names+=("$f"); done < <(find "$DIR" -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-*.sh' -printf '%f\n' | LC_ALL=C sort)
fi
dup=$(printf '%s\n' "${names[@]}" | cut -c1-4 | sort | uniq -d | head -1)
[ -z "$dup" ] || refuse "two migrations are numbered $dup: the order would be a guess"

done_at() { [ -f "$REC/done/$1" ] && head -1 "$REC/done/$1"; }
what()    { sed -n 's/^# what: *//p' "$DIR/$1" | head -1; }
pending=()
for n in "${names[@]}"; do [ -f "$REC/done/$n" ] || pending+=("$n"); done

if [ "$mode" = list ]; then
    [ ${#names[@]} -gt 0 ] || { say "none in $DIR"; exit 0; }
    for n in "${names[@]}"; do
        if [ -f "$REC/done/$n" ]; then printf '  done     %s  (%s)\n' "${n%.sh}" "$(done_at "$n")"
        else printf '  pending  %s  %s\n' "${n%.sh}" "$(what "$n")"; fi
    done
    exit 0
fi

for base in "$STATE_HOME" "$CFG" "$CACHE"; do
    if [ -d "$base/rice" ] && [ ! -L "$base/rice" ] && [ ! -e "$base/kuwai" ]; then
        refuse "$base/rice hasn't moved to $base/kuwai yet; that happens when the shell starts (kuwai restart), or run $ROOT/bin/kuwai-migrate, then this again"
    fi
done

if [ ${#pending[@]} -eq 0 ]; then say "nothing to do (${#names[@]} done)"; exit 0; fi
if [ "$mode" = dry ]; then
    say "would run, in this order:"
    for n in "${pending[@]}"; do printf '  %s  %s\n' "${n%.sh}" "$(what "$n")"; done
    exit 0
fi

command -v setpriv >/dev/null || refuse "needs setpriv (util-linux 2.39 or later) to fence the migrations in"
W="write-file,remove-dir,remove-file,make-char,make-dir,make-reg,make-sock,make-fifo,make-block,make-sym,refer,truncate"
setpriv --landlock-access "fs:$W" --landlock-rule "path-beneath:write-file:/dev/null" -- true 2>/dev/null \
    || refuse "this kernel or setpriv has no Landlock (Linux 5.13 or later with landlock in its lsm= list; setpriv from util-linux 2.39 or later), so a migration couldn't be kept inside your folders; nothing ran"
if [ "$mode" = check ]; then say "${#pending[@]} pending, and they can run here"; exit 0; fi

mkdir -p "$REC/done" "${ROOTS[@]}" || refuse "can't make $REC"
exec 9>"$REC/.lock"
flock -n 9 || refuse "another kuwai-migrations is running"
tmp=$(mktemp -d "$CACHE/kuwai-migration.XXXXXX") || refuse "can't make a temporary folder in $CACHE"
trap 'rm -rf -- "$tmp"' EXIT
rules=(--landlock-access "fs:$W" --landlock-rule "path-beneath:write-file:/dev/null")
for r in "${ROOTS[@]}"; do rules+=(--landlock-rule "path-beneath:$W:$r"); done
rev=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "$ROOT")

for i in "${!pending[@]}"; do
    n=${pending[$i]}
    out="$tmp/${n%.sh}.out"
    printf '%s %s\n' "$(date -Is)" "$n" >>"$REC/log"
    ( cd "$tmp" && env -i PATH="$ROOT/bin:/usr/local/bin:/usr/bin:/bin" HOME="$HOME" USER="${USER:-$(id -un)}" LANG="${LANG:-C.UTF-8}" \
        XDG_CONFIG_HOME="$CFG" XDG_STATE_HOME="$STATE_HOME" XDG_CACHE_HOME="$CACHE" XDG_DATA_HOME="$DATA" \
        TMPDIR="$tmp" KUWAI_ROOT="$ROOT" KUWAI_MIGRATION="${n%.sh}" \
        timeout -k 5 "$LIMIT" setpriv "${rules[@]}" -- bash -euo pipefail "$DIR/$n" </dev/null >"$out" 2>&1 )
    rc=$?
    cat "$out" >>"$REC/log"
    if [ $rc -ne 0 ]; then
        why="exit $rc"; [ $rc -eq 124 ] && why="took over ${LIMIT}s"
        left=$(( ${#pending[@]} - i - 1 ))
        printf 'kuwai-migrations: %s failed (%s); it and the %d after it are still pending:\n' "${n%.sh}" "$why" "$left" >&2
        tail -n 15 "$out" | sed 's/^/  | /' >&2
        printf '  (full output: %s)\n' "$REC/log" >&2
        exit 1
    fi
    printf '%s from %s\n' "$(date -Is)" "$rev" >"$REC/done/$n"
    last=$(tail -n 1 "$out")
    say "ran ${n%.sh}${last:+: $last}"
done
exit 0
