#!/usr/bin/env python3
"""Validated settings patches shared by the shell and rice CLI.

Cooperative writers serialize per-key changes. Unknown fields survive; malformed
and future-version documents are read-only until explicitly migrated/repaired.
"""
import argparse
import contextlib
from decimal import Decimal
import fcntl
import json
import math
import os
from pathlib import Path
import re
import sys
import tempfile
import time

SCHEMA_PATH = Path(__file__).resolve().parents[1] / 'shell/config/settings-schema.json'
MAX_BYTES = 1024 * 1024


def schema():
    return json.loads(SCHEMA_PATH.read_text())


def integral(value):
    return type(value) is int or (type(value) is float and math.isfinite(value) and value.is_integer())


def valid(entry, value):
    typ = entry['type']
    correct = {'boolean': type(value) is bool, 'integer': integral(value),
               'number': type(value) is int or (type(value) is float and math.isfinite(value)),
               'string': isinstance(value, str), 'array': isinstance(value, list)}.get(typ, False)
    if not correct:
        return False
    if 'enum' in entry and value not in entry['enum']:
        return False
    if typ in ('integer', 'number') and not entry.get('min', -math.inf) <= value <= entry.get('max', math.inf):
        return False
    if typ == 'string' and (len(value) > entry.get('maxLength', 512) or ('pattern' in entry and re.fullmatch(entry['pattern'], value) is None)):
        return False
    if typ == 'array' and (len(value) > entry.get('maxItems', 256) or any(not isinstance(x, str) or len(x) > entry.get('maxLength', 512) for x in value)):
        return False
    return True


def invalid_constant(value):
    raise ValueError("nonstandard JSON constant: " + value)


def exact_float(token):
    value = float(token)
    if not math.isfinite(value) or Decimal(token) != Decimal(str(value)):
        raise ValueError('number cannot be preserved exactly by this settings writer; file left unchanged')
    return value


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('duplicate JSON key; file left unchanged')
        result[key] = value
    return result


def decode(raw):
    if raw is None:
        return {}
    if len(raw) > MAX_BYTES:
        raise ValueError('settings file exceeds 1 MiB')
    doc = json.loads(raw, parse_constant=invalid_constant, parse_float=exact_float, object_pairs_hook=unique_object)
    if not isinstance(doc, dict):
        raise ValueError('settings must be a JSON object')
    return doc


def validate_document(doc, contract):
    version = doc.get('_schemaVersion', 0)
    if not integral(version) or not 0 <= version <= contract['version']:
        raise ValueError('unsupported settings schema version; this version will not overwrite it')
    invalid = [e['key'] for e in contract['settings'] if e['key'] in doc and not valid(e, doc[e['key']])]
    return invalid


def read_bytes(path):
    try:
        with path.open('rb') as stream:
            return stream.read(MAX_BYTES + 1)
    except FileNotFoundError:
        return None


def atomic_write(path, content, expected):
    """No partial writes; detect external edits made before the final rename.

    Editors that do not take our lock can still race the final compare/rename.
    That narrow POSIX limitation is documented, not advertised as a true CAS.
    """
    if len(content) > MAX_BYTES:
        raise ValueError("settings file would exceed 1 MiB")
    fd, name = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        if read_bytes(path) != expected:
            raise ValueError('settings changed externally; retry the change')
        os.replace(name, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


@contextlib.contextmanager
def locked(path):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(str(path) + '.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+') as lock:
        deadline = time.monotonic() + 3
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise ValueError('settings writer is busy; retry')
                time.sleep(.02)
        yield


def parse_value(value):
    try:
        return json.loads(value, parse_constant=invalid_constant, parse_float=exact_float, object_pairs_hook=unique_object)
    except json.JSONDecodeError:
        return value


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='op', required=True)
    for op in ('set', 'reset', 'get'):
        command = sub.add_parser(op)
        command.add_argument('key')
        if op == 'set':
            command.add_argument('value')
    sub.add_parser('migrate').add_argument('--dry-run', action='store_true')
    args = parser.parse_args(argv)
    path = Path((os.environ.get('XDG_CONFIG_HOME') or str(Path.home()/'.config'))) / 'rice/settings.json'
    try:
        contract = schema()
        entries = {e['key']:e for e in contract['settings']}
        if args.op != 'migrate' and args.key not in entries:
            raise ValueError('unknown setting: ' + args.key)
        if args.op == 'set':
            value = parse_value(args.value)
            if not valid(entries[args.key], value):
                raise ValueError('invalid value for ' + args.key)
        with locked(path):
            before = read_bytes(path)
            doc = decode(before)
            invalid = validate_document(doc, contract)
            if args.op == 'migrate':
                migrated = {k:v for k,v in doc.items() if k not in invalid}
                migrated['_schemaVersion'] = contract['version']
                report = {'invalid': invalid, 'unknown': [k for k in doc if k not in entries and k != '_schemaVersion'], 'document': migrated}
                if not args.dry_run and migrated != doc:
                    if before is not None:
                        fd, backup = tempfile.mkstemp(prefix='settings.pre-v1-', suffix='.json', dir=path.parent)
                        with os.fdopen(fd, 'wb') as stream:
                            stream.write(before); stream.flush(); os.fsync(stream.fileno())
                        report['backup'] = backup
                    atomic_write(path, (json.dumps(migrated, ensure_ascii=False, indent=2)+'\n').encode(), before)
                print(json.dumps(report, ensure_ascii=False))
                return 0
            if invalid:
                raise ValueError('invalid persisted values: ' + ', '.join(invalid) + '; repair the file or preview rice-settings migrate --dry-run')
            if args.op == 'get':
                print(json.dumps(doc.get(args.key, entries[args.key]['default']), ensure_ascii=False))
                return 0
            if args.op == 'reset':
                doc.pop(args.key, None)
            else:
                doc[args.key] = value
            doc['_schemaVersion'] = contract['version']
            atomic_write(path, (json.dumps(doc, ensure_ascii=False, indent=2)+'\n').encode(), before)
            print(json.dumps(doc, ensure_ascii=False))
        return 0
    except (OSError, ValueError) as error:
        print('settings: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
