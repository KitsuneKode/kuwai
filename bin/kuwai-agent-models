#!/usr/bin/env python3
"""kuwai-agent-models AGENT:CWD … — which model an agent pane runs, for the island's Agents panel.

Prints one JSON object: {"AGENT:CWD": {"model": "claude-opus-5-5", "effort": "high", "context": 253000, "window": 1000000}, …}.
context: the tokens its last turn sent (its context now); window: its size when known (Codex says it;
Claude's past 200K is the 1M window), else 0. reply: the agent's last words to you (600 characters at most).
Claude: the newest session log for that folder (~/.claude*/projects/<folder with / as ->/*.jsonl),
its last real model (not "<synthetic>") and effort. Codex: the newest rollout in
~/.codex/sessions whose cwd is that folder. Reads at most the last 256 KiB of one file per pane,
never sends anything anywhere, and prints {} entries it can't answer as absent.
"""
import glob
import json
import os
import re
import sys

HOME = os.path.expanduser("~")
TAIL = 256 * 1024
MODEL = re.compile(rb'"model"\s*:\s*"(?!codex-auto-review)([^"<][^"]{1,60})"')
EFFORT = re.compile(rb'"(?:effort|reasoning_effort|model_reasoning_effort)"\s*:\s*"([a-z]{2,12})"')


def tail(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            n = f.tell()
            f.seek(max(0, n - TAIL))
            return f.read()
    except OSError:
        return b""


def last(rx, data):
    m = rx.findall(data)
    return m[-1].decode("utf-8", "replace") if m else ""


def lines(data):
    for raw in reversed(data.split(b"\n")):
        if b'"usage"' in raw or b'"token_count"' in raw:
            try:
                yield json.loads(raw)
            except ValueError:
                continue


def claude_context(data, model):
    for d in lines(data):
        u = (d.get("message") or {}).get("usage") if isinstance(d.get("message"), dict) else None
        if not isinstance(u, dict) or d.get("isSidechain"):
            continue
        used = sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        if used <= 0:
            continue
        window = 1000000 if used > 200000 or "[1m]" in model else 0
        return used, window
    return 0, 0


def codex_context(data):
    m = re.findall(rb'"model_context_window"\s*:\s*(\d+)', data)
    window = int(m[-1]) if m else 0
    for d in lines(data):
        info = (d.get("payload") or {}).get("info") if isinstance(d.get("payload"), dict) else None
        last_use = info.get("last_token_usage") if isinstance(info, dict) else None
        if isinstance(last_use, dict) and last_use.get("input_tokens"):
            return int(last_use["input_tokens"]), window
    return 0, window


def reply_of(data):
    for raw in reversed(data.split(b"\n")):
        if b'"assistant"' not in raw or (b'"text"' not in raw and b'"output_text"' not in raw):
            continue
        try:
            d = json.loads(raw)
        except ValueError:
            continue
        if d.get("isSidechain"):
            continue
        msg = d.get("message") if isinstance(d.get("message"), dict) else d.get("payload")
        if not isinstance(msg, dict) or msg.get("role") != "assistant":
            continue
        parts = [c.get("text", "") for c in msg.get("content") or [] if isinstance(c, dict) and c.get("type") in ("text", "output_text")]
        text = "\n".join(p for p in parts if p).strip()
        if text:
            return text[:600]
    return ""


def claude(cwd):
    enc = re.sub(r"[^A-Za-z0-9]", "-", cwd)
    files = []
    for root in glob.glob(os.path.join(HOME, ".claude*", "projects")):
        files += glob.glob(os.path.join(root, enc, "*.jsonl"))
    if not files:
        return None
    data = tail(max(files, key=lambda p: os.path.getmtime(p)))
    model = last(MODEL, data)
    if not model:
        return None
    used, window = claude_context(data, model)
    return {"model": model, "effort": last(EFFORT, data), "context": used, "window": window, "reply": reply_of(data)}


def codex(cwd):
    files = sorted(glob.glob(os.path.join(HOME, ".codex", "sessions", "*", "*", "*", "*.jsonl")),
                   key=lambda p: os.path.getmtime(p), reverse=True)[:30]
    for p in files:
        data = tail(p)
        if (b'"cwd":"' + cwd.encode() + b'"') in data or (b'"cwd": "' + cwd.encode() + b'"') in data:
            model = last(MODEL, data)
            if model:
                used, window = codex_context(data)
                return {"model": model, "effort": last(EFFORT, data), "context": used, "window": window, "reply": reply_of(data)}
    return None


def main(args):
    out = {}
    for arg in args[:24]:
        agent, _, cwd = arg.partition(":")
        if not cwd:
            continue
        full = HOME + cwd[1:] if cwd.startswith("~") else cwd
        try:
            hit = codex(full) if agent.startswith("codex") else claude(full) if agent.startswith("claude") else None
        except Exception:
            hit = None
        if hit:
            out[arg] = hit
    print(json.dumps(out, separators=(",", ":")))


if __name__ == "__main__":
    main(sys.argv[1:])
