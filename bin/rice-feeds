#!/usr/bin/env python3
"""GitHub and Gmail as desktop notifications, without their apps.

    rice-feeds                 run (systemd/rice-feeds.service does)
    rice-feeds gmail-setup     your address and an app password, into the keyring
    rice-feeds gmail-forget    take them out again
    rice-feeds status          what it's watching, and when it last looked

GitHub: your notifications inbox through `gh` (its login, no token of ours).
It asks every X-Poll-Interval seconds (60) with If-Modified-Since, and a 304
("nothing new") doesn't count against the rate limit; each new thread costs
one more call, for who wrote it and what they said. Review requests,
mentions, assignments and failed CI peek out of the island; comments and
the rest are a plain toast; bots (Dependabot, Renovate, their branches' CI)
go quietly into the center.

Gmail: IMAP IDLE, so Gmail tells us when mail arrives: no polling, nothing
to rate-limit. Only what Gmail itself marks important, in Primary, unread.
Needs 2-Step Verification and an app password
(https://myaccount.google.com/apppasswords): `rice-feeds gmail-setup`. The
password lives in the keyring (secret-tool), never in a file.

Each one is a real notification (the rice's server) with Open and Mark as
Read, plus Archive for mail. Where there's someone to answer, the card has a
reply field (the center's Reply): a comment on the pull request or issue, or
an email reply Gmail threads with the original (sent over smtp.gmail.com
with the same app password; never to a no-reply address). Read, archived or
answered elsewhere (github.com, Gmail), the card leaves the center by itself.
The shell's adapter reads the x-rice-* hints (NotifAdapters.qml).

Settings: ~/.config/rice/feeds.json (see conf(); read each time, no
restart): repos to mute or keep quiet, what bots do, the Gmail search.
State: ~/.local/state/rice/feeds.json. RICE_FEEDS_DRYRUN=1 prints instead.
"""
import email
import email.message
import email.policy
import email.utils
import fnmatch
import getpass
import html
import imaplib
import json
import os
import re
import smtplib
import subprocess
import sys
import threading
import time
import urllib.request

STATE = os.path.expanduser("~/.local/state/rice/feeds.json")
CONFIG = os.path.expanduser("~/.config/rice/feeds.json")
DRY = os.environ.get("RICE_FEEDS_DRYRUN") == "1"
lock = threading.Lock()


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


state = load(STATE, {})


# ~/.config/rice/feeds.json, read each time (edit it, no restart):
#   { "gmail": "you@gmail.com",
#     "gmailQuery": "is:unread is:important category:primary",
#     "github": { "enabled": true,
#                 "mute":  ["someorg/*"],          never tell me
#                 "quiet": ["me/dotfiles"],        the center only
#                 "bots":  "quiet" } }             quiet | hide | show
def conf():
    c = load(CONFIG, {})
    g = c.get("github") if isinstance(c.get("github"), dict) else {}
    return {
        "gmail": c.get("gmail", ""),
        "gmailQuery": c.get("gmailQuery") or "is:unread is:important category:primary",
        "github": g.get("enabled", True) is not False,
        "mute": [str(x).lower() for x in g.get("mute", [])],
        "quiet": [str(x).lower() for x in g.get("quiet", [])],
        "bots": g.get("bots", "quiet") if g.get("bots") in ("quiet", "hide", "show") else "quiet",
    }


def matches(repo, patterns):
    return any(fnmatch.fnmatch(repo.lower(), p) for p in patterns)


def save():
    with lock:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, STATE)


def clip(s, n):
    s = re.sub(r"\s+", " ", str(s or "")).strip()
    return s if len(s) <= n else s[: n - 1].rstrip() + "…"


def full_text(s, n=6000):
    """The whole readable text for the island's preview: paragraphs kept,
    runs of blank lines folded, each line trimmed, capped at n characters."""
    # Trailing space goes; leading stays (nested bullets, indented code).
    lines = [re.sub(r"(?<=\S)[ \t\u00a0]+", " ", l.replace("\t", "  ")).rstrip() for l in str(s or "").replace("\r", "").split("\n")]
    t = re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()
    return t if len(t) <= n else t[: n - 1].rstrip() + "…"


# ── Notifications (org.freedesktop.Notifications, on GLib's loop) ────────────
class Notifier:
    def __init__(self):
        from gi.repository import Gio, GLib
        self.GLib = GLib
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.by_id = {}       # notification id -> { key, on }
        self.by_key = {}      # key -> notification id
        for sig in ("ActionInvoked", "NotificationReplied", "NotificationClosed"):
            self.bus.signal_subscribe(None, "org.freedesktop.Notifications", sig, "/org/freedesktop/Notifications",
                                      None, 0, self._signal)

    def _call(self, method, args, reply=None, sent=None):
        # sent: this call's own (key, on), carried with its reply. A shared
        # queue lost its order when a call failed (a shell restart): every
        # later card was bound to the previous card's link and actions.
        self.bus.call(
            "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications",
            method, args, reply and self.GLib.VariantType(reply), 0, -1, None,
            (lambda b, r, _: self._done(b, r, method, sent)), None)

    def _done(self, bus, res, method, sent=None):
        try:
            out = bus.call_finish(res)
        except Exception as e:  # the server is gone (a restart): it comes back
            log("notify:", method, e)
            return
        if method == "Notify" and sent:
            nid = out.unpack()[0]
            key, on = sent
            old = self.by_key.get(key)
            if old and old != nid:
                self.close_id(old)
            self.by_key[key] = nid
            self.by_id[nid] = {"key": key, "on": on}

    LABELS = {"default": "Open", "read": "Mark as Read", "archive": "Archive", "inline-reply": "Reply"}

    def send(self, app, icon, title, body, hints, key, on, expire=-1):
        """on: { action id: fn } in button order; "default" is a click on the
        card, "inline-reply" gets the text typed into the card's reply field."""
        if DRY:
            log("would notify:", app, "|", title, "|", clip(body, 80), "|", list(on),
                {k: v for k, v in hints.items() if k != "x-rice-feed" and v})
            return
        GLib = self.GLib

        def go():
            actions = [x for a in on for x in (a, self.LABELS.get(a, a))]
            h = {k: GLib.Variant("s", str(v)) for k, v in hints.items() if v}
            self._call("Notify", GLib.Variant("(susssasa{sv}i)", (app, 0, icon, title, body, actions, h, expire)), "(u)", sent=(key, on))
            return False
        GLib.idle_add(go)

    def flash(self, app, icon, title, body=""):
        """A short word back ("Reply sent"): a quiet toast that clears itself."""
        key = f"flash:{time.time()}"
        self.send(app, icon, title, body, {"x-rice-feed": "flash", "x-rice-severity": "low"}, key, {}, expire=2500)
        threading.Timer(4, lambda: self.close_key(key)).start()

    def close_key(self, key):
        if DRY:
            return
        self.GLib.idle_add(lambda: (self.close_id(self.by_key.pop(key, 0)), False)[1])

    def close_id(self, nid):
        if nid:
            self.by_id.pop(nid, None)
            self._call("CloseNotification", self.GLib.Variant("(u)", (nid,)))

    def _signal(self, bus, sender, path, iface, sig, params):
        args = params.unpack()
        nid = args[0]
        entry = self.by_id.get(nid)
        if not entry:
            return
        if sig == "ActionInvoked":
            fn = entry["on"].get(args[1])
            if fn and args[1] != "inline-reply":
                threading.Thread(target=fn, daemon=True).start()
        elif sig == "NotificationReplied":
            fn = entry["on"].get("inline-reply")
            if fn and args[1].strip():
                threading.Thread(target=fn, args=(args[1].strip(),), daemon=True).start()
        elif sig == "NotificationClosed":
            self.by_id.pop(nid, None)
            if self.by_key.get(entry["key"]) == nid:
                self.by_key.pop(entry["key"], None)

    def run(self):
        self.GLib.MainLoop().run()


def open_url(url):
    # Web links only: a URL from GitHub's API or a mail is someone else's
    # data, and xdg-open would hand file:// or an app's own scheme to that app.
    if not re.match(r"https?://", str(url or "")):
        log("open: refused a non-web link")
        return
    # Its own transient unit, not a child of this service: a browser started
    # from here used to live in rice-feeds' cgroup (its 2.5 GB "memory peak")
    # and died whenever the service restarted.
    subprocess.Popen(["systemd-run", "--user", "--collect", "--quiet", "--slice=app.slice",
                      "--", "xdg-open", url],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── GitHub ──────────────────────────────────────────────────────────────────
def gh(args, timeout=30):
    return subprocess.run(["gh", "api", *args], capture_output=True, text=True, timeout=timeout)


BOTS = re.compile(r"(\[bot\]$|^dependabot|^renovate|^github-actions|^snyk-bot|^greenkeeper)", re.I)
BOT_TITLE = re.compile(r"^(chore|build|fix|ci)\((deps|deps-dev|dev-deps)\)|^bump |^update dependency |^\[snyk\]", re.I)
BOT_BRANCH = re.compile(r"^(dependabot|renovate|snyk)[/-]", re.I)

# reason -> (status, glyph, tone, severity, peek)
REASONS = {
    "review_requested": ("Review requested", "\U000f04c2", "caution", "warning", True),
    "mention": ("Mentioned you", "\U000f01ee", "caution", "warning", True),
    "team_mention": ("Mentioned your team", "\U000f01ee", "caution", "warning", True),
    "assign": ("Assigned to you", "\U000f0004", "caution", "warning", True),
    "approval_requested": ("Approval requested", "\U000f0b79", "caution", "warning", True),
    "invitation": ("Invitation", "\U000f0014", "caution", "warning", True),
    "security_alert": ("Security alert", "\U000f0028", "critical", "warning", True),
    "member_feature_requested": ("Feature request", "", "", "", False),
    "comment": ("New comment", "\U000f0188", "", "", False),
    "author": ("Activity on yours", "\U000f0188", "", "", False),
    "manual": ("Activity", "", "", "", False),
    "subscribed": ("Activity", "", "", "", False),
    "state_change": ("Status changed", "", "", "", False),
}


def web_url(t):
    repo = t["repository"]["full_name"]
    s = t["subject"]
    api = s.get("url") or ""
    m = re.search(r"/(pulls|issues|commits|releases|discussions)/([^/]+)$", api)
    if s["type"] == "CheckSuite":
        return f"https://github.com/{repo}/actions"
    if m:
        kind = {"pulls": "pull", "commits": "commit"}.get(m.group(1), m.group(1))
        return f"https://github.com/{repo}/{kind}/{m.group(2)}" if kind != "releases" else f"https://github.com/{repo}/releases"
    return f"https://github.com/{repo}"


def gh_fetch(path):
    """One API object (a comment, a pull request), or None."""
    r = gh([path.replace("https://api.github.com", "")], timeout=20)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


AVATARS = os.path.expanduser("~/.cache/rice/feeds/avatars")


def avatar(login, url):
    """Their GitHub picture as a file URL (fetched once, then cached)."""
    # Only GitHub's own avatar host, at most 1 MB (the URL comes from the API).
    if not login or not url or not url.startswith("https://avatars.githubusercontent.com/"):
        return ""
    path = os.path.join(AVATARS, re.sub(r"[^\w.-]", "_", login) + ".png")
    if not os.path.exists(path) or time.time() - os.path.getmtime(path) > 7 * 86400:
        try:
            os.makedirs(AVATARS, exist_ok=True)
            with urllib.request.urlopen(url + ("&" if "?" in url else "?") + "s=96", timeout=10) as r, open(path + ".tmp", "wb") as f:
                data = r.read(1024 * 1024 + 1)
                if len(data) > 1024 * 1024:
                    raise ValueError("avatar too large")
                f.write(data)
            os.replace(path + ".tmp", path)
        except Exception:
            return "file://" + path if os.path.exists(path) else ""
    return "file://" + path


_me = []


def me():
    """Your GitHub login, lower-cased (asked once)."""
    if not _me:
        r = gh(["user", "--jq", ".login"], timeout=20)
        _me.append(r.stdout.strip().lower() if r.returncode == 0 else "")
    return _me[0]


def short(repo):
    """Your own repos without your name in front."""
    owner, _, name = repo.partition("/")
    return name if me() and owner.lower() == me() else repo


REPLYABLE = {"mention", "team_mention", "comment", "author", "manual", "subscribed", "assign", "state_change"}


def gh_thread(t, fetch=gh_fetch, c=None):
    """What the card says about one thread, or None for nothing to say."""
    c = c or conf()
    repo = t["repository"]["full_name"]
    if matches(repo, c["mute"]):
        return None
    s = t["subject"]
    reason = t.get("reason", "")
    status, glyph, tone, severity, peek = REASONS.get(reason, ("Activity", "", "", "", False))
    title = s["title"]
    m = re.search(r"/(pulls|issues)/(\d+)$", s.get("url") or "")
    number = f"#{m.group(2)}" if m else ""
    body, who = f"{short(repo)} {number}".strip(), ""

    if s["type"] == "CheckSuite":
        # "CI workflow run failed for <branch> branch"
        cm = re.match(r"^(.*?) workflow run (\w+) for (\S+) branch", title)
        wf, outcome, branch = cm.groups() if cm else ("Workflow", "failed" if "fail" in title.lower() else "", "")
        failed = outcome in ("failed", "cancelled", "timed_out") or "fail" in title.lower()
        title = wf
        body = f"{short(repo)} · {branch}" if branch else short(repo)
        status, glyph = ("Run failed", "\U000f0028") if failed else ("Run " + (outcome or "finished"), "\U000f05e0")
        tone, severity, peek = ("critical", "warning", True) if failed else ("positive", "", False)
        bot = bool(branch and BOT_BRANCH.match(branch))
        # One card per workflow and branch: the next run replaces it.
        t["_group"] = f"gh:ci:{repo}:{wf}:{branch}"
        if branch:
            t["_url"] = f"https://github.com/{repo}/actions?query=branch%3A{branch}"
    else:
        bot = bool(BOT_TITLE.search(title))
        # Who said what: the latest comment, or the pull request / issue itself.
        url = s.get("latest_comment_url") or s.get("url")
        got = fetch(url) if url else None
        if isinstance(got, dict):
            who = ((got.get("user") or got.get("author") or {}).get("login")) or ""
            text = got.get("body") or ""
            if "#issuecomment" in (got.get("html_url") or ""):
                t["_url"] = got["html_url"]
            if who and BOTS.search(who):
                bot = True
            # Your own comment or push: you know.
            if who and who.lower() == me() and reason not in ("review_requested", "assign", "mention"):
                return None
            t["_avatar"] = (who, (got.get("user") or {}).get("avatar_url") or "")
            # The whole comment for the reading view keeps its Markdown (code,
            # "a < b"); the shell's readable() cleans it in one place. Only
            # the one-line preview is stripped hard here.
            raw = re.sub(r"<!--.*?-->", "", text, flags=re.S).strip()
            text = re.sub(r"<!--.*?-->|<[^>]+>|```.*?```|!\[[^\]]*\]\([^)]*\)", " ", text, flags=re.S)
            text = re.sub(r"[#>*_`|]+", " ", text)
            if who and text.strip() and reason not in ("review_requested", "assign"):
                body = f"{who}: {clip(text, 160)}"
                t["_full"] = f"{who}:\n\n{full_text(raw, 4000)}"
            elif who:
                body = f"{short(repo)} {number} · by {who}".strip()
    if bot and c["bots"] == "hide":
        return None
    quiet = (bot and c["bots"] == "quiet") or matches(repo, c["quiet"])
    # Somewhere to answer: a comment on the pull request or issue.
    reply = (repo, m.group(2)) if m and reason in REPLYABLE and not bot else None
    return {
        "title": title, "body": body, "status": status, "glyph": glyph, "tone": tone,
        "severity": severity, "peek": peek and not quiet, "quiet": quiet, "url": t.get("_url") or web_url(t),
        "group": t.get("_group") or "gh:" + t["id"], "reply": reply, "who": t.get("_avatar", ("", ""))[0],
        "avatar": t.get("_avatar", ("", ""))[1], "full": t.get("_full", ""),
        "number": m.group(2) if m and s["type"] in ("Issue", "PullRequest") else "", "repo": repo,
    }


def gh_iso_ms(t):
    try:
        return int(time.mktime(time.strptime(t, "%Y-%m-%dT%H:%M:%SZ")) - time.timezone) * 1000
    except (TypeError, ValueError):
        return 0


def gh_conversation(repo, number, fetch=gh_fetch, n=4):
    """The thread as the reading view shows it: the issue or pull request,
    then its latest comments (oldest first), whole and in Markdown. [] when
    there's only one message (the card's own full text says it)."""
    first = fetch(f"/repos/{repo}/issues/{number}")
    comments = fetch(f"/repos/{repo}/issues/{number}/comments?per_page=100")
    if not isinstance(first, dict) or not isinstance(comments, list) or not comments:
        return []
    me_ = me()
    def item(o):
        who = (o.get("user") or {}).get("login") or "someone"
        raw = re.sub(r"<!--.*?-->", "", o.get("body") or "", flags=re.S).strip()
        return {"who": who, "me": who.lower() == me_, "when": gh_iso_ms(o.get("created_at")),
                "text": full_text(raw, 2500) or "(no description)", "bot": bool(BOTS.search(who))}
    out = [item(first)] + [item(c) for c in comments[-n:]]
    if len(comments) > n:
        out[0]["skipped"] = len(comments) - n           # "3 earlier comments"
    return out


def gh_mark_read(tid):
    r = gh(["-X", "PATCH", f"/notifications/threads/{tid}"], timeout=20)
    if r.returncode != 0 and "205" not in (r.stdout + r.stderr):
        log("github: mark read", tid, r.stderr.strip())


def gh_reply(notify, repo, number, tid, text):
    r = gh(["-X", "POST", f"/repos/{repo}/issues/{number}/comments", "-f", f"body={text}"], timeout=30)
    if r.returncode == 0:
        gh_mark_read(tid)
        notify.flash("GitHub", "github", "Comment posted", f"{short(repo)} #{number}")
    else:
        notify.flash("GitHub", "github", "Couldn't post the comment", clip(r.stderr, 120))


def github(notify):
    g = state.setdefault("github", {})
    first = "seen" not in g
    seen = g.setdefault("seen", {})          # thread id -> updated_at we've told you about
    shown = {}                               # thread id -> card key, up this run
    wait, backoff = 60, 60
    while True:
        if not conf()["github"]:
            time.sleep(300)
            continue
        args = ["-i", "/notifications?per_page=50"]
        if g.get("modified") and not first:
            args += ["-H", f"If-Modified-Since: {g['modified']}"]
        try:
            r = gh(args)
        except subprocess.TimeoutExpired:
            r = None
        out = r.stdout if r else ""
        parts = re.split(r"\r?\n\r?\n", out, maxsplit=1)
        head, body = parts[0], parts[1] if len(parts) > 1 else ""
        code = re.match(r"HTTP/\S+ (\d+)", head)
        code = int(code.group(1)) if code else 0
        pi = re.search(r"(?im)^x-poll-interval:\s*(\d+)", head)
        wait = max(60, int(pi.group(1))) if pi else wait
        if code == 304:
            backoff = 60
            g["checked"] = int(time.time())
            save()
        elif code == 200:
            backoff = 60
            lm = re.search(r"(?im)^last-modified:\s*(.+?)\s*$", head)
            if lm:
                g["modified"] = lm.group(1)
            try:
                threads = json.loads(body)
            except ValueError:
                threads = []
            live = {t["id"] for t in threads}
            # Read on github.com (or anywhere): the card goes too.
            for tid in list(shown):
                if tid not in live:
                    key = shown.pop(tid)
                    if key not in shown.values():
                        notify.close_key(key)
            fresh = [t for t in threads if seen.get(t["id"]) != t["updated_at"]]
            for t in fresh:
                seen[t["id"]] = t["updated_at"]
            if first:
                log(f"github: {len(threads)} unread now; telling you about new ones from here")
                fresh, first = [], False
            cards = {}                       # newest per card: a burst of runs is one
            for t in sorted(fresh, key=lambda t: t["updated_at"])[-12:]:
                try:
                    c = gh_thread(t)
                except Exception as e:
                    log("github: thread", t.get("id"), e)
                    continue
                if c:
                    cards.pop(c["group"], None)
                    cards[c["group"]] = (t, c)
            for t, c in list(cards.values())[-6:]:
                tid, key = t["id"], c["group"]
                hints = {"x-rice-feed": "github", "x-rice-status": c["status"], "x-rice-glyph": c["glyph"],
                         "x-rice-tone": c["tone"], "x-rice-group": key, "x-rice-url": c["url"],
                         "x-rice-severity": c["severity"], "x-rice-quiet": "1" if c["quiet"] else "",
                         "x-rice-calm": "" if c["peek"] else "1", "image-path": avatar(c["who"], c["avatar"]),
                         "x-rice-full": c.get("full") or ""}
                # The conversation, for the reading view's second pull.
                if c.get("number") and not c["quiet"]:
                    try:
                        conv = gh_conversation(c["repo"], c["number"])
                    except Exception as e:
                        log("github: conversation", e)
                        conv = []
                    if len(conv) > 1:
                        hints["x-rice-thread"] = json.dumps(conv)
                url = c["url"]
                on = {"default": lambda u=url, i=tid: (open_url(u), gh_mark_read(i)),
                      "read": lambda i=tid: gh_mark_read(i)}
                if c["reply"]:
                    rp, num = c["reply"]
                    on["inline-reply"] = lambda text, rp=rp, num=num, i=tid: gh_reply(notify, rp, num, i, text)
                    hints["x-kde-reply-placeholder-text"] = f"Comment on {short(rp)} #{num}"
                notify.send("GitHub", "github", c["title"], c["body"], hints, key, on)
                shown[tid] = key
            # Forget what's long gone, so the state stays small.
            if len(seen) > 600:
                for k in sorted(seen, key=seen.get)[:-400]:
                    seen.pop(k, None)
            g["checked"] = int(time.time())
            save()
        else:
            err = (r.stderr.strip() if r else "timed out") or f"HTTP {code}"
            log("github:", err)
            backoff = min(backoff * 2, 900)
        time.sleep(backoff if code not in (200, 304) else wait)


# ── Gmail ───────────────────────────────────────────────────────────────────
def gmail_secret(address):
    r = subprocess.run(["secret-tool", "lookup", "service", "rice-feeds", "account", address],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def imap_login(address):
    m = imaplib.IMAP4_SSL("imap.gmail.com", timeout=60)
    m.login(address, gmail_secret(address))
    return m


def text_of(msg, full=False):
    part = msg.get_body(preferencelist=("plain", "html"))
    if not part:
        return ""
    try:
        t = part.get_content()
    except Exception:
        return ""
    if part.get_content_type() == "text/html":
        # Keep the shape: blocks and breaks become new lines, list items
        # bullets (every tag became a space before, so a newsletter read as
        # one paragraph-less blob). Hidden preheaders go.
        t = re.sub(r"(?is)<(style|script|head|title)\b.*?</\1>", " ", t)
        t = re.sub(r"(?is)<([a-z0-9]+)[^>]*display\s*:\s*none[^>]*>.*?</\1>", " ", t)
        t = re.sub(r"(?i)<br\s*/?>", "\n", t)
        t = re.sub(r"(?i)<li\b[^>]*>", "\n• ", t)
        t = re.sub(r"(?i)</?(p|div|tr|table|h[1-6]|blockquote|section|article|ul|ol)\b[^>]*>", "\n", t)
        t = html.unescape(re.sub(r"<[^>]+>", "", t))
        t = t.replace("\u200c", "").replace("\u00a0", " ").replace("\u034f", "")
        t = "\n".join(l.strip() for l in t.split("\n"))
    t = t.replace("\r\n", "\n")
    # The reply itself, not the thread under it: cut at "On … wrote:", an
    # "Original Message" block or the signature; quoted lines (">") go.
    t = re.split(r"\n\s*(On .{4,200}? wrote:|-{2,}\s*Original Message\s*-{2,}|-- \n)", t, maxsplit=1)[0]
    t = "\n".join(l for l in t.split("\n") if not l.lstrip().startswith(">"))
    return full_text(t) if full else clip(re.sub(r"\s+", " ", t), 180)


def mail_card(head_bytes, full_bytes=None, thrid=""):
    """What a card says about one message (headers, and the message if small)."""
    head = email.message_from_bytes(head_bytes, policy=email.policy.default)
    name, addr = email.utils.parseaddr(str(head.get("From", "")))
    reply_to = email.utils.parseaddr(str(head.get("Reply-To", "")))[1] or addr
    subject = clip(str(head.get("Subject", "")) or "(no subject)", 120)
    msg = email.message_from_bytes(full_bytes, policy=email.policy.default) if full_bytes else None
    snippet = text_of(msg) if msg else ""
    whole = text_of(msg, full=True) if msg else ""
    thread = format(int(thrid), "x") if thrid else ""
    return {
        "from": name or addr or "Someone", "addr": addr, "replyTo": reply_to, "subject": subject,
        "snippet": snippet, "full": whole, "thread": thread, "thrid": thrid,
        "messageId": str(head.get("Message-ID", "")).strip(), "references": str(head.get("References", "")).strip(),
        "noreply": bool(re.search(r"no[-_.]?reply|do[-_.]?not[-_.]?reply|notifications?@|mailer-daemon", reply_to, re.I)),
        "url": f"https://mail.google.com/mail/u/0/#all/{thread}" if thread else "https://mail.google.com/mail/u/0/#inbox",
    }


ALL_MAIL = None


def all_mail(m):
    """Gmail's All Mail folder (its name is localised; the \\All flag isn't)."""
    global ALL_MAIL
    if ALL_MAIL is None:
        ALL_MAIL = ""
        typ, boxes = m.list()
        for b in boxes or []:
            line = b.decode(errors="replace") if isinstance(b, bytes) else str(b)
            if "\\All" in line:
                ALL_MAIL = line.split(' "/" ', 1)[-1].strip()
                break
    return ALL_MAIL


def gmail_conversation(m, thrid, address, n=5):
    """The thread, oldest first, your replies included (All Mail holds both
    sides), each message without its quoted history. [] for one message.
    Reads with BODY.PEEK: nothing is marked read. INBOX is selected again after."""
    box = all_mail(m)
    if not thrid or not box:
        return []
    out = []
    try:
        typ, _ = m.select(box, readonly=True)
        if typ != "OK":
            return []
        typ, d = m.uid("SEARCH", None, f"X-GM-THRID {thrid}")
        uids = d[0].split() if typ == "OK" and d[0] else []
        if len(uids) < 2:
            return []
        for u in uids[-n:]:
            typ, got = m.uid("FETCH", u, "(RFC822.SIZE)")
            size = re.search(rb"RFC822.SIZE (\d+)", got[0] if got and isinstance(got[0], bytes) else b"") if typ == "OK" else None
            if size and int(size.group(1)) > 3_000_000:
                continue
            typ, got = m.uid("FETCH", u, "(BODY.PEEK[])")
            if typ != "OK" or not got or not isinstance(got[0], tuple):
                continue
            msg = email.message_from_bytes(got[0][1], policy=email.policy.default)
            name, addr = email.utils.parseaddr(str(msg.get("From", "")))
            try:
                when = int(email.utils.parsedate_to_datetime(str(msg.get("Date", ""))).timestamp() * 1000)
            except (TypeError, ValueError):
                when = 0
            out.append({"who": name or addr or "Someone", "me": addr.lower() == address.lower(),
                        "when": when, "text": text_of(msg, full=True)[:3000]})
        if len(uids) > n and out:
            out[0]["skipped"] = len(uids) - n
    finally:
        m.select("INBOX", readonly=True)
    return out if len(out) > 1 else []


def gmail_card(m, uid):
    typ, data = m.uid("FETCH", uid, "(X-GM-THRID RFC822.SIZE BODY.PEEK[HEADER.FIELDS (FROM REPLY-TO SUBJECT MESSAGE-ID REFERENCES)])")
    if typ != "OK" or not data or not isinstance(data[0], tuple):
        return None
    meta = data[0][0].decode(errors="replace")
    thr = re.search(r"X-GM-THRID (\d+)", meta)
    size = re.search(r"RFC822.SIZE (\d+)", meta)
    full = None
    if size and int(size.group(1)) < 3_000_000:      # inline images made most newsletters "too big" at 400 KB
        typ, got = m.uid("FETCH", uid, "(BODY.PEEK[])")
        if typ == "OK" and got and isinstance(got[0], tuple):
            full = got[0][1]
    return mail_card(data[0][1], full, thr.group(1) if thr else "")


def gmail_act(address, uid, *stores):
    """Mark read, archive: a short second connection (the first one idles)."""
    try:
        m = imap_login(address)
        m.select("INBOX")
        for flags in stores:
            m.uid("STORE", uid, *flags)
        m.logout()
        return True
    except Exception as e:
        log("gmail:", e)
        return False


def gmail_mark_read(address, uid):
    gmail_act(address, uid, ("+FLAGS", "(\\Seen)"))


def gmail_archive(notify, address, uid):
    # Archiving in Gmail is losing the Inbox label (it stays in All Mail).
    if not gmail_act(address, uid, ("+FLAGS", "(\\Seen)"), ("-X-GM-LABELS", "(\\Inbox)")):
        notify.flash("Gmail", "gmail", "Couldn't archive it")


def reply_message(address, c, text):
    """A reply Gmail threads with the original (In-Reply-To, References, Re:)."""
    msg = email.message.EmailMessage()
    msg["From"] = address
    msg["To"] = c["replyTo"]
    msg["Subject"] = c["subject"] if re.match(r"(?i)re:", c["subject"]) else "Re: " + c["subject"]
    if c["messageId"]:
        msg["In-Reply-To"] = c["messageId"]
        msg["References"] = (c["references"] + " " + c["messageId"]).strip()
    msg.set_content(text)
    return msg


def gmail_reply(notify, address, uid, c, text):
    try:
        with smtplib.SMTP_SSL("smtp.gmail.com", 465, timeout=30) as smtp:
            smtp.login(address, gmail_secret(address))
            smtp.send_message(reply_message(address, c, text))
        gmail_mark_read(address, uid)
        notify.flash("Gmail", "gmail", f"Sent to {c['from']}", clip(text, 80))
    except Exception as e:
        log("gmail: reply", e)
        notify.flash("Gmail", "gmail", "Couldn't send the reply", clip(str(e), 120))


def gmail(notify, address):
    g = state.setdefault("gmail", {})
    shown = {}                               # uid -> key, cards up this run
    backoff = 30
    while True:
        try:
            m = imap_login(address)
            typ, _ = m.select("INBOX", readonly=True)
            if typ != "OK":
                raise RuntimeError("can't open INBOX")
            validity = int(re.search(rb"\d+", m.response("UIDVALIDITY")[1][0]).group())
            if g.get("validity") != validity or "last" not in g:
                # First time (or Gmail renumbered): start from now, no flood.
                typ, d = m.uid("SEARCH", None, "ALL")
                uids = [int(x) for x in d[0].split()] if typ == "OK" and d[0] else []
                g.update(validity=validity, last=max(uids) if uids else 0)
                save()
                log(f"gmail: watching {address}")
            backoff = 30
            while True:
                gmail_check(m, notify, address, g, shown)
                # Gmail drops an IDLE after ~30 min; renew a little sooner.
                with m.idle(duration=24 * 60) as idler:
                    for typ, _ in idler:
                        if typ in ("EXISTS", "EXPUNGE", "FETCH"):
                            break
        except Exception as e:
            log("gmail:", e)
            if "AUTHENTICATIONFAILED" in str(e) or "Invalid credentials" in str(e):
                log("gmail: the app password was refused; run `rice-feeds gmail-setup` again")
                backoff = 3600
            time.sleep(backoff)
            backoff = min(backoff * 2, 900)


def gmail_check(m, notify, address, g, shown):
    # Read, archived or deleted in Gmail since: those cards go.
    if shown:
        uids = ",".join(shown)
        typ, d = m.uid("SEARCH", None, f"UID {uids} UNSEEN")
        still = set(d[0].decode().split()) if typ == "OK" and d[0] else set()
        for uid in [u for u in shown if u not in still]:
            notify.close_key(shown.pop(uid))
    typ, d = m.uid("SEARCH", None, f"UID {g['last'] + 1}:*")
    new = [int(x) for x in d[0].split()] if typ == "OK" and d[0] else []
    new = [u for u in new if u > g["last"]]
    if not new:
        return
    g["last"] = max(new)
    save()
    query = conf()["gmailQuery"].replace('"', "")
    typ, d = m.uid("SEARCH", None, f'UID {min(new)}:{max(new)} X-GM-RAW "{query}"')
    picks = [x.decode() for x in d[0].split()] if typ == "OK" and d[0] else []
    for uid in picks[-5:]:
        c = gmail_card(m, uid)
        if not c:
            continue
        key = "gmail:" + (c["thread"] or uid)
        hints = {"x-rice-feed": "gmail", "x-rice-group": key, "x-rice-url": c["url"]}
        # The whole message for the island's preview (the body stays short for
        # the toast); only when there's more than the snippet.
        if c.get("full") and len(c["full"]) > len(c["snippet"]) + 20:
            hints["x-rice-full"] = c["subject"] + "\n\n" + c["full"]
        # A reply in a conversation: the whole exchange for the reading view.
        try:
            conv = gmail_conversation(m, c.get("thrid", ""), address)
        except Exception as e:
            log("gmail: conversation", e)
            conv = []
        if conv:
            hints["x-rice-thread"] = json.dumps(conv)
        body = c["subject"] + ("\n" + c["snippet"] if c["snippet"] else "")
        on = {"default": lambda u=c["url"]: open_url(u),
              "archive": lambda i=uid: gmail_archive(notify, address, i),
              "read": lambda i=uid: gmail_mark_read(address, i)}
        # Nobody reads a no-reply inbox: no reply field for those.
        if not c["noreply"]:
            on["inline-reply"] = lambda text, i=uid, c=c: gmail_reply(notify, address, i, c, text)
            hints["x-kde-reply-placeholder-text"] = f"Reply to {c['from']}"
        notify.send("Gmail", "gmail", c["from"], body, hints, key, on)
        shown[uid] = key


# ── Commands ────────────────────────────────────────────────────────────────
def gmail_setup():
    cfg = load(CONFIG, {})
    address = input(f"Gmail address [{cfg.get('gmail', '')}]: ").strip() or cfg.get("gmail", "")
    if not address:
        sys.exit("no address")
    print("An app password (https://myaccount.google.com/apppasswords; needs 2-Step Verification).")
    pw = getpass.getpass("App password: ").replace(" ", "")
    try:
        m = imaplib.IMAP4_SSL("imap.gmail.com", timeout=30)
        m.login(address, pw)
        m.logout()
    except Exception as e:
        sys.exit(f"Gmail refused it: {e}")
    r = subprocess.run(["secret-tool", "store", "--label", f"rice-feeds: Gmail ({address})",
                        "service", "rice-feeds", "account", address], input=pw, text=True)
    if r.returncode != 0:
        sys.exit("couldn't store it in the keyring")
    cfg["gmail"] = address
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)
    print(f"✓ {address}: signed in, kept in the keyring. Restarting the service…")
    subprocess.run(["systemctl", "--user", "restart", "rice-feeds.service"])


def gmail_forget():
    cfg = load(CONFIG, {})
    address = cfg.pop("gmail", "")
    if address:
        subprocess.run(["secret-tool", "clear", "service", "rice-feeds", "account", address])
        with open(CONFIG, "w") as f:
            json.dump(cfg, f, indent=2)
        subprocess.run(["systemctl", "--user", "restart", "rice-feeds.service"])
    print("✓ Gmail forgotten" if address else "no Gmail account set up")


def status():
    cfg = load(CONFIG, {})
    g = state.get("github", {})
    when = time.strftime("%H:%M:%S", time.localtime(g["checked"])) if g.get("checked") else "not yet"
    print(f"GitHub: last looked {when}, {len(g.get('seen', {}))} threads known")
    print(f"Gmail:  {cfg['gmail'] + ' (IMAP IDLE)' if cfg.get('gmail') else 'not set up (rice-feeds gmail-setup)'}")
    r = subprocess.run(["systemctl", "--user", "is-active", "rice-feeds.service"], capture_output=True, text=True)
    print(f"service: {r.stdout.strip()}")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return
    if cmd == "gmail-setup":
        return gmail_setup()
    if cmd == "gmail-forget":
        return gmail_forget()
    if cmd == "status":
        return status()
    notify = Notifier()
    if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode == 0:
        threading.Thread(target=github, args=(notify,), daemon=True).start()
    else:
        log("github: gh isn't signed in (gh auth login); skipping")
    address = load(CONFIG, {}).get("gmail")
    if address and gmail_secret(address):
        threading.Thread(target=gmail, args=(notify, address), daemon=True).start()
    else:
        log("gmail: not set up (rice-feeds gmail-setup)")
    notify.run()


if __name__ == "__main__":
    main()
