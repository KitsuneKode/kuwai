#!/usr/bin/env python3
"""rice-themes: HyDE's themes and wallpapers as JSON for the island's Themes panel.

    rice-themes list                 {"current": NAME, "themes": [...], "wallpapers": [...]}
    rice-themes theme NAME           switch theme (HyDE's theme.switch.sh: GTK, kitty, Hyprland, Waybar, wallpaper)
    rice-themes wallpaper PATH       set the wallpaper (HyDE's wallpaper.sh --global; wallbash recolours from it)

A theme: name, its wallpaper's thumbnail (HyDE's own cache, ~/.cache/hyde/thumbs/<sha1>.thmb, made on demand
when missing), background and accent (from its kitty.theme), and whether it's the current one. Hashes are cached
by path+mtime+size in ~/.cache/rice/themes.json, so a listing after the first is instant.
"""
import hashlib
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
THEMES = os.path.join(HOME, ".config/hyde/themes")
THUMBS = os.path.join(HOME, ".cache/hyde/thumbs")
CACHE = os.path.join(HOME, ".cache/rice/themes.json")
LIB = os.path.join(HOME, ".local/lib/hyde")
IMG = (".png", ".jpg", ".jpeg", ".webp", ".gif")


def current() -> str:
    try:
        for line in open(os.path.join(HOME, ".local/state/hyde/staterc")):
            if line.startswith("HYDE_THEME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def load_cache() -> dict:
    try:
        return json.load(open(CACHE))
    except (OSError, ValueError):
        return {}


def sha1(path: str, cache: dict) -> str:
    st = os.stat(path)
    key = f"{path}|{st.st_mtime_ns}|{st.st_size}"
    if key not in cache:
        h = hashlib.sha1()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        cache[key] = h.hexdigest()
    return cache[key]


def thumb(path: str, cache: dict) -> str:
    try:
        t = os.path.join(THUMBS, sha1(path, cache) + ".thmb")
    except OSError:
        return ""
    if not os.path.exists(t):
        os.makedirs(THUMBS, exist_ok=True)
        subprocess.run(["magick", path + "[0]", "-strip", "-resize", "1000x562^", "-gravity", "center", "-extent", "1000x562", "png:" + t],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    return t if os.path.exists(t) else path


def colors(theme_dir: str) -> dict:
    out = {}
    try:
        for line in open(os.path.join(theme_dir, "kitty.theme")):
            p = line.split()
            if len(p) >= 2 and p[1].startswith("#"):
                out[p[0]] = p[1]
    except OSError:
        pass
    return {"bg": out.get("background", "#1e1e2e"), "accent": out.get("color4", out.get("active_border_color", "#89b4fa"))}


def listing() -> dict:
    cache = load_cache()
    cur = current()
    themes, walls = [], []
    for name in sorted(os.listdir(THEMES), key=str.lower):
        d = os.path.join(THEMES, name)
        wall = os.path.realpath(os.path.join(d, "wall.set"))
        if not os.path.isdir(d) or not os.path.isfile(wall):
            continue
        themes.append({"name": name, "thumb": thumb(wall, cache), "current": name == cur, **colors(d)})
    wd = os.path.join(THEMES, cur, "wallpapers")
    active = os.path.realpath(os.path.join(HOME, ".cache/hyde/wall.set"))
    if os.path.isdir(wd):
        for f in sorted(os.listdir(wd)):
            p = os.path.join(wd, f)
            if f.lower().endswith(IMG):
                walls.append({"path": p, "name": os.path.splitext(f)[0], "thumb": thumb(p, cache), "current": os.path.realpath(p) == active})
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".tmp"
    json.dump(cache, open(tmp, "w"))
    os.replace(tmp, CACHE)
    return {"current": cur, "themes": themes, "wallpapers": walls}


def main(argv):
    cmd = argv[0] if argv else "list"
    if cmd == "list":
        print(json.dumps(listing()))
    elif cmd == "theme" and len(argv) == 2 and os.path.isdir(os.path.join(THEMES, argv[1])):
        subprocess.Popen([os.path.join(LIB, "theme.switch.sh"), "-s", argv[1]], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif cmd == "wallpaper" and len(argv) == 2 and os.path.isfile(argv[1]):
        subprocess.Popen([os.path.join(LIB, "wallpaper.sh"), "-s", argv[1], "--global"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
