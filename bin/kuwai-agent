#!/usr/bin/env bash
set -u
agent=${1:-claude}
case $agent in claude|codex|devin|gemini|opencode|aider) ;; *) echo "kuwai-agent: unknown agent '$agent'" >&2; exit 2 ;; esac
pid=${2:-}
here="$(dirname "$(readlink -f "$0")")"
dir=$("$here/kuwai-term" --dir "$pid")
class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""')
if [ "$class" = "kitty" ] && command -v kittymux >/dev/null && kittymux spawn "$agent" --tab --cwd "$dir" >/dev/null 2>&1; then
    exit 0
fi
command -v "$agent" >/dev/null || { "$here/kuwai-notify" -a kuwai "kuwai" "$agent isn't installed — install the CLI or use bin/agents/$agent"; exit 1; }
runner=()
command -v prime-run >/dev/null && runner=(prime-run)
term=${KUWAI_TERMINAL:-}
if [ -z "$term" ]; then
    for t in kitty ghostty foot alacritty wezterm konsole xterm; do command -v "$t" >/dev/null && { term=$t; break; }; done
fi
cd "$dir" || exit 1
case $term in
    *kitty*)   exec "${runner[@]}" kitty --single-instance --instance-group=local --directory "$dir" "$agent" ;;
    *ghostty*) exec "${runner[@]}" ghostty --working-directory="$dir" -e "$agent" ;;
    *foot*)    exec foot --working-directory="$dir" "$agent" ;;
    *wezterm*) exec wezterm start --cwd "$dir" -- "$agent" ;;
    "")        "$here/kuwai-notify" -a kuwai "kuwai" "No terminal installed: sudo pacman -S kitty (or set KUWAI_TERMINAL)"; exit 1 ;;
    *)         exec "$term" -e "$agent" ;;
esac
