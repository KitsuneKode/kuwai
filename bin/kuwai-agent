#!/usr/bin/env bash
# kuwai-agent AGENT [PID] — start a coding agent (claude, codex, …) in the
# folder you're working in, the kittymux way:
#   · the focused window is kitty → a new tab in it (kittymux spawn), so the
#     agent sits in your session, its bar, inbox and `pick`
#   · anything else → a new kitty window in that folder (kittymux still
#     tracks the agent through its hooks)
# PID is the focused window's process (kuwai passes it); the folder is the one
# the focused terminal's shell is in (kuwai-term --dir), else $HOME.
set -u
agent=${1:-claude}
case $agent in claude|codex|devin|gemini|opencode|aider) ;; *) echo "kuwai-agent: unknown agent '$agent'" >&2; exit 2 ;; esac
pid=${2:-}
here="$(dirname "$(readlink -f "$0")")"
dir=$("$here/kuwai-term" --dir "$pid")
class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""')
if [ "$class" = "kitty" ] && command -v kittymux >/dev/null && kittymux spawn "$agent" --tab --cwd "$dir" >/dev/null 2>&1; then
    exit 0
fi
command -v "$agent" >/dev/null || { "$here/rice-notify" -a kuwai "kuwai" "$agent isn't installed — install the CLI or use bin/agents/$agent"; exit 1; }
exec prime-run kitty --single-instance --instance-group=local --directory "$dir" "$agent"
