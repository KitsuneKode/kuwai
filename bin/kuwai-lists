#!/usr/bin/env python3
"""kuwai-lists: rebuild the launcher's emoji and glyph lists (lib/lists/).

  kuwai-lists EMOJI_TEST CLDR_EN_XML FONT OUT_DIR

EMOJI_TEST is Unicode's emoji-test.txt, CLDR_EN_XML its common/annotations/en.xml,
FONT the Symbols Nerd Font the shell draws glyphs with. Writes emoji.db
("EMOJI name keywords…" per line) and glyph.db ("GLYPH<TAB>name" per line).
"""
import re
import sys
import xml.etree.ElementTree as ET


def emoji(test_path, xml_path):
    keywords = {}
    for a in ET.parse(xml_path).getroot().iter("annotation"):
        if a.get("type") != "tts" and a.text:
            keywords[a.get("cp")] = [w.strip() for w in a.text.split("|") if w.strip()]
    out = []
    for line in open(test_path, encoding="utf-8"):
        m = re.match(r"^[0-9A-F ]+;\s*fully-qualified\s*#\s*(\S+)\s+E[0-9.]+\s+(.+)$", line)
        if not m:
            continue
        ch, name = m.group(1), m.group(2).strip()
        if any(0x1F3FB <= ord(c) <= 0x1F3FF for c in ch):
            continue
        words = [w for w in keywords.get(ch, keywords.get(ch.replace("️", ""), [])) if w.lower() != name.lower()]
        out.append(" ".join([ch, name] + words))
    return out


def glyphs(font_path):
    from fontTools.ttLib import TTFont
    cmap = TTFont(font_path).getBestCmap()
    return [f"{chr(cp)}\t{name}" for cp, name in sorted(cmap.items()) if cp >= 0xE000 and not name.startswith("uni")]


def main(argv):
    if len(argv) != 5:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    _, test_path, xml_path, font_path, out_dir = argv
    e = emoji(test_path, xml_path)
    g = glyphs(font_path)
    with open(f"{out_dir}/emoji.db", "w", encoding="utf-8") as f:
        f.write("\n".join(e) + "\n")
    with open(f"{out_dir}/glyph.db", "w", encoding="utf-8") as f:
        f.write("\n".join(g) + "\n")
    print(f"emoji {len(e)}, glyphs {len(g)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
