#!/usr/bin/env python3
"""kuwai-update: system updates for kuwai's island Updates panel (and anyone else).

    kuwai-update check                  JSON: repo + AUR updates, Arch news, disk, power
    kuwai-update review PKG             JSON: what changed in an AUR package's build files since
                                       the version you have installed (a diff, plus lines worth a look)
    kuwai-update approve PKG SHA        remember that you reviewed PKG at commit SHA
    kuwai-update trust PKG on|off       skip review for PKG from now on (your call, per package)
    kuwai-update state                  JSON: approvals and trusted packages
    kuwai-update storage                JSON: what the update pipeline keeps on disk, why, and what
                                       retention would free (read-only)
    kuwai-update clean [--legacy] [--artifacts] [--builds] [--pacman] [--all] [--dry-run]
                                       reclaim legacy AUR trees, stale artifacts, failed builds,
                                       and optionally pacman cache (via paccache)
    kuwai-update start [--repo] [--aur PKG ...] [--flatpak APP ...] [--unreviewed]
                                       (--unreviewed: build the AUR packages' newest commits without a
                                       review, for this run only; you chose it explicitly)
                                       run the update as its own background job (systemd user unit
                                       kuwai-update, sleep/shutdown held off): it keeps going whatever
                                       happens to the shell; follow it in $XDG_RUNTIME_DIR/kuwai/update.jsonl
    kuwai-update status                 JSON: {"running": bool}
    kuwai-update install-helper         install kuwai-update-root (one password, once): from then on a
                                       whole update asks for your password once, not once per step
    kuwai-update run [--repo] [--aur PKG ...]
                                       the update itself (what `start` runs): one JSON event per line
                                       (phase, log, progress, error, done) on stdout and in update.jsonl;
                                       the whole log in ~/.local/state/kuwai/updates/

How it updates (no terminal, no stored passwords, no sudo rules):
  · One password for the whole update: root's part is kuwai-update-root, started once with pkexec
    (installed root-owned by `install-helper`; it only runs pacman). Without it, each root step
    asks on its own (`pkexec pacman …`), as before.
  · Arch's packages update together: `pacman -Syu --noconfirm` (pacman's defaults answer its
    questions, and the risky ones default to "no", so a conflict stops it instead of guessing).
    Never per-package: Arch doesn't support partial upgrades. Build dependencies the AUR packages
    need come after, marked as dependencies (`--asdeps`), so they can be cleaned up as orphans.
  · AUR packages are built as you with makepkg, from the exact commit you approved (or the newest
    one for packages you trust), in a recipe checkout under ~/.local/share/kuwai-data/aur/PKG, never as root; then all of them install
    with one `pacman -U`. A package that changed after you reviewed it is not built.
  · Tests (checkdepends) run when their dependencies come from Arch's repos; when one is only in
    the AUR, the build skips the tests (`--nocheck`) instead of the whole package.
  · A package that needs another AUR package to build or run, or a PGP key, is left for the
    terminal (paru) and says so; nothing is half-done silently.
"""
import fcntl
import hashlib
import tempfile
import json
import os
import signal
import re
import shutil
import subprocess
import sys
import time
import urllib.request
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "kuwai")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "kuwai")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")), "kuwai-data")
AUR_DIR = os.path.join(DATA, "aur")
INSTALLED = os.path.join(STATE, "aur-installed.json")
APPROVED = os.path.join(STATE, "aur-approved.json")
TRUSTED = os.path.join(STATE, "aur-trusted.json")
LOG_DIR = os.path.join(STATE, "updates")
NEWS_URL = "https://archlinux.org/feeds/news/"
AUR_GIT = "https://aur.archlinux.org/{}.git"
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "kuwai")
EVENTS = os.path.join(RUNTIME, "update.jsonl")
LOCK = os.path.join(RUNTIME, "update.lock")
UNIT = "kuwai-update"
HELPER = "/usr/local/lib/kuwai/kuwai-update-root"
HELPER_SRC = os.path.join(os.path.dirname(os.path.realpath(__file__)), "kuwai-update-root")
FLATPAK_TARGET = re.compile(r"^(?:(user|system):)?([A-Za-z0-9][A-Za-z0-9._/-]*)$")
NAME_OK = re.compile(r"^[a-z0-9@._+-]+$")
SHA_OK = re.compile(r"^[0-9a-f]{40}$")
ARTIFACT_KEEP = 1
ARTIFACT_CAP_BYTES = 1024 ** 3
FAILED_KEEP = 1
PACMAN_CACHE = "/var/cache/pacman/pkg"
SIZE_UNITS = {"B": 1, "KiB": 1024, "MiB": 1024 ** 2, "GiB": 1024 ** 3, "TiB": 1024 ** 4}


def sh(cmd, **kw):
    return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, **kw)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".kuwai-", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=1)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def valid_name(p):
    if not NAME_OK.match(p or ""):
        raise SystemExit(f"kuwai-update: not a package name: {p!r}")
    return p


def git(d, *args, check=False):
    r = sh(["git", "-c", "core.hooksPath=/dev/null", "-C", d, *args])
    if check and r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"git {' '.join(args)} failed")
    return r


LINE = re.compile(r"^(\S+)\s+(\S+)\s+->\s+(\S+)")


def parse_updates(text, repo):
    out = []
    for l in text.splitlines():
        m = LINE.match(l.strip())
        if m:
            out.append({"name": m[1], "old": m[2], "new": m[3], "repo": repo})
    return out


def repo_of(names):
    """Which repository each package comes from (core/extra/multilib…), in one pacman call."""
    if not names:
        return {}
    r = sh(["pacman", "-Si", *names])
    repo, name, out = None, None, {}
    for l in r.stdout.splitlines():
        if l.startswith("Repository"):
            repo = l.split(":", 1)[1].strip()
        elif l.startswith("Name"):
            name = l.split(":", 1)[1].strip()
            if repo:
                out[name] = repo
    return out


def last_upgrade():
    """When the last full system upgrade started (pacman.log), as epoch seconds."""
    try:
        with open("/var/log/pacman.log", "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 2_000_000))
            tail = f.read().decode(errors="replace")
    except OSError:
        return 0
    stamps = re.findall(r"^\[([0-9T:+-]+)\] \[PACMAN\] starting full system upgrade", tail, re.M)
    if not stamps:
        return 0
    s = stamps[-1]
    try:
        return int(time.mktime(time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S")))
    except ValueError:
        return 0


def news(since):
    """Arch news posted since your last upgrade: the ones that ask for a manual step matter."""
    try:
        req = urllib.request.Request(NEWS_URL, headers={"User-Agent": "kuwai-kuwai-update"})
        with urllib.request.urlopen(req, timeout=6) as r:
            root = ET.fromstring(r.read())
    except Exception:
        return None
    out = []
    for it in root.iter("item"):
        title = (it.findtext("title") or "").strip()
        link = (it.findtext("link") or "").strip()
        date = it.findtext("pubDate") or ""
        try:
            ts = int(time.mktime(time.strptime(date[:25].strip(), "%a, %d %b %Y %H:%M:%S")))
        except ValueError:
            ts = 0
        if since and ts and ts < since - 86400:
            continue
        desc = re.sub(r"<[^>]+>", " ", it.findtext("description") or "")
        desc = re.sub(r"\s+", " ", desc).strip()
        manual = bool(re.search(r"manual intervention|requires? (?:manual|user) action|before upgrading|--overwrite", title + " " + desc, re.I))
        out.append({"title": title, "link": link, "date": ts, "manual": manual, "summary": desc[:400]})
    return out[:6]


def check():
    repo_run = sh(["checkupdates", "--nocolor"])
    repo = parse_updates(repo_run.stdout, "")
    repos = repo_of([p["name"] for p in repo])
    for p in repo:
        p["repo"] = repos.get(p["name"], "")
    aur = []
    if shutil.which("paru"):
        aur = parse_updates(sh(["paru", "-Qua"]).stdout, "aur")
    trusted = set(load(TRUSTED, []))
    approved = load(APPROVED, {})
    community = aur_info([p["name"] for p in aur])
    for p in aur:
        p["trusted"] = p["name"] in trusted
        p["approved"] = approved.get(p["name"], "")
        p["community"] = community.get(p["name"])
    since = last_upgrade()
    st = os.statvfs("/")
    free = st.f_bavail * st.f_frsize
    power = {"ac": True, "battery": None}
    for d in os.listdir("/sys/class/power_supply") if os.path.isdir("/sys/class/power_supply") else []:
        base = os.path.join("/sys/class/power_supply", d)
        try:
            kind = open(os.path.join(base, "type")).read().strip()
            if kind == "Mains":
                power["ac"] = open(os.path.join(base, "online")).read().strip() == "1"
            elif kind == "Battery":
                power["battery"] = int(open(os.path.join(base, "capacity")).read().strip())
        except (OSError, ValueError):
            pass
    flatpak = flatpak_updates()
    kernel = any(re.match(r"^linux(-zen|-lts|-hardened|-rt)?$", p["name"]) for p in repo)
    return {
        "checkedAt": int(time.time()),
        "repo": repo,
        "aur": aur,
        "repoError": repo_run.returncode not in (0, 2) and (repo_run.stderr.strip() or "checkupdates failed"),
        "lastUpgrade": since,
        "news": news(since),
        "freeBytes": free,
        "power": power,
        "kernel": kernel,
        "flatpak": flatpak,
    }


def flatpak_updates():
    """Flatpak apps and runtimes with updates (sandboxed and signed: each can
    update on its own, no review needed), from your own installation and the
    system-wide one. `id` is what `run --flatpak` takes: "user:app/ID/arch/branch".
    (remote-ls has no "installation" column: ask each installation in turn.)"""
    if not shutil.which("flatpak"):
        return []
    out = []
    for inst in ("user", "system"):
        r = sh(["flatpak", "remote-ls", f"--{inst}", "--updates", "--columns=ref,application,version,origin"], timeout=60)
        if r.returncode != 0:
            continue
        have = {}
        for l in sh(["flatpak", "list", f"--{inst}", "--columns=ref,name,version"]).stdout.splitlines():
            p = l.split("\t")
            if len(p) >= 3:
                have[p[0]] = (p[1], p[2])
        for l in r.stdout.splitlines():
            p = l.split("\t")
            if len(p) < 4 or not FLATPAK_TARGET.match(p[0]):
                continue
            ref, app = p[0], p[1]
            name, old = have.get(ref.split("/", 1)[-1], (app.split(".")[-1], ""))
            out.append({"id": f"{inst}:{ref}", "app": app, "name": name, "old": old, "new": p[2] or "newer build",
                        "origin": p[3], "install": inst, "runtime": ref.startswith("runtime/")})
    return out


AUR_RPC = "https://aur.archlinux.org/rpc/v5/info"


def aur_info(names):
    """The AUR's own facts about packages (one request): votes, popularity,
    maintainer, age, out-of-date flag. `established` is the bar for
    approving routine bumps by themselves: widely used (≥ 100 votes or
    popularity ≥ 2), maintained, not flagged out of date, a year old or more.
    It says the package is established, not that a new upstream release is
    safe; for -bin packages the program itself is never reviewed."""
    names = [n for n in names if NAME_OK.match(n)]
    if not names:
        return {}
    q = "&".join("arg[]=" + urllib.request.quote(n) for n in names)
    try:
        req = urllib.request.Request(f"{AUR_RPC}?{q}", headers={"User-Agent": "kuwai-kuwai-update"})
        with urllib.request.urlopen(req, timeout=8) as r:
            res = json.load(r).get("results", [])
    except Exception:
        return {}
    now = time.time()
    out = {}
    for p in res:
        votes = p.get("NumVotes") or 0
        pop = p.get("Popularity") or 0
        first = p.get("FirstSubmitted") or now
        info = {
            "votes": votes, "popularity": round(pop, 2), "maintainer": p.get("Maintainer"),
            "firstSubmitted": first, "lastModified": p.get("LastModified"), "outOfDate": p.get("OutOfDate"),
            "packageBase": p.get("PackageBase") or p.get("Name"),
            "url": p.get("URL") or "", "binary": p.get("PackageBase", p.get("Name", "")).endswith("-bin"),
        }
        info["established"] = bool((votes >= 100 or pop >= 2) and info["maintainer"] and not info["outOfDate"]
                                   and now - first > 365 * 86400)
        out[p.get("Name")] = info
    return out


def clone(pkg):
    info = aur_info([pkg]).get(pkg, {})
    base = info.get("packageBase")
    if not isinstance(base, str) or not NAME_OK.fullmatch(base):
        raise RuntimeError(f"{pkg}: AUR recipe base unavailable; retry when metadata is available")
    d = os.path.join(AUR_DIR, base)
    if not os.path.isdir(os.path.join(d, ".git")):
        os.makedirs(AUR_DIR, exist_ok=True)
        r = sh(["git", "clone", "-q", "--no-checkout", AUR_GIT.format(base), d], timeout=90)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or "clone failed")
    else:
        git(d, "fetch", "-q", "origin", check=True)
    head = git(d, "rev-parse", "origin/HEAD").stdout.strip() or git(d, "rev-parse", "origin/master").stdout.strip()
    if not SHA_OK.match(head):
        raise RuntimeError("no upstream commit")
    return d, head


def installed_version(pkg):
    r = sh(["pacman", "-Q", pkg])
    return r.stdout.split()[1] if r.returncode == 0 and len(r.stdout.split()) == 2 else ""


def installed_fingerprint(pkg):
    """Identify this pacman installation, including same-version reinstalls.

    Missing/inaccessible local metadata means provenance is unknown, never guessed
    from a matching recipe version. No package code is executed here.
    """
    version = installed_version(pkg)
    if not version or "/" in version:
        return None
    path = os.path.join("/var/lib/pacman/local", f"{pkg}-{version}", "desc")
    try:
        with open(path, "rb") as f:
            st = os.fstat(f.fileno())
            content = f.read(1024 * 1024)
            after = os.fstat(f.fileno())
        if (st.st_ino, st.st_mtime_ns, st.st_ctime_ns) != (after.st_ino, after.st_mtime_ns, after.st_ctime_ns):
            return None
        identity = hashlib.sha256(content).hexdigest()
        return {"version": version, "identity": identity, "inode": st.st_ino,
                "mtimeNs": st.st_mtime_ns, "ctimeNs": st.st_ctime_ns}
    except OSError:
        return None


def record_install(pkg, head, files):
    fingerprint = installed_fingerprint(pkg)
    if not fingerprint:
        raise RuntimeError(f"{pkg}: installed package identity unavailable; provenance not recorded")
    receipts = load(INSTALLED, {})
    artifacts = []
    for path in files:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for block in iter(lambda: f.read(1024 * 1024), b""):
                h.update(block)
        artifacts.append({"file": os.path.basename(path), "sha256": h.hexdigest()})
    receipts[pkg] = {"schema": 1, "recipe": head, "installed": fingerprint,
                     "artifacts": artifacts, "at": time.time_ns()}
    save(INSTALLED, receipts)


def baseline(d, pkg, head):
    """Only a verified install receipt can identify the installed recipe.

    Legacy cached refs and version matches are insufficient: a newer recipe may
    carry the same version, or pacman/paru may have reinstalled it externally.
    """
    receipt = load(INSTALLED, {}).get(pkg, {})
    mark = receipt.get("recipe", "") if isinstance(receipt, dict) else ""
    if not SHA_OK.fullmatch(mark) or receipt.get("schema") != 1:
        return ""
    fingerprint = installed_fingerprint(pkg)
    if not fingerprint or receipt.get("installed") != fingerprint:
        return ""
    if git(d, "cat-file", "-e", mark + "^{commit}").returncode != 0:
        return ""
    return mark


FLAGS = [
    (r"\b(curl|wget)\b.*\|\s*(ba|z)?sh\b", "downloads and runs a script"),
    (r"\b(curl|wget|aria2c)\b", "downloads something during the build"),
    (r"\bbase64\s+(-d|--decode)\b|\bxxd\s+-r\b", "decodes hidden content"),
    (r"\beval\b", "evaluates generated code"),
    (r"\bsudo\b|\bpkexec\b|\bdoas\b", "asks for root inside the build"),
    (r"/dev/tcp/|\bnc\b\s+-|\bsocat\b", "opens a network connection"),
    (r"\bchmod\s+[0-7]*[4-7][0-7]{2}\b.*/usr|\bchmod\s+[ug]\+s\b|\bsetcap\b", "changes permissions or capabilities"),
    (r"systemctl\s+(--global\s+)?enable", "enables a service"),
    (r"\brm\s+-r?f?\s+(/(\s|$)|\$HOME|~/)", "deletes outside its build folder"),
    (r"'SKIP'|\"SKIP\"", "skips checksum verification"),
    (r"^\s*(source|source_\w+)\s*\+?=", "changes where sources come from"),
    (r"^\s*(sha\d+sums|b2sums|md5sums)", "changes checksums"),
    (r"^\s*validpgpkeys", "changes the trusted signing keys"),
    (r"\.install\b|^\s*install\s*=", "runs a script at install time"),
]


def review(pkg):
    valid_name(pkg)
    d, head = clone(pkg)
    base = baseline(d, pkg, head)
    files = []
    flags = []
    if base:
        diff = git(d, "diff", "--no-color", "-U3", "--no-renames", base, head, "--", ".", ":(exclude).SRCINFO").stdout
    else:
        empty = git(d, "hash-object", "-t", "tree", "/dev/null").stdout.strip()
        diff = git(d, "diff", "--no-color", "-U3", empty, head, "--", ".", ":(exclude).SRCINFO").stdout
    cur = None
    hunk = None
    o = n = 0
    for l in diff.splitlines():
        if l.startswith("diff --git "):
            path = l.split(" b/", 1)[-1]
            cur = {"path": path, "status": "modified", "add": 0, "del": 0, "hunks": [], "binary": False}
            files.append(cur)
            hunk = None
        elif cur is None:
            continue
        elif l.startswith("new file"):
            cur["status"] = "added"
        elif l.startswith("deleted file"):
            cur["status"] = "deleted"
        elif l.startswith("Binary files"):
            cur["binary"] = True
        elif l.startswith("@@"):
            m = re.match(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@(.*)", l)
            o, n = (int(m[1]), int(m[2])) if m else (0, 0)
            hunk = {"header": l, "context": (m[3].strip() if m else ""), "lines": []}
            cur["hunks"].append(hunk)
        elif hunk is not None and l[:1] in "+- " and not l.startswith(("+++", "---")):
            t = l[:1]
            text = l[1:]
            row = {"t": t, "o": o if t != "+" else None, "n": n if t != "-" else None, "s": text}
            if t != "+":
                o += 1
            if t != "-":
                n += 1
            if t == "+":
                cur["add"] += 1
            elif t == "-":
                cur["del"] += 1
            hunk["lines"].append(row)
    head_si = git(d, "show", f"{head}:.SRCINFO").stdout
    ver = re.search(r"^\s*pkgver = (.+)$", head_si, re.M)
    rel = re.search(r"^\s*pkgrel = (.+)$", head_si, re.M)

    vers = set()
    have = installed_version(pkg)
    if have:
        vers.add(have.rpartition(":")[2].rpartition("-")[0])
    if ver:
        vers.add(ver[1].strip())
    if base:
        bsi = git(d, "show", f"{base}:.SRCINFO").stdout
        bv = re.search(r"^\s*pkgver = (.+)$", bsi, re.M)
        if bv:
            vers.add(bv[1].strip())
    vers = sorted((v for v in vers if v), key=len, reverse=True)

    def norm(x):
        x = x.strip()
        for v in vers:
            x = x.replace(v, "{V}")
        x = re.sub(r"\b[0-9a-f]{32,}\b", "{H}", x)
        x = re.sub(r"^(pkgrel|epoch)\s*=\s*\S+", r"\1={R}", x)
        x = re.sub(r"\b\d+(\.\d+){1,3}\b", "{N}", x)
        return x

    routine = True
    for f in files:
        removed = {norm(r["s"]) for h in f["hunks"] for r in h["lines"] if r["t"] == "-"}
        for h in f["hunks"]:
            for r in h["lines"]:
                if r["t"] != "+":
                    continue
                if base and norm(r["s"]) in removed:
                    r["routine"] = True
                    continue
                if r["s"].strip() and not r["s"].strip().startswith("#"):
                    routine = False
                for rx, why in FLAGS:
                    if re.search(rx, r["s"]):
                        flags.append({"path": f["path"], "line": r["n"], "text": r["s"].strip()[:160], "why": why})
                        break
    log = git(d, "log", "--format=%h%x09%an%x09%ar%x09%s", f"{base}..{head}" if base else head, "-n", "12").stdout
    commits = [dict(zip(("sha", "author", "when", "subject"), c.split("\t", 3))) for c in log.splitlines() if c.count("\t") >= 3]
    return {
        "pkg": pkg,
        "packageBase": os.path.basename(d),
        "base": base,
        "head": head,
        "firstTime": not base,
        "routine": bool(base) and routine,
        "installed": installed_version(pkg),
        "next": f"{ver[1].strip()}-{rel[1].strip()}" if ver and rel else "",
        "files": files,
        "flags": flags,
        "commits": commits,
        "url": f"https://aur.archlinux.org/cgit/aur.git/log/?h={pkg}",
        "approved": load(APPROVED, {}).get(pkg, "") == head,
        "community": aur_info([pkg]).get(pkg),
        "trusted": pkg in load(TRUSTED, []),
    }


class Run:
    def __init__(self):
        os.makedirs(LOG_DIR, exist_ok=True)
        os.makedirs(RUNTIME, exist_ok=True)
        self.events = open(EVENTS, "w", buffering=1)
        self.path = os.path.join(LOG_DIR, time.strftime("%Y-%m-%d_%H%M%S") + ".log")
        self.log = open(self.path, "w", buffering=1)
        link = os.path.join(LOG_DIR, "last.log")
        try:
            if os.path.lexists(link):
                os.remove(link)
            os.symlink(os.path.basename(self.path), link)
        except OSError:
            pass
        logs = sorted(f for f in os.listdir(LOG_DIR) if f.endswith(".log") and f != "last.log")
        for f in logs[:-10]:
            try:
                os.remove(os.path.join(LOG_DIR, f))
            except OSError:
                pass

    def emit(self, **ev):
        line = json.dumps(ev)
        self.events.write(line + "\n")
        try:
            print(line, flush=True)
        except (BrokenPipeError, OSError):
            pass
        if ev.get("e") == "log":
            self.log.write(ev["line"] + "\n")
        elif ev.get("e") in ("phase", "error", "done"):
            self.log.write(f"## {ev.get('label') or ev.get('msg') or ev.get('e')}\n")

    def stream(self, cmd, cwd=None, progress=None):
        """Run cmd, forward each output line, report pacman's (k/n) as progress.

        The command writes to a file, not a pipe: if this process dies, pacman
        (running as root under pkexec) still has somewhere to write and finishes
        its transaction instead of dying of a broken pipe halfway."""
        self.log.write("$ " + " ".join(cmd) + "\n")
        out = os.path.join(RUNTIME, "update-step.out")
        with open(out, "w") as w:
            p = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=w, stderr=subprocess.STDOUT,
                                 env={**os.environ, "LC_ALL": "C", "PACMAN_COLOR": "never"}, start_new_session=True)
        pending = ""
        shown = ""
        with open(out, newline="") as r:
            while True:
                chunk = r.read()
                if chunk:
                    pending += ANSI.sub("", chunk)
                    *lines, pending = pending.split("\n")
                    for line in lines:
                        self.line(line.split("\r")[-1] if "\r" in line.rstrip("\r") else line, progress)
                    now = pending.rstrip("\r").split("\r")[-1].strip()
                    if now and now != shown:
                        shown = now
                        self.emit(e="status", line=now)
                elif p.poll() is not None:
                    last = pending.rstrip("\r").split("\r")[-1].strip()
                    if last:
                        self.emit(e="log", line=last)
                    return p.returncode
                else:
                    time.sleep(0.1)

    def line(self, line, progress=None):
        """One line of a command's output: logged, and pacman's (k/n) as progress."""
        line = line.rstrip("\r")
        if not line.strip():
            return
        self.emit(e="log", line=line)
        m = re.match(r"^\(\s*(\d+)/(\d+)\)\s+(\S+)\s+(\S+)", line)
        if m and progress:
            self.emit(e="progress", phase=progress, k=int(m[1]), n=int(m[2]), what=f"{m[3]} {m[4]}")


AUTH_FAIL = (126, 127)
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07")


def helper_ok():
    """kuwai-update-root is installed where root alone can change it, and is this version."""
    try:
        for p in (HELPER, os.path.dirname(HELPER)):
            st = os.stat(p)
            if st.st_uid != 0 or st.st_mode & 0o022:
                return False
        with open(HELPER, "rb") as a, open(HELPER_SRC, "rb") as b:
            return a.read() == b.read()
    except OSError:
        return False


def agent_missing():
    """No polkit agent in this session: pkexec fails at once and looks like a
    cancel. Start one (kuwai's, else KDE's) and say so."""
    def up(u):
        return subprocess.run(["systemctl", "--user", "-q", "is-active", u]).returncode == 0
    if up("kuwai-auth.service") or up("plasma-polkit-agent.service"):
        return False
    for u in ("kuwai-auth.service", "plasma-polkit-agent.service"):
        if subprocess.run(["systemctl", "--user", "start", u]).returncode == 0:
            break
    return True


def cancelled_msg(tail="Nothing was changed."):
    if agent_missing():
        return "No password prompt was running (started it now). Try again. " + tail
    return "Cancelled at the password prompt. " + tail

class Root:
    """Root's part of a run. With kuwai-update-root installed: one pkexec (one password) for the
    whole run, opened up front so the prompt comes before the builds, not after them. Without
    it: one pkexec per step, as before."""

    def __init__(self, R):
        self.R = R
        self.p = None
        self.prompts = 0
        self.helper = os.path.isfile(HELPER_SRC)

    def open(self):
        """0 once root is there; pkexec's code (126/127: cancelled) when it isn't."""
        if not self.helper or self.p:
            return 0
        self.prompts += 1
        if helper_ok():
            cmd = ["pkexec", HELPER]
        else:
            self.R.emit(e="log", line="Setting up one-password updates (kuwai-update-root)")
            cmd = ["pkexec", "/bin/sh", "-c", 'umask 022 && /usr/bin/install -D -o root -g root -m 0755 -- "$1" "$2" && exec "$2"',
                   "sh", HELPER_SRC, HELPER]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        hello = self.p.stdout.readline()
        if '"ready"' not in hello:
            rc = self.p.wait()
            self.p = None
            return rc or 127
        return 0

    def run(self, op, progress=None, deps=(), files=(), keep=2):
        if not self.helper:
            self.prompts += 1
            if op == "clean-cache":
                if not shutil.which("paccache"):
                    return 0
                script = f'/usr/bin/paccache -rk{int(keep)} && /usr/bin/paccache -ruk0'
                return self.R.stream(["pkexec", "/bin/sh", "-c", script], progress=progress)
            if op == "upgrade" and deps:
                script = '/usr/bin/pacman -Syu --noconfirm --needed && /usr/bin/pacman -S --noconfirm --needed --asdeps -- "$@"'
                return self.R.stream(["pkexec", "/bin/sh", "-c", script, "sh", *deps], progress=progress)
            cmd = {"upgrade": ["-Syu", "--noconfirm", "--needed"],
                   "deps": ["-S", "--noconfirm", "--needed", "--asdeps", "--", *deps],
                   "install": ["-U", "--noconfirm", "--needed", "--", *files]}[op]
            return self.R.stream(["pkexec", "pacman", *cmd], progress=progress)
        rc = self.open()
        if rc:
            return rc
        self.R.log.write(f"$ (root) pacman {op} {' '.join([*deps, *files])}\n")
        try:
            payload = {"op": op, "deps": list(deps), "files": list(files)}
            if op == "clean-cache":
                payload = {"op": "clean-cache", "keep": int(keep)}
            self.p.stdin.write(json.dumps(payload) + "\n")
            self.p.stdin.flush()
            for raw in self.p.stdout:
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue
                if "log" in msg:
                    self.R.line(msg["log"], progress)
                elif "rc" in msg:
                    return msg["rc"]
        except (BrokenPipeError, OSError):
            pass
        self.R.emit(e="log", line="kuwai-update-root stopped unexpectedly")
        self.p = None
        return 1

    def close(self):
        if self.p:
            try:
                self.p.stdin.close()
                self.p.wait(timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                pass
            self.p = None


def prepare_recipe(repository, pkg, head):
    """A unique build tree: durable recipe history never holds build products."""
    builds = os.path.join(CACHE, "builds")
    os.makedirs(builds, mode=0o700, exist_ok=True)
    stage = tempfile.mkdtemp(prefix=f"{valid_name(pkg)}-{head[:12]}-", dir=builds)
    try:
        git(repository, "worktree", "add", "--detach", stage, head, check=True)
        git(stage, "checkout", "-q", "--force", "--detach", head, check=True)
        git(stage, "clean", "-qfdx", check=True)
        actual = git(stage, "rev-parse", "HEAD", check=True).stdout.strip()
        dirty = git(stage, "status", "--porcelain", "--untracked-files=no", check=True).stdout.strip()
        if actual != head or dirty:
            raise RuntimeError("prepared recipe does not match the reviewed commit")
        save(os.path.join(stage, ".kuwai-workspace.json"), {"schema": 1, "repository": os.path.realpath(repository), "created": time.time_ns()})
        return stage
    except Exception:
        git(repository, "worktree", "remove", "--force", stage)
        if os.path.isdir(stage) and not os.listdir(stage): os.rmdir(stage)
        raise


def workspace_repository(stage):
    real = os.path.realpath(stage)
    builds = os.path.realpath(os.path.join(CACHE, "builds"))
    if os.path.islink(stage) or os.path.dirname(real) != builds:
        raise RuntimeError("not an owned build workspace")
    meta = load(os.path.join(real, ".kuwai-workspace.json"), {})
    repository = os.path.realpath(meta.get("repository", ""))
    if meta.get("schema") != 1 or os.path.dirname(repository) != os.path.realpath(AUR_DIR):
        raise RuntimeError("unknown workspace ownership")
    return repository


def makepkg_config(stage):
    """Write a build-local makepkg config that inherits user settings and disables -debug packages."""
    cfg = os.path.join(stage, ".kuwai-makepkg.conf")
    with open(cfg, "w", encoding="utf-8") as f:
        f.write('[ -r /etc/makepkg.conf ] && source /etc/makepkg.conf\n')
        f.write('[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf" ] && source "${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf"\n')
        f.write('[ -r "$HOME/.makepkg.conf" ] && source "$HOME/.makepkg.conf"\n')
        f.write('OPTIONS+=(!debug)\n')
    return cfg


def enforce_artifact_cap(keep_batch=None):
    """Evict oldest rollback artifact batches across all recipes until total stays within ARTIFACT_CAP_BYTES."""
    if ARTIFACT_CAP_BYTES <= 0:
        return 0
    archives = os.path.join(CACHE, "artifacts")
    entries = []
    for recipe in subdirs(archives):
        for b in subdirs(recipe):
            if os.path.basename(b).startswith("installed-"):
                entries.append((os.path.getmtime(b), b, recipe, tree_bytes(b)))
    total = sum(e[3] for e in entries)
    freed = 0
    if total <= ARTIFACT_CAP_BYTES:
        return 0
    keep_real = os.path.realpath(keep_batch) if keep_batch else ""
    for _, b, recipe, sz in sorted(entries, key=lambda e: e[0]):
        if total <= ARTIFACT_CAP_BYTES:
            break
        if keep_real and os.path.realpath(b) == keep_real:
            continue
        shutil.rmtree(b, ignore_errors=True)
        total -= sz
        freed += sz
        try:
            if not os.listdir(recipe):
                os.rmdir(recipe)
        except OSError:
            pass
    return freed


def finish_workspace(stage, files):
    """Retain bounded rollback artifact sets per recipe; release build sources immediately."""
    repository = workspace_repository(stage)
    archives = os.path.join(CACHE, "artifacts", os.path.basename(repository))
    os.makedirs(archives, mode=0o700, exist_ok=True)
    batch = tempfile.mkdtemp(prefix="installed-", dir=archives)
    kept = []
    for source in files:
        if os.path.dirname(os.path.realpath(source)) != os.path.realpath(stage) or os.path.islink(source):
            raise RuntimeError("artifact not inside its build workspace")
        target = os.path.join(batch, os.path.basename(source))
        shutil.move(source, target)
        kept.append(target)
    git(repository, "worktree", "remove", "--force", stage, check=True)
    batches = sorted((os.path.join(archives, n) for n in os.listdir(archives) if n.startswith("installed-")
                      and os.path.isdir(os.path.join(archives, n)) and not os.path.islink(os.path.join(archives, n))),
                     key=os.path.getmtime)
    drop = batches if ARTIFACT_KEEP <= 0 else batches[:-ARTIFACT_KEEP]
    for old in drop:
        shutil.rmtree(old)
    enforce_artifact_cap(keep_batch=batch)
    return kept


def prune_failed_workspaces():
    """Prune owned failed build workspaces beyond FAILED_KEEP and strip unpacked src/pkg trees."""
    builds = os.path.join(CACHE, "builds")
    if not os.path.isdir(builds): return
    groups = {}
    for name in os.listdir(builds):
        stage = os.path.join(builds, name)
        try:
            repository = workspace_repository(stage)
        except (RuntimeError, OSError):
            continue
        groups.setdefault(repository, []).append(stage)
    for repository, stages in groups.items():
        ordered = sorted(stages, key=os.path.getmtime)
        drop = ordered if FAILED_KEEP <= 0 else ordered[:-FAILED_KEEP]
        keep = [] if FAILED_KEEP <= 0 else ordered[-FAILED_KEEP:]
        for old in drop:
            git(repository, "worktree", "remove", "--force", old, check=True)
        for held in keep:
            for sub in ("src", "pkg"):
                p = os.path.join(held, sub)
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p, ignore_errors=True)


def package_files(directory, wanted):
    """Select split outputs by pacman metadata, never by filename guesses."""
    listed = sh(["makepkg", "--packagelist"], cwd=directory)
    if listed.returncode != 0:
        raise RuntimeError("could not enumerate built package files")
    selected = {}
    for path in listed.stdout.splitlines():
        if not os.path.isfile(path):
            continue
        query = sh(["pacman", "-Qp", "--", path])
        fields = query.stdout.split()
        if query.returncode != 0 or len(fields) != 2 or not NAME_OK.fullmatch(fields[0]):
            raise RuntimeError("could not verify built package metadata")
        name = fields[0]
        if name in wanted:
            if name in selected:
                raise RuntimeError(f"ambiguous built output: {name}")
            selected[name] = path
    missing = set(wanted) - selected.keys()
    if missing:
        raise RuntimeError("missing selected outputs: " + ", ".join(sorted(missing)))
    return [selected[name] for name in wanted]


def missing_deps(d):
    """What a build still needs, split by where it comes from: (from Arch's repos, only in the
    AUR, run tests). The package's own names (a split package's parts depend on each other)
    don't count. Tests run only when everything they need comes from the repos."""
    si = sh(["makepkg", "--printsrcinfo"], cwd=d).stdout
    own = set(re.findall(r"^pkgname = (\S+)$", si, re.M))

    def missing(kinds):
        deps = re.findall(rf"^\s*(?:{kinds})(?:_\w+)? = (.+)$", si, re.M)
        deps = [x for x in deps if re.split(r"[<>=]", x)[0] not in own]
        if not deps:
            return [], []
        miss = [x for x in sh(["pacman", "-T", *deps]).stdout.split() if x]
        names = sorted({re.split(r"[<>=]", x)[0] for x in miss})
        in_repo = [x for x in names if sh(["pacman", "-Si", x]).returncode == 0]
        return in_repo, [x for x in names if x not in in_repo]

    in_repo, aur_only = missing("depends|makedepends")
    check_repo, check_aur = missing("checkdepends")
    if check_aur:
        return in_repo, aur_only, False
    return sorted(set(in_repo + check_repo)), aur_only, True


def legacy_aur_dir():
    """Where recipes lived before they moved to kuwai-data (057b5e8)."""
    return os.path.join(CACHE, "aur")


def stat_isdir(st):
    return (st.st_mode & 0o170000) == 0o040000


def tree_bytes(path):
    """Allocated bytes under path; links are counted as links, never followed."""
    try:
        st = os.lstat(path)
    except OSError:
        return 0
    total = st.st_blocks * 512
    if not stat_isdir(st):
        return total
    for top, dirs, files in os.walk(path, followlinks=False, onerror=lambda e: None):
        for name in dirs + files:
            try:
                total += os.lstat(os.path.join(top, name)).st_blocks * 512
            except OSError:
                pass
    return total


def subdirs(path):
    """Real directories directly under path (no links), sorted by name."""
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    out = []
    for name in names:
        full = os.path.join(path, name)
        try:
            if stat_isdir(os.lstat(full)):
                out.append(full)
        except OSError:
            pass
    return out


def parse_size(text):
    """Parse pacman/paccache human sizes into integer bytes."""
    m = re.fullmatch(r"\s*([0-9]+(?:\.[0-9]+)?)\s*(B|KiB|MiB|GiB|TiB)\s*", text or "")
    return int(float(m[1]) * SIZE_UNITS[m[2]]) if m else None


def paccache_dry(args):
    """Bytes paccache would remove, from its own dry run (read-only)."""
    if not shutil.which("paccache"):
        return None
    r = sh(["paccache", "-d", "-c", PACMAN_CACHE, *args], timeout=60)
    out = r.stdout + "\n" + r.stderr
    if "no candidate packages found" in out:
        return {"files": 0, "bytes": 0}
    m = re.search(r"(\d+)\s+candidates?\s+\(disk space saved:\s*([^)]+)\)", out)
    if not m:
        return None
    sz = parse_size(m[2])
    return {"files": int(m[1]), "bytes": sz} if sz is not None else None


def installed_sizes(names):
    """Installed size per package, from one pacman -Qi call."""
    if not names:
        return {}
    r = sh(["pacman", "-Qi", "--", *names], timeout=60)
    out, name = {}, None
    for line in r.stdout.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        if key == "Name":
            name = value.strip()
        elif key == "Installed Size" and name:
            out[name] = parse_size(value)
    return out


def artifact_package_name(filename):
    """Extract package name from name-ver-rel-arch.pkg.tar.*."""
    stem = re.sub(r"\.pkg\.tar(\.[a-z0-9]+)?$", "", filename)
    if stem == filename:
        return None
    parts = stem.rsplit("-", 3)
    return parts[0] if len(parts) == 4 and parts[0] else None


def update_running():
    return sh(["systemctl", "--user", "is-active", "--quiet", UNIT + ".service"]).returncode == 0


def storage_report():
    """Every byte the updater owns, by purpose, with the retention it is held to."""
    items = []
    installed = set(sh(["pacman", "-Qq"], timeout=60).stdout.split())
    receipts = load(INSTALLED, {})

    items.append({"id": "recipes", "path": AUR_DIR, "owner": "kuwai-update", "keep": True,
                  "purpose": "Reviewed recipe history: what review diffs and install receipts are checked against",
                  "bytes": tree_bytes(AUR_DIR), "reclaimable": 0, "count": len(subdirs(AUR_DIR))})

    builds = os.path.join(CACHE, "builds")
    stages = [(d, tree_bytes(d)) for d in subdirs(builds)]
    by_repo, unowned = {}, []
    for d, size in stages:
        try:
            by_repo.setdefault(workspace_repository(d), []).append((d, size))
        except (RuntimeError, OSError):
            unowned.append(d)
    over = [size for group in by_repo.values()
            for _, size in (sorted(group, key=lambda e: os.path.getmtime(e[0])) if FAILED_KEEP <= 0
                            else sorted(group, key=lambda e: os.path.getmtime(e[0]))[:-FAILED_KEEP])]
    items.append({"id": "builds", "path": builds, "owner": "kuwai-update", "keep": False,
                  "purpose": f"Failed build workspaces, {FAILED_KEEP} per recipe kept for diagnosis",
                  "bytes": sum(size for _, size in stages), "reclaimable": sum(over),
                  "count": len(stages), "unowned": unowned})

    archives = os.path.join(CACHE, "artifacts")
    entries = []
    retained_batches = []
    for recipe in subdirs(archives):
        batches = sorted((b for b in subdirs(recipe) if os.path.basename(b).startswith("installed-")),
                         key=os.path.getmtime)
        sizes = {b: tree_bytes(b) for b in batches}
        names = set()
        for b in batches[-1:]:
            try:
                names = {n for f in os.listdir(b) if (n := artifact_package_name(f))}
            except OSError:
                pass
        gone = bool(names) and not (names & installed)
        drop = batches if (gone or ARTIFACT_KEEP <= 0) else batches[:-ARTIFACT_KEEP]
        kept = [] if (gone or ARTIFACT_KEEP <= 0) else batches[-ARTIFACT_KEEP:]
        for b in kept:
            retained_batches.append((os.path.getmtime(b), sizes[b]))
        free = sum(sizes[b] for b in drop)
        entries.append({"recipe": os.path.basename(recipe), "batches": len(batches),
                        "bytes": sum(sizes.values()), "reclaimable": free,
                        **({"why": "none of its packages is installed any more"} if gone else {})})
    artifact_total = sum(e["bytes"] for e in entries)
    artifact_reclaim = sum(e["reclaimable"] for e in entries)
    kept_total = sum(sz for _, sz in retained_batches)
    if ARTIFACT_CAP_BYTES > 0 and kept_total > ARTIFACT_CAP_BYTES:
        for _, sz in sorted(retained_batches, key=lambda e: e[0]):
            if kept_total <= ARTIFACT_CAP_BYTES:
                break
            kept_total -= sz
            artifact_reclaim += sz
    items.append({"id": "artifacts", "path": archives, "owner": "kuwai-update", "keep": False,
                  "purpose": f"Built packages for rollback, {ARTIFACT_KEEP} set per recipe (cap {ARTIFACT_CAP_BYTES // (1024 ** 2)} MiB)",
                  "bytes": artifact_total, "reclaimable": artifact_reclaim,
                  "capBytes": ARTIFACT_CAP_BYTES, "entries": entries})

    legacy_dir = legacy_aur_dir()
    legacy = []
    for d in subdirs(legacy_dir):
        name = os.path.basename(d)
        ref = git(d, "for-each-ref", "--format=%(refname)", "refs/rice/installed", "refs/kuwai/installed").stdout.strip()
        legacy.append({"recipe": name, "bytes": tree_bytes(d),
                       "receipt": isinstance(receipts.get(name), dict), "legacyRef": bool(ref)})
    items.append({"id": "legacy-aur", "path": legacy_dir, "owner": "nobody (pre-rename location)", "keep": False,
                  "purpose": "Recipe clones and build trees from before recipes moved to kuwai-data; the updater no longer reads them",
                  "bytes": sum(e["bytes"] for e in legacy), "reclaimable": sum(e["bytes"] for e in legacy),
                  "entries": legacy,
                  "note": "A recipe without a receipt is reviewed in full next time either way: a legacy ref cannot be verified."})

    options = {"keep2": paccache_dry(["-k2"]), "keep1": paccache_dry(["-k1"]),
               "keep0": paccache_dry(["-k0"]), "uninstalled": paccache_dry(["-uk0"])}
    try:
        stale = sorted(n for n in os.listdir(PACMAN_CACHE) if n.startswith("download-"))
    except OSError:
        stale = []
    items.append({"id": "pacman-cache", "path": PACMAN_CACHE, "owner": "pacman", "keep": False,
                  "purpose": "Package files pacman downloaded; paccache prunes it",
                  "bytes": tree_bytes(PACMAN_CACHE),
                  "reclaimable": sum((options[k] or {}).get("bytes", 0) for k in ("keep2", "uninstalled")),
                  "policy": "paccache -rk2 (installed + one older version) and -ruk0 (nothing of removed packages)",
                  "options": options,
                  "staleDownloads": len(stale)})

    orphan_names = sh(["pacman", "-Qdtq"], timeout=60).stdout.split()
    debug_names = sorted(n for n in installed if n.endswith("-debug") and n[:-len("-debug")] in installed)
    sizes = installed_sizes(orphan_names + debug_names)
    packages = {"orphans": [{"name": n, "bytes": sizes.get(n)} for n in orphan_names],
                "debug": [{"name": n, "bytes": sizes.get(n)} for n in debug_names]}

    return {"schema": 1, "dryRun": True, "at": int(time.time()), "running": update_running(),
            "bytes": sum(i["bytes"] for i in items), "reclaimable": sum(i["reclaimable"] for i in items),
            "items": items, "packages": packages}


def clean_storage(args):
    """Reclaim legacy AUR trees, stale/over-cap artifacts, owned failed builds, and optionally pacman cache."""
    dry = "--dry-run" in args
    want_all = "--all" in args
    want_legacy = want_all or "--legacy" in args
    want_artifacts = want_all or "--artifacts" in args
    want_builds = want_all or "--builds" in args
    want_pacman = "--pacman" in args
    if not (want_legacy or want_artifacts or want_builds or want_pacman):
        want_legacy = want_artifacts = want_builds = True

    os.makedirs(RUNTIME, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return {"ok": False, "error": "An update is currently running."}

    actions = []
    freed = 0
    try:
        if want_legacy:
            legacy_dir = legacy_aur_dir()
            cache_real = os.path.realpath(CACHE)
            if os.path.isdir(legacy_dir) and not os.path.islink(legacy_dir) and os.path.dirname(os.path.realpath(legacy_dir)) == cache_real:
                sz = tree_bytes(legacy_dir)
                if not dry:
                    shutil.rmtree(legacy_dir)
                freed += sz
                actions.append({"id": "legacy-aur", "path": legacy_dir, "bytes": sz})

        if want_artifacts:
            installed = set(sh(["pacman", "-Qq"], timeout=60).stdout.split())
            archives = os.path.join(CACHE, "artifacts")
            art_freed = 0
            removed_batches = 0
            for recipe in subdirs(archives):
                batches = sorted((b for b in subdirs(recipe) if os.path.basename(b).startswith("installed-")),
                                 key=os.path.getmtime)
                names = set()
                for b in batches[-1:]:
                    try:
                        names = {n for f in os.listdir(b) if (n := artifact_package_name(f))}
                    except OSError:
                        pass
                gone = bool(names) and not (names & installed)
                drop = batches if (gone or ARTIFACT_KEEP <= 0) else batches[:-ARTIFACT_KEEP]
                for old in drop:
                    sz = tree_bytes(old)
                    if not dry:
                        shutil.rmtree(old, ignore_errors=True)
                    art_freed += sz
                    removed_batches += 1
                if not dry:
                    try:
                        if not os.listdir(recipe):
                            os.rmdir(recipe)
                    except OSError:
                        pass
            if ARTIFACT_CAP_BYTES > 0:
                if dry:
                    rem = []
                    for recipe in subdirs(archives):
                        batches = sorted((b for b in subdirs(recipe) if os.path.basename(b).startswith("installed-")),
                                         key=os.path.getmtime)
                        names = set()
                        for b in batches[-1:]:
                            try:
                                names = {n for f in os.listdir(b) if (n := artifact_package_name(f))}
                            except OSError:
                                pass
                        gone = bool(names) and not (names & installed)
                        kept = [] if (gone or ARTIFACT_KEEP <= 0) else batches[-ARTIFACT_KEEP:]
                        for b in kept:
                            rem.append((os.path.getmtime(b), tree_bytes(b)))
                    tot = sum(sz for _, sz in rem)
                    for _, sz in sorted(rem, key=lambda e: e[0]):
                        if tot <= ARTIFACT_CAP_BYTES:
                            break
                        tot -= sz
                        art_freed += sz
                        removed_batches += 1
                else:
                    cap_freed = enforce_artifact_cap()
                    art_freed += cap_freed
            freed += art_freed
            actions.append({"id": "artifacts", "path": archives, "bytes": art_freed, "removedBatches": removed_batches})

        if want_builds:
            builds = os.path.join(CACHE, "builds")
            b_freed = 0
            b_count = 0
            for stage in subdirs(builds):
                try:
                    repo = workspace_repository(stage)
                except (RuntimeError, OSError):
                    continue
                sz = tree_bytes(stage)
                if not dry:
                    git(repo, "worktree", "remove", "--force", stage)
                    if os.path.isdir(stage):
                        shutil.rmtree(stage, ignore_errors=True)
                b_freed += sz
                b_count += 1
            freed += b_freed
            actions.append({"id": "builds", "path": builds, "bytes": b_freed, "removedWorkspaces": b_count})

        if want_pacman:
            keep2 = paccache_dry(["-k2"]) or {}
            uninst = paccache_dry(["-uk0"]) or {}
            est = keep2.get("bytes", 0) + uninst.get("bytes", 0)
            rc = 0
            if not dry:
                R = Run()
                root = Root(R)
                try:
                    rc = root.run("clean-cache", keep=2)
                finally:
                    root.close()
            if rc == 0:
                freed += est
            actions.append({"id": "pacman-cache", "path": PACMAN_CACHE, "bytes": est if rc == 0 else 0, "rc": rc})
    finally:
        lock.close()
    return {"ok": all(a.get("rc", 0) == 0 for a in actions), "dryRun": dry, "freedBytes": freed, "actions": actions}


def run(args):
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    os.makedirs(RUNTIME, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print(json.dumps({"e": "status", "line": "Waiting for the update that's already running…"}), flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        return run_locked(args)
    finally:
        try:
            prune_failed_workspaces()
        except Exception:
            print("kuwai-update: inactive build workspace cleanup failed", file=sys.stderr)
        lock.close()


def run_locked(args):
    want_repo = "--repo" in args
    unreviewed = "--unreviewed" in args
    def after(flag):
        if flag not in args:
            return []
        out = []
        for a in args[args.index(flag) + 1:]:
            if a.startswith("--"):
                break
            out.append(a)
        return out
    aur = [valid_name(a) for a in after("--aur")]
    flatpaks = [a for a in after("--flatpak") if FLATPAK_TARGET.match(a)]
    R = Run()
    approved = load(APPROVED, {})
    trusted = set(load(TRUSTED, []))
    result = {"ok": True, "repo": None, "built": [], "skipped": [], "installed": [], "log": R.path}

    R.emit(e="plan", repo=want_repo, aur=aur, flatpak=flatpaks)
    R.emit(e="phase", id="check", label="Checking space and power")
    for destination in ("/", CACHE, AUR_DIR):
        probe = os.path.abspath(destination)
        while not os.path.exists(probe):
            probe = os.path.dirname(probe)
        st = os.statvfs(probe)
        if st.f_bavail * st.f_frsize < 3 * 1024 ** 3:
            R.emit(e="error", msg=f"Less than 3 GB free at {destination}. Free some space first.")
            R.emit(e="done", **{**result, "ok": False})
            return 1

    plan = []
    prepared = {}
    extra_repo_deps = []
    for pkg in aur:
        try:
            d, head = clone(pkg)
        except Exception as ex:
            result["skipped"].append({"pkg": pkg, "why": f"couldn't fetch it: {ex}"})
            continue
        want = head if (pkg in trusted or unreviewed) else approved.get(pkg, "")
        if want != head:
            result["skipped"].append({"pkg": pkg, "why": "it changed after you reviewed it: review it again" if want else "not reviewed"})
            continue
        recipe = (d, head)
        if recipe in prepared:
            if pkg not in prepared[recipe]: prepared[recipe].append(pkg)
            continue
        try:
            d = prepare_recipe(d, pkg, head)
            in_repo, aur_only, tests = missing_deps(d)
        except Exception as ex:
            result["skipped"].append({"pkg": pkg, "why": f"recipe preparation failed: {ex}"})
            continue
        if aur_only:
            result["skipped"].append({"pkg": pkg, "why": "needs AUR packages first (" + ", ".join(aur_only) + "): update it in the terminal with paru"})
            continue
        extra_repo_deps += in_repo
        outputs = [pkg]
        prepared[recipe] = outputs
        plan.append((pkg, d, head, tests, outputs))
    extra_repo_deps = sorted(set(extra_repo_deps))

    root = Root(R)
    try:
        result["oneprompt"] = root.helper
        if root.helper and (want_repo or extra_repo_deps or plan):
            rc = root.open()
            if rc:
                R.emit(e="error", msg=cancelled_msg())
                R.emit(e="done", **{**result, "ok": False, "cancelled": True})
                return 1

        if want_repo or extra_repo_deps:
            R.emit(e="phase", id="repo", label="Updating Arch packages" if want_repo else "Installing build dependencies")
            rc = root.run("upgrade" if want_repo else "deps", progress="repo", deps=extra_repo_deps)
            if rc in AUTH_FAIL:
                R.emit(e="error", msg=cancelled_msg())
                R.emit(e="done", **{**result, "ok": False, "cancelled": True})
                return 1
            if rc != 0:
                R.emit(e="error", msg="pacman stopped (see the log). Nothing was half-installed: pacman applies a transaction whole or not at all.")
                R.emit(e="done", **{**result, "ok": False, "repo": False})
                return 1
            result["repo"] = True

        built = []
        for i, (pkg, d, head, tests, outputs) in enumerate(plan, 1):
            R.emit(e="phase", id="build", label=f"Building {pkg}", k=i, n=len(plan))
            if not tests:
                R.emit(e="log", line=f"{pkg}: its tests need AUR packages; building without them (--nocheck)")
            cfg = makepkg_config(d)
            rc = R.stream(["makepkg", "-f", "-c", "--noconfirm", "--noprogressbar", "--config", cfg, *([] if tests else ["--nocheck"])], cwd=d)
            if rc != 0:
                why = "build failed (see the log)"
                if rc == 13:
                    why = "already built"
                result["skipped"].append({"pkg": pkg, "why": why})
                continue
            try:
                files = package_files(d, outputs)
            except RuntimeError as ex:
                result["skipped"].extend({"pkg": name, "why": str(ex)} for name in outputs)
                continue
            built.append((outputs, d, head, files))
            result["built"].extend(outputs)

        if built:
            R.emit(e="phase", id="install", label=f"Installing {len(built)} AUR package" + ("s" if len(built) > 1 else ""))
            files = [f for b in built for f in b[3]]
            rc = root.run("install", progress="install", files=files)
            if rc in AUTH_FAIL:
                R.emit(e="error", msg=cancelled_msg("The AUR packages are built but not installed."))
                result["ok"] = False
            elif rc != 0:
                R.emit(e="error", msg="Installing the AUR packages failed (see the log).")
                result["ok"] = False
            else:
                for outputs, d, head, files in built:
                    for pkg in outputs:
                        result["installed"].append(pkg)
                        try:
                            record_install(pkg, head, files)
                            git(d, "update-ref", "refs/kuwai/installed", head, check=True)
                            approved.pop(pkg, None)
                        except Exception as ex:
                            R.emit(e="error", msg=f"{pkg}: installed, but provenance could not be recorded: {ex}")
                            result["ok"] = False
                    try:
                        finish_workspace(d, files)
                    except Exception as ex:
                        R.emit(e="log", line=f"Build files retained for diagnosis: {ex}")
                save(APPROVED, approved)
        if root.helper and root.p and (result["repo"] or result["installed"]):
            R.emit(e="phase", id="clean", label="Pruning package cache")
            root.run("clean-cache", keep=2)
    finally:
        root.close()
    result["prompts"] = root.prompts

    if flatpaks:
        R.emit(e="phase", id="flatpak", label=f"Updating {len(flatpaks)} Flatpak item" + ("s" if len(flatpaks) > 1 else ""))
        groups = {}
        for t in flatpaks:
            m = FLATPAK_TARGET.match(t)
            groups.setdefault(m[1] or "", []).append(m[2])
        rc = 0
        for inst, refs in groups.items():
            rc |= R.stream(["flatpak", "update", *([f"--{inst}"] if inst else []), "-y", "--noninteractive", *refs], progress="flatpak")
        result["flatpak"] = rc == 0
        if rc != 0:
            R.emit(e="error", msg="Some Flatpak updates didn't install (see the log).")
            result["ok"] = False

    R.emit(e="phase", id="after", label="Finishing")
    running = os.uname().release
    result["restart"] = not os.path.isdir(f"/usr/lib/modules/{running}")
    pac = sh(["pacdiff", "-o"]).stdout.split() if shutil.which("pacdiff") else []
    result["pacnew"] = pac[:20]
    failed = sh(["systemctl", "--failed", "--no-legend", "--plain"]).stdout
    result["failedUnits"] = [l.split()[0] for l in failed.splitlines() if l.strip()][:10]
    if result["skipped"]:
        result["ok"] = False if not (result["repo"] or result["installed"]) else result["ok"]
    R.emit(e="done", **result)
    return 0 if result["ok"] else 1


def main(argv):
    cmd = argv[0] if argv else "check"
    try:
        if cmd == "check":
            data = check()
            save(os.path.join(CACHE, "updates.json"), data)
            print(json.dumps(data))
        elif cmd == "review" and len(argv) == 2:
            print(json.dumps(review(argv[1])))
        elif cmd == "approve" and len(argv) == 3 and SHA_OK.match(argv[2]):
            a = load(APPROVED, {})
            a[valid_name(argv[1])] = argv[2]
            save(APPROVED, a)
        elif cmd == "unapprove" and len(argv) == 2:
            a = load(APPROVED, {})
            a.pop(valid_name(argv[1]), None)
            save(APPROVED, a)
        elif cmd == "trust" and len(argv) == 3 and argv[2] in ("on", "off"):
            t = set(load(TRUSTED, []))
            (t.add if argv[2] == "on" else t.discard)(valid_name(argv[1]))
            save(TRUSTED, sorted(t))
        elif cmd == "state":
            print(json.dumps({"approved": load(APPROVED, {}), "trusted": load(TRUSTED, [])}))
        elif cmd == "storage" and len(argv) == 1:
            print(json.dumps(storage_report()))
        elif cmd == "clean":
            res = clean_storage(argv[1:])
            print(json.dumps(res))
            return 0 if res.get("ok") else 1
        elif cmd == "run":
            return run(argv[1:])
        elif cmd == "install-helper":
            if helper_ok():
                print(json.dumps({"installed": True, "already": True}))
                return 0
            r = subprocess.run(["pkexec", "/usr/bin/install", "-D", "-o", "root", "-g", "root", "-m", "0755", HELPER_SRC, HELPER])
            ok = r.returncode == 0 and helper_ok()
            print(json.dumps({"installed": ok} if ok else {"error": "not installed (cancelled at the password prompt?)"}))
            return 0 if ok else 1
        elif cmd == "status":
            print(json.dumps({"running": sh(["systemctl", "--user", "is-active", "--quiet", UNIT + ".service"]).returncode == 0}))
        elif cmd == "start":
            args = argv[1:]
            for a in args:
                if not a.startswith("--") and not (re.match(r"^[A-Za-z0-9@._+-]+$", a) or FLATPAK_TARGET.match(a)):
                    raise SystemExit(f"kuwai-update: not a package or app id: {a!r}")
            if sh(["systemctl", "--user", "is-active", "--quiet", UNIT + ".service"]).returncode == 0:
                print(json.dumps({"error": "An update is already running."}))
                return 1
            sh(["systemctl", "--user", "reset-failed", UNIT + ".service"])
            os.makedirs(RUNTIME, exist_ok=True)
            open(EVENTS, "w").close()
            env = [f"--setenv={k}={os.environ[k]}" for k in ("PATH", "HOME", "LANG", "XDG_RUNTIME_DIR", "XDG_STATE_HOME", "XDG_CACHE_HOME") if k in os.environ]
            r = sh(["systemd-run", "--user", "--quiet", "--collect", f"--unit={UNIT}",
                    "--description=kuwai: installing updates", *env,
                    "systemd-inhibit", "--what=sleep:idle:shutdown", "--who=kuwai", "--why=Installing updates", "--mode=block",
                    os.path.abspath(__file__), "run", *args])
            if r.returncode != 0:
                print(json.dumps({"error": r.stderr.strip() or "couldn't start the update job"}))
                return 1
            print(json.dumps({"started": True}))
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except Exception as ex:
        print(json.dumps({"error": str(ex)}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
