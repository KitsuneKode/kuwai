#!/usr/bin/env bash
set -uo pipefail

usage() {
cat <<'KUWAI_USAGE'
kuwai — the desktop from the command line. This file is the Hyprland half; any other
command goes to the shell half, bin/kuwai-ctl (channel, promote, bar, notifs, timers, …).

  kuwai info                      version, mode, GPU, theme
  kuwai doctor                    check config, session, scripts; exit 1 on problems
  kuwai mode [NAME|--pick|list]   focus · default · glass · gaming · battery
  kuwai display [NAME|list]       everyday · accurate · movie · gaming · battery (what the screens are for)
  kuwai display hdr [on|off|toggle] explicit HDR (hdredid) on external HDR screens (for browser HDR)
  kuwai display calibrate [SCREEN] adjust a screen by eye with test patterns (→ next, q done)
  kuwai display profile           measured (colorimeter) profiles: where they go, which are loaded
  kuwai play [URL]                open a URL (or clipboard link) in mpv (auto 120 Hz + auto HDR)
  kuwai motion [full|reduced|off]
  kuwai gpu [auto|nvidia|intel]   renderer for the next login
  kuwai rescue                    password prompt, clipboard, island, idle: back to working
  kuwai auth [status|here|restart|fallback|restore|reset-tries|pin|unpin]   the password prompt (pin: root-owned copy)
  kuwai feature [NAME on|off]     list / switch what kuwai does on its own
  kuwai screen [NAME scale N|rate HZ|reset]  a screen's scale and refresh rate (over monitors.lua)
  kuwai pointer SETTING VALUE     speed, accel, natural scrolling, tap, scroll speed, key repeat (kuwai pointer for the list)
  kuwai keyboard [LAYOUTS [VARIANTS]] [--switch alt-shift|caps|win-space|ctrl-shift|none]
                                  e.g. `kuwai keyboard us,de` · `kuwai keyboard --switch alt-shift`
  kuwai focus [MINUTES|stop]      focus session: DND + focus mode for a while
  kuwai session [save|restore]    the open apps and where they were
  kuwai binds [WORD]              every bind, grouped as in the Shortcuts panel
  kuwai keys [set ACTION KEYS NAME|reset ACTION|reset-all]   your own chords for kuwai's shortcuts
  kuwai update install-helper     one password per update from then on (see kuwai update --help)
  kuwai reload
KUWAI_USAGE
}

ROOT=${KUWAI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
HERE=$(dirname "$(readlink -f "$0")")
ENTRY=${XDG_CONFIG_HOME:-$HOME/.config}/kuwai/hypr/hyprland.lua
[ -f "$ENTRY" ] || ENTRY=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/kuwai
STATE=$STATE_DIR/state

lua() { hyprctl repl "$1" 2>/dev/null; }
live() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl version >/dev/null 2>&1; }

state_set() {
    mkdir -p "$STATE_DIR"; touch "$STATE"
    local tmp; tmp=$(mktemp "$STATE_DIR/.state.XXXXXX")
    grep -v "^$1=" "$STATE" >"$tmp" || true
    [ -n "${2:-}" ] && printf '%s=%s\n' "$1" "$2" >>"$tmp"
    sort -o "$tmp" "$tmp"; mv "$tmp" "$STATE"
}
state_get() { sed -n "s/^$1=//p" "$STATE" 2>/dev/null | tail -1; }

MODES="focus default glass gaming battery"
describe() {
    case $1 in
        focus) echo "Opaque windows, glass on the shell only" ;;
        default) echo "Theme as designed, per-app translucency" ;;
        glass) echo "Liquid glass: acrylic lens blur, translucent windows" ;;
        gaming) echo "Nothing between you and the frame" ;;
        battery) echo "Light effects, longer battery" ;;
    esac
}

cmd_mode() {
    local m=${1:-}
    case $m in
        "") state_get mode || true; [ -z "$(state_get mode)" ] && echo focus; return ;;
        list) for x in $MODES; do printf '%-8s %s\n' "$x" "$(describe "$x")"; done; return ;;
        --pick)
            local menu cur; cur=$(state_get mode); cur=${cur:-focus}
            menu=$(for x in $MODES; do printf '%s%s\t%s\n' "$x" "$([ "$x" = "$cur" ] && echo ' ●')" "$(describe "$x")"; done)
            if command -v rofi >/dev/null; then
                m=$(printf '%s\n' "$menu" | rofi -dmenu -i -p "Mode" -theme-str 'window {width: 34em;}' | cut -f1 | awk '{print $1}')
            elif command -v fuzzel >/dev/null; then
                m=$(printf '%s\n' "$menu" | fuzzel --dmenu -p "Mode " | cut -f1 | awk '{print $1}')
            fi
            [ -n "$m" ] || return 0 ;;
    esac
    case " $MODES " in *" $m "*) ;; *) echo "kuwai: no mode '$m' (try: $MODES)" >&2; return 2 ;; esac
    if live; then hyprctl eval "kuwai.mode('$m')" >/dev/null; else state_set mode "$m"; fi
    echo "mode: $m — $(describe "$m")"
}

display_profile() {
    live || { echo "kuwai: needs the running desktop" >&2; return 1; }
    echo "Measured colour profiles (used by the accurate preset):"
    lua 'return kuwai.display_profiles()' | while IFS=$'\t' read -r name desc path have; do
        printf '  %-7s %s\n          %s  [%s]\n' "$name" "$desc" "$path" "$([ "$have" = yes ] && echo loaded in Accurate || echo none yet)"
    done
    echo
    if command -v dispcal >/dev/null; then
        echo "ArgyllCMS is installed. With the colorimeter plugged in, on the screen to measure:"
    else
        echo "To make one: a colorimeter (e.g. Calibrite Display Plus HL, Datacolor SpyderX) and ArgyllCMS (sudo pacman -S argyllcms). Then:"
    fi
    cat <<'STEPS'
  1. Monitor menu as you'll use it: 6500 K, contrast 50, brightness where you work, Black Boost 0.
  2. kuwai display accurate            (Night Shift off, strict colour)
  3. dispcal -v -d1 -t6500 -g2.2 -qm screen     (-d: display number from `dispcal -?`; follow its prompts)
  4. targen -v -d3 -f250 screen && dispread -v -d1 -k screen.cal screen && colprof -v -qm -aS screen
  5. cp screen.icc to the path shown above, then: kuwai display accurate
STEPS
}

display_calibrate() {
    live || { echo "kuwai: calibrate needs the running desktop" >&2; return 1; }
    local mon w h cache prev conf
    mon=${1:-$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')}
    read -r w h <<<"$(hyprctl -j monitors | jq -r --arg n "$mon" '.[] | select(.name == $n) | "\(.width) \(.height)"')"
    [ -n "${w:-}" ] || { echo "kuwai: no screen '$mon' (try: $(hyprctl -j monitors | jq -r '[.[].name] | join(" ")'))" >&2; return 2; }
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/calibration/${w}x${h}"
    [ -s "$cache/08-white-point.png" ] || "$ROOT/bin/kuwai-calibrate" "$cache" "$w" "$h" >/dev/null || return 1
    prev=$(lua 'return kuwai.display()')
    [ "$prev" = accurate ] || hyprctl eval "kuwai.display('accurate')" >/dev/null
    conf=$(mktemp --suffix=.conf)
    printf '%s\n' 'RIGHT playlist-next' 'SPACE playlist-next' 'ENTER playlist-next' 'LEFT playlist-prev' \
        'BS playlist-prev' 'q quit' 'ESC quit' >"$conf"
    echo "Calibrating $mon (${w}x${h}): → next, ← back, q done. Adjust the monitor's own menu as each pattern says."
    mpv --no-config --vo=gpu-next --target-colorspace-hint=auto --target-colorspace-hint-mode=source \
        --load-scripts=no --osc=no --osd-level=0 --no-input-default-bindings --input-conf="$conf" \
        --image-display-duration=inf --loop-playlist=inf --video-unscaled=yes --deband=no \
        --fs --fs-screen-name="$mon" --screen-name="$mon" --title=kuwai-calibrate \
        "$cache"/*.png >/dev/null 2>&1
    rm -f -- "$conf"
    [ "$prev" = accurate ] || hyprctl eval "kuwai.display('$prev')" >/dev/null
    echo "Done; display preset back to $prev."
}

cmd_display() {
    local all="everyday accurate movie gaming battery" m=${1:-}
    case $m in
        "") if live; then lua 'return kuwai.display()'; echo; else c=$(state_get display); echo "${c:-everyday}"; fi; return ;;
        hdr)
            local v=${2:-}
            case $v in
                "")
                    if live; then lua 'return kuwai.display_hdr()'; echo
                    else [ "$(state_get display_hdr)" = on ] && echo on || echo off; fi
                    return ;;
                on|off|toggle)
                    if live; then
                        local res; res=$(lua "return kuwai.display_hdr('$v')")
                        echo "display hdr: ${res:-$v}"
                    else
                        local cur; cur=$(state_get display_hdr)
                        [ "$v" = toggle ] && { [ "$cur" = on ] && v=off || v=on; }
                        state_set display_hdr "$([ "$v" = on ] && echo on)"
                        echo "display hdr: $v"
                    fi
                    return ;;
                *) echo "usage: kuwai display hdr [on|off|toggle]" >&2; return 2 ;;
            esac ;;
        calibrate) shift; display_calibrate "$@"; return ;;
        profile) display_profile; return ;;
        list) printf '%s\n' \
            "everyday  configured refresh rates, Night Shift on its schedule" \
            "accurate  Night Shift held off, strict colour management" \
            "movie     external screens at 120 Hz for even film cadence" \
            "gaming    the gaming look: no effects, tearing allowed" \
            "battery   built-in panel at 60 Hz"; return ;;
    esac
    case " $all " in *" $m "*) ;; *) echo "kuwai: no display preset '$m' (try: $all)" >&2; return 2 ;; esac
    if live; then hyprctl eval "kuwai.display('$m')" >/dev/null; else state_set display "$([ "$m" = everyday ] || echo "$m")"; fi
    echo "display: $m"
}

cmd_play() {
    local url=${1:-}
    if [ -z "$url" ]; then
        url=$(wl-paste --no-newline 2>/dev/null || true)
    fi
    if ! [[ "$url" =~ ^https?:// ]]; then
        echo "kuwai play: need an http(s) URL (pass one or copy it to the clipboard)" >&2
        [ -x "$ROOT/bin/kuwai-notify" ] && "$ROOT/bin/kuwai-notify" -a kuwai "Nothing to play" "Copy a video URL first, or run kuwai play <URL>" >/dev/null 2>&1 || true
        return 2
    fi
    command -v mpv >/dev/null || { echo "kuwai play: mpv not installed" >&2; return 1; }
    setsid mpv -- "$url" </dev/null >/dev/null 2>&1 &
    echo "playing in mpv: $url"
}

cmd_motion() {
    case ${1:-} in
        "") echo "${KUWAI_REDUCE_MOTION:+reduced (KUWAI_REDUCE_MOTION)}$(state_get motion)"; [ -z "$(state_get motion)" ] && echo full; return ;;
        full) state_set motion "" ;;
        reduced|off) state_set motion "$1" ;;
        *) echo "usage: kuwai motion [full|reduced|off]" >&2; return 2 ;;
    esac
    live && hyprctl reload >/dev/null; echo "motion: $1"
}

cmd_gpu() {
    case ${1:-} in
        "") echo "renderer now: ${KUWAI_GPU_PRIMARY:-$(lua 'return kuwai.K.gpu and kuwai.K.gpu.primary or "?"')}  ·  choice: $(state_get gpu || true)${KUWAI_GPU:+ (KUWAI_GPU=$KUWAI_GPU)}"
            [ -z "$(state_get gpu)" ] && echo "(auto: NVIDIA when a screen hangs off it at login, the iGPU otherwise)"
            return 0 ;;
        auto) state_set gpu "" ;;
        nvidia|intel) state_set gpu "$1" ;;
        *) echo "usage: kuwai gpu [auto|nvidia|intel]" >&2; return 2 ;;
    esac
    echo "gpu: $1 — takes effect at the next login (Hyprland picks its renderer once)"
}

cmd_binds() {
    hyprctl binds -j | jq -r --arg q "${1:-}" '
      .[] | select(.has_description and .description != "") | .modmask as $mm |
      (.description | (capture("^\\[(?<g>[^\\]]+)\\]\\s*(?<t>.*)$") // {g: "Other", t: .})) as $d |
      ([[64, "Super"], [4, "Ctrl"], [8, "Alt"], [1, "Shift"]] | map(select((($mm / .[0]) | floor) % 2 == 1) | .[1])) as $mods |
      {g: ($d.g | split("|") | join(" · ")), t: $d.t, k: ($mods + [.key] | join("+"))} |
      select($q == "" or ((.g + " " + .t + " " + .k) | ascii_downcase | contains($q | ascii_downcase))) |
      "\(.g)\t\(.k)\t\(.t)"' | sort -t$'\t' -k1,1 -s | awk -F'\t' '$1 != g { g = $1; printf "\n\033[1m%s\033[0m\n", g } { printf "  %-26s %s\n", $2, $3 }'
}

FEATURES="desktops island_switcher clamshell battery_guard session_restore launch_focus quake minimize per_monitor_ws layouts screenshare_privacy auto_battery auto_game night_light persistent_size hold_super wobble resize_mode remember_place pip_dodge focus_sessions overview"
cmd_feature() {
    local name=${1:-} v=${2:-}
    if [ -z "$name" ]; then
        if live && out=$(lua 'return kuwai.features()') && [[ $out == *=* ]]; then
            printf '%s\n' "$out" | awk -F'\t' '{split($1,a,"="); printf "  %-22s %-4s %s\n", a[1], a[2], $2}'
        else
            for f in $FEATURES; do v=$(state_get "feature.$f"); printf '  %-22s %s\n' "$f" "${v:-on (default)}"; done
        fi
        return
    fi
    case " $FEATURES " in *" $name "*) ;; *) echo "kuwai: no feature '$name' ($FEATURES)" >&2; return 2 ;; esac
    case $v in
        on|off) ;;
        *) echo "usage: kuwai feature $name on|off" >&2; return 2 ;;
    esac
    if live; then hyprctl eval "kuwai.feature('$name', $([ "$v" = on ] && echo true || echo false))" >/dev/null; else state_set "feature.$name" "$v"; fi
    echo "$name: $v"
}

cmd_screen() {
    local name=${1:-} field=${2:-} value=${3:-}
    if [ -z "$name" ] || [ "$name" = list ]; then live && { lua 'return kuwai.screens_json()'; echo; }; return 0; fi
    [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "kuwai screen: a screen's name, like DP-3 (kuwai screen list)" >&2; return 2; }
    case $field in
        scale|rate) [[ "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "kuwai screen: $field takes a number" >&2; return 2; } ;;
        reset) value="" ;;
        *) echo "usage: kuwai screen NAME scale 1.5 | rate 144 | reset   (kuwai screen list)" >&2; return 2 ;;
    esac
    live || { echo "kuwai screen: needs the running session" >&2; return 1; }
    lua "return kuwai.screen('$name', '$field', '$value')"; echo
}

cmd_pointer() {
    local key=${1:-} value=${2:-}
    case $key in
        speed|accel|mouse-natural|trackpad-natural|tap|trackpad-scroll|repeat-delay|repeat-rate) ;;
        *) echo "usage: kuwai pointer speed -1..1 | accel flat|adaptive | mouse-natural on|off | trackpad-natural on|off | tap on|off | trackpad-scroll 0.2..3 | repeat-delay 150..1000 | repeat-rate 10..80" >&2; return 2 ;;
    esac
    [[ "$value" =~ ^(-?[0-9]+(\.[0-9]+)?|flat|adaptive|on|off)$ ]] || { echo "kuwai pointer: $key needs a value" >&2; return 2; }
    if live; then lua "return kuwai.pointer('$key', '$value')"; echo
    else state_set "ptr.$key" "$value"; echo "saved for the next login"; fi
}

cmd_keyboard() {
    local layout="" variant="" switch="" set=0
    while [ $# -gt 0 ]; do
        case $1 in
            --switch) switch=${2:-}; shift ;;
            --switch=*) switch=${1#--switch=} ;;
            *) if [ -z "$layout" ]; then layout=$1; set=1; elif [ -z "$variant" ]; then variant=$1; else echo "kuwai keyboard: too many arguments" >&2; return 2; fi ;;
        esac
        shift
    done
    if [ $set = 0 ] && [ -z "$switch" ]; then
        if live; then lua 'return (require("kuwai.core").state["kb_layout"] or "us") .. " · switch " .. (require("kuwai.core").state["kb_switch"] or "none")'; echo
        else echo "$(state_get kb_layout || echo us) · switch $(state_get kb_switch || echo none)"; fi
        return 0
    fi
    [[ -z "$layout" || "$layout" =~ ^[a-z]{2,3}(,[a-z]{2,3}){0,3}$ ]] || { echo "kuwai keyboard: layouts are xkb names like us or us,de" >&2; return 2; }
    [[ -z "$variant" || "$variant" =~ ^[a-z0-9_-]*(,[a-z0-9_-]*){0,3}$ ]] || { echo "kuwai keyboard: variants are xkb names like nodeadkeys (comma-separated)" >&2; return 2; }
    [[ -z "$switch" || "$switch" =~ ^(alt-shift|caps|win-space|ctrl-shift|none)$ ]] || { echo "kuwai keyboard: --switch alt-shift|caps|win-space|ctrl-shift|none" >&2; return 2; }
    if live; then
        local a=nil b=nil c=nil
        [ $set = 1 ] && a="'$layout'" && b="'$variant'"
        [ -n "$switch" ] && c="'$switch'"
        lua "return kuwai.keyboard($a, $b, $c)"; echo
    else
        [ $set = 1 ] && { state_set kb_layout "$layout"; state_set kb_variant "$variant"; }
        [ -n "$switch" ] && state_set kb_switch "$([ "$switch" = none ] || echo "$switch")"
        echo "saved for the next login"
    fi
}

problems=0
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; problems=$((problems + 1)); }
note() { printf '  \033[33m•\033[0m %s\n' "$*"; }

cmd_doctor() {
    echo "Config"
    if live; then
        errs=$(hyprctl configerrors 2>/dev/null | sed '/^[[:space:]]*$/d')
        if [ -z "$errs" ]; then ok "the running Hyprland's config has no errors"
        else bad "the running Hyprland's config has errors:"; printf '%s\n' "$errs" | sed 's/^/      /'; fi
        vrc=-1
    else
        if command -v prlimit >/dev/null; then out=$(prlimit --core=1:1 -- Hyprland --verify-config -c "$ENTRY" 2>&1); vrc=$?
        else out=$(Hyprland --verify-config -c "$ENTRY" 2>&1); vrc=$?; fi
    fi
    if [ $vrc -eq -1 ]; then :
    elif [ $vrc -ge 128 ]; then
        if live && [ -z "$(hyprctl configerrors 2>/dev/null | tr -d '[:space:]')" ]; then
            note "Hyprland --verify-config crashed (signal $((vrc - 128)), Hyprland's bug); the live config has no errors"
        else
            bad "Hyprland --verify-config crashed (signal $((vrc - 128))) — see coredumpctl"
        fi
    elif [ $vrc -eq 0 ]; then
        res=$(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g' | sed -n '/Config parsing result:/,$p' | tail -n +2 | sed '/^$/d')
        if [ "$res" = "config ok" ]; then ok "Hyprland --verify-config: ok"; else bad "verify-config:"; printf '%s\n' "$res" | sed 's/^/      /'; fi
        kerr=$(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g' | grep -E '\[kuwai\] ' | grep -v 'gpu:' | sed 's/.*\[kuwai\] //')
        [ -z "$kerr" ] && ok "kuwai modules: no errors" || { bad "kuwai module errors:"; printf '%s\n' "$kerr" | sed 's/^/      /'; }
    else
        bad "could not run Hyprland --verify-config"
    fi
    for f in "$ENTRY" "$ROOT/hypr/init.lua" "$ROOT"/hypr/kuwai/*.lua "${ENTRY%/*}"/monitors.lua "${ENTRY%/*}"/user.lua; do
        [ -f "$f" ] || continue
        if ! luac -p "$f" 2>/dev/null; then
            if [ "$f" = "${ENTRY%/*}/user.lua" ]; then
                bad "syntax: $f (your overrides — fix or move aside; kuwai repo configs are ok)"
            else
                bad "syntax: $f"
            fi
        fi
    done

    echo "Session"
    if live; then
        cfg=$(lua 'return os.getenv("HYPRLAND_CONFIG") or ""')
        case $cfg in
            ""|*hyprland.lua) ok "Hyprland reads ${cfg:-$ENTRY}" ;;
            *) bad "HYPRLAND_CONFIG=$cfg is not the Lua entry — Hyprland will load the wrong file" ;;
        esac
        if grep -qs 'HYPRLAND_CONFIG=.*hyprland\.conf' "${ZDOTDIR:-$HOME}"/conf.d/hyde/env.zsh "$HOME"/.config/uwsm/env-hyprland.d/*.sh; then
            bad "your login env still exports a hyprlang HYPRLAND_CONFIG (HyDE's env.zsh / uwsm env)"
        fi
        stamp=$(lua 'return tostring(kuwai and kuwai.loaded_at)')
        [[ $stamp =~ ^[0-9]+$ ]] && ok "kuwai loaded by Hyprland $(date -d "@$stamp" +%H:%M:%S)" || bad "kuwai isn't what Hyprland loaded this session — log out and back in"
        errs=$(hyprctl configerrors 2>/dev/null | sed '/^$/d')
        [ -z "$errs" ] && ok "no live config errors" || { bad "live config errors:"; printf '%s\n' "$errs" | sed 's/^/      /'; }
        info=$(lua 'return kuwai and kuwai.info() or "kuwai not loaded"'); [[ $info == kuwai\ 0* ]] && ok "$info" || bad "$info"
        [ -s "$STATE_DIR/errors" ] && { bad "errors at last load:"; sed 's/^/      /' "$STATE_DIR/errors"; }
        n=$(hyprctl binds -j | jq '[.[] | select(.submap == "")] | length'); ok "$n binds"
        clash=$(lua 'return kuwai.bind_conflicts and kuwai.bind_conflicts() or ""' | sed '/^$/d; /^ok$/d; /^nil$/d')
        if [ -z "$clash" ]; then ok "no two kuwai binds on the same keys"; else bad "binds on the same keys (the later one wins):"; printf '%s\n' "$clash" | sed 's/^/      /'; fi
        hyprctl monitors -j | jq -r '.[] | "\(.name) \(.width)x\(.height)@\(.refreshRate|floor)Hz ×\(.scale|tostring|.[0:5]) \(.currentFormat) vrr:\(.vrr)"' | while read -r l; do ok "screen $l"; done
    else
        note "not inside Hyprland — session checks skipped"
    fi
    idle_owner=$(jq -r '.idleOwner // "shell"' "${XDG_CONFIG_HOME:-$HOME/.config}/kuwai/settings.json" 2>/dev/null || echo shell)
    if [ "$idle_owner" = hypridle ]; then units="hypridle.service"; else units=""
        systemctl --user is-active --quiet hypridle.service && bad "hypridle runs beside the shell's idle: systemctl --user stop hypridle" || ok "idle: the shell's (hypridle off)"
    fi
    for u in $units voxtype.service gcr-ssh-agent.socket kuwai-clipboard.service kuwai-feeds.service; do
        st=$(systemctl --user is-active "$u" 2>/dev/null); [ "$st" = active ] && ok "$u" || note "$u: $st"
    done
    if [ "$(systemctl --user is-active kuwai-auth.service 2>/dev/null)" = active ]; then ok "password prompt: kuwai (kuwai-auth)"
        case $(auth_pin_state) in
            current) ok "password prompt code: root's copy ($AUTH_PINNED)" ;;
            older) note "password prompt code: root's copy is older than this checkout: kuwai auth pin" ;;
            *) note "password prompt code: from your checkout, which your account can change: kuwai auth pin (sudo)" ;;
        esac
    elif [ "$(systemctl --user is-active plasma-polkit-agent.service 2>/dev/null)" = active ]; then note "password prompt: KDE's fallback (kuwai-auth not running)"
    else bad "no password prompt (polkit agent) running: systemctl --user start kuwai-auth"; fi
    auth_audit
    n=$(faillock --user "$USER" 2>/dev/null | grep -c ' V$'); deny=$(sed -nE 's/^\s*deny\s*=\s*([0-9]+).*/\1/p' /etc/security/faillock.conf); deny=${deny:-3}
    [ "${n:-0}" -ge "$deny" ] && bad "account locked by faillock ($n/$deny failed tries): faillock --user $USER --reset" || ok "faillock: ${n:-0}/$deny recent failed tries"
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh" ] && ok "ssh agent socket" || note "no ssh agent socket"

    echo "Scripts"
    legacy=$(grep -rlE "hyprctl( -q| -j)? (keyword|dispatch (workspace|exit|focuswindow|movetoworkspace|togglespecialworkspace|killactive|exec |submap [a-z]))|hyprctl --batch" \
        "$HOME/Scripts" "$ROOT/bin" "$ROOT/shell" "$HOME/.config/voxtype" "$HOME/.local/share/waybar/modules" 2>/dev/null | grep -vE '\.(bak|orig)|lib-dispatch.sh|esc-guard|/bin/kuwai$' )
    [ -z "$legacy" ] && ok "no pre-0.57 hyprctl syntax in your scripts" || { bad "pre-0.57 hyprctl syntax:"; printf '%s\n' "$legacy" | sed "s|$HOME|~|; s/^/      /"; }
    grep -rqP 'Hyprland\.dispatch\(["`](?!hl\.|kuwai\.)' "$ROOT/shell" 2>/dev/null && bad "shell: Hyprland.dispatch with classic syntax" || ok "shell dispatches are Lua"

    echo
    if [ $problems -eq 0 ]; then
        echo "Hyprland & kuwai: all good"
    else
        echo "Hyprland & kuwai: $problems problem(s)"
        echo "  (user.lua errors are in ${ENTRY%/*} — not the kuwai repo)"
    fi
    [ $problems -eq 0 ]
}

auth_audit() {
    local A="$ROOT/shell-auth" bad_=0
    [ -d "$A" ] || { note "shell-auth not found"; return; }
    if [ -n "$(find "$A" -type l)" ]; then bad "shell-auth contains links: $(find "$A" -type l -printf '%P ' )"; bad_=1; fi
    local talk
    talk=$(grep -rnE 'Process|Socket|execDetached|XMLHttpRequest|IpcHandler|Quickshell\.Hyprland|Quickshell\.Services|qs\.services|qs\.modules' "$A/config" "$A/components" 2>/dev/null | grep -vE '^[^:]+:[0-9]+:\s*//' | cut -d: -f1 | sort -u | sed "s|$A/||" | tr '\n' ' ')
    if [ -n "$talk" ]; then bad "shell-auth config/ or components/ talk to other programs: $talk"; bad_=1; fi
    if grep -E 'execDetached|XMLHttpRequest|IpcHandler|Socket \{|qs\.services|qs\.modules' "$A/shell.qml" >/dev/null; then bad "shell-auth/shell.qml uses IPC, sockets or the shell's services"; bad_=1; fi
    local unknown
    unknown=$(grep -E '^\s*command:' "$A/shell.qml" | grep -vE '"hyprctl", "repl", "return kuwai.where\(\)"|"hyprctl", "devices", "-j"|"faillock", "--user", root\.me|"sh", "-c", .f="\$HOME/\.face"|"sh", "-c", "echo \$PPID"' )
    if [ -n "$unknown" ]; then bad "shell-auth/shell.qml runs a command not on its list:"; printf '      %s\n' "$unknown"; bad_=1; fi
    [ $bad_ -eq 0 ] && ok "password prompt code: files and drawing only (no links, 5 known commands)"
}

AUTH_PINNED=/usr/local/share/kuwai/shell-auth

auth_pin_state() {
    if [ ! -f "$AUTH_PINNED/shell.qml" ]; then echo none
    elif diff -rq "$AUTH_PINNED" "$ROOT/shell-auth" >/dev/null 2>&1; then echo current
    else echo older; fi
}

cmd_auth() {
    case ${1:-status} in
        pin)
            local tmp st
            if ! git -C "$ROOT" diff --quiet HEAD -- shell-auth || [ -n "$(git -C "$ROOT" ls-files --others --exclude-standard -- shell-auth)" ]; then
                echo "shell-auth/ has uncommitted changes: commit or discard them first" >&2; return 1
            fi
            tmp=$(mktemp -d) || return 1
            git -C "$ROOT" archive HEAD shell-auth | tar -x -C "$tmp" || { rm -rf "$tmp"; return 1; }
            if [ -n "$(find "$tmp" ! -type f ! -type d)" ]; then rm -rf "$tmp"; echo "shell-auth/ holds something that isn't a plain file; refusing" >&2; return 1; fi
            local sum
            sum=$(cd "$tmp/shell-auth" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-64)
            echo "Copies the password prompt (shell-auth/ at $(git -C "$ROOT" rev-parse --short HEAD), tree sha256 $sum) to $AUTH_PINNED,"
            echo "owned by root, so the code that reads your password isn't code your account can change. sudo asks once."
            sudo sh -c 'set -e; rm -rf "$1.new"; mkdir -p "$(dirname "$1")"; cp -R --no-preserve=all "$2/shell-auth" "$1.new"
                        chown -R root:root "$1.new"; chmod -R u=rwX,go=rX "$1.new"
                        got=$(cd "$1.new" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-64)
                        [ "$got" = "$3" ] || { rm -rf "$1.new"; echo "the copy changed after it was checked; nothing pinned" >&2; exit 1; }
                        rm -rf "$1"; mv "$1.new" "$1"' sh "$AUTH_PINNED" "$tmp" "$sum"
            st=$?; rm -rf "$tmp"
            [ $st = 0 ] || { echo "not pinned" >&2; return 1; }
            systemctl --user reset-failed kuwai-auth.service 2>/dev/null; systemctl --user restart kuwai-auth.service && echo "password prompt now runs from $AUTH_PINNED" ;;
        unpin)
            sudo sh -c 'rm -rf "$1" && rmdir --ignore-fail-on-non-empty "$(dirname "$1")"' sh "$AUTH_PINNED" && systemctl --user restart kuwai-auth.service && echo "password prompt runs from $ROOT/shell-auth again" ;;
        diff)
            for f in Label Spring NotchShape GlassCard RaisedButton; do
                diff -u <(cat "$ROOT/shell/components/$f.qml") <(sed '1,/^\/\/ on purpose/d' "$ROOT/shell-auth/components/$f.qml") \
                    --label "shell/components/$f.qml" --label "shell-auth/components/$f.qml" || true
            done ;;
        status)
            systemctl --user --no-pager status kuwai-auth.service | head -5
            case $(auth_pin_state) in
                current) echo "  runs from $AUTH_PINNED (root's copy, same as this checkout)" ;;
                older) echo "  runs from $AUTH_PINNED (root's copy, older than this checkout: kuwai auth pin)" ;;
                *) echo "  runs from $ROOT/shell-auth (your account can change it: kuwai auth pin)" ;;
            esac
            local rt="${XDG_RUNTIME_DIR:-/run/user/$UID}/kuwai"
            [ -s "$rt/auth-pending" ] && echo "  waiting: $(head -1 "$rt/auth-pending") (on $(sed -n 2p "$rt/auth-pending"))" || echo "  no password request waiting"
            pgrep -a pkexec | sed 's/^/  pkexec: /'
            n=$(faillock --user "$USER" 2>/dev/null | grep -c ' V$'); echo "  failed tries: ${n:-0}"
            auth_audit ;;
        here|summon)
            local rt="${XDG_RUNTIME_DIR:-/run/user/$UID}/kuwai" s=${2:-}
            [ -n "$s" ] || s=$(hyprctl repl 'return kuwai.where()' 2>/dev/null | tail -1 | jq -r '.looking // empty' 2>/dev/null)
            [ -n "$s" ] || s=$(hyprctl monitors -j | jq -r '.[]|select(.focused).name')
            mkdir -p "$rt" && echo "$s" > "$rt/auth-summon" && echo "prompt → $s" ;;
        restart)
            systemctl --user reset-failed kuwai-auth.service 2>/dev/null; systemctl --user restart kuwai-auth.service && echo "password prompt restarted" ;;
        fallback)
            systemctl --user stop kuwai-auth.service; systemctl --user start plasma-polkit-agent.service && echo "KDE's password prompt is in charge (kuwai auth restore to go back)" ;;
        restore)
            systemctl --user stop plasma-polkit-agent.service; systemctl --user reset-failed kuwai-auth.service 2>/dev/null; systemctl --user start kuwai-auth.service && echo "kuwai's password prompt is back" ;;
        reset-tries)
            faillock --user "$USER" --reset && echo "failed tries cleared" ;;
        *) echo "kuwai auth [status|here [SCREEN]|restart|fallback|restore|reset-tries|diff|pin|unpin]" >&2; return 2 ;;
    esac
}

cmd_rescue() {
    echo "kuwai rescue"
    local rt="${XDG_RUNTIME_DIR:-/run/user/$UID}/kuwai"
    systemctl --user reset-failed kuwai-auth.service kuwai-clipboard.service kuwai-feeds.service 2>/dev/null
    systemctl --user restart kuwai-auth.service && echo "  ✓ password prompt restarted"
    local consent="${XDG_CONFIG_HOME:-$HOME/.config}/kuwai/collect.conf"
    if grep -qx clipboard=on "$consent" 2>/dev/null; then
        systemctl --user restart kuwai-clipboard.service && echo "  ✓ clipboard history watchers restarted"
    else echo "  • clipboard history is off (kuwai collect clipboard on)"; fi
    if grep -qx feeds=on "$consent" 2>/dev/null; then
        systemctl --user restart kuwai-feeds.service && echo "  ✓ GitHub and Gmail notifications restarted"
    else echo "  • GitHub and Gmail notifications are off (kuwai collect feeds on)"; fi
    : > "$rt/auth-pending" 2>/dev/null
    "$ROOT/bin/kuwai-shell" >/dev/null 2>&1 && echo "  ✓ island shell restarted"
    echo "  • idle ownership is reconciled by the shell (see Power & Idle for errors)"
    if [ "$(faillock --user "$USER" 2>/dev/null | grep -c ' V$')" -gt 0 ]; then echo "  • failed password tries recorded: kuwai auth reset-tries clears them"; fi
    echo "  then: kuwai doctor"
}

case ${1:-info} in
    info) live && lua 'return kuwai.info()' && echo || echo "kuwai (not running) · mode $(state_get mode || echo focus)" ;;
    doctor) cmd_doctor; rc=$?; if [ "${KUWAI_IN_DOCTOR:-0}" != 1 ] && [ -x "$HERE/kuwai-doctor" ]; then KUWAI_IN_DOCTOR=1 "$HERE/kuwai-doctor" || rc=1; fi; exit $rc ;;
    auth) shift; cmd_auth "$@" ;;
    rescue) cmd_rescue ;;
    mode) shift; cmd_mode "$@" ;;
    display) shift; cmd_display "$@" ;;
    play) shift; cmd_play "$@" ;;
    motion) shift; cmd_motion "$@" ;;
    gpu) shift; cmd_gpu "$@" ;;
    binds) shift; cmd_binds "$@" ;;
    keys) shift; exec "$HERE/kuwai-keys" "$@" ;;
    secrets) shift; exec "$HERE/kuwai-secrets" "$@" ;;
    update|updates) shift; exec "$HERE/kuwai-update" "$@" ;;
    feature|features) shift; cmd_feature "$@" ;;
    keyboard|kb) shift; cmd_keyboard "$@" ;;
    pointer|mouse|trackpad) shift; cmd_pointer "$@" ;;
    screen|screens) shift; cmd_screen "$@" ;;
    session) shift; snap=$STATE_DIR/session
        case ${1:-show} in
            save) lua 'return kuwai.session_save and kuwai.session_save() or 0' | sed 's/$/ apps saved/' ;;
            restore) lua 'return kuwai.session_restore and kuwai.session_restore() or "session_restore is off"'; echo ;;
            offer)
                [ -s "$snap" ] || exit 0
                n=$(grep -vc '^#' "$snap"); when=$(head -1 "$snap" | sed 's/^# kuwai session //')
                RN="$ROOT/bin/kuwai-notify"
                a=$([ -x "$RN" ] && "$RN" -w -a kuwai -i view-restore -A restore="Restore" -A no="Not now" \
                    "Restore your last session?" "$n apps on their workspaces, saved $when" \
                    || notify-send -a kuwai -i view-restore -t 30000 -A restore="Restore" -A no="Not now" \
                    "Restore your last session?" "$n apps on their workspaces, saved $when")
                [ "$a" = restore ] && lua 'return kuwai.session_restore()' >/dev/null ;;
            show|*) [ -s "$snap" ] && { head -1 "$snap"; grep -v '^#' "$snap" | awk -F'\t' '{printf "  ws %-3s %-28s %s\n", $1, $5, ($2=="1"?"floating":"")}'; } || echo "no saved session" ;;
        esac ;;
    focus) shift; case ${1:-} in
               stop) lua 'return kuwai.focus and kuwai.focus() or "focus_sessions is off"' ;;
               *) lua "return kuwai.focus and kuwai.focus(${1:-25}) or 'focus_sessions is off'" ;;
           esac; echo ;;
    reload) hyprctl reload ;;
    -h|--help|help) usage
                    echo; "$HERE/kuwai-ctl" help 2>/dev/null ;;
    *) exec "$HERE/kuwai-ctl" "$@" ;;
esac
