#!/usr/bin/env bash
set -eu
app=kuwai
icon=""
urgency=1
wait=0
transient=0
actions=()
declare -A xhints=()
while getopts "a:i:u:wtA:H:" opt; do
    case $opt in
        a) app=$OPTARG ;;
        i) icon=$OPTARG ;;
        u) case $OPTARG in critical) urgency=2 ;; low) urgency=0 ;; *) urgency=1 ;; esac ;;
        w) wait=1 ;;
        t) transient=1 ;;
        A) actions+=("$OPTARG") ;;
        H)
            key=${OPTARG%%=*}; val=${OPTARG#*=}
            case $key in x-kuwai-*) xhints[$key]=$val ;;
                *) echo "kuwai-notify: hint key must start with x-kuwai- ($key)" >&2; exit 2 ;;
            esac
            ;;
        *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))
title=${1:-Notification}; body=${2:-}

hints="{\"urgency\": <byte $urgency>"
[ "$transient" = 1 ] && hints+=", \"transient\": <true>"
if command -v jq >/dev/null 2>&1; then
    for k in "${!xhints[@]}"; do
        esc=$(jq -Rn --arg v "${xhints[$k]}" '$v')
        hints+=", \"$k\": <$esc>"
    done
else
    for k in "${!xhints[@]}"; do
        v=${xhints[$k]//\\/\\\\}; v=${v//\"/\\\"}
        hints+=", \"$k\": <\"$v\">"
    done
fi
hints+="}"

if [ ${#actions[@]} -gt 0 ]; then
    arr="["
    for a in "${actions[@]}"; do
        key=${a%%=*}; label=${a#*=}
        key=${key//\\/\\\\}; key=${key//\"/\\\"}
        label=${label//\\/\\\\}; label=${label//\"/\\\"}
        [ "$arr" != "[" ] && arr+=", "
        arr+="\"$key\", \"$label\""
    done
    arr+="]"
else
    arr="[]"
fi

if ! out=$(gdbus call --session --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    "$app" 0 "$icon" "$title" "$body" "$arr" "$hints" 0 2>&1); then
    why=$(printf '%s\n' "$out" | sed -n '/./{s/^Error: //;p;q}')
    printf 'kuwai-notify: the notification server did not take "%s": %s\n' "$title" "${why:-gdbus failed with no message}" >&2
    exit 1
fi
reply=$(printf '%s\n' "$out" | grep -m1 '^(uint32' || true)
if [ "$wait" = 1 ] && [ ${#actions[@]} -gt 0 ]; then
    nid=$(echo "$reply" | awk '{print $2}' | tr -d '(),')
    exec 3< <(gdbus monitor --session --dest org.freedesktop.Notifications 2>/dev/null)
    mon=$!
    choice=""
    while read -r line <&3; do
        case "$line" in
            *"ActionInvoked"*"uint32 $nid,"*)
                choice=$(echo "$line" | sed -n "s/.*'\\([^']*\\)'.*/\\1/p" | head -1)
                break
                ;;
            *"NotificationClosed"*"uint32 $nid,"*)
                break
                ;;
        esac
    done
    kill "$mon" 2>/dev/null
    exec 3<&-
    if [ -n "$choice" ]; then echo "$choice"; fi
fi
