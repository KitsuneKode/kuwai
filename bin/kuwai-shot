#!/usr/bin/env bash
set -uo pipefail

usage() {
cat <<'KUWAI_USAGE'
Screenshots for kuwai, in place of HyDE's script (hypr/kuwai/binds.lua).

  kuwai-shot area      pick a region, then annotate it in Satty (Super+P)
  kuwai-shot quick     pick a region, done: copied and saved, no editor; the
                      clipboard island shows it (Super+Alt+P)
  kuwai-shot window    the window you're in (Super+Ctrl+Alt+P)
  kuwai-shot delay     this monitor in 3 s, for menus that close on a click (Shift+Print)
  kuwai-shot ocr       pick a region; its text is copied, not the picture (Super+Shift+Alt+P)
  kuwai-shot freeze    freeze the screen, then pick (Super+Ctrl+P)
  kuwai-shot monitor   the focused monitor (Super+Ctrl+Shift+P)
  kuwai-shot all       every monitor (Print)

The shot goes on the clipboard at once (the clipboard island shows it) and
is saved to ~/Pictures/Screenshots; then Satty opens on it to annotate,
KUWAI_USAGE
}
umask 077

NOTIFY="$(dirname "$(readlink -f "$0")")/kuwai-notify"
notify() { [ -x "$NOTIFY" ] && "$NOTIFY" "$@" || command -v notify-send >/dev/null && notify-send "$@" || true; }

mode="${1:-area}"
case "$mode" in area|quick|freeze|window|delay|ocr|monitor|all) ;; *) usage; exit 2 ;; esac
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir" || exit 1
out=$(mktemp "$dir/Screenshot_$(date +%Y%m%d_%H%M%S)_XXXXXX.png") || exit 1
frz=""
cleanup() {
    if [ -n "$frz" ]; then kill "$frz" 2>/dev/null || true; fi
    if [ ! -s "$out" ]; then rm -f -- "$out"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

pick() {
    local ws boxes geo x y w h
    ws=$(hyprctl -j monitors | jq -c '[.[] | .activeWorkspace.id, .specialWorkspace.id] | map(select(. != 0))')
    boxes=$(hyprctl -j clients | jq -r --argjson ws "$ws" \
        '.[] | select(.hidden | not) | select(.workspace.id as $w | $ws | index($w)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    geo=$(printf '%s\n' "$boxes" | slurp -d 2>/dev/null) || return 1
    read -r x y w h <<<"$(printf '%s' "$geo" | sed -E 's/^(-?[0-9]+),(-?[0-9]+) ([0-9]+)x([0-9]+)$/\1 \2 \3 \4/')"
    if [ "${w:-0}" -lt 16 ] && [ "${h:-0}" -lt 16 ]; then
        local hit
        hit=$(printf '%s\n' "$boxes" | awk -v px="$x" -v py="$y" '{ split($1, a, ","); split($2, b, "x");
            if (px >= a[1] && px < a[1] + b[1] && py >= a[2] && py < a[2] + b[2]) { print; exit } }')
        [ -n "$hit" ] && geo="$hit" || return 1
    fi
    printf '%s\n' "$geo"
}

if [ "$mode" = area ] || [ "$mode" = quick ] || [ "$mode" = freeze ]; then
    frz=""
    if [ "$mode" = freeze ]; then hyprpicker -r -z >/dev/null 2>&1 & frz=$!; sleep 0.15; fi
    geo=$(pick); ok=$?
    if [ -n "$frz" ]; then kill "$frz" 2>/dev/null || true; frz=""; fi
    [ $ok -eq 0 ] && [ -n "$geo" ] || exit 0
    if ! grim -g "$geo" "$out" 2>/dev/null || [ ! -s "$out" ]; then
        rm -f -- "$out"; notify -a "Screenshot" "Screenshot failed" "grim couldn't capture $geo"; exit 0
    fi
    wl-copy --type image/png < "$out"
    case "$mode" in quick) exit 0 ;; esac
    shoot=()
fi

if [ "$mode" = window ]; then
    win=$(hyprctl -j activewindow 2>/dev/null)
    addr=$(jq -r '.address // empty' <<<"$win")
    [ -n "$addr" ] || exit 0
    geo=$(jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' <<<"$win")
    if ! grim -g "$geo" "$out" 2>/dev/null || [ ! -s "$out" ]; then
        rm -f -- "$out"; notify -a "Screenshot" "Screenshot failed" "grim couldn't capture the window"; exit 0
    fi
    if [ "$(jq -r '.fullscreen' <<<"$win")" = 0 ]; then
        r=$(hyprctl getprop "address:$addr" rounding 2>/dev/null)
        pw=$(hyprctl getprop "address:$addr" rounding_power 2>/dev/null)
        case "$r" in ''|*[!0-9.]*) r=$(hyprctl -j getoption decoration:rounding | jq -r '.int') ;; esac
        case "$pw" in ''|*[!0-9.]*) pw=$(hyprctl -j getoption decoration:rounding_power | jq -r '.float') ;; esac
        "$(dirname "$(readlink -f "$0")")/kuwai-shot-round" "$out" "$(jq -r '.size[0]' <<<"$win")" "$r" "$pw" 2>/dev/null
    fi
    wl-copy --type image/png < "$out"
    exit 0
fi

focused_output() { hyprctl -j monitors 2>/dev/null | jq -r 'map(select(.focused)) | .[0].name // empty'; }

case "$mode" in
    area|quick|freeze) ;;
    delay)   sleep 3; shoot=(grim -o "$(focused_output)") ;;
    ocr)
        command -v tesseract >/dev/null || { notify -a "Screenshot" "Reading text needs Tesseract" "Install tesseract and tesseract-data-eng, then try again."; exit 0; }
        tmp=$(mktemp --suffix=.png)
        if geo=$(slurp 2>/dev/null) && grim -g "$geo" "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
            text=$(tesseract "$tmp" - 2>/dev/null | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
            if [ -n "$text" ]; then
                printf '%s' "$text" | wl-copy
            else
                notify -a "Screenshot" "No text found" "Nothing readable in that region."
            fi
        fi
        rm -f -- "$tmp"; exit 0 ;;
    monitor) shoot=(grim -o "$(focused_output)") ;;
    all)     shoot=(grim) ;;
    *) usage; exit 2 ;;
esac

errf=$(mktemp)
rc=0
if [ ${#shoot[@]} -gt 0 ]; then
    "${shoot[@]}" "$out" >/dev/null 2>"$errf" </dev/null
    rc=$?
    [ $rc -eq 0 ] && [ -s "$out" ] && wl-copy --type image/png < "$out"
fi
err=$(cat "$errf"); rm -f -- "$errf"
if [ $rc -ne 0 ] || [ ! -s "$out" ]; then
    rm -f -- "$out"
    if [ -n "$err" ] && ! printf '%s' "$err" | grep -qi "cancel"; then
        notify -a "Screenshot" -u normal "Screenshot failed" "$(printf '%s' "$err" | tail -3)"
    fi
    exit 0
fi

case "$mode" in quick|window|delay) exit 0 ;; esac

if ! command -v satty >/dev/null; then
    notify -a "Screenshot" "Screenshot copied" "Install satty to mark it up before it's copied."
    exit 0
fi

log="${XDG_STATE_HOME:-$HOME/.local/state}/kuwai/kuwai-shot.log"
mkdir -p "$(dirname "$log")" || exit 1
satty --filename "$out" --output-filename "$out" --copy-command wl-copy \
    --early-exit save --actions-on-enter save-to-clipboard,exit --actions-on-escape exit >>"$log" 2>&1 &
pid=$!

for _ in $(seq 60); do
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .address' | head -1)
    if [ -n "$addr" ]; then
        hyprctl dispatch "hl.dsp.focus({window = 'address:$addr'})" >/dev/null
        break
    fi
    sleep 0.05
done
wait "$pid"
