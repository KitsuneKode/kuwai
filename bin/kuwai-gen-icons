    0xF06B0: "arrow-clockwise", 0xF0E7B: "atom", 0xF029A: "gauge", 0xF0EE0: "cpu",
    0xF00E2: "broom", 0xF04C5: "speedometer", 0xF0028: "warning-circle", 0xF0B79: "chat",
    0xF05E0: "check-circle", 0xF02EE: "image-broken", 0xF0645: "tree-structure", 0xF035B: "memory",
    0xF04C4: "speaker-x", 0xF02CA: "hard-drives", 0xF008E: "battery-medium", 0xF0E09: "image",
    0xF04C3: "speaker-high", 0xF010B: "car", 0xF037D: "mouse", 0xF030C: "keyboard",
