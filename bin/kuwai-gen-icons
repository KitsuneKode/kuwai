#!/usr/bin/env python3
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "shell/assets/phosphor/map.json"
OUTPUT = ROOT / "shell/config/icons.mjs"

NERD_TO_PHOSPHOR = {
    0xF0026: "warning", 0xF0159: "x-circle", 0xF012C: "check", 0xF0176: "coffee",
    0xF009B: "bell-slash", 0xF0594: "moon-stars", 0xF05A9: "wifi-high", 0xF00AF: "bluetooth",
