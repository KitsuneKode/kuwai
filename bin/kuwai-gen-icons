    0xF075F: "speaker-none", 0xF057F: "speaker-low", 0xF0580: "speaker-high", 0xF057E: "speaker-high",
    0xF0772: "spinner", 0xF0054: "arrow-right", 0xF075A: "music-notes", 0xF00DE: "sun",
    0xF00DF: "sun", 0xF036C: "microphone", 0xF0370: "microphone", 0xF0079: "battery-full",
    0xF0371: "microphone-slash", 0xF036D: "microphone-slash", 0xF003B: "squares-four", 0xF009C: "bell",
    0xF0128: "chart-bar", 0xF0450: "arrows-clockwise", 0xF033E: "lock", 0xF0083: "battery-warning",
    0xF0393: "thermometer", 0xF03CC: "arrow-square-out", 0xF0565: "shield-check", 0xF0156: "x",
    0xF0349: "magnifying-glass", 0xF0339: "link", 0xF0493: "gear-six", 0xF0A7A: "trash",
    0xF0214: "file", 0xF024B: "folder", 0xF0403: "push-pin", 0xF061A: "cpu",
    0xF03D8: "palette", 0xF0675: "gear", 0xF00B2: "bluetooth-x", 0xF0483: "shield-check",
}


def render():
    data = json.loads(SOURCE.read_text())
    for name in NERD_TO_PHOSPHOR.values():
        if name not in data:
            raise SystemExit(f"nerdToPhosphor names a missing Phosphor icon: {name}")
    entries = ",".join(
        json.dumps(name) + ":" + json.dumps([entry.get("r", 0), entry.get("db", 0), entry.get("df", 0)], separators=(",", ":"))
        for name, entry in sorted(data.items())
    )
    nerd = ",".join(json.dumps(str(cp)) + ":" + json.dumps(name) for cp, name in sorted(NERD_TO_PHOSPHOR.items()))
    return """export const entries=Object.freeze({%s});
export const nerdToPhosphor=Object.freeze({%s});
const keys={r:0,db:1,df:2};
export function entry(name){return entries[name]||null}
export function codepoint(name,key){const e=entry(name);if(!e)return 0;const k=keys[key||"r"];if(k===undefined)return 0;if(k>0&&(!e[1]||!e[2]))return 0;return e[k]||0}
export function glyph(name,key){const cp=codepoint(name,key);return cp?String.fromCodePoint(cp):""}
export function phosphorForNerd(cp){return nerdToPhosphor[String(cp)]||""}
export function nerdGlyph(cp,key){const name=phosphorForNerd(cp);return name?glyph(name,key):""}
""" % (entries, nerd)


def main():
    mode = "--check" if "--check" in sys.argv[1:] else "--generate"
    text = render()
    if mode == "--check":
        if not OUTPUT.exists() or OUTPUT.read_text() != text:
            print("shell/config/icons.mjs is not current; run bin/kuwai-gen-icons --generate", file=sys.stderr)
            return 1
        return 0
    OUTPUT.write_text(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
