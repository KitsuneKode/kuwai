#!/usr/bin/env python3
"""kuwai-themes: HyDE's themes and wallpapers as JSON for the island's Themes panel.

    kuwai-themes list                 {"current": NAME, "themes": [...], "wallpapers": [...]}
    kuwai-themes photos               ["PATH", ...]: the current theme's own wallpapers, nothing hashed (the Photos screensaver)
    kuwai-themes theme NAME [--wait]  switch theme (HyDE's theme.switch.sh: GTK, kitty, Hyprland, Waybar, wallpaper)
    kuwai-themes wallpaper PATH       set the wallpaper (HyDE's wallpaper.sh --global; wallbash recolours from it)
    kuwai-themes colormode MODE       theme | auto | dark | light: where apps take colours from (HyDE's wallbash
                                     mode: the theme's own palette, or the wallpaper's in its own/dark/light tone)

A theme: name, its wallpaper's thumbnail (HyDE's own cache, ~/.cache/hyde/thumbs/<sha1>.thmb, made on demand
when missing), background and accent (from its kitty.theme), and whether it's the current one. Hashes are cached
by path+mtime+size in ~/.cache/kuwai/themes.json, so a listing after the first is instant; the ones it doesn't
know yet (a new theme, its wallpapers) are hashed several at once. The last listing is kept in
~/.cache/kuwai/themes-list.json: the panel shows it the moment it opens, then this listing replaces it.
"""
import hashlib
import json
import os
import signal
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.join(ROOT, "lib") not in sys.path:
    sys.path.insert(0, os.path.join(ROOT, "lib"))

from look.packs import installed_walls
from look.screens import connected_screen_walls

HOME = os.path.expanduser("~")
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")
THEMES = os.path.join(HOME, ".config/hyde/themes")
THUMBS = os.path.join(HOME, ".cache/hyde/thumbs")
CACHE = os.path.join(HOME, ".cache/kuwai/themes.json")
LAST = os.path.join(HOME, ".cache/kuwai/themes-list.json")
LIB = os.path.join(HOME, ".local/lib/hyde")
IMG = (".png", ".jpg", ".jpeg", ".webp", ".gif")


def hyde_here() -> bool:
    """HyDE is installed: its scripts are (the same test as hypr/kuwai/core.lua's
    K.hyde, lib/hyde.sh and shell/services/Hyde.qml)."""
    return os.path.isfile(os.path.join(LIB, "globalcontrol.sh"))


def current() -> str:
    try:
        for line in open(os.path.join(HOME, ".local/state/hyde/staterc")):
            if line.startswith("HYDE_THEME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def load_cache() -> dict:
    try:
        return json.load(open(CACHE))
    except (OSError, ValueError):
        return {}


def sha1(path: str, cache: dict) -> str:
    st = os.stat(path)
    key = f"{path}|{st.st_mtime_ns}|{st.st_size}"
    if key not in cache:
        h = hashlib.sha1()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        cache[key] = h.hexdigest()
    return cache[key]


def warm(paths: list, cache: dict) -> None:
    """Hash what the cache doesn't know yet, several at once: a cold listing read 167 MB of
    wallpapers one after another on one core (hashlib lets go of the GIL while it hashes)."""
    todo = []
    for p in paths:
        try:
            st = os.stat(p)
        except OSError:
            continue
        if f"{p}|{st.st_mtime_ns}|{st.st_size}" not in cache:
            todo.append(p)
    if len(todo) < 2:
        return

    def one(p):
        try:
            sha1(p, cache)
        except OSError:
            pass

    from concurrent.futures import ThreadPoolExecutor

    with ThreadPoolExecutor(max_workers=min(8, os.cpu_count() or 2)) as ex:
        list(ex.map(one, todo))


def thumb(path: str, cache: dict) -> str:
    try:
        t = os.path.join(THUMBS, sha1(path, cache) + ".thmb")
    except OSError:
        return ""
    if not os.path.exists(t):
        os.makedirs(THUMBS, exist_ok=True)
        subprocess.run(["magick", path + "[0]", "-strip", "-resize", "1000x562^", "-gravity", "center", "-extent", "1000x562", "png:" + t],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    return t if os.path.exists(t) else path


def colors(theme_dir: str) -> dict:
    out = {}
    try:
        for line in open(os.path.join(theme_dir, "kitty.theme")):
            p = line.split()
            if len(p) >= 2 and p[1].startswith("#"):
                out[p[0]] = p[1]
    except OSError:
        pass
    keys = ["background", "color1", "color3", "color2", "color6", "color4", "color5", "foreground"]
    return {"bg": out.get("background", "#1e1e2e"), "fg": out.get("foreground", "#cdd6f4"),
            "accent": out.get("color4", out.get("active_border_color", "#89b4fa")),
            "palette": [out[k] for k in keys if k in out]}


def dcol(path: str) -> dict:
    """A wallbash palette file (dcol_*="RRGGBB") as a dict."""
    out = {}
    try:
        for line in open(path):
            k, _, v = line.strip().partition("=")
            v = v.strip('"')
            if k.startswith("dcol_") and len(v) == 6:
                out[k[5:]] = "#" + v
            elif k == "dcol_mode":
                out["mode"] = v
    except OSError:
        pass
    return out


def wall_palette(path: str, cache: dict) -> list:
    """The wallpaper's wallbash colours (HyDE caches them per image hash)."""
    try:
        d = dcol(os.path.join(HOME, ".cache/hyde/dcols", sha1(path, cache) + ".dcol"))
    except OSError:
        return []
    keys = ["pry1", "pry2", "1xa7", "2xa7", "3xa7", "4xa7", "pry4", "txt1"]
    return [d[k] for k in keys if k in d]


MODES = ["theme", "auto", "dark", "light"]


def color_mode() -> int:
    try:
        for line in open(os.path.join(HOME, ".local/state/hyde/staterc")):
            if line.startswith("enableWallDcol="):
                return int(line.split("=", 1)[1].strip().strip('"'))
    except (OSError, ValueError):
        pass
    return 0


def listing() -> dict:
    cache = load_cache()
    known = len(cache)
    cur = current()
    themes, walls = [], []
    wd = os.path.join(THEMES, cur, "wallpapers")
    names = sorted(os.listdir(THEMES), key=str.lower) if os.path.isdir(THEMES) else []
    own = sorted(os.listdir(wd)) if os.path.isdir(wd) else []
    warm([os.path.realpath(os.path.join(THEMES, n, "wall.set")) for n in names]
         + [os.path.join(wd, f) for f in own if f.lower().endswith(IMG)], cache)
    for name in names:
        d = os.path.join(THEMES, name)
        wall = os.path.realpath(os.path.join(d, "wall.set"))
        if not os.path.isdir(d) or not os.path.isfile(wall):
            continue
        themes.append({"name": name, "thumb": thumb(wall, cache), "current": name == cur, **colors(d)})
    active = os.path.realpath(os.path.join(HOME, ".cache/hyde/wall.set"))
    if own:
        for f in own:
            p = os.path.join(wd, f)
            if f.lower().endswith(IMG):
                walls.append({"path": p, "name": os.path.splitext(f)[0], "thumb": thumb(p, cache),
                              "current": os.path.realpath(p) == active, "palette": wall_palette(p, cache)})
    native_wall = os.path.join(STATE_HOME, "kuwai", "wallpaper")
    packed = installed_walls(ROOT)
    monitors, screen_walls = connected_screen_walls(STATE_HOME, fallback_wall=active)
    if monitors:
        active = next((m["wallpaper"] for m in monitors if m["focused"]), active)
        for item in walls:
            item["current"] = os.path.realpath(item["path"]) == active
    elif os.path.isfile(native_wall):
        active = os.path.realpath(native_wall)
    for item in packed:
        path = item["path"]
        walls.append({**item, "thumb": thumb(path, cache), "current": path == active, "palette": []})
    if len(cache) != known:
        save(CACHE, json.dumps(cache))
    present = hyde_here()
    return {
        "current": cur,
        "themes": themes,
        "wallpapers": walls,
        "mode": color_mode(),
        "modes": MODES,
        "hyde": present,
        "backend": "themes" if present else "look",
        "monitors": monitors,
        "screenWallpapers": screen_walls,
    }


def photos() -> list:
    cur = current()
    wd = os.path.join(THEMES, cur, "wallpapers") if cur else ""
    try:
        names = sorted(os.listdir(wd), key=str.lower) if wd else []
    except OSError:
        return []
    return [os.path.join(wd, f) for f in names if f.lower().endswith(IMG) and not f.startswith(".")]


def save(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def launch(command, wait=False):
    p = subprocess.Popen(command, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not wait:
        return 0
    try:
        return p.wait(timeout=90)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGTERM)
        try:
            p.wait(timeout=3)
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL)
            p.wait()
        return 124


def bar_after(code, waited):
    """HyDE's theme switch restarts Waybar; kuwai's bar is the island. Put back
    the bar you chose (`kuwai bar apply`: kills Waybar when it's the island), now
    if we waited for the switch, else once it has had time to finish."""
    kuwai = os.path.join(os.path.dirname(os.path.realpath(__file__)), "kuwai")
    if waited:
        subprocess.run([kuwai, "bar", "apply"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(["sh", "-c", 'sleep 3; "$0" bar apply; sleep 7; exec "$0" bar apply', kuwai], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return code


def main(argv):
    wait = "--wait" in argv
    argv = [a for a in argv if a != "--wait"]
    output = None
    if "--output" in argv:
        idx = argv.index("--output")
        if idx + 1 >= len(argv):
            return 2
        output = argv[idx + 1]
        argv = argv[:idx] + argv[idx + 2:]
    cmd = argv[0] if argv else "list"
    needs = {"theme": "theme.switch.sh", "wallpaper": "wallpaper.sh", "colormode": "theme.switch.sh"}.get(cmd)
    if needs and not (cmd == "wallpaper" and output) and not os.path.isfile(os.path.join(LIB, needs)):
        print(f"kuwai-themes: {cmd} switches through HyDE's {needs} ({LIB}), and HyDE isn't installed; nothing changed",
              file=sys.stderr)
        return 3
    if cmd == "list":
        out = json.dumps(listing())
        print(out, flush=True)
        try:
            save(LAST, out)
        except OSError:
            pass
    elif cmd == "photos":
        print(json.dumps(photos()), flush=True)
    elif cmd == "variant" and len(argv) in (2, 4) and argv[1] in ("day", "night") and (len(argv) == 2 or argv[2] == "--boundary"):
        look = os.path.join(ROOT, "bin", "kuwai-look")
        name = current()
        if not name:
            return 1
        os.execv(look, [look, *argv, "--theme", name, "--fetch"])
    elif cmd == "apply-variant" and (len(argv) == 2 or len(argv) == 4 and argv[2] == "--boundary"):
        look = os.path.join(ROOT, "bin", "kuwai-look")
        cm = color_mode()
        mode = MODES[cm] if 0 <= cm < len(MODES) else "theme"
        return launch([look, *argv, "--mode", mode], wait)
    elif cmd == "theme" and len(argv) == 2 and os.path.isdir(os.path.join(THEMES, argv[1])):
        wall = os.path.join(THEMES, argv[1], "wall.set")
        look = os.path.join(ROOT, "bin", "kuwai-look")
        command = [os.path.join(LIB, "theme.switch.sh"), "-s", argv[1]]
        if os.path.isfile(wall):
            command = ["sh", "-c", '"$1" -s "$2" && "$3" record-wallpaper --mode theme "$4"',
                       "kuwai-themes", command[0], argv[1], look, wall]
        return bar_after(launch(command, wait), wait)
    elif cmd == "wallpaper" and len(argv) == 2 and os.path.isfile(argv[1]):
        look = os.path.join(ROOT, "bin", "kuwai-look")
        cm = color_mode()
        mode = MODES[cm] if 0 <= cm < len(MODES) else "theme"
        if output:
            command = [look, "set-wallpaper", "--mode", mode, "--output", output, argv[1]]
            previous = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "hyde", "wall.set")
            if os.path.isfile(previous):
                command += ["--fallback-wall", os.path.realpath(previous)]
            return launch(command, wait)
        run = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(HOME, ".cache")
        script = 'printf "%s" "$3" > "$1.want"; exec 9>"$1"; flock 9; [ "$(cat "$1.want" 2>/dev/null)" = "$3" ] || exit 0; "$2" -s "$3" --global 9>&- || exit $?; if [ "$#" -ge 5 ]; then "$4" record-wallpaper --mode "$5" "$3"; fi'
        return launch(["sh", "-c", script, "kuwai-themes", os.path.join(run, "kuwai-wallpaper.lock"),
                       os.path.join(LIB, "wallpaper.sh"), argv[1], look, mode], wait)
    elif cmd == "colormode" and len(argv) == 2 and argv[1] in MODES:
        script = 'eval "$(hyde-shell init)"; set_conf enableWallDcol "$1"; "$LIB_DIR/hyde/theme.switch.sh"'
        return bar_after(launch(["bash", "-c", script, "kuwai-themes", str(MODES.index(argv[1]))], wait), wait)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
