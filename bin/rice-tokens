#!/usr/bin/env python3
"""Design-token ratchet for the shell (docs/design/STATES.md).

Counts what should come from Theme but is typed by hand:
  sizes      `size:` / `font.pixelSize:` numbers off the type scale
  durations  `duration: <number>` (motion tokens live in Theme)
  hex        raw "#rrggbb" colours outside shell/config

  rice-tokens            print the counts and the baseline
  rice-tokens --check    exit 1 if any count went UP from the baseline
  rice-tokens --update   lower the baseline to today's counts (never raises it)

The baseline is docs/design/tokens-baseline.json. Migrations lower it; new
literals fail rice-check, so the drift can only shrink.
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SHELL = os.path.join(ROOT, "shell")
BASE = os.path.join(ROOT, "docs", "design", "tokens-baseline.json")
SCALE = {10, 11, 12, 13, 14, 15, 18, 20, 24}

SIZE = re.compile(r"\b(?:size|font\.pixelSize)\s*:\s*(\d+)\b")
DUR = re.compile(r"\bduration\s*:\s*\d+\b")
HEX = re.compile(r'"#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?"')


def count():
    c = {"sizes": 0, "durations": 0, "hex": 0}
    for d, _, files in os.walk(SHELL):
        for f in files:
            if not f.endswith(".qml"):
                continue
            p = os.path.join(d, f)
            text = open(p, encoding="utf-8", errors="replace").read()
            code = "\n".join(l.split("//")[0] if not l.lstrip().startswith("//") else "" for l in text.split("\n"))
            c["sizes"] += sum(1 for m in SIZE.finditer(code) if int(m.group(1)) not in SCALE)
            c["durations"] += len(DUR.findall(code))
            if os.sep + "config" + os.sep not in p:
                c["hex"] += len(HEX.findall(code))
    return c


def main():
    now = count()
    try:
        base = json.load(open(BASE))
    except (OSError, ValueError):
        base = {}
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--update" or not base:
        new = {k: min(now[k], base.get(k, now[k])) for k in now}
        os.makedirs(os.path.dirname(BASE), exist_ok=True)
        with open(BASE, "w") as f:
            json.dump(new, f, indent=2)
            f.write("\n")
        print("baseline:", new)
        return 0
    up = {k: (base[k], now[k]) for k in now if k in base and now[k] > base[k]}
    if arg == "--check":
        if up:
            print("; ".join(f"{k} {a} → {b}" for k, (a, b) in up.items()))
            return 1
        down = [k for k in now if k in base and now[k] < base[k]]
        print("tokens: " + ", ".join(f"{k} {now[k]}" for k in now) + (" (lower than the baseline: rice-tokens --update)" if down else ""))
        return 0
    print("now:     ", now)
    print("baseline:", base)
    return 0


if __name__ == "__main__":
    sys.exit(main())
