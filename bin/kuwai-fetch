#!/usr/bin/env bash
set -u

usage() {
cat <<'KUWAI_USAGE'
kuwai-fetch: fastfetch with a moving picture beside it.

  kuwai-fetch              an animated GIF on the left (kitty), the system on the right
  kuwai-fetch NAME         that one (a file name in the folder, without .gif)
  kuwai-fetch --list       what's in the library
  kuwai-fetch --gather     one library for every fetch: ~/Pictures/fetch (text art in ascii/),
                           with ~/.config/fastfetch/logo, neofetch/pngs, neofetch/gifs and
                           kuwai/fetch linked to it (each picture once; the old folders kept)
  kuwai-fetch --greet      the greeting: once per new kitty window, unless one is already on this workspace
  kuwai-fetch --logo       a random picture from ~/.config/fastfetch/logo (fastfetch's own logo)
  kuwai-fetch --get-pokemon N [N…]   (a range 1-151, or random=10)
                           fetch Pokémon N's animated sprite (Gen 5's, else
                           Pokémon Showdown's; the PokeAPI sprites repo on
                           GitHub, the source pocket-dots uses) into the folder. Your
                           download, for your machine: nothing like it ships here.

Pictures: ~/.config/kuwai/fetch, ~/.config/neofetch/gifs and ~/.config/neofetch/pngs
(.gif, .png, .webp). The text: your neofetch layout (neofetch --off) when you
have a neofetch config, else fastfetch's (KUWAI_FETCH_INFO=fastfetch picks it).
Each is scaled once (nearest neighbour for pixel art, transparent background,
full frames so kitty draws no trails) into ~/.cache/kuwai/fetch/.
Outside kitty, or with no pictures: a still picture in blocks (chafa), else
plain fastfetch. Never fails the shell it's greeting: every error is quiet.

The layout technique (info printed indented first, the cursor sent back, the
image placed with `kitten icat`, then below the info) is the one pocket-dots
uses for its pokéfetch; written again here, not copied.
KUWAI_USAGE
}
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
DIR="${KUWAI_FETCH_LIB:-$HOME/Pictures/fetch}"
[ -d "$DIR" ] || DIR="$CFG/kuwai/fetch"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/fetch"
W=${KUWAI_FETCH_W:-200}
H=${KUWAI_FETCH_H:-168}
INDENT=${KUWAI_FETCH_INDENT:-30}

NEO="${XDG_CONFIG_HOME:-$HOME/.config}/neofetch"
pics() {
    find -L "$DIR" "$DIR/ascii" "$CFG/kuwai/fetch" "$NEO/gifs" "$NEO/pngs" -maxdepth 1 -type f \( -iname '*.gif' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.txt' \) 2>/dev/null \
        | while IFS= read -r f; do printf '%s\t%s\n' "$(readlink -f "$f")" "$f"; done | sort -u -t $'\t' -k1,1 | cut -f1
}
gather() {
    local lib=${KUWAI_FETCH_LIB:-$HOME/Pictures/fetch} keep
    keep="${XDG_STATE_HOME:-$HOME/.local/state}/kuwai/fetch-folders-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$lib/ascii"
    declare -A seen=()
    local f sum name
    while IFS= read -r f; do sum=$(md5sum <"$f" | cut -d' ' -f1); seen[$sum]=1; done < <(find "$lib" -maxdepth 2 -type f 2>/dev/null)
    local src dest
    for pair in "$CFG/fastfetch/logo:" "$NEO/pngs:" "$NEO/gifs:" "$CFG/kuwai/fetch:" "$CFG/fastfetch/ascii:ascii"; do
        src=${pair%%:*}; dest=$lib; [ -n "${pair#*:}" ] && dest=$lib/${pair#*:}
        [ -d "$src" ] && [ ! -L "$src" ] || continue
        while IFS= read -r f; do
            sum=$(md5sum <"$f" | cut -d' ' -f1)
            [ -n "${seen[$sum]:-}" ] && continue
            seen[$sum]=1
            name=$(basename "$f")
            [ -e "$dest/$name" ] && name="${name%.*}-$sum.${name##*.}"
            cp -p -- "$f" "$dest/$name"
        done < <(find "$src" -type f \( -iname '*.gif' -o -iname '*.png' -o -iname '*.jpg' -o -iname '*.webp' -o -iname '*.icon' -o -iname '*.txt' \))
        mkdir -p "$keep"
        mv -- "$src" "$keep/$(printf '%s' "${src#"$CFG"/}" | tr / -)"
        ln -s -- "$dest" "$src"
        printf 'linked %s → %s\n' "${src/#$HOME/\~}" "${dest/#$HOME/\~}"
    done
    [ -d "$keep" ] && printf 'the old folders are in %s (delete them once you are happy)\n' "${keep/#$HOME/\~}"
    printf '%s pictures and %s text pictures in %s\n' "$(find "$lib" -maxdepth 1 -type f | wc -l)" "$(find "$lib/ascii" -maxdepth 1 -type f | wc -l)" "${lib/#$HOME/\~}"
}
info() {
    if [ "${KUWAI_FETCH_INFO:-auto}" != fastfetch ] && command -v neofetch >/dev/null && [ -f "$NEO/config.conf" ]; then
        neofetch --off 2>/dev/null | sed -E $'s/\x1b\\[\\?(25|7)[hl]//g'
    else
        fastfetch --logo none --pipe false 2>/dev/null \
            | sed -E 's/ \([0-9]+\) @ [0-9.]+ GHz//; s/ @ [0-9.]+ GHz//; s/ \[(Integrated|Discrete)\]//; s/\((R|TM)\)//g'
    fi
}

case "${1:-}" in
    --list) pics | sed "s|$DIR/||"; exit 0 ;;
    --gather) gather; exit 0 ;;
    --logo)
        mapfile -t logos < <(find -L "${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/logo" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.webp' -o -iname '*.icon' \) 2>/dev/null)
        [ ${#logos[@]} -gt 0 ] && printf '%s\n' "${logos[RANDOM % ${#logos[@]}]}"
        exit 0 ;;
    --get-pokemon)
        shift
        mkdir -p "$DIR"
        nums=()
        for a in "$@"; do
            case "$a" in
                random=*) k=${a#random=}; case "$k" in *[!0-9]*|"") k=6 ;; esac; mapfile -t -O "${#nums[@]}" nums < <(shuf -i 1-1025 -n "$k") ;;
                *-*) lo=${a%-*}; hi=${a#*-}; case "$lo$hi" in *[!0-9]*|"") nums+=("$a") ;; *) mapfile -t -O "${#nums[@]}" nums < <(seq "$lo" "$hi") ;; esac ;;
                *) nums+=("$a") ;;
            esac
        done
        for n in "${nums[@]}"; do
            [ -s "$DIR/pokemon-$n.gif" ] && continue
            case "$n" in *[!0-9]*|"") echo "not a number: $n" >&2; continue ;; esac
            base="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon"
            if curl -fsSL --max-time 20 -o "$DIR/pokemon-$n.gif.part" "$base/versions/generation-v/black-white/animated/$n.gif" \
                || curl -fsSL --max-time 20 -o "$DIR/pokemon-$n.gif.part" "$base/other/showdown/$n.gif"; then
                mv "$DIR/pokemon-$n.gif.part" "$DIR/pokemon-$n.gif"; echo "pokemon-$n"
            else
                rm -f "$DIR/pokemon-$n.gif.part"; echo "couldn't fetch $n (1–1025: Gen 5's animated sprites, else Pokémon Showdown's)" >&2
            fi
        done
        exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --greet)
        [ -n "${KITTY_WINDOW_ID:-}" ] || exit 0
        hypr=""
        [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null && command -v jq >/dev/null && hypr=1
        win=""
        [ -n "$hypr" ] && win=$(hyprctl activewindow -j 2>/dev/null | jq -r 'select(.class == "kitty") | .address' 2>/dev/null)
        mark="${XDG_RUNTIME_DIR:-/tmp}/kuwai/greeted-${win:-${KITTY_PID:-0}}"
        [ -e "$mark" ] && exit 0
        mkdir -p "$(dirname "$mark")" && : >"$mark"
        if [ -n "$hypr" ] && [ -n "$win" ]; then
            ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id' 2>/dev/null)
            others=$(hyprctl clients -j 2>/dev/null | jq --argjson ws "${ws:-0}" --arg win "$win" '[.[] | select(.class == "kitty" and .workspace.id == $ws and .address != $win)] | length' 2>/dev/null)
            [ "${others:-0}" -gt 0 ] && exit 0
        fi
        shift ;;
esac

command -v fastfetch >/dev/null || exit 0
mapfile -t all < <(pics)
pick=""
if [ -n "${1:-}" ]; then
    for p in "${all[@]}"; do case "$(basename "${p%.*}")" in "$1") pick=$p ;; esac; done
elif [ ${#all[@]} -gt 0 ]; then
    pick=${all[RANDOM % ${#all[@]}]}
fi
[ -n "$pick" ] || exec fastfetch
case "$pick" in
    *.txt)
        if [ "${KUWAI_FETCH_INFO:-auto}" != fastfetch ] && command -v neofetch >/dev/null && [ -f "$NEO/config.conf" ]; then
            exec neofetch --ascii "$pick" --ascii_colors 6
        fi
        exec fastfetch --logo-type file --logo "$pick" --logo-color-1 cyan ;;
esac

in_kitty() { [ -n "${KITTY_WINDOW_ID:-}" ] && command -v kitten >/dev/null; }

if ! in_kitty; then
    if command -v chafa >/dev/null; then
        logo=$(chafa -f symbols --symbols block+sextant+half+quad+space --dither none --size 36x18 "$pick" 2>/dev/null | head -n 18)
        [ -n "$logo" ] && exec fastfetch --logo-type data-raw --logo "$logo" --logo-padding-top 1
    fi
    exec fastfetch
fi

mkdir -p "$CACHE"
key=$( { cksum < "$pick"; echo "$W $H"; } | cksum | cut -d' ' -f1)
box="$CACHE/$key.gif"
if [ ! -s "$box" ]; then
    if command -v ffmpeg >/dev/null; then
        ffmpeg -y -loglevel error -i "$pick" -filter_complex \
            "fps=15,scale=w=$W:h=$H:force_original_aspect_ratio=decrease:flags=neighbor,format=rgba,pad=$W:ih:($W-iw)/2:0:color=#00000000,split[a][b];[a]palettegen=reserve_transparent=1[p];[b][p]paletteuse=alpha_threshold=128:diff_mode=none" \
            -gifflags -offsetting "$box.tmp.gif" 2>/dev/null && mv "$box.tmp.gif" "$box"
    elif command -v magick >/dev/null; then
        magick "$pick" -coalesce -filter point -resize "${W}x${H}" "$box" 2>/dev/null
    fi
    [ -s "$box" ] || cp -f "$pick" "$box" 2>/dev/null
fi

mapfile -t info < <(info)
n=${#info[@]}
printf '\0337'
printf '\033[?7l'
for l in "${info[@]}"; do printf '%*s%s\n' "$INDENT" '' "$l"; done
printf '\033[?7h'
printf '\0338\033[1B'
kitten icat --align left --loop -1 "$box" 2>/dev/null
printf '\0338'
rows=$(( (H / 18) + 2 )); [ "$n" -gt "$rows" ] && rows=$n
printf '\033[%dB\n' "$rows"
