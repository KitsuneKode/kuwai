#!/usr/bin/env bash
# rice-check: is the running shell healthy? `rice promote` runs it first.
#
#   rice-check            check the shell running from this copy (or stable)
#   rice-check --quiet    only failures
#   rice-check --soak     the screensaver 10 times (start, 10 s, stop): memory must not
#                         grow more than 25 MB, and it must stay under 5 % CPU while it
#                         plays. It takes the screen and keyboard: run it as you step away.
#   rice-check --shots    also put the island through its states (test hook) and save
#                         the notch of every screen to ~/.cache/rice/shots/<commit>/
#                         (no keyboard-grabbing panel is ever opened)
#
# Checks (docs/ROADMAP.md, Phase 1):
#   load       the shell's last load says "Configuration Loaded", no "caused by" after it
#   orphans    no helper (systemd-inhibit, gdbus monitor, sleep infinity) that isn't
#              a descendant of the running shell: a left-over one blocks idle or sleep
#   idle       exactly one "lock before sleeping" guard while the shell owns idle,
#              and hypridle not running beside it
#   memory     the shell's anonymous memory (Pss_Anon) under RICE_MEM_BUDGET_MB (450)
#   cpu        the shell under 5 % CPU over 3 s at rest
#   compile    every file in modules/ and components/ compiles (panels load on first
#              open, so a broken one would otherwise hide until you open it)
#   tokens     literal font sizes, durations and hex colours never increase
#              (bin/rice-tokens; the baseline only goes down)
# Exit 0 = all good, 1 = something failed (listed).
set -u
QUIET=0; SHOTS=0; SOAK=0
for a in "$@"; do case $a in --quiet) QUIET=1 ;; --shots) SHOTS=1 ;; --soak) SOAK=1 ;; esac; done
BUDGET=${RICE_MEM_BUDGET_MB:-450}
fail=0
ok()   { [ $QUIET = 1 ] || printf '  ✓ %s\n' "$1"; }
bad()  { printf '  ✗ %s\n' "$1"; fail=1; }

pid=$(pgrep -f '^qs -p .*/shell -d$' | head -1)
[ -n "$pid" ] || { bad "no shell running"; exit 1; }
root=$(tr '\0' ' ' < /proc/$pid/cmdline | sed -n 's#^qs -p \(.*\)/shell -d.*#\1#p')
[ $QUIET = 1 ] || echo "rice-check: shell $pid from $root"

# load
log=$(readlink -f /run/user/$(id -u)/quickshell/by-pid/$pid 2>/dev/null)/log.qslog
if [ -r "$log" ]; then
    last=$(strings "$log" | grep -nE "Configuration Loaded|Failed to load configuration" | tail -1)
    case $last in
        *Loaded*) ok "load: configuration loaded" ;;
        *)        bad "load: the last reload failed ($(strings "$log" | grep -m1 -A1 'Failed to load' | tail -1 | cut -c1-120))" ;;
    esac
else
    bad "load: no log for pid $pid"
fi

# orphans
descends() {   # $1 descends from $pid?
    local a=$1
    while [ -n "$a" ] && [ "$a" -gt 1 ] 2>/dev/null; do
        [ "$a" = "$pid" ] && return 0
        a=$(ps -o ppid= -p "$a" 2>/dev/null | tr -d ' ')
    done
    return 1
}
orph=""
for p in $(pgrep -f '^systemd-inhibit .*--who=rice' ; pgrep -f 'gdbus monitor --system --dest org.freedesktop.login1'); do
    descends "$p" || orph="$orph $p"
done
if [ -z "$orph" ]; then ok "orphans: none"; else bad "orphans: helpers left by an earlier shell:$orph (kill them)"; fi

# idle
owner=$(jq -r '.idleOwner // "shell"' "${XDG_CONFIG_HOME:-$HOME/.config}/rice/settings.json" 2>/dev/null)
guards=$(systemd-inhibit --list --no-pager 2>/dev/null | grep -c "Lock the screen before sleeping")
if [ "$owner" = shell ]; then
    [ "$guards" = 1 ] && ok "idle: one sleep guard" || bad "idle: $guards sleep guards (want 1)"
    pgrep -x hypridle >/dev/null && bad "idle: hypridle runs beside the shell's idle" || ok "idle: hypridle off"
else
    ok "idle: handed to hypridle"
fi

# memory
anon=$(awk '/Pss_Anon/ {print int($2/1024)}' /proc/$pid/smaps_rollup 2>/dev/null)
if [ -n "$anon" ] && [ "$anon" -le "$BUDGET" ]; then ok "memory: ${anon} MB (budget $BUDGET)"; else bad "memory: ${anon:-?} MB over the $BUDGET MB budget"; fi

# cpu (3 s)
t0=$(awk '{print $14+$15}' /proc/$pid/stat); sleep 3; t1=$(awk '{print $14+$15}' /proc/$pid/stat)
cpu=$(( (t1 - t0) * 100 / $(getconf CLK_TCK) / 3 ))
[ "$cpu" -lt 5 ] && ok "cpu: ${cpu}% at rest" || bad "cpu: ${cpu}% at rest (want < 5)"

# compile (after memory and cpu: compiling caches types)
broken=""
for f in $(cd "$root/shell" && find modules components -name '*.qml' | sort); do
    r=$(qs ipc -p "$root/shell" call test compile "$f" </dev/null 2>&1)
    [ "$r" = ok ] || broken="$broken
      $f: $(printf '%s' "$r" | head -1 | cut -c1-160)"
done
if [ -z "$broken" ]; then ok "compile: every module and component"; else bad "compile:$broken"; fi

# soak (the screensaver, ten times)
if [ $SOAK = 1 ]; then
    [ $QUIET = 1 ] || echo "  soak: the screensaver 10 × (start, 10 s, stop), ~2.5 min; any key ends it early"
    pss() { awk '/Pss_Anon/ {print int($2/1024)}' /proc/$pid/smaps_rollup; }
    before=$(pss); worst=0; ended=0
    for i in $(seq 1 10); do
        "$root/bin/rice" screensaver start >/dev/null 2>&1
        sleep 2
        t0=$(awk '{print $14+$15}' /proc/$pid/stat); sleep 6; t1=$(awk '{print $14+$15}' /proc/$pid/stat)
        c=$(( (t1 - t0) * 100 / $(getconf CLK_TCK) / 6 )); [ "$c" -gt "$worst" ] && worst=$c
        sleep 2
        "$root/bin/rice" screensaver stop >/dev/null 2>&1
        sleep 3
    done
    sleep 10   # let it settle and free what it let go of
    after=$(pss); grew=$((after - before))
    [ "$grew" -le 25 ] && ok "soak: memory ${before} → ${after} MB over 10 runs" || bad "soak: memory grew ${grew} MB over 10 runs (${before} → ${after})"
    [ "$worst" -lt 5 ] && ok "soak: the shell at ${worst}% CPU at most while it played" || bad "soak: the shell at ${worst}% CPU while it played (want < 5; the decoder is mpv's own)"
fi

# shots
# tokens: hand-typed sizes, durations and colours may only go down (bin/rice-tokens)
RICE_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if out=$("$RICE_ROOT/bin/rice-tokens" --check 2>&1); then ok "$out"; else bad "tokens went up: $out (use Theme tokens)"; fi

if [ $SHOTS = 1 ]; then
    commit=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)
    dir=${XDG_CACHE_HOME:-$HOME/.cache}/rice/shots/$commit
    mkdir -p "$dir"
    T() { qs ipc -p "$root/shell" call test "$@" </dev/null >/dev/null 2>&1; }
    snap() {   # $1 = state name: the top 160 px around the centre of every screen
        sleep "${2:-0.9}"
        hyprctl monitors -j | jq -r '.[] | "\(.name) \(.x) \(.y) \(.width) \(.height) \(.scale)"' |
        while read -r name x y w h sc; do
            lw=$(awk -v w="$w" -v s="$sc" 'BEGIN{printf "%d", w/s}')
            grim -g "$(( x + lw / 2 - 420 )),$y 840x160" "$dir/$1-$name.png" 2>/dev/null
        done
    }
    T clear;                                   snap rest
    T moment focus "Focus" "On";               snap moment
    T clear; T alert warn "CPU at 95 °C";      snap alert-warn
    T alert crit "Battery at 3 %";             snap alert-crit
    T clear; T agents 3 0;                     snap agents-working
    T agents 3 2;                              snap agents-waiting
    T clear; T timer 300 "test pizza";         snap timer
    T clear
    n=$(ls "$dir" | wc -l)
    [ "$n" -gt 0 ] && ok "shots: $n in $dir" || bad "shots: none saved (grim?)"
fi

exit $fail
