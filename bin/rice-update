#!/usr/bin/env python3
"""rice-update: system updates for kuwai's island Updates panel (and anyone else).

    rice-update check                  JSON: repo + AUR updates, Arch news, disk, power
    rice-update review PKG             JSON: what changed in an AUR package's build files since
                                       the version you have installed (a diff, plus lines worth a look)
    rice-update approve PKG SHA        remember that you reviewed PKG at commit SHA
    rice-update trust PKG on|off       skip review for PKG from now on (your call, per package)
    rice-update state                  JSON: approvals and trusted packages
    rice-update start [--repo] [--aur PKG ...] [--flatpak APP ...] [--unreviewed]
                                       (--unreviewed: build the AUR packages' newest commits without a
                                       review, for this run only; you chose it explicitly)
                                       run the update as its own background job (systemd user unit
                                       kuwai-update, sleep/shutdown held off): it keeps going whatever
                                       happens to the shell; follow it in $XDG_RUNTIME_DIR/rice/update.jsonl
    rice-update status                 JSON: {"running": bool}
    rice-update install-helper         install rice-update-root (one password, once): from then on a
                                       whole update asks for your password once, not once per step
    rice-update run [--repo] [--aur PKG ...]
                                       the update itself (what `start` runs): one JSON event per line
                                       (phase, log, progress, error, done) on stdout and in update.jsonl;
                                       the whole log in ~/.local/state/rice/updates/

How it updates (no terminal, no stored passwords, no sudo rules):
  · One password for the whole update: root's part is rice-update-root, started once with pkexec
    (installed root-owned by `install-helper`; it only runs pacman). Without it, each root step
    asks on its own (`pkexec pacman …`), as before.
  · Arch's packages update together: `pacman -Syu --noconfirm` (pacman's defaults answer its
    questions, and the risky ones default to "no", so a conflict stops it instead of guessing).
    Never per-package: Arch doesn't support partial upgrades. Build dependencies the AUR packages
    need come after, marked as dependencies (`--asdeps`), so they can be cleaned up as orphans.
  · AUR packages are built as you with makepkg, from the exact commit you approved (or the newest
    one for packages you trust), in ~/.cache/rice/aur/PKG, never as root; then all of them install
    with one `pacman -U`. A package that changed after you reviewed it is not built.
  · Tests (checkdepends) run when their dependencies come from Arch's repos; when one is only in
    the AUR, the build skips the tests (`--nocheck`) instead of the whole package.
  · A package that needs another AUR package to build or run, or a PGP key, is left for the
    terminal (paru) and says so; nothing is half-done silently.
"""
import fcntl
import json
import os
import signal
import re
import shutil
import subprocess
import sys
import time
import urllib.request
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "rice")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "rice")
AUR_DIR = os.path.join(CACHE, "aur")
APPROVED = os.path.join(STATE, "aur-approved.json")
TRUSTED = os.path.join(STATE, "aur-trusted.json")
LOG_DIR = os.path.join(STATE, "updates")
NEWS_URL = "https://archlinux.org/feeds/news/"
AUR_GIT = "https://aur.archlinux.org/{}.git"
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "rice")
EVENTS = os.path.join(RUNTIME, "update.jsonl")
LOCK = os.path.join(RUNTIME, "update.lock")
UNIT = "kuwai-update"
HELPER = "/usr/local/lib/kuwai/rice-update-root"
HELPER_SRC = os.path.join(os.path.dirname(os.path.realpath(__file__)), "rice-update-root")
FLATPAK_TARGET = re.compile(r"^(?:(user|system):)?([A-Za-z0-9][A-Za-z0-9._/-]*)$")
NAME_OK = re.compile(r"^[a-z0-9@._+-]+$")
SHA_OK = re.compile(r"^[0-9a-f]{40}$")


# ── small helpers ────────────────────────────────────────────────────────────
def sh(cmd, **kw):
    return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, **kw)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


def valid_name(p):
    if not NAME_OK.match(p or ""):
        raise SystemExit(f"rice-update: not a package name: {p!r}")
    return p


def git(d, *args, check=False):
    r = sh(["git", "-C", d, *args])
    if check and r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"git {' '.join(args)} failed")
    return r


# ── check ────────────────────────────────────────────────────────────────────
LINE = re.compile(r"^(\S+)\s+(\S+)\s+->\s+(\S+)")


def parse_updates(text, repo):
    out = []
    for l in text.splitlines():
        m = LINE.match(l.strip())
        if m:
            out.append({"name": m[1], "old": m[2], "new": m[3], "repo": repo})
    return out


def repo_of(names):
    """Which repository each package comes from (core/extra/multilib…), in one pacman call."""
    if not names:
        return {}
    r = sh(["pacman", "-Si", *names])
    repo, name, out = None, None, {}
    for l in r.stdout.splitlines():
        if l.startswith("Repository"):
            repo = l.split(":", 1)[1].strip()
        elif l.startswith("Name"):
            name = l.split(":", 1)[1].strip()
            if repo:
                out[name] = repo
    return out


def last_upgrade():
    """When the last full system upgrade started (pacman.log), as epoch seconds."""
    try:
        with open("/var/log/pacman.log", "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 2_000_000))
            tail = f.read().decode(errors="replace")
    except OSError:
        return 0
    stamps = re.findall(r"^\[([0-9T:+-]+)\] \[PACMAN\] starting full system upgrade", tail, re.M)
    if not stamps:
        return 0
    s = stamps[-1]
    try:
        return int(time.mktime(time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S")))
    except ValueError:
        return 0


def news(since):
    """Arch news posted since your last upgrade: the ones that ask for a manual step matter."""
    try:
        req = urllib.request.Request(NEWS_URL, headers={"User-Agent": "kuwai-rice-update"})
        with urllib.request.urlopen(req, timeout=6) as r:
            root = ET.fromstring(r.read())
    except Exception:
        return None
    out = []
    for it in root.iter("item"):
        title = (it.findtext("title") or "").strip()
        link = (it.findtext("link") or "").strip()
        date = it.findtext("pubDate") or ""
        try:
            ts = int(time.mktime(time.strptime(date[:25].strip(), "%a, %d %b %Y %H:%M:%S")))
        except ValueError:
            ts = 0
        if since and ts and ts < since - 86400:
            continue
        desc = re.sub(r"<[^>]+>", " ", it.findtext("description") or "")
        desc = re.sub(r"\s+", " ", desc).strip()
        manual = bool(re.search(r"manual intervention|requires? (?:manual|user) action|before upgrading|--overwrite", title + " " + desc, re.I))
        out.append({"title": title, "link": link, "date": ts, "manual": manual, "summary": desc[:400]})
    return out[:6]


def check():
    repo_run = sh(["checkupdates", "--nocolor"])
    repo = parse_updates(repo_run.stdout, "")
    repos = repo_of([p["name"] for p in repo])
    for p in repo:
        p["repo"] = repos.get(p["name"], "")
    aur = []
    if shutil.which("paru"):
        aur = parse_updates(sh(["paru", "-Qua"]).stdout, "aur")
    trusted = set(load(TRUSTED, []))
    approved = load(APPROVED, {})
    community = aur_info([p["name"] for p in aur])
    for p in aur:
        p["trusted"] = p["name"] in trusted
        p["approved"] = approved.get(p["name"], "")
        p["community"] = community.get(p["name"])
    since = last_upgrade()
    st = os.statvfs("/")
    free = st.f_bavail * st.f_frsize
    power = {"ac": True, "battery": None}
    for d in os.listdir("/sys/class/power_supply") if os.path.isdir("/sys/class/power_supply") else []:
        base = os.path.join("/sys/class/power_supply", d)
        try:
            kind = open(os.path.join(base, "type")).read().strip()
            if kind == "Mains":
                power["ac"] = open(os.path.join(base, "online")).read().strip() == "1"
            elif kind == "Battery":
                power["battery"] = int(open(os.path.join(base, "capacity")).read().strip())
        except (OSError, ValueError):
            pass
    flatpak = flatpak_updates()
    kernel = any(re.match(r"^linux(-zen|-lts|-hardened|-rt)?$", p["name"]) for p in repo)
    return {
        "checkedAt": int(time.time()),
        "repo": repo,
        "aur": aur,
        "repoError": repo_run.returncode not in (0, 2) and (repo_run.stderr.strip() or "checkupdates failed"),
        "lastUpgrade": since,
        "news": news(since),
        "freeBytes": free,
        "power": power,
        "kernel": kernel,
        "flatpak": flatpak,
    }


def flatpak_updates():
    """Flatpak apps and runtimes with updates (sandboxed and signed: each can
    update on its own, no review needed), from your own installation and the
    system-wide one. `id` is what `run --flatpak` takes: "user:app/ID/arch/branch".
    (remote-ls has no "installation" column: ask each installation in turn.)"""
    if not shutil.which("flatpak"):
        return []
    out = []
    for inst in ("user", "system"):
        r = sh(["flatpak", "remote-ls", f"--{inst}", "--updates", "--columns=ref,application,version,origin"], timeout=60)
        if r.returncode != 0:
            continue
        have = {}
        for l in sh(["flatpak", "list", f"--{inst}", "--columns=ref,name,version"]).stdout.splitlines():
            p = l.split("\t")
            if len(p) >= 3:
                have[p[0]] = (p[1], p[2])
        for l in r.stdout.splitlines():
            p = l.split("\t")
            if len(p) < 4 or not FLATPAK_TARGET.match(p[0]):
                continue
            ref, app = p[0], p[1]
            # `list` shows refs without the app/ or runtime/ that `remote-ls` puts first.
            name, old = have.get(ref.split("/", 1)[-1], (app.split(".")[-1], ""))
            out.append({"id": f"{inst}:{ref}", "app": app, "name": name, "old": old, "new": p[2] or "newer build",
                        "origin": p[3], "install": inst, "runtime": ref.startswith("runtime/")})
    return out


# ── AUR community standing ──────────────────────────────────────────────────
AUR_RPC = "https://aur.archlinux.org/rpc/v5/info"


def aur_info(names):
    """The AUR's own facts about packages (one request): votes, popularity,
    maintainer, age, out-of-date flag. `established` is the bar for
    approving routine bumps by themselves: widely used (≥ 100 votes or
    popularity ≥ 2), maintained, not flagged out of date, a year old or more.
    It says the package is established, not that a new upstream release is
    safe; for -bin packages the program itself is never reviewed."""
    names = [n for n in names if NAME_OK.match(n)]
    if not names:
        return {}
    q = "&".join("arg[]=" + urllib.request.quote(n) for n in names)
    try:
        req = urllib.request.Request(f"{AUR_RPC}?{q}", headers={"User-Agent": "kuwai-rice-update"})
        with urllib.request.urlopen(req, timeout=8) as r:
            res = json.load(r).get("results", [])
    except Exception:
        return {}
    now = time.time()
    out = {}
    for p in res:
        votes = p.get("NumVotes") or 0
        pop = p.get("Popularity") or 0
        first = p.get("FirstSubmitted") or now
        info = {
            "votes": votes, "popularity": round(pop, 2), "maintainer": p.get("Maintainer"),
            "firstSubmitted": first, "lastModified": p.get("LastModified"), "outOfDate": p.get("OutOfDate"),
            "url": p.get("URL") or "", "binary": p.get("PackageBase", p.get("Name", "")).endswith("-bin"),
        }
        info["established"] = bool((votes >= 100 or pop >= 2) and info["maintainer"] and not info["outOfDate"]
                                   and now - first > 365 * 86400)
        out[p.get("Name")] = info
    return out


# ── AUR review ───────────────────────────────────────────────────────────────
def clone(pkg):
    d = os.path.join(AUR_DIR, pkg)
    if not os.path.isdir(os.path.join(d, ".git")):
        os.makedirs(AUR_DIR, exist_ok=True)
        r = sh(["git", "clone", "-q", "--no-checkout", AUR_GIT.format(pkg), d], timeout=90)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or "clone failed")
    else:
        git(d, "fetch", "-q", "origin", check=True)
    head = git(d, "rev-parse", "origin/HEAD").stdout.strip() or git(d, "rev-parse", "origin/master").stdout.strip()
    if not SHA_OK.match(head):
        raise RuntimeError("no upstream commit")
    return d, head


def installed_version(pkg):
    r = sh(["pacman", "-Q", pkg])
    return r.stdout.split()[1] if r.returncode == 0 and len(r.stdout.split()) == 2 else ""


def baseline(d, pkg, head):
    """The commit that built what you have installed: the newest one whose .SRCINFO has your
    version (pkgver-pkgrel, epoch-aware). Falls back to the last commit we installed."""
    mark = git(d, "rev-parse", "-q", "--verify", "refs/rice/installed").stdout.strip()
    have = installed_version(pkg)
    if have:
        epoch, _, rest = have.rpartition(":")
        ver, _, rel = rest.rpartition("-")
        commits = git(d, "log", "--format=%H", "-n", "80", head, "--", ".SRCINFO").stdout.split()
        for c in commits:
            si = git(d, "show", f"{c}:.SRCINFO").stdout
            if (re.search(rf"^\s*pkgver = {re.escape(ver)}\s*$", si, re.M)
                    and re.search(rf"^\s*pkgrel = {re.escape(rel)}\s*$", si, re.M)
                    and (not epoch or re.search(rf"^\s*epoch = {re.escape(epoch)}\s*$", si, re.M))):
                return c
    return mark if SHA_OK.match(mark) else ""


FLAGS = [
    (r"\b(curl|wget)\b.*\|\s*(ba|z)?sh\b", "downloads and runs a script"),
    (r"\b(curl|wget|aria2c)\b", "downloads something during the build"),
    (r"\bbase64\s+(-d|--decode)\b|\bxxd\s+-r\b", "decodes hidden content"),
    (r"\beval\b", "evaluates generated code"),
    (r"\bsudo\b|\bpkexec\b|\bdoas\b", "asks for root inside the build"),
    (r"/dev/tcp/|\bnc\b\s+-|\bsocat\b", "opens a network connection"),
    (r"\bchmod\s+[0-7]*[4-7][0-7]{2}\b.*/usr|\bchmod\s+[ug]\+s\b|\bsetcap\b", "changes permissions or capabilities"),
    (r"systemctl\s+(--global\s+)?enable", "enables a service"),
    (r"\brm\s+-r?f?\s+(/(\s|$)|\$HOME|~/)", "deletes outside its build folder"),
    (r"'SKIP'|\"SKIP\"", "skips checksum verification"),
    (r"^\s*(source|source_\w+)\s*\+?=", "changes where sources come from"),
    (r"^\s*(sha\d+sums|b2sums|md5sums)", "changes checksums"),
    (r"^\s*validpgpkeys", "changes the trusted signing keys"),
    (r"\.install\b|^\s*install\s*=", "runs a script at install time"),
]


def review(pkg):
    valid_name(pkg)
    d, head = clone(pkg)
    base = baseline(d, pkg, head)
    files = []
    flags = []
    if base:
        diff = git(d, "diff", "--no-color", "-U3", "--no-renames", base, head, "--", ".", ":(exclude).SRCINFO").stdout
    else:
        # First time we see it: show every file as new (empty tree → head).
        empty = git(d, "hash-object", "-t", "tree", "/dev/null").stdout.strip()
        diff = git(d, "diff", "--no-color", "-U3", empty, head, "--", ".", ":(exclude).SRCINFO").stdout
    cur = None
    hunk = None
    o = n = 0
    for l in diff.splitlines():
        if l.startswith("diff --git "):
            path = l.split(" b/", 1)[-1]
            cur = {"path": path, "status": "modified", "add": 0, "del": 0, "hunks": [], "binary": False}
            files.append(cur)
            hunk = None
        elif cur is None:
            continue
        elif l.startswith("new file"):
            cur["status"] = "added"
        elif l.startswith("deleted file"):
            cur["status"] = "deleted"
        elif l.startswith("Binary files"):
            cur["binary"] = True
        elif l.startswith("@@"):
            m = re.match(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@(.*)", l)
            o, n = (int(m[1]), int(m[2])) if m else (0, 0)
            hunk = {"header": l, "context": (m[3].strip() if m else ""), "lines": []}
            cur["hunks"].append(hunk)
        elif hunk is not None and l[:1] in "+- " and not l.startswith(("+++", "---")):
            t = l[:1]
            text = l[1:]
            row = {"t": t, "o": o if t != "+" else None, "n": n if t != "-" else None, "s": text}
            if t != "+":
                o += 1
            if t != "-":
                n += 1
            if t == "+":
                cur["add"] += 1
            elif t == "-":
                cur["del"] += 1
            hunk["lines"].append(row)
    head_si = git(d, "show", f"{head}:.SRCINFO").stdout
    ver = re.search(r"^\s*pkgver = (.+)$", head_si, re.M)
    rel = re.search(r"^\s*pkgrel = (.+)$", head_si, re.M)

    # A version bump rewrites the version, checksums and download links; that's
    # routine. A line is routine when, with versions and hashes blanked out, it
    # matches a line it replaced. Only the rest is flagged.
    vers = set()
    have = installed_version(pkg)
    if have:
        vers.add(have.rpartition(":")[2].rpartition("-")[0])
    if ver:
        vers.add(ver[1].strip())
    if base:
        bsi = git(d, "show", f"{base}:.SRCINFO").stdout
        bv = re.search(r"^\s*pkgver = (.+)$", bsi, re.M)
        if bv:
            vers.add(bv[1].strip())
    vers = sorted((v for v in vers if v), key=len, reverse=True)

    def norm(x):
        x = x.strip()
        for v in vers:
            x = x.replace(v, "{V}")
        x = re.sub(r"\b[0-9a-f]{32,}\b", "{H}", x)
        x = re.sub(r"^(pkgrel|epoch)\s*=\s*\S+", r"\1={R}", x)
        x = re.sub(r"\b\d+(\.\d+){1,3}\b", "{N}", x)
        return x

    routine = True
    for f in files:
        removed = {norm(r["s"]) for h in f["hunks"] for r in h["lines"] if r["t"] == "-"}
        for h in f["hunks"]:
            for r in h["lines"]:
                if r["t"] != "+":
                    continue
                if base and norm(r["s"]) in removed:
                    r["routine"] = True
                    continue
                if r["s"].strip() and not r["s"].strip().startswith("#"):
                    routine = False
                for rx, why in FLAGS:
                    if re.search(rx, r["s"]):
                        flags.append({"path": f["path"], "line": r["n"], "text": r["s"].strip()[:160], "why": why})
                        break
    log = git(d, "log", "--format=%h%x09%an%x09%ar%x09%s", f"{base}..{head}" if base else head, "-n", "12").stdout
    commits = [dict(zip(("sha", "author", "when", "subject"), c.split("\t", 3))) for c in log.splitlines() if c.count("\t") >= 3]
    return {
        "pkg": pkg,
        "base": base,
        "head": head,
        "firstTime": not base,
        "routine": bool(base) and routine,
        "installed": installed_version(pkg),
        "next": f"{ver[1].strip()}-{rel[1].strip()}" if ver and rel else "",
        "files": files,
        "flags": flags,
        "commits": commits,
        "url": f"https://aur.archlinux.org/cgit/aur.git/log/?h={pkg}",
        "approved": load(APPROVED, {}).get(pkg, "") == head,
        "community": aur_info([pkg]).get(pkg),
        "trusted": pkg in load(TRUSTED, []),
    }


# ── run ──────────────────────────────────────────────────────────────────────
class Run:
    def __init__(self):
        os.makedirs(LOG_DIR, exist_ok=True)
        os.makedirs(RUNTIME, exist_ok=True)
        self.events = open(EVENTS, "w", buffering=1)
        self.path = os.path.join(LOG_DIR, time.strftime("%Y-%m-%d_%H%M%S") + ".log")
        self.log = open(self.path, "w", buffering=1)
        link = os.path.join(LOG_DIR, "last.log")
        try:
            if os.path.lexists(link):
                os.remove(link)
            os.symlink(os.path.basename(self.path), link)
        except OSError:
            pass
        # Keep the ten newest logs.
        logs = sorted(f for f in os.listdir(LOG_DIR) if f.endswith(".log") and f != "last.log")
        for f in logs[:-10]:
            try:
                os.remove(os.path.join(LOG_DIR, f))
            except OSError:
                pass

    def emit(self, **ev):
        line = json.dumps(ev)
        self.events.write(line + "\n")
        try:
            print(line, flush=True)
        except (BrokenPipeError, OSError):
            pass  # nobody listening on stdout: the events file still has it
        if ev.get("e") == "log":
            self.log.write(ev["line"] + "\n")
        elif ev.get("e") in ("phase", "error", "done"):
            self.log.write(f"## {ev.get('label') or ev.get('msg') or ev.get('e')}\n")

    def stream(self, cmd, cwd=None, progress=None):
        """Run cmd, forward each output line, report pacman's (k/n) as progress.

        The command writes to a file, not a pipe: if this process dies, pacman
        (running as root under pkexec) still has somewhere to write and finishes
        its transaction instead of dying of a broken pipe halfway."""
        self.log.write("$ " + " ".join(cmd) + "\n")
        out = os.path.join(RUNTIME, "update-step.out")
        with open(out, "w") as w:
            p = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=w, stderr=subprocess.STDOUT,
                                 env={**os.environ, "LC_ALL": "C", "PACMAN_COLOR": "never"}, start_new_session=True)
        pending = ""
        shown = ""
        with open(out, newline="") as r:   # keep \r: progress redraws are handled below
            while True:
                chunk = r.read()
                if chunk:
                    pending += ANSI.sub("", chunk)
                    *lines, pending = pending.split("\n")
                    for line in lines:
                        # A progress bar redrawn with \r (flatpak, curl): the log
                        # keeps the line's final state, not every redraw.
                        self.line(line.split("\r")[-1] if "\r" in line.rstrip("\r") else line, progress)
                    # Still drawing (no newline yet): show where it is now.
                    now = pending.rstrip("\r").split("\r")[-1].strip()
                    if now and now != shown:
                        shown = now
                        self.emit(e="status", line=now)
                elif p.poll() is not None:
                    last = pending.rstrip("\r").split("\r")[-1].strip()
                    if last:
                        self.emit(e="log", line=last)
                    return p.returncode
                else:
                    time.sleep(0.1)

    def line(self, line, progress=None):
        """One line of a command's output: logged, and pacman's (k/n) as progress."""
        line = line.rstrip("\r")
        if not line.strip():
            return
        self.emit(e="log", line=line)
        m = re.match(r"^\(\s*(\d+)/(\d+)\)\s+(\S+)\s+(\S+)", line)
        if m and progress:
            self.emit(e="progress", phase=progress, k=int(m[1]), n=int(m[2]), what=f"{m[3]} {m[4]}")


AUTH_FAIL = (126, 127)
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07")


def helper_ok():
    """rice-update-root is installed where root alone can change it, and is this version."""
    try:
        for p in (HELPER, os.path.dirname(HELPER)):
            st = os.stat(p)
            if st.st_uid != 0 or st.st_mode & 0o022:
                return False
        with open(HELPER, "rb") as a, open(HELPER_SRC, "rb") as b:
            return a.read() == b.read()
    except OSError:
        return False


class Root:
    """Root's part of a run. With rice-update-root installed: one pkexec (one password) for the
    whole run, opened up front so the prompt comes before the builds, not after them. Without
    it: one pkexec per step, as before."""

    def __init__(self, R):
        self.R = R
        self.p = None
        self.prompts = 0
        # The helper is used whenever its source is here: not installed yet (or
        # out of date), the same password installs it and starts it, so even the
        # first run asks once (it used to be once per step until `install-helper`).
        self.helper = os.path.isfile(HELPER_SRC)

    def open(self):
        """0 once root is there; pkexec's code (126/127: cancelled) when it isn't."""
        if not self.helper or self.p:
            return 0
        self.prompts += 1
        if helper_ok():
            cmd = ["pkexec", HELPER]
        else:
            # Copied to a root-owned place first, then run from there (never from
            # your home folder, which anything running as you could rewrite).
            self.R.emit(e="log", line="Setting up one-password updates (rice-update-root)")
            cmd = ["pkexec", "/bin/sh", "-c", 'umask 022 && /usr/bin/install -D -o root -g root -m 0755 -- "$1" "$2" && exec "$2"',
                   "sh", HELPER_SRC, HELPER]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        hello = self.p.stdout.readline()
        if '"ready"' not in hello:
            rc = self.p.wait()
            self.p = None
            return rc or 127
        return 0

    def run(self, op, progress=None, deps=(), files=()):
        if not self.helper:
            self.prompts += 1
            if op == "upgrade" and deps:
                # One prompt for both: the upgrade, then the build deps marked as deps.
                script = '/usr/bin/pacman -Syu --noconfirm --needed && /usr/bin/pacman -S --noconfirm --needed --asdeps -- "$@"'
                return self.R.stream(["pkexec", "/bin/sh", "-c", script, "sh", *deps], progress=progress)
            cmd = {"upgrade": ["-Syu", "--noconfirm", "--needed"],
                   "deps": ["-S", "--noconfirm", "--needed", "--asdeps", "--", *deps],
                   "install": ["-U", "--noconfirm", "--needed", "--", *files]}[op]
            return self.R.stream(["pkexec", "pacman", *cmd], progress=progress)
        rc = self.open()
        if rc:
            return rc
        self.R.log.write(f"$ (root) pacman {op} {' '.join([*deps, *files])}\n")
        try:
            self.p.stdin.write(json.dumps({"op": op, "deps": list(deps), "files": list(files)}) + "\n")
            self.p.stdin.flush()
            for raw in self.p.stdout:
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue
                if "log" in msg:
                    self.R.line(msg["log"], progress)
                elif "rc" in msg:
                    return msg["rc"]
        except (BrokenPipeError, OSError):
            pass
        self.R.emit(e="log", line="rice-update-root stopped unexpectedly")
        self.p = None
        return 1

    def close(self):
        if self.p:
            try:
                self.p.stdin.close()
                self.p.wait(timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                pass
            self.p = None


def missing_deps(d):
    """What a build still needs, split by where it comes from: (from Arch's repos, only in the
    AUR, run tests). The package's own names (a split package's parts depend on each other)
    don't count. Tests run only when everything they need comes from the repos."""
    si = sh(["makepkg", "--printsrcinfo"], cwd=d).stdout
    own = set(re.findall(r"^pkgname = (\S+)$", si, re.M))

    def missing(kinds):
        deps = re.findall(rf"^\s*(?:{kinds})(?:_\w+)? = (.+)$", si, re.M)
        deps = [x for x in deps if re.split(r"[<>=]", x)[0] not in own]
        if not deps:
            return [], []
        miss = [x for x in sh(["pacman", "-T", *deps]).stdout.split() if x]
        names = sorted({re.split(r"[<>=]", x)[0] for x in miss})
        in_repo = [x for x in names if sh(["pacman", "-Si", x]).returncode == 0]
        return in_repo, [x for x in names if x not in in_repo]

    in_repo, aur_only = missing("depends|makedepends")
    check_repo, check_aur = missing("checkdepends")
    if check_aur:
        return in_repo, aur_only, False   # tests skipped: what they need is only in the AUR
    return sorted(set(in_repo + check_repo)), aur_only, True


def run(args):
    # Nothing outside should stop it halfway: a closed terminal or pipe is ignored.
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    os.makedirs(RUNTIME, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        # Another update holds it (sysup in a terminal, an earlier start):
        # wait for it instead of failing every step as "skipped"; then this
        # one runs (what's left to do is checked afresh below).
        print(json.dumps({"e": "status", "line": "Waiting for the update that's already running…"}), flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
    want_repo = "--repo" in args
    unreviewed = "--unreviewed" in args
    def after(flag):
        if flag not in args:
            return []
        out = []
        for a in args[args.index(flag) + 1:]:
            if a.startswith("--"):
                break
            out.append(a)
        return out
    aur = [valid_name(a) for a in after("--aur")]
    flatpaks = [a for a in after("--flatpak") if FLATPAK_TARGET.match(a)]
    R = Run()
    approved = load(APPROVED, {})
    trusted = set(load(TRUSTED, []))
    result = {"ok": True, "repo": None, "built": [], "skipped": [], "installed": [], "log": R.path}

    # The plan first: a shell that joins mid-run (a restart, the panel opened
    # later) reads it from the top of the feed, so its progress ring is scaled
    # to what this run will do (it assumed "repo only" and sat at 97 % through
    # every AUR build).
    R.emit(e="plan", repo=want_repo, aur=aur, flatpak=flatpaks)
    # Pre-flight
    R.emit(e="phase", id="check", label="Checking space and power")
    st = os.statvfs("/")
    if st.f_bavail * st.f_frsize < 3 * 1024 ** 3:
        R.emit(e="error", msg="Less than 3 GB free on /. Free some space first.")
        R.emit(e="done", **{**result, "ok": False})
        return 1

    # Prepare AUR packages first (no root): fetch, verify the reviewed commit, find deps.
    plan = []
    extra_repo_deps = []
    for pkg in aur:
        try:
            d, head = clone(pkg)
        except Exception as ex:
            result["skipped"].append({"pkg": pkg, "why": f"couldn't fetch it: {ex}"})
            continue
        # --unreviewed: you chose "update everything now" for this run.
        want = head if (pkg in trusted or unreviewed) else approved.get(pkg, "")
        if want != head:
            result["skipped"].append({"pkg": pkg, "why": "it changed after you reviewed it: review it again" if want else "not reviewed"})
            continue
        git(d, "checkout", "-q", "--force", "--detach", head)
        git(d, "clean", "-qfdx", "-e", "src", "-e", "pkg")
        in_repo, aur_only, tests = missing_deps(d)
        if aur_only:
            result["skipped"].append({"pkg": pkg, "why": "needs AUR packages first (" + ", ".join(aur_only) + "): update it in the terminal with paru"})
            continue
        extra_repo_deps += in_repo
        plan.append((pkg, d, head, tests))
    extra_repo_deps = sorted(set(extra_repo_deps))

    # Root, once (rice-update-root installed): the password now, before the builds.
    root = Root(R)
    result["oneprompt"] = root.helper
    if root.helper and (want_repo or extra_repo_deps or plan):
        rc = root.open()
        if rc:
            R.emit(e="error", msg="Cancelled at the password prompt. Nothing was changed.")
            R.emit(e="done", **{**result, "ok": False, "cancelled": True})
            return 1

    # 1. Arch's packages, together; then the repo deps the AUR builds need, as deps.
    if want_repo or extra_repo_deps:
        R.emit(e="phase", id="repo", label="Updating Arch packages" if want_repo else "Installing build dependencies")
        rc = root.run("upgrade" if want_repo else "deps", progress="repo", deps=extra_repo_deps)
        if rc in AUTH_FAIL:
            R.emit(e="error", msg="Cancelled at the password prompt. Nothing was changed.")
            R.emit(e="done", **{**result, "ok": False, "cancelled": True})
            return 1
        if rc != 0:
            R.emit(e="error", msg="pacman stopped (see the log). Nothing was half-installed: pacman applies a transaction whole or not at all.")
            R.emit(e="done", **{**result, "ok": False, "repo": False})
            return 1
        result["repo"] = True

    # 2. AUR builds, as you.
    built = []
    for i, (pkg, d, head, tests) in enumerate(plan, 1):
        R.emit(e="phase", id="build", label=f"Building {pkg}", k=i, n=len(plan))
        if not tests:
            R.emit(e="log", line=f"{pkg}: its tests need AUR packages; building without them (--nocheck)")
        rc = R.stream(["makepkg", "-f", "--noconfirm", "--noprogressbar", *([] if tests else ["--nocheck"])], cwd=d)
        if rc != 0:
            why = "build failed (see the log)"
            if rc == 13:
                why = "already built"
            result["skipped"].append({"pkg": pkg, "why": why})
            continue
        files = [f for f in sh(["makepkg", "--packagelist"], cwd=d).stdout.split() if os.path.exists(f)]
        if not files:
            result["skipped"].append({"pkg": pkg, "why": "no package came out of the build"})
            continue
        built.append((pkg, d, head, files))
        result["built"].append(pkg)

    # 3. Install them all with one prompt.
    if built:
        R.emit(e="phase", id="install", label=f"Installing {len(built)} AUR package" + ("s" if len(built) > 1 else ""))
        files = [f for b in built for f in b[3]]
        rc = root.run("install", progress="install", files=files)
        if rc in AUTH_FAIL:
            R.emit(e="error", msg="Cancelled at the password prompt; the AUR packages are built but not installed.")
            result["ok"] = False
        elif rc != 0:
            R.emit(e="error", msg="Installing the AUR packages failed (see the log).")
            result["ok"] = False
        else:
            for pkg, d, head, _ in built:
                git(d, "update-ref", "refs/rice/installed", head)
                result["installed"].append(pkg)
                approved.pop(pkg, None)
            save(APPROVED, approved)
    root.close()
    result["prompts"] = root.prompts

    # 4. Flatpak (yours: no password; system-wide ones ask through polkit), one
    # flatpak call per installation ("user:app/ID/arch/branch"; a bare ID from an
    # older check: whichever installation has it).
    if flatpaks:
        R.emit(e="phase", id="flatpak", label=f"Updating {len(flatpaks)} Flatpak item" + ("s" if len(flatpaks) > 1 else ""))
        groups = {}
        for t in flatpaks:
            m = FLATPAK_TARGET.match(t)
            groups.setdefault(m[1] or "", []).append(m[2])
        rc = 0
        for inst, refs in groups.items():
            rc |= R.stream(["flatpak", "update", *([f"--{inst}"] if inst else []), "-y", "--noninteractive", *refs], progress="flatpak")
        result["flatpak"] = rc == 0
        if rc != 0:
            R.emit(e="error", msg="Some Flatpak updates didn't install (see the log).")
            result["ok"] = False

    # 5. What needs your attention afterwards.
    R.emit(e="phase", id="after", label="Finishing")
    running = os.uname().release
    result["restart"] = not os.path.isdir(f"/usr/lib/modules/{running}")
    pac = sh(["pacdiff", "-o"]).stdout.split() if shutil.which("pacdiff") else []
    result["pacnew"] = pac[:20]
    failed = sh(["systemctl", "--failed", "--no-legend", "--plain"]).stdout
    result["failedUnits"] = [l.split()[0] for l in failed.splitlines() if l.strip()][:10]
    if result["skipped"]:
        result["ok"] = False if not (result["repo"] or result["installed"]) else result["ok"]
    R.emit(e="done", **result)
    return 0 if result["ok"] else 1


def main(argv):
    cmd = argv[0] if argv else "check"
    try:
        if cmd == "check":
            data = check()
            save(os.path.join(CACHE, "updates.json"), data)
            print(json.dumps(data))
        elif cmd == "review" and len(argv) == 2:
            print(json.dumps(review(argv[1])))
        elif cmd == "approve" and len(argv) == 3 and SHA_OK.match(argv[2]):
            a = load(APPROVED, {})
            a[valid_name(argv[1])] = argv[2]
            save(APPROVED, a)
        elif cmd == "trust" and len(argv) == 3 and argv[2] in ("on", "off"):
            t = set(load(TRUSTED, []))
            (t.add if argv[2] == "on" else t.discard)(valid_name(argv[1]))
            save(TRUSTED, sorted(t))
        elif cmd == "state":
            print(json.dumps({"approved": load(APPROVED, {}), "trusted": load(TRUSTED, [])}))
        elif cmd == "run":
            return run(argv[1:])
        elif cmd == "install-helper":
            # Root-owned, outside your home, so nothing running as you can change what runs as root.
            if helper_ok():
                print(json.dumps({"installed": True, "already": True}))
                return 0
            r = subprocess.run(["pkexec", "/usr/bin/install", "-D", "-o", "root", "-g", "root", "-m", "0755", HELPER_SRC, HELPER])
            ok = r.returncode == 0 and helper_ok()
            print(json.dumps({"installed": ok} if ok else {"error": "not installed (cancelled at the password prompt?)"}))
            return 0 if ok else 1
        elif cmd == "status":
            print(json.dumps({"running": sh(["systemctl", "--user", "is-active", "--quiet", UNIT + ".service"]).returncode == 0}))
        elif cmd == "start":
            args = argv[1:]
            for a in args:
                if not a.startswith("--") and not (re.match(r"^[A-Za-z0-9@._+-]+$", a) or FLATPAK_TARGET.match(a)):
                    raise SystemExit(f"rice-update: not a package or app id: {a!r}")
            if sh(["systemctl", "--user", "is-active", "--quiet", UNIT + ".service"]).returncode == 0:
                print(json.dumps({"error": "An update is already running."}))
                return 1
            sh(["systemctl", "--user", "reset-failed", UNIT + ".service"])
            os.makedirs(RUNTIME, exist_ok=True)
            open(EVENTS, "w").close()   # a fresh feed for the island
            env = [f"--setenv={k}={os.environ[k]}" for k in ("PATH", "HOME", "LANG", "XDG_RUNTIME_DIR", "XDG_STATE_HOME", "XDG_CACHE_HOME") if k in os.environ]
            r = sh(["systemd-run", "--user", "--quiet", "--collect", f"--unit={UNIT}",
                    "--description=kuwai: installing updates", *env,
                    "systemd-inhibit", "--what=sleep:idle:shutdown", "--who=kuwai", "--why=Installing updates", "--mode=block",
                    os.path.abspath(__file__), "run", *args])
            if r.returncode != 0:
                print(json.dumps({"error": r.stderr.strip() or "couldn't start the update job"}))
                return 1
            print(json.dumps({"started": True}))
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except Exception as ex:  # one JSON error, never a traceback in the UI
        print(json.dumps({"error": str(ex)}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
