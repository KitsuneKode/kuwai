#!/usr/bin/env bash
set -u

usage() {
cat <<'KUWAI_USAGE'
Live wallpapers: add your own, and play them in the shell.

  kuwai-wall add FILE [NAME] [--no-loop]   make FILE a live wallpaper: 30 fps,
                                          your largest screen's height (max
                                          1440p), GPU-encoded, and a seamless
                                          loop (the last 1.5 s fade into the
                                          first) unless it already loops
  kuwai-wall import [STEAM_DIR]            Wallpaper Engine's *video* wallpapers
                                          from the Steam Workshop (431960)
  kuwai-wall list                          the library, in play order
  kuwai-wall play NAME|FILE                play one now
  kuwai-wall set IMAGE                     the still wallpaper, set with awww and
                                          kept in kuwai's state (no HyDE needed)
  kuwai-wall restore                       set the kept one again (at login)

The library is ~/Pictures/live-wallpapers (or a theme's own
~/.config/hyde/themes/<theme>/wallpapers/live). Names start with a number
for the order Super+Ctrl+Shift+W steps through.
KUWAI_USAGE
}
unset LD_LIBRARY_PATH
LIB="$HOME/Pictures/live-wallpapers"
SCRIPT="$(dirname "$(readlink -f "$0")")/kuwai-livewall"
mkdir -p "$LIB"

next_number() {
    local n
    n=$(find "$LIB" -maxdepth 1 -name '[0-9]*-*' -printf '%f\n' 2>/dev/null | sed -n 's/^\([0-9]\+\)-.*/\1/p' | sort -n | tail -1)
    [ "${#n}" -le 9 ] || { echo "kuwai-wall: library sequence is too large" >&2; return 1; }
    echo $(( 10#${n:-0} + 1 ))
}
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//' | cut -c1-40; }

target_h() {
    local h
    h=$(hyprctl monitors -j 2>/dev/null | jq '[.[].height] | max' 2>/dev/null)
    [ -n "$h" ] && [ "$h" -gt 0 ] 2>/dev/null || h=1080
    [ "$h" -gt 1440 ] && h=1440
    echo "$h"
}

SOFTWARE="-c:v libx265 -preset slow -crf 18 -profile:v main10 -pix_fmt yuv420p10le -tag:v hvc1 -x265-params log-level=error"
encoder() {
    if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q hevc_nvenc; then echo "-c:v hevc_nvenc -preset p6 -rc vbr -cq 19 -b:v 0 -profile:v main10 -pix_fmt p010le -tag:v hvc1"
    else echo "$SOFTWARE"; fi
}

add() (
    [ "$#" -gt 0 ] || { echo "usage: kuwai-wall add FILE [NAME] [--no-loop]" >&2; return 2; }
    local src=$1 name=${2:-} loop=1
    [ "${3:-}" = --no-loop ] || [ "${2:-}" = --no-loop ] && loop=0
    [ "${2:-}" = --no-loop ] && name=""
    [ -r "$src" ] || { echo "kuwai-wall: can't read $src" >&2; return 1; }
    [ -n "$name" ] || name=$(slug "$(basename "${src%.*}")")
    name=$(slug "$name"); [ -n "$name" ] || name=wallpaper
    exec 9>"$LIB/.import.lock"
    flock -x 9
    local number; number=$(next_number) || return 1
    local out="$LIB/$number-$name.mp4"
    local H; H=$(target_h)
    local D; D=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$src") || return 1
    if ! [[ $D =~ ^[0-9]+([.][0-9]+)?$ ]] || ! awk -v d="$D" 'BEGIN{exit !(d > 0)}'; then
        echo "kuwai-wall: video duration is unavailable" >&2; return 1
    fi
    local F=1.5
    local base="scale=-2:$H:flags=lanczos,fps=30,format=yuv420p10le"
    local filters=() codec=() temporary
    temporary=$(mktemp "$LIB/.encode.XXXXXX") || return 1
    trap "rm -f -- $(printf %q "$temporary")" EXIT
    if [ "$loop" = 1 ] && awk -v d="$D" 'BEGIN{exit !(d > 4)}'; then
        local off; off=$(awk -v d="$D" -v f="$F" 'BEGIN{printf "%.3f", d-2*f}')
        filters=(-filter_complex "[0:v]${base},split[x][y];[x]trim=start=$F,setpts=PTS-STARTPTS[a];[y]trim=end=$F,setpts=PTS-STARTPTS[b];[a][b]xfade=transition=fade:duration=$F:offset=${off},format=yuv420p10le[v]" -map "[v]")
    else
        filters=(-vf "$base")
    fi
    read -r -a codec <<<"$(encoder)"
    if ! ffmpeg -nostdin -v error -stats -y -i "$src" "${filters[@]}" -an "${codec[@]}" -movflags +faststart -f mp4 "$temporary"; then
        [ "${codec[1]}" = hevc_nvenc ] || return 1
        read -r -a codec <<<"$SOFTWARE"
        ffmpeg -nostdin -v error -stats -y -i "$src" "${filters[@]}" -an "${codec[@]}" -movflags +faststart -f mp4 "$temporary" || return 1
    fi
    [ -s "$temporary" ] || return 1
    mv -- "$temporary" "$out" || return 1
    echo "added $(basename "$out") ($(du -h "$out" | cut -f1))"
)

import() {
    local steam=${1:-}
    if [ -z "$steam" ]; then
        for d in "$HOME/.local/share/Steam" "$HOME/.steam/steam" "$HOME/.var/app/com.valvesoftware.Steam/data/Steam"; do
            [ -d "$d/steamapps/workshop/content/431960" ] && { steam=$d; break; }
        done
    fi
    local ws="$steam/steamapps/workshop/content/431960"
    [ -d "$ws" ] || { echo "kuwai-wall: no Wallpaper Engine Workshop folder (install Steam, own Wallpaper Engine, subscribe to some wallpapers)" >&2; return 1; }
    local seen="$LIB/.imported"; touch "$seen"
    local n=0 skipped=0
    for dir in "$ws"/*/; do
        local id; id=$(basename "$dir")
        grep -qx "$id" "$seen" && continue
        local pj="$dir/project.json"
        [ -r "$pj" ] || continue
        local type file title
        type=$(jq -r '.type // "" | ascii_downcase' "$pj"); file=$(jq -r '.file // ""' "$pj"); title=$(jq -r '.title // ""' "$pj")
        if [ "$type" = video ] && [ -r "$dir/$file" ]; then
            add "$dir/$file" "${title:-we-$id}" && echo "$id" >> "$seen" && n=$((n + 1))
        else
            echo "  skipped $id \"$title\" (${type:-unknown}: needs linux-wallpaperengine)"; skipped=$((skipped + 1))
        fi
    done
    echo "imported $n video wallpapers; $skipped scene/web ones skipped"
}

json() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/live-thumbs" cur
    mkdir -p "$cache"
    cur=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/live-wallpaper/last" 2>/dev/null)
    local first=1
    printf '['
    while IFS= read -r -d '' f; do
        local path="$LIB/$f" base="${f%.*}" thumb="$cache/${f%.*}.jpg"
        if [ ! -s "$thumb" ] || [ "$thumb" -ot "$path" ]; then
            local d; d=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$path" 2>/dev/null)
            ffmpeg -nostdin -v error -y -ss "$(awk -v d="${d:-3}" 'BEGIN{print d/3}')" -i "$path" -frames:v 1 -vf "scale=640:-2" -q:v 4 "$thumb" 2>/dev/null
        fi
        [ $first = 1 ] || printf ','
        first=0
        jq -cn --arg n "$(printf '%s' "$base" | sed 's/^[0-9]*-//')" --arg p "$path" --arg t "$thumb" --argjson c "$([ "$path" = "$cur" ] && echo true || echo false)" \
            '{name: $n, path: $p, thumb: $t, current: $c}' | tr -d '\n'
    done < <(find "$LIB" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) -printf '%f\0' | sort -zV)
    printf ']\n'
}

STILL=${XDG_STATE_HOME:-$HOME/.local/state}/kuwai/wallpaper
still() {
    local f; f=$(readlink -f "$1")
    [ -f "$f" ] || { echo "kuwai-wall: no such image: $f" >&2; return 1; }
    case "$(file -b --mime-type "$f" 2>/dev/null)" in image/*) ;; *) echo "kuwai-wall: not an image: $f" >&2; return 1 ;; esac
    command -v awww >/dev/null || { echo "kuwai-wall: awww isn't installed" >&2; return 1; }
    if ! awww query >/dev/null 2>&1; then
        setsid -f awww-daemon --format xrgb >/dev/null 2>&1
        for _ in $(seq 1 50); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
    fi
    if [ "${WALLPAPER_AWWW_TRANSITION_DEFAULT:-}" = none ]; then awww img "$f" --transition-type none >/dev/null 2>&1 || return 1
    else awww img "$f" --transition-type fade --transition-duration 0.6 >/dev/null 2>&1 || return 1; fi
    mkdir -p "$(dirname "$STILL")"
    ln -sfn "$(readlink -f "$f")" "$STILL"
    local look="$(dirname "$(readlink -f "$0")")/kuwai-look"
    [ -x "$look" ] && "$look" set-wallpaper --no-apply "$f" >/dev/null 2>&1 || true
}

prune_art() {
    local d f b
    rm -f -- "${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/live-posters/"*.png
    for d in "${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/live-posters" "${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/live-thumbs"; do
        [ -d "$d" ] || continue
        for f in "$d"/*; do
            [ -f "$f" ] || continue
            b=$(basename "${f%.*}")
            compgen -G "$LIB/$b.*" >/dev/null || rm -f -- "$f"
        done
    done
    "$SCRIPT" prune
}

case "${1:-list}" in
    set)    still "${2:?usage: kuwai-wall set IMAGE}" ;;
    restore) [ -e "$STILL" ] || exit 0; still "$STILL" ;;
    json)   json ;;
    off)    "$SCRIPT" stop; [ -e "$STILL" ] && WALLPAPER_AWWW_TRANSITION_DEFAULT=${WALLPAPER_AWWW_TRANSITION_DEFAULT:-none} still "$STILL"; exit 0 ;;
    add)    shift; add "$@" ;;
    import) shift; import "$@" ;;
    list)   find "$LIB" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) -printf '%f\n' | sort -V ;;
    poster) f=${2:?usage: kuwai-wall poster NAME|FILE}; [ -f "$f" ] || f=$(find "$LIB" -maxdepth 1 -iname "*$f*" | sort -V | head -1)
            [ -f "$f" ] || { echo "kuwai-wall: no wallpaper matches $2" >&2; exit 1; }
            dir="${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/live-posters"; mkdir -p "$dir"
            b=$(basename "${f%.*}"); p="$dir/$b.jpg"
            if [ ! -s "$p" ] || [ "$f" -nt "$p" ]; then
                ffmpeg -nostdin -v error -y -i "$f" -frames:v 1 -q:v 2 "$p.tmp.jpg" && mv -f -- "$p.tmp.jpg" "$p" || { rm -f -- "$p.tmp.jpg"; exit 1; }
            fi
            prune_art >/dev/null 2>&1 &
            printf '%s\n' "$p" ;;
    play)   f=${2:?usage: kuwai-wall play NAME|FILE}; [ -f "$f" ] || f=$(find "$LIB" -maxdepth 1 -iname "*$f*" | sort -V | head -1)
            [ -f "$f" ] || { echo "kuwai-wall: no wallpaper matches $2" >&2; exit 1; }
            "$SCRIPT" play "$f" ;;
    *)      usage; exit 2 ;;
esac
