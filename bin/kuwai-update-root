#!/usr/bin/python3 -I
"""kuwai-update-root: root's half of kuwai-update, so one password covers a whole update.

kuwai-update starts it once per update as

    pkexec /usr/local/lib/kuwai/kuwai-update-root upgrade=N:HEX hold=A,B deps=C,D install=E,F clean-cache=K

from where `kuwai update install-helper` put it (root's checked copy of a signed release): owned
by root, writable only by root. It is never run from your home folder, which anything running as
you could rewrite.

The command line is the whole transaction, and the password prompt shows it: upgrade=N:HEX is
how many Arch packages and the sha256 of exactly which "NAME VERSION"s (sorted, one per line);
hold= the packages left alone; deps= the build dependencies; install= the AUR packages by name;
clean-cache= how many cached versions stay; pacnew alone allows config file choices. Each named
operation runs once; a request for anything else, or for something other than what is named, is
refused before pacman starts.

It reads one JSON request per line on stdin and only ever runs pacman:

    {"op": "upgrade", "deps": [PKG...], "hold": [PKG...]}
                                          pacman -Sy, then {"plan": ["NAME VERSION"...]}: the
                                          transaction pacman resolved against the fresh
                                          databases (replacements and new dependencies too).
                                          Only when that is the one the prompt named:
                                          pacman -Su --noconfirm --needed (--ignore the held
                                          packages: they stay at the version installed); with deps,
                                          pacman -S --noconfirm --needed --asdeps PKG...
                                          Otherwise {"rc": 92} and nothing is installed.
    {"op": "deps", "deps": [PKG...]}      pacman -S --noconfirm --needed --asdeps PKG...
    {"op": "install", "files": [{"path": FILE, "sha256": HEX}...]}
                                          pacman -U --noconfirm --needed on copies: each package
                                          file (yours, in your home folder) is copied once,
                                          through a descriptor that refuses links, into a folder
                                          only root can open, and must hash to the digest taken
                                          when it was built, so a file changed or swapped after
                                          the build is never the one installed; each one
                                          must be a package the prompt named
    {"op": "clean-cache", "keep": 2}      paccache -rk<keep> and paccache -ruk0 (0 <= keep <= 5)
    {"op": "pacnew", "items": [{"path": "/etc/X", "action": "keep"|"take"}]}
                                          a config file's .pacnew after an update: keep yours
                                          (delete X.pacnew) or take the new default (X.pacnew
                                          replaces X; X saved under /var/lib/kuwai/pacnew-backups
                                          with a name of its own). Each file answers
                                          {"item": {path, ok, why}}. Only real files
                                          under /etc with a root-owned X.pacnew beside them, no
                                          symlinks; sudoers only after `visudo -c` passes.

While pacman runs it answers {"log": LINE}, then {"rc": N}. It says {"ready": true} first.
It ends when stdin closes (kuwai-update finished or died), or after four hours at most.

pacman writes to a file, not to the pipe: if kuwai-update dies halfway, pacman still has
somewhere to write and finishes its transaction instead of dying of a broken pipe.
"""
import hashlib
import json
import os
import pwd
import re
import signal
import subprocess
import sys
import tempfile
import shutil
import stat
import time

PACMAN = "/usr/bin/pacman"
PACCACHE = "/usr/bin/paccache"
OUT_DIR = "/run"
NAME = re.compile(r"^[a-z0-9@_+][a-z0-9@._+-]*$")
PLAN_LINE = re.compile(r"^\S+ \S+$")
PLAN_TOKEN = re.compile(r"\d{1,4}:[0-9a-f]{64}")
PLAN_CHANGED = 92
PKGFILE = re.compile(r"\.pkg\.tar(\.[a-z0-9]+)?$")
ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C", "PACMAN_COLOR": "never", "HOME": "/root"}

alive = True


def say(**msg):
    global alive
    if not alive:
        return
    try:
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, OSError):
        alive = False


def run_tool(cmd):
    fd, out = tempfile.mkstemp(prefix="kuwai-update-root.", suffix=".out", dir=OUT_DIR)
    try:
        return _run_tool(cmd, fd, out)
    finally:
        try:
            os.unlink(out)
        except OSError:
            pass


def _run_tool(cmd, fd, out):
    with os.fdopen(fd, "w") as w:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=w, stderr=subprocess.STDOUT,
                             env=ENV, start_new_session=True, umask=0o022)
    pending = ""
    with open(out) as r:
        while True:
            chunk = r.read()
            if chunk:
                pending += chunk
                *lines, pending = pending.split("\n")
                for line in lines:
                    line = line.rstrip("\r")
                    if line.strip():
                        say(log=line)
            elif p.poll() is not None:
                if pending.strip():
                    say(log=pending.strip())
                return p.returncode
            else:
                time.sleep(0.1)


def pacman(args):
    return run_tool([PACMAN, *args])


def resolved(ignore=()):
    """What -Su would install now, as pacman itself resolved it; None when pacman couldn't say."""
    try:
        r = subprocess.run([PACMAN, "-Su", *ignore, "--print", "--print-format", "%n %v"], env=ENV,
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return [l.strip() for l in r.stdout.splitlines() if PLAN_LINE.match(l.strip())][:2000]


def plan_token(plan):
    lines = sorted(set(plan))
    return f"{len(lines)}:{hashlib.sha256(chr(10).join(lines).encode()).hexdigest()}"


def package_names(paths):
    """The package each file is, as pacman reads it from the file itself."""
    out = []
    for p in paths:
        r = subprocess.run([PACMAN, "-Qqp", "--", p], env=ENV, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
        name = r.stdout.strip()
        if r.returncode != 0 or not NAME.match(name):
            raise ValueError(f"{os.path.basename(p)} isn't a package pacman can read")
        out.append(name)
    return out


def clean_cache(req):
    """Prune /var/cache/pacman/pkg using paccache with a bounded keep count."""
    keep = req.get("keep", 2)
    if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0 or keep > 5:
        raise ValueError(f"invalid keep count: {keep!r}")
    if not os.path.isfile(PACCACHE):
        say(log="paccache not installed; skipping pacman cache cleanup")
        return 0
    rc = run_tool([PACCACHE, f"-rk{keep}"])
    rc2 = run_tool([PACCACHE, "-ruk0"])
    return rc if rc != 0 else rc2


SHA256 = re.compile(r"[0-9a-f]{64}")


def names(req, key="deps"):
    pkgs = req.get(key) or []
    if not isinstance(pkgs, list) or not all(isinstance(x, str) and NAME.match(x) for x in pkgs):
        raise ValueError("not package names")
    return pkgs


def taken(paths, into, uid):
    out = []
    for p, want in paths:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
                raise ValueError(f"not a package file of yours: {p!r}")
            dst = os.path.join(into, os.path.basename(p))
            wfd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
            h = hashlib.sha256()
            with os.fdopen(wfd, "wb") as w, os.fdopen(os.dup(fd), "rb") as r:
                for chunk in iter(lambda: r.read(1 << 20), b""):
                    h.update(chunk)
                    w.write(chunk)
            if h.hexdigest() != want:
                os.unlink(dst)
                raise ValueError(f"{os.path.basename(p)} is not the file that was built (its digest changed)")
            out.append(dst)
        finally:
            os.close(fd)
    return out


def files(req, home, uid):
    out = []
    for entry in req.get("files") or []:
        f = entry.get("path") if isinstance(entry, dict) else None
        want = entry.get("sha256") if isinstance(entry, dict) else None
        if not isinstance(f, str) or not isinstance(want, str) or not SHA256.fullmatch(want) or os.path.islink(f):
            raise ValueError(f"not a package file with its digest: {entry!r}")
        real = os.path.realpath(f)
        st = os.stat(real)
        if not (real.startswith(home + "/") and PKGFILE.search(real) and os.path.isfile(real) and st.st_uid == uid):
            raise ValueError(f"not a package file of yours: {f!r}")
        out.append((real, want))
    if not out:
        raise ValueError("no package files")
    return out


ETC = "/etc/"


BACKUPS = "/var/lib/kuwai/pacnew-backups"


def backup_dir():
    """Root's own folder for the files a take replaces: made 0700, never through a link."""
    os.makedirs(BACKUPS, mode=0o700, exist_ok=True)
    for d in (os.path.dirname(BACKUPS), BACKUPS):
        st = os.lstat(d)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise ValueError(f"backup folder not root's own: {d}")
    return BACKUPS


def backup(path):
    """A copy of path under BACKUPS with a name of its own (time, path, a counter), opened
    without following links and never over an existing file."""
    src = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        if not stat.S_ISREG(os.fstat(src).st_mode):
            raise ValueError(f"not a regular file: {path!r}")
        base = os.path.join(backup_dir(), time.strftime("%Y%m%d-%H%M%S-") + path[len(ETC):].replace("/", "%"))
        for n in range(100):
            dest = base if n == 0 else f"{base}.{n}"
            try:
                out = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                break
            except FileExistsError:
                continue
        else:
            raise ValueError(f"no free backup name for {path!r}")
        with os.fdopen(out, "wb") as o, os.fdopen(os.dup(src), "rb") as i:
            shutil.copyfileobj(i, o)
            o.flush()
            os.fsync(o.fileno())
        return dest
    finally:
        os.close(src)


NEVER_TAKE = frozenset({"passwd", "shadow", "group", "gshadow", "fstab", "crypttab"})


def pacnew_one(path, action):
    if action not in ("keep", "take") or not isinstance(path, str) or not path.startswith(ETC) \
            or "\0" in path or any(part in ("", ".", "..") for part in path[1:].split("/")):
        raise ValueError(f"not a config file: {path!r}")
    new = path + ".pacnew"
    if action == "take" and path[len(ETC):] in NEVER_TAKE:
        raise ValueError(f"{path} holds your accounts or disks: merge {new} by hand (pacdiff); yours stays")
    if os.path.realpath(new) != new or os.path.realpath(os.path.dirname(path)) != os.path.dirname(path):
        raise ValueError(f"symlink in the way: {path!r}")
    st = os.lstat(new)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0:
        raise ValueError(f"not a root-owned .pacnew: {new!r}")
    if os.path.lexists(path) and (os.path.islink(path) or not stat.S_ISREG(os.lstat(path).st_mode)):
        raise ValueError(f"not a regular file: {path!r}")
    if action == "keep":
        os.unlink(new)
        return f"kept yours: {path}"
    if path == "/etc/sudoers" or path.startswith("/etc/sudoers.d/"):
        if subprocess.run(["/usr/bin/visudo", "-c", "-q", "-f", new], env=ENV).returncode != 0:
            raise ValueError(f"{new} doesn't pass visudo -c; yours stays")
    saved = ""
    if os.path.exists(path):
        old = os.lstat(path)
        saved = backup(path)
        os.chmod(new, stat.S_IMODE(old.st_mode))
        os.chown(new, old.st_uid, old.st_gid)
    os.replace(new, path)
    return f"took the new default: {path}" + (f" (yours saved as {saved})" if saved else "")


def pacnew(req):
    """Keep yours or take the new default, for each X with an X.pacnew. Each file is its own
    step: one refused doesn't stop the rest, and each one says how it went."""
    items = req.get("items") or []
    if not isinstance(items, list) or not items:
        raise ValueError("no config files")
    rc = 0
    for it in items:
        path, action = (it or {}).get("path"), (it or {}).get("action")
        try:
            line = pacnew_one(path, action)
            say(log=line)
            say(item={"path": path, "ok": True})
        except (ValueError, OSError) as ex:
            rc = 1
            say(log=f"refused {path!r}: {ex}")
            say(item={"path": path if isinstance(path, str) else "", "ok": False, "why": str(ex)[:200]})
    return rc


OPS = frozenset({"upgrade", "deps", "pacnew", "install", "clean-cache"})


def prompt_terms(argv):
    """What pkexec's command line (the password prompt) named: {op: value}; None if anything on
    it is unknown, repeated or malformed, or it names no operation."""
    out = {}
    for arg in argv:
        op, eq, value = arg.partition("=")
        if op not in OPS | {"hold"} or op in out:
            return None
        if op == "upgrade":
            if not PLAN_TOKEN.fullmatch(value):
                return None
        elif op in ("deps", "install", "hold"):
            items = value.split(",") if value else []
            if not items or not all(NAME.match(x) for x in items):
                return None
            value = sorted(items)
        elif op == "clean-cache":
            if not re.fullmatch(r"[0-5]", value):
                return None
            value = int(value)
        elif eq:
            return None
        else:
            value = True
        out[op] = value
    return out if set(out) - {"hold"} else None


def as_named(req, op, terms):
    """The request is the one the prompt named for op, or ValueError."""
    if op == "upgrade":
        if sorted(names(req, "hold")) != terms.get("hold", []):
            raise ValueError("the held packages aren't the ones the password prompt named")
        deps = names(req)
        if deps and sorted(deps) != terms.get("deps"):
            raise ValueError("the build dependencies aren't the ones the password prompt named")
        if deps:
            terms.pop("deps")
    elif op == "deps" and sorted(names(req)) != terms["deps"]:
        raise ValueError("the build dependencies aren't the ones the password prompt named")
    elif op == "clean-cache" and req.get("keep", 2) != terms["clean-cache"]:
        raise ValueError("the cache count isn't the one the password prompt named")


def main():
    os.umask(0o077)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    signal.alarm(4 * 3600)
    if os.geteuid() != 0 or "PKEXEC_UID" not in os.environ:
        print("kuwai-update-root: run by kuwai-update through pkexec", file=sys.stderr)
        return 2
    terms = prompt_terms(sys.argv[1:])
    if terms is None:
        print("kuwai-update-root: name the transaction this run may do: upgrade=N:HEX hold=… deps=… install=… clean-cache=K pacnew",
              file=sys.stderr)
        return 2
    uid = int(os.environ["PKEXEC_UID"])
    home = os.path.realpath(pwd.getpwuid(uid).pw_dir)
    say(ready=True)
    for line in sys.stdin:
        try:
            req = json.loads(line)
            op = req.get("op")
            if op not in terms or op == "hold":
                raise ValueError(f"{op!r} wasn't named at the password prompt")
            as_named(req, op, terms)
            named = terms.pop(op)
            if op == "upgrade":
                deps = names(req)
                hold = names(req, "hold")
                ignore = ["--ignore", ",".join(hold)] if hold else []
                rc = pacman(["-Sy"])
                if rc == 0:
                    plan = resolved(ignore)
                    say(plan=plan or [])
                    if plan is None:
                        say(log="kuwai-update-root: refused: pacman couldn't work out what the update would install; nothing was installed")
                        rc = PLAN_CHANGED
                    elif plan_token(plan) != named:
                        say(log="kuwai-update-root: refused: Arch's packages changed after the password prompt named them; nothing was installed")
                        rc = PLAN_CHANGED
                    else:
                        rc = pacman(["-Su", "--noconfirm", "--needed", *ignore])
                if rc == 0 and deps:
                    rc = pacman(["-S", "--noconfirm", "--needed", "--asdeps", "--", *deps])
            elif op == "deps":
                rc = pacman(["-S", "--noconfirm", "--needed", "--asdeps", "--", *names(req)])
            elif op == "pacnew":
                rc = pacnew(req)
            elif op == "install":
                wanted = files(req, home, uid)
                with tempfile.TemporaryDirectory(prefix="kuwai-update-root-", dir="/var/tmp" if os.path.isdir("/var/tmp") else None) as d:
                    copies = taken(wanted, d, uid)
                    other = sorted(set(package_names(copies)) - set(named))
                    if other:
                        raise ValueError("not named at the password prompt: " + ", ".join(other))
                    rc = pacman(["-U", "--noconfirm", "--needed", "--", *copies])
            elif op == "clean-cache":
                rc = clean_cache(req)
            else:
                raise ValueError(f"unknown request {op!r}")
        except (ValueError, OSError, TypeError, AttributeError) as ex:
            say(log=f"kuwai-update-root: refused: {ex}")
            rc = 2
        say(rc=rc)
    return 0


if __name__ == "__main__":
    sys.exit(main())
