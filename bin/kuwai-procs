#!/usr/bin/env python3
import json, os, pwd, re, select, signal, subprocess, sys, time

ME = os.getuid()
TICK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
FRIENDLY = [(r"zen-bin", "Zen"), (r"firefox", "Firefox"), (r"chrome|chromium", "Chrome"),
            (r"t3code", "T3 Code"), (r"QtWebEngineProcess", "Qt web view"), (r"electron", "Electron app"),
            (r"\bcode\b|/code/", "VS Code"), (r"next-server", "Next.js server"), (r"\bvite\b", "Vite"), (r"discord", "Discord"), (r"qs\b|quickshell", "kuwai shell")]


SESSION = re.compile(r"(Hyprland|start-hyprland|uwsm|systemd|\(sd-pam\)|dbus-broker(-launch)?|dbus-daemon|pipewire(-pulse)?|wireplumber"
                     r"|xdg-desktop-portal.*|xdg-desktop-por|xdg-document-portal|xdg-permission-store|polkitd|gnome-keyring-d.*|kwalletd.*|awww-daemon|hypridle|hyprlock"
                     r"|greetd|agreety|sshd|ssh-agent|gcr-ssh-agent|gpg-agent|NetworkManager|Xwayland)")
SESSION_UNITS = ("kuwai-shell.service", "kuwai-auth.service", "kuwai-wallpaper.service")


def protected(pid, name):
    """Ending it would take the session, the screen or the password prompt with it."""
    if pid <= 1 or SESSION.fullmatch(name):
        return True
    try:
        with open("/proc/%d/cgroup" % pid) as f:
            cg = f.read()
    except OSError:
        return False
    return "/init.scope" in cg or "/session.slice/" in cg or any(cg.rstrip().endswith("/" + u) for u in SESSION_UNITS)


def ancestors():
    out, pid = set(), os.getpid()
    while pid > 1:
        out.add(pid)
        try:
            with open("/proc/%d/stat" % pid) as f:
                st = f.read()
            pid = int(st[st.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return out


def full_name(name, cmd):
    if len(name) == 15:
        first = os.path.basename(cmd.split()[0]) if cmd.split() else ""
        if first.startswith(name.split()[0]):
            return first
    return name


def procs():
    out = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        p = "/proc/" + d
        try:
            with open(p + "/stat") as f:
                st = f.read()
            name = st[st.index("(") + 1:st.rindex(")")]
            rest = st[st.rindex(")") + 2:].split()
            ppid = int(rest[1])
            ticks = int(rest[11]) + int(rest[12])
            start = int(rest[19])
            rss = int(rest[21]) * PAGE
            uid = os.stat(p).st_uid
            with open(p + "/cmdline", "rb") as f:
                cmd = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        except (OSError, ValueError, IndexError):
            continue
        if not cmd:
            continue
        name = full_name(name, cmd)
        out[int(d)] = {"pid": int(d), "ppid": ppid, "name": name, "cmd": cmd[:300], "uid": uid, "ticks": ticks, "rss": rss, "start": start}
    return out


def user_of(uid):
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


def ports():
    """pid → sorted ports it listens on (ss sees only your own pids without root)."""
    m = {}
    try:
        txt = subprocess.run(["ss", "-Hlntup"], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return m, []
    listeners = []
    for line in txt.splitlines():
        f = line.split()
        if len(f) < 5:
            continue
        local = f[4]
        port = local.rsplit(":", 1)[-1]
        if not port.isdigit():
            continue
        pids = [int(x) for x in re.findall(r"pid=(\d+)", line)]
        listeners.append({"port": int(port), "proto": f[0], "addr": local, "pids": pids})
        for pid in pids:
            m.setdefault(pid, set()).add(int(port))
    return {k: sorted(v) for k, v in m.items()}, listeners


def friendly(r):
    for pat, nm in FRIENDLY:
        if re.search(pat, r["cmd"]) or re.search(pat, r["name"]):
            return nm
    return ""


def row(r, cpu, pm):
    return {"pid": r["pid"], "start": r.get("start", 0), "name": r["name"], "cmd": r["cmd"], "user": user_of(r["uid"]),
            "mine": r["uid"] == ME, "cpu": round(cpu, 1), "memMB": round(r["rss"] / 1048576),
            "ports": pm.get(r["pid"], []), "app": friendly(r), "protected": protected(r["pid"], r["name"])}


def apps(hits, allp, cpu, pm):
    """An app made of many processes (Zen, T3 Code, VS Code…) first as one row:
    its main process (the one whose parent isn't the same app), with the whole
    app's memory and CPU. Ending it closes the app, children and all; ending
    one of its rows below ends only that tab or helper."""
    groups = {}
    for p in allp.values():
        a = friendly(p)
        if a and p["uid"] == ME:
            groups.setdefault(a, []).append(p)
    out = []
    for a in dict.fromkeys(friendly(p) for p in hits if friendly(p)):
        g = groups.get(a, [])
        if len(g) < 2:
            continue
        pids = {p["pid"] for p in g}
        kids = {}
        for p in g:
            kids.setdefault(p["ppid"], []).append(p)
        def tree(p):
            out, todo = [], [p]
            while todo:
                x = todo.pop()
                out.append(x)
                todo.extend(kids.get(x["pid"], []))
            return out
        roots = sorted((tree(p) for p in g if p["ppid"] not in pids), key=len, reverse=True)
        if not roots or len(roots[0]) < 2 or len(roots[0]) * 2 < len(g):
            continue
        t = roots[0]
        r = row(t[0], sum(cpu.get(p["pid"], 0) for p in t), pm)
        r["memMB"] = round(sum(p["rss"] for p in t) / 1048576)
        r["group"] = len(t)
        out.append(r)
    return out


USER_CGROUP = "/sys/fs/cgroup/user.slice/user-%d.slice/user@%d.service" % (ME, ME)
UNIT = re.compile(r"app-[^/\x00]+\.(scope|service)")
SKIP_SLICES = ("session", "background")


def unit_app(name):
    """(launcher, application id) from an app-*.scope / app-*.service name, as systemd's
    XDG naming has it: app[-launcher]-ID[@random].service, app[-launcher]-ID-random.scope,
    a dash inside the ID written \\x2d."""
    base = re.sub(r"\.(scope|service)$", "", name)[4:]
    base = re.sub(r"@[^@]*$", "", base) if name.endswith(".service") else re.sub(r"-\d+$", "", base)
    parts = [re.sub(r"\\x([0-9a-fA-F]{2})", lambda m: chr(int(m.group(1), 16)), p) for p in base.split("-")]
    if len(parts) == 1:
        return "", parts[0]
    return parts[0], "-".join(parts[1:])


def find_units(root=None):
    """{unit name: cgroup directory} for the app-*.scope and app-*.service units of this user's
    manager, looking inside its slices (app.slice, uwsm's app-graphical.slice…), never the session's."""
    out = {}
    top = root or USER_CGROUP

    def walk(d, depth):
        try:
            entries = list(os.scandir(d))
        except OSError:
            return
        for e in entries:
            if not e.is_dir(follow_symlinks=False):
                continue
            if UNIT.fullmatch(e.name):
                out.setdefault(e.name, e.path)
            elif e.name.endswith(".slice") and depth < 4 and not e.name.startswith(SKIP_SLICES):
                walk(e.path, depth + 1)

    walk(top, 0)
    return out


def unit_pids(path):
    """Every process in a unit's cgroup and the groups under it."""
    pids = []
    for d, _, files in os.walk(path):
        if "cgroup.procs" in files:
            try:
                with open(d + "/cgroup.procs") as f:
                    pids.extend(int(x) for x in f.read().split())
            except (OSError, ValueError):
                pass
    return pids


def unit_kept(unit, comms, own=False):
    """A unit the session lives on: kuwai's own, a portal, a key or login agent, or the one this helper runs in."""
    app = unit_app(unit)[1]
    return (own or app.lower().startswith("kuwai") or "portal" in app.lower() or unit in SESSION_UNITS
            or bool(SESSION.fullmatch(app)) or any(SESSION.fullmatch(c) for c in comms))


def alive(pid):
    try:
        with open("/proc/%d/stat" % pid) as f:
            st = f.read()
        return st[st.rindex(")") + 2] != "Z"
    except (OSError, ValueError, IndexError):
        return False


def own_unit():
    try:
        with open("/proc/self/cgroup") as f:
            return f.read().strip().rsplit("/", 1)[-1]
    except OSError:
        return ""


def end_unit(unit, force, root=None):
    """Stop (SIGTERM) or force-quit (SIGKILL) every process of one app unit, never one that holds
    the session or this launcher, and say whether it is gone."""
    if not UNIT.fullmatch(unit):
        return {"ok": False, "why": "that is not an app"}
    path = find_units(root).get(unit)
    pids = [p for p in unit_pids(path) if alive(p)] if path else []
    if not pids:
        return {"ok": True, "why": "already gone"}
    if set(pids) & ancestors() or unit == own_unit():
        return {"ok": False, "why": "it runs this launcher"}
    comms = []
    for pid in pids:
        try:
            if os.stat("/proc/%d" % pid).st_uid != ME:
                return {"ok": False, "why": "not yours (another user's process needs sudo)"}
            with open("/proc/%d/stat" % pid) as f:
                st = f.read()
            comms.append(st[st.index("(") + 1:st.rindex(")")])
        except (OSError, ValueError):
            continue
    if unit_kept(unit, comms) or any(protected(p, c) for p, c in zip(pids, comms)):
        return {"ok": False, "why": "your session needs it"}
    sig = signal.SIGKILL if force else signal.SIGTERM
    deadline = time.monotonic() + (1.5 if force else 3.0)
    sent = False
    while True:
        left = [p for p in unit_pids(path) if alive(p)] if os.path.isdir(path) else []
        if not left:
            return {"ok": True, "gone": True}
        if force or not sent:
            for pid in left:
                try:
                    fd = os.pidfd_open(pid)
                except OSError:
                    continue
                try:
                    if pid in unit_pids(path):
                        signal.pidfd_send_signal(fd, sig)
                except (OSError, ValueError):
                    pass
                finally:
                    os.close(fd)
            sent = True
        if time.monotonic() >= deadline:
            return {"ok": True, "gone": False, "why": "it's still running; force quit ends it"}
        time.sleep(0.1)


def started(pid):
    with open("/proc/%d/stat" % pid) as f:
        st = f.read()
    return int(st[st.rindex(")") + 2:].split()[19])


def end(pid, force, start=None):
    """Signal pid only if it is still the process that was listed: a pidfd pins it, and its
    start time must match the listing's (a number reused by a newer process doesn't)."""
    if pid in ancestors() or pid == 1:
        return {"ok": False, "why": "it runs this launcher"}
    try:
        fd = os.pidfd_open(pid)
    except ProcessLookupError:
        return {"ok": True, "why": "already gone"}
    except OSError as e:
        return {"ok": False, "why": str(e)}
    try:
        if os.stat("/proc/%d" % pid).st_uid != ME:
            return {"ok": False, "why": "not yours (another user's process needs sudo)"}
        if start is not None and started(pid) != start:
            return {"ok": False, "why": "that process has ended; the number now belongs to another one"}
        with open("/proc/%d/stat" % pid) as f:
            st = f.read()
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                cmd = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        except OSError:
            cmd = ""
        name = st[st.index("(") + 1:st.rindex(")")]
        if protected(pid, name) or protected(pid, full_name(name, cmd)):
            return {"ok": False, "why": "your session needs it"}
        signal.pidfd_send_signal(fd, signal.SIGKILL if force else signal.SIGTERM)
        waiter = select.poll()
        waiter.register(fd, select.POLLIN)
        if waiter.poll(1000 if force else 3000):
            return {"ok": True, "gone": True}
        return {"ok": True, "gone": False, "why": "it's still running; force quit ends it"}
    except ProcessLookupError:
        return {"ok": True, "why": "already gone"}
    except FileNotFoundError:
        return {"ok": True, "why": "already gone"}
    except PermissionError:
        return {"ok": False, "why": "not allowed"}
    except (OSError, ValueError, IndexError) as e:
        return {"ok": False, "why": str(e)}
    finally:
        os.close(fd)


def pss(pid):
    """Proportional memory (shared pages split between their users), bytes."""
    try:
        with open(f"/proc/{pid}/smaps_rollup") as f:
            for line in f:
                if line.startswith("Pss:"):
                    return int(line.split()[1]) * 1024
    except OSError:
        pass
    return None


def by_app(limit=7):
    """Memory by app (PSS where readable, else RSS): [{app, mb, count}], biggest first."""
    groups = {}
    for r in procs().values():
        key = friendly(r) or r["name"]
        m = pss(r["pid"]) if r["uid"] == ME else None
        g = groups.setdefault(key, {"app": key, "bytes": 0, "count": 0})
        g["bytes"] += m if m is not None else r["rss"]
        g["count"] += 1
    rows = sorted(groups.values(), key=lambda g: -g["bytes"])
    return [{"app": g["app"], "mb": round(g["bytes"] / 1048576), "count": g["count"]} for g in rows[:limit]]


def main(argv):
    if argv[:1] == ["--by-app"]:
        print(json.dumps(by_app()))
        return
    if argv[:1] == ["--end"]:
        try:
            pid = int(argv[1])
        except (IndexError, ValueError):
            print(json.dumps({"ok": False, "why": "no pid"}))
            return
        start = None
        if "--start" in argv:
            try:
                start = int(argv[argv.index("--start") + 1])
            except (IndexError, ValueError):
                print(json.dumps({"ok": False, "why": "bad start time"}))
                return
        print(json.dumps(end(pid, "--force" in argv, start)))
        return
    if argv[:1] == ["--end-unit"]:
        if len(argv) < 2:
            print(json.dumps({"ok": False, "why": "no app"}))
            return
        at = argv.index("--cgroup-root") + 1 if "--cgroup-root" in argv else 0
        root = argv[at] if 0 < at < len(argv) else None
        print(json.dumps(end_unit(argv[1], "--force" in argv, root)))
        return
    q = " ".join(argv).strip()
    a = procs()
    time.sleep(0.6)
    b = procs()
    span = 0.6 * TICK
    pm, listeners = ports()
    cpu = {pid: max(0.0, (b[pid]["ticks"] - a[pid]["ticks"]) * 100 / span) for pid in b if pid in a}
    port_q = re.fullmatch(r":?(\d{1,5})", q)
    if port_q:
        want = int(port_q.group(1))
        rows, seen, shown = [], set(), set()
        for l in listeners:
            if l["port"] != want:
                continue
            if not l["pids"] and (l["proto"], l["addr"]) not in shown:
                shown.add((l["proto"], l["addr"]))
                rows.append({"pid": 0, "name": "?", "cmd": "", "user": "owner unknown", "mine": False, "cpu": 0,
                             "memMB": 0, "ports": [want], "app": "", "proto": l["proto"], "addr": l["addr"]})
            for pid in l["pids"]:
                if pid in b and pid not in seen:
                    seen.add(pid)
                    r = row(b[pid], cpu.get(pid, 0), pm)
                    r["proto"], r["addr"] = l["proto"], l["addr"]
                    rows.append(r)
        print(json.dumps(rows))
        return
    if q:
        ql = q.lower()
        def named(p):
            exe = os.path.basename(p["cmd"].split()[0]).lower() if p["cmd"].split() else ""
            return ql in p["name"].lower() or ql in friendly(p).lower() or ql in exe
        hits = [p for p in b.values() if named(p) or (len(ql) >= 4 and ql in p["cmd"].lower())]
        hits.sort(key=lambda p: (-named(p), -(p["uid"] == ME), -cpu.get(p["pid"], 0), -p["rss"]))
        whole = apps([p for p in hits if named(p)], b, cpu, pm)
        once = {r["pid"] for r in whole}
        print(json.dumps(whole + [row(p, cpu.get(p["pid"], 0), pm) for p in hits if p["pid"] not in once][:30]))
        return
    BUSY = 10
    allp = list(b.values())
    allp.sort(key=lambda p: (-(cpu.get(p["pid"], 0) >= BUSY), -(cpu.get(p["pid"], 0) if cpu.get(p["pid"], 0) >= BUSY else 0), -p["rss"]))
    print(json.dumps([row(p, cpu.get(p["pid"], 0), pm) for p in allp[:12]]))


if __name__ == "__main__":
    main(sys.argv[1:])
