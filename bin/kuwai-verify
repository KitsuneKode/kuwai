#!/usr/bin/python3 -I
"""kuwai-verify: whether a copy of kuwai is a release its signers signed; root's copy of one.

A release is a tag vX.Y.Z made by `kuwai release`: signed with `git tag -s` by a key in
release-signers/, its message carrying the digest of every file in its tree,

    kuwai-tree-sha256 HEX

so any copy can be checked file by file, with or without git. The digest covers each path,
whether it is executable, its content, and where each link points. A name with a control
character in it (a newline would let one file read as two) is refused wherever a digest is taken.

As you:
    kuwai-verify manifest DIR             the tree digest of a folder (its top .git left out)
    kuwai-verify manifest-rev REPO REV    the tree digest of a commit, as `git archive` gives it
    kuwai-verify signers DIR...           the fingerprints of the keys in each DIR/*.asc
    kuwai-verify tag REPO NAME [--ref REF] --signers DIR...
                                          NAME is signed by one of those keys (a keyring of them
                                          alone, in a temporary GNUPGHOME) and its tree is the one
                                          the signature names; JSON
    kuwai-verify fetch SOURCE [NAME] --signers DIR... --into NEW
                                          only that tag (the newest vX.Y.Z when not named), into a
                                          new folder, checked as above before it is checked out,
                                          then the checked-out files checked again; nothing in it
                                          runs; JSON

As root (sudo or pkexec):
    kuwai-verify install --from DIR --tag-file FILE --name vX.Y.Z --digest HEX [--signer FPR...]
                                          copies DIR into /usr/local/lib/kuwai/releases/NAME, owned
                                          by root, then checks that copy: the tag signed by a key
                                          root trusts (the --signer fingerprints the first time;
                                          its own list after that), naming HEX, and every file the
                                          signed one. An older release than root's is refused.
                                          Root then trusts exactly the keys that release lists in
                                          its release-signers/ (a key added there, a key removed),
                                          written at once to root's fingerprints file.
    kuwai-verify check DIR                DIR is root's copy of a release, still as signed
    kuwai-verify place update-helper|auth-prompt
                                          puts one piece of root's current release in place,
                                          after checking that release again

Without root it does the root half only under KUWAI_SYSROOT (a stand-in / for tests), with the
caller standing in for root as the owner everything must have.
"""
import argparse
import base64
import hashlib
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile

TREE_LINE = re.compile(rb"^kuwai-tree-sha256 ([0-9a-f]{64})$", re.M)
NAME = re.compile(r"^v(\d{1,4})\.(\d{1,4})\.(\d{1,4})$")
FPR = re.compile(r"^(?:[0-9A-F]{40}|[0-9A-F]{64})$")
HEX64 = re.compile(r"^[0-9a-f]{64}$")
SIG_START = b"-----BEGIN PGP SIGNATURE-----\n"
ARMOR = re.compile(r"-----BEGIN PGP PUBLIC KEY BLOCK-----\r?\n(.*?)-----END PGP PUBLIC KEY BLOCK-----", re.S)
WEAK_HASHES = {"1", "2", "3"}
BAD_STATUS = {"BADSIG", "ERRSIG", "EXPKEYSIG", "REVKEYSIG", "EXPSIG", "FAILURE"}
GPGV = "/usr/bin/gpgv"
TAG_MAX = 1 << 16
FILE_MAX = 1 << 28
ROOT_ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C"}
GIT_SAFE = ["-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "core.attributesFile=/dev/null",
            "-c", "gpg.format=openpgp",
            "-c", "gpg.program=gpg", "-c", "protocol.ext.allow=never", "-c", "advice.detachedHead=false"]
PIECES = {"update-helper", "auth-prompt"}


class Refused(Exception):
    pass


def version(name):
    m = NAME.match(name or "")
    if not m:
        raise Refused(f"{name!r} isn't a release name (vX.Y.Z)")
    return tuple(int(x) for x in m.groups())


def file_sha256(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    h = hashlib.sha256()
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise Refused(f"not a plain file: {os.fsdecode(path)}")
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def digest_of(entries):
    h = hashlib.sha256()
    for path, kind, sha in sorted(entries):
        if any(c < 0x20 or c == 0x7f for c in path):
            raise Refused(f"a name in the release has a control character in it: {os.fsdecode(path)!r}")
        h.update(kind.encode() + b" " + sha.encode() + b" " + path + b"\n")
    return h.hexdigest()


def link_entry(path, target):
    return (path, "l", hashlib.sha256(target).hexdigest())


def walk(top):
    """Every entry under top as (relative path, lstat), top's own .git left out; links never followed."""
    topb = os.fsencode(top)
    stack = [b""]
    while stack:
        rel = stack.pop()
        with os.scandir(os.path.join(topb, rel) if rel else topb) as it:
            entries = sorted(it, key=lambda e: e.name)
        for e in entries:
            if not rel and e.name == b".git":
                continue
            path = rel + b"/" + e.name if rel else e.name
            st = e.stat(follow_symlinks=False)
            yield path, st
            if stat.S_ISDIR(st.st_mode):
                stack.append(path)


def manifest_dir(top):
    topb = os.fsencode(top)
    entries = []
    for path, st in walk(top):
        full = os.path.join(topb, path)
        if stat.S_ISREG(st.st_mode):
            entries.append((path, "x" if st.st_mode & 0o100 else "f", file_sha256(full)))
        elif stat.S_ISLNK(st.st_mode):
            entries.append(link_entry(path, os.readlink(full)))
        elif not stat.S_ISDIR(st.st_mode):
            raise Refused(f"not a file, a folder or a link: {os.fsdecode(path)}")
    return digest_of(entries)


def manifest_tar(stream):
    entries = []
    with tarfile.open(fileobj=stream, mode="r|") as tar:
        for m in tar:
            path = os.fsencode(m.name)
            if m.isreg():
                h = hashlib.sha256()
                f = tar.extractfile(m)
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
                entries.append((path, "x" if m.mode & 0o100 else "f", h.hexdigest()))
            elif m.issym():
                entries.append(link_entry(path, os.fsencode(m.linkname)))
            elif not m.isdir():
                raise Refused(f"not a file, a folder or a link: {m.name}")
    return digest_of(entries)


def git_env(extra=None):
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null", GIT_TERMINAL_PROMPT="0", LC_ALL="C")
    env.update(extra or {})
    return env


def git(repo, *args, env=None, check=False):
    r = subprocess.run(["git", *GIT_SAFE, "-C", repo, *args], env=git_env(env), stdin=subprocess.DEVNULL,
                       capture_output=True)
    if check and r.returncode != 0:
        raise Refused(r.stderr.decode("utf-8", "replace").strip().splitlines()[-1:][0] if r.stderr.strip()
                      else f"git {args[0]} failed")
    return r


def manifest_rev(repo, rev):
    p = subprocess.Popen(["git", *GIT_SAFE, "-C", repo, "archive", "--format=tar", rev], env=git_env(),
                         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        digest = manifest_tar(p.stdout)
    finally:
        p.stdout.close()
        err = p.stderr.read()
        p.wait()
    if p.returncode != 0:
        raise Refused(err.decode("utf-8", "replace").strip() or f"{rev} can't be read")
    return digest


def split_tag(raw):
    if len(raw) > TAG_MAX:
        raise Refused("the release tag is too large to be one")
    at = raw.find(b"\n" + SIG_START)
    if at < 0:
        if b"-----BEGIN SSH SIGNATURE-----" in raw:
            raise Refused("the release tag is signed with an SSH key; kuwai releases are signed with an OpenPGP key in release-signers")
        raise Refused("the release tag isn't signed")
    payload, sig = raw[:at + 1], raw[at + 1:]
    head, _, message = payload.partition(b"\n\n")
    fields = {}
    for line in head.split(b"\n"):
        key, _, value = line.partition(b" ")
        fields.setdefault(key.decode("ascii", "replace"), value.decode("utf-8", "replace"))
    return payload, sig, fields, message


def tree_digest(message):
    found = TREE_LINE.findall(message)
    if len(found) != 1:
        raise Refused("the release tag doesn't name the digest of its files (release tags are made with kuwai release)")
    return found[0].decode()


def check_fields(fields, name):
    if fields.get("tag") != name:
        raise Refused(f"the tag called {name} was made as {fields.get('tag')!r}")
    if fields.get("type") != "commit":
        raise Refused(f"{name} doesn't name a commit")


def signer_of(status, trusted):
    seen, valid = set(), []
    for line in status.splitlines():
        parts = line.split()
        if len(parts) < 2 or parts[0] != "[GNUPG:]":
            continue
        seen.add(parts[1])
        if parts[1] == "VALIDSIG" and len(parts) >= 11:
            if parts[9] in WEAK_HASHES:
                raise Refused("the release tag is signed with a hash too weak to trust")
            valid.append((parts[11] if len(parts) > 11 else parts[2]).upper())
    if "NO_PUBKEY" in seen:
        raise Refused("the release tag is signed by a key that isn't a kuwai release key")
    if seen & BAD_STATUS:
        raise Refused("the release tag's signature doesn't check out")
    for fpr in valid:
        if fpr in trusted:
            return fpr
    if valid:
        raise Refused(f"the release tag is signed by a key that isn't a kuwai release key ({valid[0]})")
    raise Refused("the release tag isn't signed by a kuwai release key")


def asc_files(dirs):
    files = []
    for d in dirs:
        if os.path.isdir(d):
            files += sorted(os.path.join(d, f) for f in os.listdir(d)
                            if f.endswith(".asc") and os.path.isfile(os.path.join(d, f)))
    if not files:
        raise Refused("release-signers holds no key, so no release can be checked (release-signers/README says how one is added)")
    return files


class Gnupg:
    """A keyring of the release keys alone, in a GNUPGHOME of its own that is gone afterwards."""

    def __enter__(self):
        self.home = tempfile.mkdtemp(prefix="kuwai-verify-")
        os.chmod(self.home, 0o700)
        return self

    def gpg(self, *args):
        return subprocess.run(["gpg", "--homedir", self.home, "--batch", "--quiet", "--no-tty", *args],
                              stdin=subprocess.DEVNULL, capture_output=True, env={**os.environ, "LC_ALL": "C"})

    def take(self, dirs):
        self.gpg("--import-options", "import-minimal", "--import", *asc_files(dirs))
        fprs, want = set(), False
        for line in self.gpg("--with-colons", "--fixed-list-mode", "--list-keys").stdout.decode().splitlines():
            f = line.split(":")
            if f[0] == "pub":
                want = True
            elif f[0] == "fpr" and want and len(f) > 9:
                fprs.add(f[9].upper())
                want = False
            elif f[0] == "sub":
                want = False
        if not fprs:
            raise Refused("release-signers holds no key gpg can read")
        return fprs

    def __exit__(self, *exc):
        subprocess.run(["gpgconf", "--homedir", self.home, "--kill", "all"], stdin=subprocess.DEVNULL, capture_output=True)
        shutil.rmtree(self.home, ignore_errors=True)


def verify_tag(repo, name, ref, dirs):
    version(name)
    ref = ref or f"refs/tags/{name}"
    kind = git(repo, "cat-file", "-t", ref)
    if kind.returncode != 0:
        raise Refused(f"there is no {name} here")
    if kind.stdout.strip() != b"tag":
        raise Refused(f"{name} is a plain tag: it isn't signed by anyone")
    raw = git(repo, "cat-file", "tag", ref, check=True).stdout
    _, _, fields, message = split_tag(raw)
    check_fields(fields, name)
    digest = tree_digest(message)
    with Gnupg() as g:
        trusted = g.take(dirs)
        r = git(repo, "verify-tag", "--raw", ref, env={"GNUPGHOME": g.home})
        signer = signer_of(r.stderr.decode("utf-8", "replace"), trusted)
        if r.returncode != 0:
            raise Refused("the release tag's signature doesn't check out")
    if manifest_rev(repo, ref) != digest:
        raise Refused(f"{name}'s files aren't the ones its signature names")
    commit = git(repo, "rev-parse", f"{ref}^{{commit}}", check=True).stdout.decode().strip()
    return {"name": name, "commit": commit, "digest": digest, "signer": signer, "raw": raw}


def plain_source(source):
    if not source or source.startswith("-") or "\n" in source:
        raise Refused(f"{source!r} isn't a place to fetch kuwai from")
    return source


def newest(source):
    r = subprocess.run(["git", *GIT_SAFE, "ls-remote", "--tags", "--refs", plain_source(source), "refs/tags/v*"],
                       env=git_env(), stdin=subprocess.DEVNULL, capture_output=True)
    if r.returncode != 0:
        raise Refused("couldn't list the releases there (offline?)")
    names = [line.split("refs/tags/", 1)[1] for line in r.stdout.decode().splitlines() if "refs/tags/" in line]
    names = [n for n in names if NAME.match(n)]
    if not names:
        raise Refused("there is no release there yet")
    return max(names, key=version)


def fetch(source, name, dirs, into):
    plain_source(source)
    name = name or newest(source)
    version(name)
    asc_files(dirs)
    os.makedirs(os.path.dirname(os.path.abspath(into)), exist_ok=True)
    os.mkdir(into, 0o700)
    init = subprocess.run(["git", *GIT_SAFE, "init", "-q", into], env=git_env(), stdin=subprocess.DEVNULL, capture_output=True)
    if init.returncode != 0:
        raise Refused("couldn't make a folder to check the release in")
    git(into, "fetch", "-q", "--no-tags", "--depth=1", source, f"+refs/tags/{name}:refs/tags/{name}", check=True)
    info = verify_tag(into, name, None, dirs)
    git(into, "checkout", "-q", "--detach", f"refs/tags/{name}", check=True)
    if manifest_dir(into) != info["digest"]:
        raise Refused(f"the checked-out files aren't the ones {name}'s signature names")
    tag_file = os.path.join(into, ".git", "kuwai-release.tag")
    fd = os.open(tag_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(info.pop("raw"))
    git(into, "remote", "add", "origin", source, check=True)
    return {**info, "tree": os.path.abspath(into), "tagFile": tag_file}


def sysroot():
    if os.geteuid() == 0:
        return ""
    root = os.environ.get("KUWAI_SYSROOT", "")
    if not root:
        raise Refused("this part runs as root (sudo or pkexec)")
    return os.path.realpath(root)


def lib():
    return sysroot() + "/usr/local/lib/kuwai"


def secure(path, top):
    """path and every folder from top down to it: no link, owned by root (the caller, under a
    stand-in root), writable by no one else."""
    uid = os.geteuid()
    rel = os.path.relpath(path, top)
    cur = top
    for part in [""] + ([] if rel == "." else rel.split(os.sep)):
        cur = os.path.join(cur, part) if part else cur
        st = os.lstat(cur)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != uid or st.st_mode & 0o022:
            raise Refused(f"{cur} isn't root's alone, so nothing in it is trusted")


def root_folder(path, top):
    os.makedirs(path, mode=0o755, exist_ok=True)
    secure(path, top)
    os.chmod(path, 0o755)


def owned_tree(top):
    uid = os.geteuid()
    for path, st in walk(top):
        if st.st_uid != uid or (not stat.S_ISLNK(st.st_mode) and st.st_mode & 0o022):
            raise Refused(f"{os.fsdecode(path)} in root's copy isn't root's alone")


def read_small(path, limit=TAG_MAX):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise Refused(f"not a plain file: {path}")
        data = f.read(limit + 1)
    if len(data) > limit:
        raise Refused(f"too large: {path}")
    return data


def write_new(path, data, mode):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
        f.flush()
        os.fchmod(f.fileno(), mode)
        os.fsync(f.fileno())


def write_atomic(path, data, mode):
    tmp = f"{path}.{secrets.token_hex(6)}.new"
    write_new(tmp, data, mode)
    os.replace(tmp, path)


def copy_file(src, dst):
    fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(fd, "rb") as r:
        st = os.fstat(r.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_size > FILE_MAX:
            raise Refused(f"not a plain file: {os.fsdecode(src)}")
        out = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(out, "wb") as w:
            shutil.copyfileobj(r, w, 1 << 20)
            os.fchmod(w.fileno(), 0o755 if st.st_mode & 0o100 else 0o644)


def copy_tree(src, dst, links=True):
    """src (anyone's) into a new dst, entry by entry: links never followed, each file read
    through one descriptor; a link is kept only when it stays inside the tree."""
    srcb, dstb = os.fsencode(src), os.fsencode(dst)
    os.mkdir(dstb, 0o700)
    for path, st in walk(src):
        s, d = os.path.join(srcb, path), os.path.join(dstb, path)
        if stat.S_ISDIR(st.st_mode):
            os.mkdir(d, 0o755)
            os.chmod(d, 0o755)
        elif stat.S_ISREG(st.st_mode):
            copy_file(s, d)
        elif stat.S_ISLNK(st.st_mode) and links:
            target = os.readlink(s)
            inside = os.path.normpath(os.path.join(os.path.dirname(path), target))
            if os.path.isabs(target) or inside == b".." or inside.startswith(b"../"):
                raise Refused(f"{os.fsdecode(path)} points outside the release")
            os.symlink(target, d)
        else:
            raise Refused(f"not a file or a folder: {os.fsdecode(path)}")
    os.chmod(dstb, 0o755)


def dearmor(paths):
    out = b""
    for p in paths:
        for block in ARMOR.findall(read_small(p, 1 << 20).decode("ascii", "replace")):
            lines = block.replace("\r", "").split("\n")
            body = lines[lines.index("") + 1:] if "" in lines else lines
            out += base64.b64decode("".join(l for l in body if l and not l.startswith("=")), validate=True)
    if not out or not out[0] & 0x80:
        raise Refused("release-signers holds no key")
    return out


def packets(data):
    """Each OpenPGP packet in data as (tag, body), RFC 9580 section 4.2."""
    i = 0
    try:
        while i < len(data):
            b = data[i]
            if not b & 0x80:
                raise Refused("release-signers holds something that isn't an OpenPGP key")
            if b & 0x40:
                tag, first = b & 0x3F, data[i + 1]
                if first < 192:
                    n, i = first, i + 2
                elif first < 224:
                    n, i = ((first - 192) << 8) + data[i + 2] + 192, i + 3
                elif first == 255:
                    n, i = int.from_bytes(data[i + 2:i + 6], "big"), i + 6
                else:
                    raise Refused("release-signers holds a key kuwai can't read")
            else:
                tag, size = (b >> 2) & 0x0F, b & 3
                if size == 3:
                    raise Refused("release-signers holds a key kuwai can't read")
                width = 1 << size
                n, i = int.from_bytes(data[i + 1:i + 1 + width], "big"), i + 1 + width
            body = data[i:i + n]
            if len(body) != n:
                raise Refused("release-signers holds a key that is cut short")
            i += n
            yield tag, body
    except IndexError:
        raise Refused("release-signers holds a key that is cut short") from None


KEY_HASH = {4: (b"\x99", 2, hashlib.sha1), 5: (b"\x9a", 4, hashlib.sha256), 6: (b"\x9b", 4, hashlib.sha256)}


def key_fingerprints(data):
    """The fingerprint of every primary key in data, as gpg prints it."""
    fprs = set()
    for tag, body in packets(data):
        if tag != 6:
            continue
        if not body or body[0] not in KEY_HASH:
            raise Refused("release-signers holds a key of a version kuwai can't read")
        mark, width, algo = KEY_HASH[body[0]]
        fprs.add(algo(mark + len(body).to_bytes(width, "big") + body).hexdigest().upper())
    if not fprs:
        raise Refused("release-signers holds no key")
    return fprs


def release_keyring(tree, work):
    """A keyring of the keys tree's release-signers lists, and their fingerprints."""
    data = dearmor(asc_files([os.path.join(tree, "release-signers")]))
    listed = key_fingerprints(data)
    keyring = os.path.join(work, "keyring.gpg")
    write_new(keyring, data, 0o644)
    return keyring, listed


def stored_signers(signers):
    path = os.path.join(signers, "fingerprints")
    if not os.path.lexists(path):
        return None
    fprs = {l.strip() for l in read_small(path).decode().splitlines() if l.strip()}
    if not fprs or not all(FPR.match(f) for f in fprs):
        raise Refused("root's list of release keys can't be read")
    return fprs


def gpgv(raw, name, digest, keyring, trusted, work):
    payload, sig, fields, message = split_tag(raw)
    check_fields(fields, name)
    if tree_digest(message) != digest:
        raise Refused(f"the digest asked for isn't the one {name}'s tag names")
    home = os.path.join(work, "gnupg")
    os.mkdir(home, 0o700)
    write_new(os.path.join(work, "payload"), payload, 0o600)
    write_new(os.path.join(work, "payload.sig"), sig, 0o600)
    r = subprocess.run([GPGV, "--homedir", home, "--status-fd", "1", "--keyring", keyring,
                        os.path.join(work, "payload.sig"), os.path.join(work, "payload")],
                       env=ROOT_ENV, stdin=subprocess.DEVNULL, capture_output=True)
    signer = signer_of(r.stdout.decode("utf-8", "replace"), trusted)
    if r.returncode != 0:
        raise Refused("the release tag's signature doesn't check out")
    return signer


def current_name(base):
    link = os.path.join(base, "current")
    if not os.path.lexists(link):
        return None
    target = os.readlink(link)
    name = target[len("releases/"):] if target.startswith("releases/") else ""
    version(name)
    return name


def install(src, tag_file, name, digest, asked, allow_older):
    version(name)
    if not HEX64.match(digest or ""):
        raise Refused("--digest is the release's tree sha256")
    asked = {a.upper() for a in asked}
    if not all(FPR.match(a) for a in asked):
        raise Refused("--signer is a key's full fingerprint")
    top = sysroot() or "/"
    base = lib()
    root_folder(base, top)
    signers = os.path.join(base, "signers")
    trusted = stored_signers(signers) if os.path.isdir(signers) else None
    first = trusted is None
    if first and not asked:
        raise Refused("root trusts no release key yet: name the release key's fingerprint (--signer)")
    if not first and asked - trusted:
        raise Refused("root takes a new release key only from a release signed by one it already trusts "
                      "(release-signers/README, Changing keys)")
    trusted = asked if first else trusted
    work = tempfile.mkdtemp(prefix=".incoming-", dir=base)
    try:
        tree = os.path.join(work, "tree")
        copy_tree(src, tree)
        raw = read_small(tag_file)
        keyring, listed = release_keyring(tree, work)
        signer = gpgv(raw, name, digest, keyring, trusted, work)
        if manifest_dir(tree) != digest:
            raise Refused(f"root's copy isn't the tree {name}'s signature names")
        current = current_name(base)
        older = bool(current) and version(name) < version(current)
        if older and not allow_older:
            raise Refused(f"{name} is older than root's {current}; nothing changed")
        adopted = trusted & listed if older else listed
        releases = os.path.join(base, "releases")
        root_folder(releases, top)
        dest = os.path.join(releases, name)
        if os.path.lexists(dest):
            os.rename(dest, os.path.join(work, "old"))
        os.rename(tree, dest)
        write_atomic(dest + ".tag", raw, 0o644)
        root_folder(signers, top)
        write_atomic(os.path.join(signers, "fingerprints"), ("\n".join(sorted(adopted)) + "\n").encode(), 0o644)
        link = os.path.join(base, f".current-{secrets.token_hex(6)}")
        os.symlink(f"releases/{name}", link)
        os.replace(link, os.path.join(base, "current"))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return {"name": name, "digest": digest, "signer": signer, "path": dest}


def check(tree):
    top = sysroot() or "/"
    base = lib()
    real = os.path.realpath(tree)
    name = os.path.basename(real)
    if os.path.dirname(real) != os.path.join(base, "releases") or not NAME.match(name):
        raise Refused("this isn't root's copy of a kuwai release")
    secure(real, top)
    owned_tree(real)
    signers = os.path.join(base, "signers")
    trusted = stored_signers(signers)
    if not trusted:
        raise Refused("root trusts no release key")
    for p in (real + ".tag", os.path.join(signers, "fingerprints")):
        secure(p, top)
    raw = read_small(real + ".tag")
    digest = tree_digest(split_tag(raw)[3])
    with tempfile.TemporaryDirectory(prefix="kuwai-verify-") as work:
        keyring, _ = release_keyring(real, work)
        signer = gpgv(raw, name, digest, keyring, trusted, work)
    if manifest_dir(real) != digest:
        raise Refused(f"root's copy of {name} has changed since it was checked")
    return {"name": name, "digest": digest, "signer": signer, "path": real}


def place(what):
    if what not in PIECES:
        raise Refused(f"nothing called {what!r} is placed from a release")
    base = lib()
    name = current_name(base)
    if not name:
        raise Refused("root has no verified release of kuwai yet (kuwai setup installs one)")
    info = check(os.path.join(base, "releases", name))
    tree = info["path"]
    if what == "update-helper":
        write_atomic(os.path.join(base, "kuwai-update-root"), read_small(os.path.join(tree, "bin/kuwai-update-root"), 1 << 20), 0o755)
        return {**info, "placed": os.path.join(base, "kuwai-update-root")}
    share = sysroot() + "/usr/local/share/kuwai"
    root_folder(share, sysroot() or "/")
    dest = os.path.join(share, "shell-auth")
    new = f"{dest}.{secrets.token_hex(6)}.new"
    try:
        copy_tree(os.path.join(tree, "shell-auth"), new, links=False)
        if os.path.lexists(dest):
            old = f"{dest}.{secrets.token_hex(6)}.old"
            os.rename(dest, old)
            os.rename(new, dest)
            shutil.rmtree(old, ignore_errors=True)
        else:
            os.rename(new, dest)
    finally:
        shutil.rmtree(new, ignore_errors=True)
    return {**info, "placed": dest}


def signers_of(dirs):
    with Gnupg() as g:
        return sorted(g.take(dirs))


def main(argv):
    os.umask(0o022)
    ap = argparse.ArgumentParser(prog="kuwai-verify", add_help=False)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("manifest")
    p.add_argument("dir")
    p = sub.add_parser("manifest-rev")
    p.add_argument("repo")
    p.add_argument("rev")
    p = sub.add_parser("signers")
    p.add_argument("dirs", nargs="+")
    p = sub.add_parser("tag")
    p.add_argument("repo")
    p.add_argument("name")
    p.add_argument("--ref")
    p.add_argument("--signers", action="append", required=True)
    p = sub.add_parser("fetch")
    p.add_argument("source")
    p.add_argument("name", nargs="?")
    p.add_argument("--signers", action="append", required=True)
    p.add_argument("--into", required=True)
    p = sub.add_parser("install")
    p.add_argument("--from", dest="src", required=True)
    p.add_argument("--tag-file", required=True)
    p.add_argument("--name", required=True)
    p.add_argument("--digest", required=True)
    p.add_argument("--signer", action="append", default=[])
    p.add_argument("--allow-older", action="store_true")
    p = sub.add_parser("check")
    p.add_argument("dir")
    p = sub.add_parser("place")
    p.add_argument("what")
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    try:
        a = ap.parse_args(argv)
    except SystemExit:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        if a.cmd == "manifest":
            print(manifest_dir(a.dir))
        elif a.cmd == "manifest-rev":
            print(manifest_rev(a.repo, a.rev))
        elif a.cmd == "signers":
            print("\n".join(signers_of(a.dirs)))
        elif a.cmd == "tag":
            info = verify_tag(a.repo, a.name, a.ref, a.signers)
            info.pop("raw")
            print(json.dumps(info))
        elif a.cmd == "fetch":
            print(json.dumps(fetch(a.source, a.name, a.signers, a.into)))
        elif a.cmd == "install":
            info = install(a.src, a.tag_file, a.name, a.digest, a.signer, a.allow_older)
            print(f"Root's copy of kuwai is {info['name']} now: checked by root, signed by {info['signer']}, "
                  f"tree sha256 {info['digest']}.")
        elif a.cmd == "check":
            info = check(a.dir)
            print(f"kuwai {info['name']}: root's copy is as signed by {info['signer']}.")
        elif a.cmd == "place":
            info = place(a.what)
            print(json.dumps({"placed": info["placed"], "release": info["name"]}))
    except (Refused, OSError, ValueError) as ex:
        print(f"kuwai: {ex}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
