#!/usr/bin/env bash
# Screenshots for the rice, in place of HyDE's script (hypr/kuwai/binds.lua).
#
#   rice-shot area      pick a region, then annotate it in Satty (Super+P)
#   rice-shot quick     pick a region, done: copied and saved, no editor; the
#                       clipboard island shows it (Super+Alt+P)
#   rice-shot window    the window you're in (Super+Ctrl+Alt+P)
#   rice-shot delay     this monitor in 3 s, for menus that close on a click (Shift+Print)
#   rice-shot ocr       pick a region; its text is copied, not the picture (Super+Shift+Alt+P)
#   rice-shot freeze    freeze the screen, then pick (Super+Ctrl+P)
#   rice-shot monitor   the focused monitor (Super+Ctrl+Shift+P)
#   rice-shot all       every monitor (Print)
#
# The shot goes on the clipboard at once (the clipboard island shows it) and
# is saved to ~/Pictures/Screenshots; then Satty opens on it to annotate,
# floating and centred, and gets the keyboard: Super+Q closes Satty, not the
# window under the mouse (HyDE's script left focus wherever the mouse was).
# Cancelling the selection is not an error: nothing is said.
set -uo pipefail

mode="${1:-area}"
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
out="$dir/Screenshot_$(date +%Y%m%d_%H%M%S).png"

# Our own region pick (grimblast's, through slurp, let a click that moved a
# pixel or two turn into a tiny drag: "only a small part comes"). Visible
# windows are offered as boxes; a click selects one; a drag selects a region;
# a "drag" smaller than 16 px is taken as the click it was meant to be.
pick() {
    local ws boxes geo x y w h
    ws=$(hyprctl -j monitors | jq -c '[.[] | .activeWorkspace.id, .specialWorkspace.id] | map(select(. != 0))')
    boxes=$(hyprctl -j clients | jq -r --argjson ws "$ws" \
        '.[] | select(.hidden | not) | select(.workspace.id as $w | $ws | index($w)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    geo=$(printf '%s\n' "$boxes" | slurp -d 2>/dev/null) || return 1
    read -r x y w h <<<"$(printf '%s' "$geo" | sed -E 's/^(-?[0-9]+),(-?[0-9]+) ([0-9]+)x([0-9]+)$/\1 \2 \3 \4/')"
    if [ "${w:-0}" -lt 16 ] && [ "${h:-0}" -lt 16 ]; then
        local hit
        hit=$(printf '%s\n' "$boxes" | awk -v px="$x" -v py="$y" '{ split($1, a, ","); split($2, b, "x");
            if (px >= a[1] && px < a[1] + b[1] && py >= a[2] && py < a[2] + b[2]) { print; exit } }')
        [ -n "$hit" ] && geo="$hit" || return 1
    fi
    printf '%s\n' "$geo"
}

# area/quick/freeze: pick, then grim the region; the rest go through grimblast.
if [ "$mode" = area ] || [ "$mode" = quick ] || [ "$mode" = freeze ]; then
    frz=""
    if [ "$mode" = freeze ]; then hyprpicker -r -z >/dev/null 2>&1 & frz=$!; sleep 0.15; fi
    geo=$(pick); ok=$?
    [ -n "$frz" ] && kill "$frz" 2>/dev/null
    [ $ok -eq 0 ] && [ -n "$geo" ] || exit 0                      # cancelled
    if ! grim -g "$geo" "$out" 2>/dev/null || [ ! -s "$out" ]; then
        rm -f -- "$out"; notify-send -a "Screenshot" "Screenshot failed" "grim couldn't capture $geo"; exit 0
    fi
    wl-copy --type image/png < "$out"
    case "$mode" in quick) exit 0 ;; esac
    args=()
fi

case "$mode" in
    area|quick|freeze) ;;
    window)  args=(copysave active) ;;
    delay)   args=(--wait 3 copysave output) ;;
    ocr)
        tmp=$(mktemp --suffix=.png)
        if grimblast save area "$tmp" >/dev/null 2>&1 </dev/null && [ -s "$tmp" ]; then
            text=$(tesseract "$tmp" - 2>/dev/null | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
            if [ -n "$text" ]; then
                printf '%s' "$text" | wl-copy
            else
                notify-send -a "Screenshot" "No text found" "Nothing readable in that region."
            fi
        fi
        rm -f -- "$tmp"; exit 0 ;;
    monitor) args=(copysave output) ;;
    all)     args=(copysave screen) ;;
    *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

# A cancelled selection (Esc, right click: slurp says "selection
# cancelled") is the user changing their mind: leave quietly. Anything else
# is a real failure and says so, with grimblast's own words.
# Errors go to a file, not a pipe: grimblast leaves wl-copy running in the
# background to serve the clipboard, and it would hold a pipe open, so
# waiting for grimblast's output would wait until the next copy.
errf=$(mktemp)
rc=0
if [ ${#args[@]} -gt 0 ]; then
    grimblast "${args[@]}" "$out" >/dev/null 2>"$errf" </dev/null
    rc=$?
fi
err=$(cat "$errf"); rm -f -- "$errf"
if [ $rc -ne 0 ] || [ ! -s "$out" ]; then
    rm -f -- "$out"
    if [ -n "$err" ] && ! printf '%s' "$err" | grep -qi "cancel"; then
        notify-send -a "Screenshot" -u normal "Screenshot failed" "$(printf '%s' "$err" | tail -3)"
    fi
    exit 0
fi

# Quick: the shot is on the clipboard and on disk; that's all.
case "$mode" in quick|window|delay) exit 0 ;; esac

log="${XDG_STATE_HOME:-$HOME/.local/state}/rice/rice-shot.log"
# Copying keeps the editor open (copy, annotate more, copy again); Enter copies
# and closes, Esc closes, saving still exits. A bare --early-exit used to close
# Satty on every copy (0.21: it means "after any action").
satty --filename "$out" --output-filename "$out" --copy-command wl-copy \
    --early-exit save --actions-on-enter save-to-clipboard,exit --actions-on-escape exit >>"$log" 2>&1 &
pid=$!

# Give Satty the keyboard once it's on screen.
for _ in $(seq 60); do
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .address' | head -1)
    if [ -n "$addr" ]; then
        hyprctl dispatch "hl.dsp.focus({window = 'address:$addr'})" >/dev/null
        break
    fi
    sleep 0.05
done
wait "$pid"
