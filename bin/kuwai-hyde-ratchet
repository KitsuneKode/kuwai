#!/usr/bin/env python3
"""Static HyDE dependency ratchet (docs/design/WITHOUT-HYDE.md).

Counts runtime files under shell/, hypr/, bin/, lib/, greeter/, and install.sh
that still mention HyDE markers (hyde, wallbash, wall.set, wall.dcol, staterc).
Dedicated adapter files are tracked separately from non-adapter files so the
non-adapter count can only shrink toward zero.

Usage:
  kuwai-hyde-ratchet            print counts and baseline
  kuwai-hyde-ratchet --check    exit 1 if any count went UP from the baseline
  kuwai-hyde-ratchet --update   lower the baseline to today's counts (never raises)
  kuwai-hyde-ratchet --list     list every matching file
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BASE = os.path.join(ROOT, "docs", "design", "hyde-baseline.json")

SCAN_DIRS = ("shell", "hypr", "bin", "lib", "greeter")
SCAN_FILES = ("install.sh",)
SKIP_FILES = {"bin/kuwai-nohyde", "bin/kuwai-hyde-ratchet"}
ADAPTER_FILES = {
    "hypr/kuwai/hyde.lua",
    "shell/services/Hyde.qml",
    "lib/hyde.sh",
    "bin/kuwai-themes",
    "bin/kuwai-hyde-waybar",
}
HYDE_RE = re.compile(r"hyde|wallbash|wall\.set|wall\.dcol|staterc", re.I)


def iter_files():
    for rel in SCAN_FILES:
        p = os.path.join(ROOT, rel)
        if os.path.isfile(p):
            yield rel, p
    for area in SCAN_DIRS:
        base = os.path.join(ROOT, area)
        if not os.path.isdir(base):
            continue
        for d, dirs, files in os.walk(base):
            dirs[:] = sorted(x for x in dirs if x != "__pycache__")
            for f in sorted(files):
                p = os.path.join(d, f)
                if os.path.islink(p) or not os.path.isfile(p):
                    continue
                rel = os.path.relpath(p, ROOT)
                if rel in SKIP_FILES:
                    continue
                yield rel, p


def hits():
    adapters = []
    other = []
    for rel, p in iter_files():
        try:
            data = open(p, "rb").read()
        except OSError:
            continue
        if b"\x00" in data:
            continue
        text = data.decode("utf-8", errors="replace")
        if HYDE_RE.search(text):
            if rel in ADAPTER_FILES:
                adapters.append(rel)
            else:
                other.append(rel)
    return sorted(adapters), sorted(other)


def main():
    adapters, other = hits()
    now = {"non_adapter_files": len(other), "adapter_files": len(adapters)}
    try:
        base = json.load(open(BASE))
    except (OSError, ValueError):
        base = {}
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--list":
        for rel in other:
            print(f"non-adapter  {rel}")
        for rel in adapters:
            print(f"adapter      {rel}")
        return 0
    if arg == "--update" or not base:
        new = {k: min(now[k], base.get(k, now[k])) for k in now}
        os.makedirs(os.path.dirname(BASE), exist_ok=True)
        with open(BASE, "w") as f:
            json.dump(new, f, indent=2)
            f.write("\n")
        print("baseline:", new)
        return 0
    up = {k: (base[k], now[k]) for k in now if k in base and now[k] > base[k]}
    if arg == "--check":
        if up:
            print("; ".join(f"{k} {a} → {b}" for k, (a, b) in up.items()))
            return 1
        down = [k for k in now if k in base and now[k] < base[k]]
        print(
            "hyde: "
            + ", ".join(f"{k} {now[k]}" for k in now)
            + (" (lower than the baseline: kuwai-hyde-ratchet --update)" if down else "")
        )
        return 0
    print("now:     ", now)
    print("baseline:", base)
    return 0


if __name__ == "__main__":
    sys.exit(main())
