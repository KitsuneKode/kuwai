#!/usr/bin/env python3
"""Design-token ratchet for the shell (docs/design/STATES.md).

Counts what should come from Theme but is typed by hand:
  sizes      `size:` / `font.pixelSize:` numbers off the type scale
  durations  `duration: <number>` (motion tokens live in Theme)
  hex        raw "#rrggbb" colours outside shell/config
  white      a hand-typed white overlay (Qt.rgba(1, 1, 1, ≤ 0.3)) outside shell/config:
             fills take Theme.wash(step), borders Theme.edge(step)

  kuwai-tokens            print the counts and the baseline
  kuwai-tokens --check    exit 1 if any count went UP from the baseline
  kuwai-tokens --update   lower the baseline to today's counts (never raises it)
  kuwai-tokens --list     print each counted literal as kind file:line value

The baseline is docs/design/tokens-baseline.json. Migrations lower it; new
literals fail kuwai-check, so the drift can only shrink.
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SHELL = os.path.join(ROOT, "shell")
BASE = os.path.join(ROOT, "docs", "design", "tokens-baseline.json")
SCALE = {10, 11, 12, 13, 14, 15, 18, 20, 24}

SIZE = re.compile(r"\b(?:size|font\.pixelSize)\s*:\s*(\d+)\b")
DUR = re.compile(r"\bduration\s*:\s*\d+\b")
HEX = re.compile(r'"#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?"')
WHITE = re.compile(r"Qt\.rgba\(\s*1\s*,\s*1\s*,\s*1\s*,\s*(\d*\.\d+|0)\s*\)")
EASING = re.compile(r"\bEasing\.(?:OutCubic|InOutCubic|InCubic|OutQuad|InOutQuad|InQuad|OutQuart|InOutQuart|OutSine|InOutSine|OutExpo)\b")


def literals():
    """Yield (kind, path, line, value) for every literal the ratchet counts."""
    for d, dirs, files in os.walk(SHELL):
        dirs.sort()
        for f in sorted(files):
            if not f.endswith(".qml"):
                continue
            p = os.path.join(d, f)
            text = open(p, encoding="utf-8", errors="replace").read()
            code = "\n".join(l.split("//")[0] if not l.lstrip().startswith("//") else "" for l in text.split("\n"))
            line = lambda m: code.count("\n", 0, m.start()) + 1
            for m in SIZE.finditer(code):
                if int(m.group(1)) not in SCALE:
                    yield "sizes", p, line(m), m.group(0)
            for m in DUR.finditer(code):
                yield "durations", p, line(m), m.group(0)
            if os.sep + "config" + os.sep not in p:
                for m in HEX.finditer(code):
                    yield "hex", p, line(m), m.group(0)
                for m in WHITE.finditer(code):
                    if float(m.group(1)) <= 0.3:
                        yield "white", p, line(m), m.group(0)
                for m in EASING.finditer(code):
                    yield "easings", p, line(m), m.group(0)


def count():
    c = {"sizes": 0, "durations": 0, "hex": 0, "white": 0, "easings": 0}
    for kind, *_ in literals():
        c[kind] += 1
    return c


def main():
    now = count()
    try:
        base = json.load(open(BASE))
    except (OSError, ValueError):
        base = {}
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--list":
        for kind, p, n, v in literals():
            print(f"{kind:9} {os.path.relpath(p, ROOT)}:{n}  {v}")
        return 0
    if arg == "--update" or not base:
        new = {k: min(now[k], base.get(k, now[k])) for k in now}
        os.makedirs(os.path.dirname(BASE), exist_ok=True)
        with open(BASE, "w") as f:
            json.dump(new, f, indent=2)
            f.write("\n")
        print("baseline:", new)
        return 0
    up = {k: (base[k], now[k]) for k in now if k in base and now[k] > base[k]}
    if arg == "--check":
        if up:
            print("; ".join(f"{k} {a} → {b}" for k, (a, b) in up.items()))
            return 1
        down = [k for k in now if k in base and now[k] < base[k]]
        print("tokens: " + ", ".join(f"{k} {now[k]}" for k in now) + (" (lower than the baseline: kuwai-tokens --update)" if down else ""))
        return 0
    print("now:     ", now)
    print("baseline:", base)
    return 0


if __name__ == "__main__":
    sys.exit(main())
