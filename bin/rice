#!/usr/bin/env bash
# Control the running rice.
#
#   rice start|restart        (re)start the shell, take over notifications
#   rice stop                 stop it (dunst takes notifications back)
#   rice logs                 follow the shell's log
#   rice notifs <cmd>         dnd | dnd-on | dnd-off | mute-on | mute-off | clear | hide | open | last | count | waybar
#   rice feeds [status|gmail-setup|gmail-forget|logs]   GitHub and Gmail notifications (bin/rice-feeds)
#   rice center [agents] [pointer]   toggle the center (Notifications or Agents);
#                             `pointer` (the bell) morphs it, keys open it instantly
#   rice assistant [here|open] toggle the AI assistant; `here` opens it about the focused window
#   rice bar [island|waybar]  which top bar: the rice's island or HyDE's Waybar
#   rice lock [--wait]        lock with the rice's lock screen (--wait: until it is locked; hyprlock if the shell is down)
#   rice fade [start|stop]    darken the screens before the idle lock
#   rice timer 10m [label]    a timer in the island (cancel · list)
#   rice pomodoro             start/stop 25/5 focus cycles
#   rice remind in 20m tea    a reminder ("at 5 call mum", "tomorrow 9am x"; list · clear)
#   rice settings [page]      open Settings (power, saver, time, notifs, island, …)
#   rice usage                agent usage limits in the island (Claude, Codex, … windows and resets)
#   rice alarm 7:30 [label]   an alarm (wakes the laptop with system/install; list · clear · stop · snooze)
#   rice note buy milk        a line in ~/Notes/inbox.md (no text: open it)
#   rice screensaver          show the screensaver now (it also comes on idle while Caffeine is on)
#   rice saver add FILE [name]  make a video a screensaver film (seamless loop + thumbnail); list · remove
#   rice set KEY VALUE        change a setting (~/.config/rice/settings.json)
#   rice get [KEY]            print one setting, or all of them
#   rice channel [stable|dev] run from the stable copy (~/.local/share/kuwai) or the repo
#   rice promote [--force]    move stable up to the repo's latest commit (and reload it), after rice-check
#   rice check                is the running shell healthy (load, orphans, idle, memory, cpu)
#   rice doctor               kuwai + notifications + shell + feeds (before promote)
#
# `notifs` falls back to dunstctl when the rice isn't the notification server,
# so Waybar and keybinds keep working either way.
set -u

RICE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SHELL_DIR="$RICE/shell"

ipc() { qs ipc -p "$SHELL_DIR" call "$@" 2>/dev/null; }

rice_owns_notifications() {
    local pid
    pid=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
        GetConnectionUnixProcessID s org.freedesktop.Notifications 2>/dev/null | awk '{print $2}')
    [ -n "$pid" ] && [ "$(cat /proc/"$pid"/comm 2>/dev/null)" != "dunst" ]
}

dunst_waybar() {
    # Same JSON shape as the rice's, from dunst's history and pause state.
    # Only if dunst is already running: dunstctl would otherwise make D-Bus
    # launch it, racing the rice for the notification name during a restart.
    if ! pgrep -x dunst >/dev/null; then
        printf '{"text":"","alt":"none","class":"none","tooltip":"Notifications starting…"}\n'
        return
    fi
    local count paused alt
    count=$(dunstctl count history 2>/dev/null || echo 0)
    paused=$(dunstctl is-paused 2>/dev/null || echo false)
    if [ "$paused" = true ]; then alt=dnd; [ "$count" -gt 0 ] && alt=dnd-notification
    else alt=none; [ "$count" -gt 0 ] && alt=notification; fi
    printf '{"text":"%s","alt":"%s","class":"%s","tooltip":"󰎟 Notifications (dunst fallback)"}\n' "$count" "$alt" "$alt"
}

SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/rice/settings.json"

# Settings are JSON the shell watches: write the file, the shell follows.
# Values parse as JSON when they can (true, 220, "x"), else as a string.
set_setting() {
    local key=$1 value=$2 tmp
    mkdir -p "$(dirname "$SETTINGS")"
    [ -s "$SETTINGS" ] || echo '{}' > "$SETTINGS"
    tmp=$(mktemp "$SETTINGS.XXXXXX")
    if jq -e . >/dev/null 2>&1 <<<"$value"; then
        jq --arg k "$key" --argjson v "$value" '.[$k] = $v' "$SETTINGS" > "$tmp"
    else
        jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$SETTINGS" > "$tmp"
    fi && mv -- "$tmp" "$SETTINGS" || { rm -f -- "$tmp"; return 1; }
}

get_setting() { jq -r --arg k "$1" '.[$k] // empty' "$SETTINGS" 2>/dev/null; }

# The island bar replaces Waybar: one of the two runs. `apply` makes the
# processes match the setting (rice-shell calls it after starting).
bar() {
    case ${1:-} in
        island|waybar) set_setting bar "\"$1\"" ;;
        apply|"") ;;
        *) echo "usage: rice bar [island|waybar|apply]" >&2; return 2 ;;
    esac
    [ -z "${1:-}" ] && { get_setting bar || echo waybar; return; }
    if [ "$(get_setting bar)" = island ]; then
        pkill -x waybar 2>/dev/null
    elif ! pgrep -x waybar >/dev/null; then
        setsid -f hyde-shell waybar >/dev/null 2>&1 </dev/null
    fi
    return 0
}

notifs() {
    local cmd=${1:-}
    if rice_owns_notifications; then
        case $cmd in
            dnd)     ipc notifs toggleDnd >/dev/null ;;
            dnd-on)  ipc notifs setDnd true ;;
            dnd-off) ipc notifs setDnd false ;;
            mute-on) ipc notifs setDndMute true ;;
            mute-off) ipc notifs setDndMute false ;;
            clear)   ipc notifs clear ;;
            hide)    ipc notifs dismissPopups ;;
            open)    ipc notifs openLatest ;;
            last)    ipc notifs showLast ;;
            count)   ipc notifs count ;;
            waybar)  ipc notifs waybar ;;
            *) echo "usage: rice notifs dnd|dnd-on|dnd-off|clear|hide|open|last|count|waybar" >&2; return 2 ;;
        esac
    else
        case $cmd in
            dnd)     dunstctl set-paused toggle ;;
            dnd-on)  dunstctl set-paused true ;;
            dnd-off) dunstctl set-paused false ;;
            clear)   dunstctl history-clear ;;
            hide)    dunstctl close-all ;;
            open)    dunstctl action 0 ;;
            last)    dunstctl history-pop ;;
            count)   dunstctl count history ;;
            waybar)  dunst_waybar ;;
            *) echo "usage: rice notifs dnd|dnd-on|dnd-off|clear|hide|open|last|count|waybar" >&2; return 2 ;;
        esac
    fi
}

# Stable and dev (hypr/templates/hyprland.lua reads the channel): stable is
# ~/.local/share/kuwai, a worktree on the repo's `stable` branch; dev is the
# repo you edit. Switching reloads Hyprland and restarts the shell from the
# other copy, so keys, PATH and the shell all move together.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kuwai"
STABLE="${XDG_DATA_HOME:-$HOME/.local/share}/kuwai"
dev_root() { for d in "$HOME/Projects/kuwai" "$HOME/Projects/rice"; do [ -e "$d/hypr/init.lua" ] && { echo "$d"; return; }; done; }
switch_to() {   # $1 = the root to run from
    hyprctl reload >/dev/null 2>&1
    sleep 0.5
    # The old copy's shell: stopped by its own rice-shell's rule (kill -9).
    for pid in $(pgrep -f '^qs -p .*/shell -d$'); do
        case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
            *"$1/shell"*) ;;
            *) kill -9 "$pid" 2>/dev/null ;;
        esac
    done
    # systemd's copy (hypridle and the units run `rice` from it): Hyprland's
    # environment, which the reload just updated, exported again.
    systemctl --user set-environment KUWAI_ROOT="$1" 2>/dev/null
    hyprctl dispatch "hl.dsp.exec_cmd('dbus-update-activation-environment --systemd PATH KUWAI_ROOT')" >/dev/null 2>&1
    sleep 0.3
    exec "$1/bin/rice-shell"
}

case ${1:-} in
    channel)
        mkdir -p "$STATE_DIR"
        case ${2:-} in
            stable)
                [ -d "$STABLE/.git" ] || [ -f "$STABLE/.git" ] || { echo "rice: no stable copy at $STABLE (git worktree add $STABLE stable)" >&2; exit 1; }
                echo stable > "$STATE_DIR/channel"; switch_to "$STABLE" ;;
            dev)
                echo dev > "$STATE_DIR/channel"; switch_to "$(dev_root)" ;;
            "") cat "$STATE_DIR/channel" 2>/dev/null || echo "dev (no channel set)" ;;
            *) echo "usage: rice channel [stable|dev]" >&2; exit 2 ;;
        esac ;;
    promote)
        # Stable moves up to the repo's latest commit (fast-forward only:
        # nothing on stable is ever rewritten). Uncommitted work stays behind.
        dev=$(dev_root)
        # The running shell must be healthy first (bin/rice-check); --force skips it.
        if [ "${2:-}" != --force ] && ! "$dev/bin/rice-check" --quiet; then
            echo "rice: rice-check failed (above); fix it, or rice promote --force" >&2
            exit 1
        fi
        head=$(git -C "$dev" rev-parse HEAD) || exit 1
        # The QML that would go live must load: rice-check above only sees the
        # running shell, so a broken import in the new code took the island
        # down once. Lint just the changed files, for the fatal classes.
        # Always, even with --force (that only skips the running shell's health).
        if command -v /usr/lib/qt6/bin/qmllint >/dev/null; then
            bad=""
            for f in $(git -C "$dev" diff --name-only "$(git -C "$STABLE" rev-parse HEAD)" "$head" -- '*.qml'); do
                [ -f "$dev/$f" ] || continue
                out=$(/usr/lib/qt6/bin/qmllint --bare -I /usr/lib/qt6/qml "$dev/$f" 2>&1 | grep -E "unknown attached property scope|\[syntax\]|^Error")
                [ -n "$out" ] && bad="$bad\n$f:\n$out"
                # A property named like one of Item's anchor lines (left, top…) is
                # a FINAL override: the file won't load, and lint is silent.
                # The offscreen load test can't reach panels, so check by name.
                # Only lines this promote adds (a window's own `top` is fine and old).
                fin=$(git -C "$dev" diff -U0 "$(git -C "$STABLE" rev-parse HEAD)" "$head" -- "$f" | grep -E '^\+\s*(readonly\s+)?property\s+[A-Za-z_.<>]+\s+(left|right|top|bottom|horizontalCenter|verticalCenter|baseline)\s*[:;]')
                [ -n "$fin" ] && bad="$bad\n$f (a property named like an anchor line, a FINAL override; it won't load — rename it):\n$fin"
            done
            if [ -n "$bad" ]; then
                printf "rice: this QML wouldn't load; stable left as it is:%b\n" "$bad" >&2
                exit 1
            fi
        fi
        # A helper that streams for the shell's whole life (subscribe, monitor,
        # watch, tail -F, a while-loop) must die with it: without pdeathsig
        # every restart left one behind (127 of them and 78 polling loops,
        # 1.1 GB, found 2026-11-07).
        leak=$(git -C "$dev" grep -nE 'command: *\[.*("subscribe"|"monitor"|"--watch"|"watch"|"-F"|while :)' "$head" -- 'shell/*.qml' | grep -v pdeathsig | grep -v '"hyprctl", "monitors"')
        if [ -n "$leak" ]; then
            printf "rice: these helpers would outlive a restart (start them with setpriv --pdeathsig KILL --); stable left as it is:\n%s\n" "$leak" >&2
            exit 1
        fi
        # And it must load: a throwaway offscreen shell (bin/rice-loadtest)
        # reports what lint can't (a handler set twice, a singleton that fails).
        # The login screen too: it runs this same shell from greeter.qml.
        "$dev/bin/rice-loadtest" "$head" || { echo "rice: stable left as it is" >&2; exit 1; }
        "$dev/bin/rice-loadtest" "$head" greeter.qml || { echo "rice: the login screen wouldn't load; stable left as it is" >&2; exit 1; }
        prev=$(git -C "$STABLE" rev-parse HEAD)
        git -C "$STABLE" merge --ff-only --quiet "$head" || { echo "rice: stable can't fast-forward to $(git -C "$dev" log --oneline -1)" >&2; exit 1; }
        echo "stable is now $(git -C "$STABLE" log --oneline -1)"
        # Live, and if it doesn't load after all (what no check before could
        # see), straight back to the commit that did: a few seconds, not a
        # shell that stays down until someone notices.
        if [ "$(cat "$STATE_DIR/channel" 2>/dev/null)" = stable ]; then
            if ! ( switch_to "$STABLE" ); then
                echo "rice: the new shell didn't load; stable back to $(git -C "$STABLE" log --oneline -1 "$prev")" >&2
                # First rice-shell's wait-for-a-save retry (it would fire on the reset's own file changes).
                # Matched by its exact argv[3] ($0 = rice-shell-watch), never a
                # pattern anywhere in a command line (that killed a bystander).
                for w in $(pgrep -x bash); do
                    [ "$(tr '\0' '\n' < /proc/$w/cmdline 2>/dev/null | sed -n 4p)" = rice-shell-watch ] && kill "$w" 2>/dev/null
                done
                git -C "$STABLE" reset --hard --quiet "$prev"
                ( switch_to "$STABLE" ) && echo "rice: rolled back; fix it in dev and promote again" >&2
                exit 1
            fi
        fi ;;
    check)         exec "$RICE/bin/rice-check" "$@" ;;
    doctor)        exec "$RICE/bin/rice-doctor" "$@" ;;
    start|restart) exec "$RICE/bin/rice-shell" ;;
    stop)          for pid in $(qs list -p "$SHELL_DIR" --json 2>/dev/null | jq -r ".[].pid"); do kill -9 "$pid"; done ;;
    logs)          exec qs log -p "$SHELL_DIR" -f ;;
    notifs)        shift; notifs "$@" ;;
    feeds)         case ${2:-status} in
                       logs) exec journalctl --user -u rice-feeds.service -f ;;
                       *) exec "$RICE/bin/rice-feeds" "${2:-status}" ;;
                   esac ;;
    bar)           shift; bar "$@" ;;
    lock)
        # The shell's lock screen. --wait: return only once the compositor
        # confirms the lock (before_sleep_cmd uses it, so nothing shows
        # unlocked after a resume). The shell not running: hyprlock, so
        # locking never fails.
        if ! ipc lock lock 2>/dev/null; then
            pidof hyprlock >/dev/null || { setsid -f hyprlock >/dev/null 2>&1 </dev/null; sleep 0.5; }
            exit 0
        fi
        if [ "${2:-}" = --wait ]; then
            for _ in $(seq 60); do [ "$(ipc lock state)" = locked ] && exit 0; sleep 0.05; done
            exit 1
        fi ;;
    fade)          ipc fade "${2:-start}" >/dev/null 2>&1 ;;   # (hypridle)
    screensaver)   ipc screensaver "${2:-start}" ;;   # start it now (any input dismisses) · stop
    saver)
        # Screensaver films: ~/.local/share/rice/screensavers/NAME.mp4 (+ .jpg).
        # Themes → Screensaver lists every film there; this makes one well:
        # half speed, then reversed, so the loop has no seam; a little darker;
        # 24 fps, ~3–7 Mbit/s (cheap to decode); a thumbnail beside it.
        dir="${XDG_DATA_HOME:-$HOME/.local/share}/rice/screensavers"
        case ${2:-} in
            add)
                src=${3:-}; [ -f "$src" ] || { echo "usage: rice saver add FILE [name]" >&2; exit 2; }
                name=${4:-$(basename "${src%.*}")}; name=$(printf '%s' "$name" | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9-')
                [ -n "$name" ] || { echo "rice: give it a name (letters, digits, -)" >&2; exit 2; }
                mkdir -p "$dir"
                echo "making $dir/$name.mp4 (a seamless half-speed loop)…"
                ffmpeg -nostdin -v error -y -i "$src" -filter_complex \
                    "[0:v]scale='min(2560,iw)':-2,setpts=2.0*PTS,fps=24,split[a][b];[b]reverse[r];[a][r]concat=n=2:v=1,eq=brightness=-0.03:saturation=0.9,format=yuv420p[v]" \
                    -map "[v]" -an -c:v libx264 -preset slow -crf 23 -maxrate 7M -bufsize 14M -g 48 -movflags +faststart "$dir/$name.mp4" \
                    && ffmpeg -nostdin -v error -y -ss 4 -i "$dir/$name.mp4" -frames:v 1 -vf scale=480:-2 -q:v 3 "$dir/$name.jpg" \
                    && echo "✓ $name: pick it in Themes → Screensaver (or: rice set screensaverClip $name; rice set screensaverStyle night)" ;;
            remove)
                [ -n "${3:-}" ] && rm -i -- "$dir/${3}.mp4" "$dir/${3}.jpg" ;;
            ""|list)
                for f in "$dir"/*.mp4; do [ -e "$f" ] && basename "${f%.mp4}"; done ;;
            *) echo "usage: rice saver [list|add FILE [name]|remove NAME]" >&2; exit 2 ;;
        esac ;;
    pomodoro|pomo) ipc timer pomodoro ;;
    remind)
        case "${2:-list}" in
            list) ipc remind list ;;
            clear) ipc remind clear ;;
            *) ipc remind add "${*:2}" ;;
        esac ;;
    settings)      ipc island settings "${2:-}" ;;   # open Settings (on a page: power, saver, time, notifs, …)
    usage)         ipc island open usage ;;          # the Usage panel (services/Limits)
    alarm)
        case "${2:-list}" in
            list|clear|stop|snooze) ipc alarm "${2:-list}" ;;
            *) ipc alarm add "${*:2}" ;;
        esac ;;
    note)
        if [ $# -lt 2 ]; then ipc note open; else ipc note add "${*:2}"; fi ;;
    timer)         # rice timer 10m pizza · rice timer cancel · rice timer list
        case ${2:-} in
            cancel) ipc timer cancel ;;
            list|"") ipc timer list ;;
            *) ipc timer start "$2" "${*:3}" ;;
        esac ;;   # hypridle: darken before the lock (stop: any input)
    set)           [ $# -eq 3 ] || { echo "usage: rice set KEY VALUE" >&2; exit 2; }; set_setting "$2" "$3" ;;
    get)           if [ -n "${2:-}" ]; then get_setting "$2"; else jq . "$SETTINGS" 2>/dev/null || echo '{}'; fi ;;
    center)
        # Needs the shell running, not the notification name: start it if
        # it isn't up rather than doing nothing.
        if ! qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1; then
            "$RICE/bin/rice-shell" >/dev/null 2>&1
            for _ in $(seq 20); do qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1 && break; sleep 0.1; done
        fi
        ipc center toggle "${2:-notifications}" "${3:-key}" ;;
    assistant)
        if ! qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1; then
            "$RICE/bin/rice-shell" >/dev/null 2>&1
            for _ in $(seq 20); do qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1 && break; sleep 0.1; done
        fi
        case "${2:-}" in
            here) ipc assistant here ;;      # with the focused window's screenshot, selection, folder
            open) ipc assistant open ;;
            *)    ipc assistant toggle ;;
        esac ;;
    *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
