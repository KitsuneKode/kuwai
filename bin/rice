#!/usr/bin/env bash
# Control the running rice.
#
#   rice start|restart        (re)start the shell, take over notifications
#   rice stop                 stop it (dunst takes notifications back)
#   rice logs                 follow the shell's log
#   rice notifs <cmd>         dnd | dnd-on | dnd-off | clear | hide | open | last | count | waybar
#   rice center [agents] [pointer]   toggle the center (Notifications or Agents);
#                             `pointer` (the bell) morphs it, keys open it instantly
#   rice assistant [here]     toggle the AI assistant; `here` opens it about the focused window
#   rice bar [island|waybar]  which top bar: the rice's island or HyDE's Waybar
#   rice lock [--wait]        lock with the rice's lock screen (--wait: until it is locked; hyprlock if the shell is down)
#   rice fade [start|stop]    darken the screens before the idle lock
#   rice set KEY VALUE        change a setting (~/.config/rice/settings.json)
#   rice get [KEY]            print one setting, or all of them
#   rice channel [stable|dev] run from the stable copy (~/.local/share/kuwai) or the repo
#   rice promote              move stable up to the repo's latest commit (and reload it)
#
# `notifs` falls back to dunstctl when the rice isn't the notification server,
# so Waybar and keybinds keep working either way.
set -u

RICE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SHELL_DIR="$RICE/shell"

ipc() { qs ipc -p "$SHELL_DIR" call "$@" 2>/dev/null; }

rice_owns_notifications() {
    local pid
    pid=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
        GetConnectionUnixProcessID s org.freedesktop.Notifications 2>/dev/null | awk '{print $2}')
    [ -n "$pid" ] && [ "$(cat /proc/"$pid"/comm 2>/dev/null)" != "dunst" ]
}

dunst_waybar() {
    # Same JSON shape as the rice's, from dunst's history and pause state.
    # Only if dunst is already running: dunstctl would otherwise make D-Bus
    # launch it, racing the rice for the notification name during a restart.
    if ! pgrep -x dunst >/dev/null; then
        printf '{"text":"","alt":"none","class":"none","tooltip":"Notifications starting…"}\n'
        return
    fi
    local count paused alt
    count=$(dunstctl count history 2>/dev/null || echo 0)
    paused=$(dunstctl is-paused 2>/dev/null || echo false)
    if [ "$paused" = true ]; then alt=dnd; [ "$count" -gt 0 ] && alt=dnd-notification
    else alt=none; [ "$count" -gt 0 ] && alt=notification; fi
    printf '{"text":"%s","alt":"%s","class":"%s","tooltip":"󰎟 Notifications (dunst fallback)"}\n' "$count" "$alt" "$alt"
}

SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/rice/settings.json"

# Settings are JSON the shell watches: write the file, the shell follows.
# Values parse as JSON when they can (true, 220, "x"), else as a string.
set_setting() {
    local key=$1 value=$2 tmp
    mkdir -p "$(dirname "$SETTINGS")"
    [ -s "$SETTINGS" ] || echo '{}' > "$SETTINGS"
    tmp=$(mktemp "$SETTINGS.XXXXXX")
    if jq -e . >/dev/null 2>&1 <<<"$value"; then
        jq --arg k "$key" --argjson v "$value" '.[$k] = $v' "$SETTINGS" > "$tmp"
    else
        jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$SETTINGS" > "$tmp"
    fi && mv -- "$tmp" "$SETTINGS" || { rm -f -- "$tmp"; return 1; }
}

get_setting() { jq -r --arg k "$1" '.[$k] // empty' "$SETTINGS" 2>/dev/null; }

# The island bar replaces Waybar: one of the two runs. `apply` makes the
# processes match the setting (rice-shell calls it after starting).
bar() {
    case ${1:-} in
        island|waybar) set_setting bar "\"$1\"" ;;
        apply|"") ;;
        *) echo "usage: rice bar [island|waybar|apply]" >&2; return 2 ;;
    esac
    [ -z "${1:-}" ] && { get_setting bar || echo waybar; return; }
    if [ "$(get_setting bar)" = island ]; then
        pkill -x waybar 2>/dev/null
    elif ! pgrep -x waybar >/dev/null; then
        setsid -f hyde-shell waybar >/dev/null 2>&1 </dev/null
    fi
    return 0
}

notifs() {
    local cmd=${1:-}
    if rice_owns_notifications; then
        case $cmd in
            dnd)     ipc notifs toggleDnd >/dev/null ;;
            dnd-on)  ipc notifs setDnd true ;;
            dnd-off) ipc notifs setDnd false ;;
            clear)   ipc notifs clear ;;
            hide)    ipc notifs dismissPopups ;;
            open)    ipc notifs openLatest ;;
            last)    ipc notifs showLast ;;
            count)   ipc notifs count ;;
            waybar)  ipc notifs waybar ;;
            *) echo "usage: rice notifs dnd|dnd-on|dnd-off|clear|hide|open|last|count|waybar" >&2; return 2 ;;
        esac
    else
        case $cmd in
            dnd)     dunstctl set-paused toggle ;;
            dnd-on)  dunstctl set-paused true ;;
            dnd-off) dunstctl set-paused false ;;
            clear)   dunstctl history-clear ;;
            hide)    dunstctl close-all ;;
            open)    dunstctl action 0 ;;
            last)    dunstctl history-pop ;;
            count)   dunstctl count history ;;
            waybar)  dunst_waybar ;;
            *) echo "usage: rice notifs dnd|dnd-on|dnd-off|clear|hide|open|last|count|waybar" >&2; return 2 ;;
        esac
    fi
}

# Stable and dev (hypr/templates/hyprland.lua reads the channel): stable is
# ~/.local/share/kuwai, a worktree on the repo's `stable` branch; dev is the
# repo you edit. Switching reloads Hyprland and restarts the shell from the
# other copy, so keys, PATH and the shell all move together.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kuwai"
STABLE="${XDG_DATA_HOME:-$HOME/.local/share}/kuwai"
dev_root() { for d in "$HOME/Projects/kuwai" "$HOME/Projects/rice"; do [ -e "$d/hypr/init.lua" ] && { echo "$d"; return; }; done; }
switch_to() {   # $1 = the root to run from
    hyprctl reload >/dev/null 2>&1
    sleep 0.5
    # The old copy's shell: stopped by its own rice-shell's rule (kill -9).
    for pid in $(pgrep -f '^qs -p .*/shell -d$'); do
        case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
            *"$1/shell"*) ;;
            *) kill -9 "$pid" 2>/dev/null ;;
        esac
    done
    systemctl --user set-environment KUWAI_ROOT="$1" 2>/dev/null
    exec "$1/bin/rice-shell"
}

case ${1:-} in
    channel)
        mkdir -p "$STATE_DIR"
        case ${2:-} in
            stable)
                [ -d "$STABLE/.git" ] || [ -f "$STABLE/.git" ] || { echo "rice: no stable copy at $STABLE (git worktree add $STABLE stable)" >&2; exit 1; }
                echo stable > "$STATE_DIR/channel"; switch_to "$STABLE" ;;
            dev)
                echo dev > "$STATE_DIR/channel"; switch_to "$(dev_root)" ;;
            "") cat "$STATE_DIR/channel" 2>/dev/null || echo "dev (no channel set)" ;;
            *) echo "usage: rice channel [stable|dev]" >&2; exit 2 ;;
        esac ;;
    promote)
        # Stable moves up to the repo's latest commit (fast-forward only:
        # nothing on stable is ever rewritten). Uncommitted work stays behind.
        dev=$(dev_root)
        head=$(git -C "$dev" rev-parse HEAD) || exit 1
        git -C "$STABLE" merge --ff-only --quiet "$head" || { echo "rice: stable can't fast-forward to $(git -C "$dev" log --oneline -1)" >&2; exit 1; }
        echo "stable is now $(git -C "$STABLE" log --oneline -1)"
        if [ "$(cat "$STATE_DIR/channel" 2>/dev/null)" = stable ]; then switch_to "$STABLE"; fi ;;
    start|restart) exec "$RICE/bin/rice-shell" ;;
    stop)          for pid in $(qs list -p "$SHELL_DIR" --json 2>/dev/null | jq -r ".[].pid"); do kill -9 "$pid"; done ;;
    logs)          exec qs log -p "$SHELL_DIR" -f ;;
    notifs)        shift; notifs "$@" ;;
    bar)           shift; bar "$@" ;;
    lock)
        # The shell's lock screen. --wait: return only once the compositor
        # confirms the lock (before_sleep_cmd uses it, so nothing shows
        # unlocked after a resume). The shell not running: hyprlock, so
        # locking never fails.
        if ! ipc lock lock 2>/dev/null; then
            pidof hyprlock >/dev/null || { setsid -f hyprlock >/dev/null 2>&1 </dev/null; sleep 0.5; }
            exit 0
        fi
        if [ "${2:-}" = --wait ]; then
            for _ in $(seq 60); do [ "$(ipc lock state)" = locked ] && exit 0; sleep 0.05; done
            exit 1
        fi ;;
    fade)          ipc fade "${2:-start}" >/dev/null 2>&1 ;;   # hypridle: darken before the lock (stop: any input)
    set)           [ $# -eq 3 ] || { echo "usage: rice set KEY VALUE" >&2; exit 2; }; set_setting "$2" "$3" ;;
    get)           if [ -n "${2:-}" ]; then get_setting "$2"; else jq . "$SETTINGS" 2>/dev/null || echo '{}'; fi ;;
    center)
        # Needs the shell running, not the notification name: start it if
        # it isn't up rather than doing nothing.
        if ! qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1; then
            "$RICE/bin/rice-shell" >/dev/null 2>&1
            for _ in $(seq 20); do qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1 && break; sleep 0.1; done
        fi
        ipc center toggle "${2:-notifications}" "${3:-key}" ;;
    assistant)
        if ! qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1; then
            "$RICE/bin/rice-shell" >/dev/null 2>&1
            for _ in $(seq 20); do qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1 && break; sleep 0.1; done
        fi
        case "${2:-}" in
            here) ipc assistant here ;;      # with the focused window's screenshot, selection, folder
            *)    ipc assistant toggle ;;
        esac ;;
    *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
