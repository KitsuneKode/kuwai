#!/usr/bin/env python3
"""Layer boundary ratchet for the shell (docs/ROADMAP-showcase.md §9).

Enforces import boundaries between shell layers:
  comp_imports_service  shell/components/**/*.qml importing qs.services
  comp_imports_module   shell/components/**/*.qml importing qs.modules
  service_imports_ui    shell/services/**/*.qml importing qs.modules or qs.components

Usage:
  kuwai-layers            print the counts and the baseline
  kuwai-layers --check    exit 1 if any count went UP from the baseline
  kuwai-layers --update   lower the baseline to today's counts (never raises it)
  kuwai-layers --list     print each violation as kind file:line import
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SHELL = os.path.join(ROOT, "shell")
BASE = os.path.join(ROOT, "docs", "design", "layers-baseline.json")

IMPORT_RE = re.compile(r"^\s*import\s+(qs\.(?:services|modules|components)(?:\.[A-Za-z0-9_]+)*)\b", re.M)


def violations():
    """Yield (kind, path, line, target) for every layer import violation."""
    for area, rules in (
        ("components", {"qs.services": "comp_imports_service", "qs.modules": "comp_imports_module"}),
        ("services", {"qs.modules": "service_imports_ui", "qs.components": "service_imports_ui"}),
    ):
        root_dir = os.path.join(SHELL, area)
        if not os.path.isdir(root_dir):
            continue
        for d, dirs, files in os.walk(root_dir):
            dirs.sort()
            for f in sorted(files):
                if not f.endswith(".qml"):
                    continue
                p = os.path.join(d, f)
                text = open(p, encoding="utf-8", errors="replace").read()
                for m in IMPORT_RE.finditer(text):
                    imp = m.group(1)
                    prefix = ".".join(imp.split(".")[:2])
                    kind = rules.get(prefix)
                    if kind:
                        line = text.count("\n", 0, m.start()) + 1
                        yield kind, p, line, imp


def count():
    c = {"comp_imports_service": 0, "comp_imports_module": 0, "service_imports_ui": 0}
    for kind, *_ in violations():
        c[kind] += 1
    return c


def main():
    now = count()
    try:
        base = json.load(open(BASE))
    except (OSError, ValueError):
        base = {}
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--list":
        for kind, p, n, imp in violations():
            print(f"{kind:22} {os.path.relpath(p, ROOT)}:{n}  {imp}")
        return 0
    if arg == "--update" or not base:
        new = {k: min(now[k], base.get(k, now[k])) for k in now}
        os.makedirs(os.path.dirname(BASE), exist_ok=True)
        with open(BASE, "w") as f:
            json.dump(new, f, indent=2)
            f.write("\n")
        print("baseline:", new)
        return 0
    up = {k: (base[k], now[k]) for k in now if k in base and now[k] > base[k]}
    if arg == "--check":
        if up:
            print("; ".join(f"{k} {a} → {b}" for k, (a, b) in up.items()))
            return 1
        down = [k for k in now if k in base and now[k] < base[k]]
        print(
            "layers: "
            + ", ".join(f"{k} {now[k]}" for k in now)
            + (" (lower than the baseline: kuwai-layers --update)" if down else "")
        )
        return 0
    print("now:     ", now)
    print("baseline:", base)
    return 0


if __name__ == "__main__":
    sys.exit(main())
