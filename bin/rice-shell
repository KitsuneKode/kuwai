#!/usr/bin/env bash
# Start (or restart) the rice and make it the notification server.
#
# Only one process can own org.freedesktop.Notifications. HyDE starts dunst at
# login, so stop it, start Quickshell, and check Quickshell really got the
# name (a notification arriving in between can D-Bus-activate dunst again).
# If the rice ever dies, the next notification activates dunst on its own:
# that is the fallback, nothing to do here.
#
# Stopping uses SIGKILL, not `qs kill`: Quickshell 0.3.2 can segfault while
# tearing down on a polite exit (Wayland objects destroyed after the
# connection), and its crash handler then relaunches the very instance we
# stopped, leaving two rices running (two HUDs, two toast stacks, doubled
# global shortcuts). A killed process tears nothing down and isn't relaunched.
set -u
mkdir -p "${XDG_RUNTIME_DIR:-/tmp}/rice"   # shared shapes for shell-auth (island.json)

RICE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SHELL_DIR="$RICE/shell"
NAME=org.freedesktop.Notifications

owner_pid() {
    busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
        GetConnectionUnixProcessID s "$NAME" 2>/dev/null | awk '{print $2}'
}

rice_pids() {
    qs list -p "$SHELL_DIR" --json 2>/dev/null | jq -r '.[].pid' 2>/dev/null
}

stop_rice() {
    for pid in $(rice_pids); do kill -9 "$pid" 2>/dev/null; done
    for _ in $(seq 20); do
        [ -z "$(rice_pids)" ] && return
        sleep 0.1
    done
}

# The log of the newest rice instance (Quickshell keeps one per run).
# (Not `qs list`: an instance whose config failed to load isn't listed.)
# Only ones started after $MARK, the moment this launch began.
newest_log() {
    local d
    for d in $(find "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id" -mindepth 1 -maxdepth 1 -type d -newer "$MARK" 2>/dev/null); do
        if strings "$d/log.qslog" 2>/dev/null | grep -qF "Launching config: \"$SHELL_DIR/shell.qml\""; then
            echo "$d/log.qslog"
            return
        fi
    done
}

# The config didn't load (a typo, a half-saved file mid-edit): say so, keep a
# bar on screen, and come back by itself. Quickshell exits when its config
# fails at startup, so a watcher waits for the next save to any of the
# shell's files and tries again (one watcher: it becomes the next attempt).
notify_critical() {
    local title=$1 body=$2
    gdbus call --session --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        'Shell' 0 'dialog-error' "$title" "$body" '[]' '{"urgency": <byte 2>}' 15000 \
        >/dev/null 2>&1 || true
}
broken() {
    local log=$1 why
    why=$(strings "$log" 2>/dev/null | grep -m3 'caused by' | sed 's/^[^c]*caused by //' | paste -sd ' ' | cut -c1-220)
    echo "rice-shell: the shell didn't load: $why" >&2
    pgrep -x waybar >/dev/null || setsid -f hyde-shell waybar >/dev/null 2>&1 </dev/null
    # Idle and locking fall back to hypridle (its config locks with `rice
    # lock`, which uses hyprlock while the shell is down).
    systemctl --user start hypridle.service 2>/dev/null
    notify_critical "The island didn't load" "${why:-see the Quickshell log} · Waybar is up meanwhile; saving a fixed QML file reloads the island"
    setsid -f bash -c '
        dir=$1 rice=$2
        stamp() { find "$dir" \( -name "*.qml" -o -name "*.js" -o -name "*.mjs" -o -name qmldir \) -printf "%T@\n" 2>/dev/null | sort -n | tail -1; }
        was=$(stamp)
        for _ in $(seq 3600); do       # two hours, then give up quietly
            sleep 2
            now=$(stamp)
            if [ "$now" != "$was" ]; then
                sleep 1                # let a burst of saves finish
                exec "$rice/bin/rice-shell"
            fi
        done' rice-shell-watch "$SHELL_DIR" "$RICE" >/dev/null 2>&1 </dev/null
    exit 1
}

stop_dunst() {
    pkill -x dunst 2>/dev/null
    for _ in $(seq 20); do
        [ -z "$(owner_pid)" ] && return
        sleep 0.1
    done
}

# Retire any running rice (all of them, if a crash ever left two), and the
# standalone glass HUD it replaces.
stop_rice
pkill -f 'qs -p .*/quickshell/glass-osd' 2>/dev/null
# A watcher from an earlier failed start: this run replaces it.
for p in $(pgrep -f "rice-shell-watch $SHELL_DIR $RICE\$"); do [ "$p" != "$$" ] && kill "$p" 2>/dev/null; done

loaded() { [ -n "$1" ] && strings "$1" 2>/dev/null | grep -q 'Configuration Loaded'; }

MARK=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/rice/launch.XXXXXX")
trap 'rm -f -- "$MARK"' EXIT
for attempt in 1 2 3; do
    stop_dunst
    touch "$MARK"
    # Started by Hyprland, as at login: run from a terminal it would otherwise
    # live (and die) in that terminal's process group and cgroup.
    # The allocator: 2 arenas, not 8 per core (each thread's arena kept its
    # own freed memory), and freed memory goes back to the system sooner.
    # Same speed for a shell; a smaller idle footprint after panels close.
    ENV="GLIBC_TUNABLES=glibc.malloc.arena_max=2:glibc.malloc.trim_threshold=8388608"
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl dispatch "hl.dsp.exec_cmd('env $ENV qs -p $SHELL_DIR -d')" >/dev/null 2>&1; then :
    else env "$ENV" qs -p "$SHELL_DIR" -d >/dev/null 2>&1; fi
    log=
    for i in $(seq 60); do
        # Every half second: did the config fail to load?
        if [ $((i % 5)) -eq 0 ]; then
            log=$(newest_log)
            if [ -n "$log" ] && strings "$log" 2>/dev/null | grep -q 'Failed to load configuration' \
               && ! loaded "$log"; then
                broken "$log"
            fi
        fi
        pid=$(owner_pid)
        # Dunst, D-Bus-activated by a notification in between: again.
        [ -n "$pid" ] && [ "$(cat /proc/"$pid"/comm 2>/dev/null)" = "dunst" ] && pkill -x dunst
        # The new rice has the name: done.
        if [ -n "$pid" ] && rice_pids | grep -qx "$pid"; then
            "$RICE/bin/rice" bar apply      # one top bar: the island or Waybar
            systemctl --user stop hypridle.service 2>/dev/null   # idle is the shell's (services/Idle)
            exit 0
        fi
        sleep 0.1
    done
    # Loaded but without the name: someone else has it, most likely the rice
    # of another session on another tty (one D-Bus for both). Keep this one;
    # Quickshell takes the name by itself once that one lets go. Killing it
    # would also drop a lock it may already hold.
    if loaded "$log" && [ -n "$(rice_pids)" ]; then
        owner=$(owner_pid)
        echo "rice-shell: running; notifications stay with pid ${owner:-?} ($(tr '\0' ' ' </proc/"${owner:-0}"/cmdline 2>/dev/null | cut -c1-80)) until it exits" >&2
        "$RICE/bin/rice" bar apply
        systemctl --user stop hypridle.service 2>/dev/null
        exit 0
    fi
    echo "rice-shell: the shell didn't come up (attempt $attempt), retrying" >&2
    stop_rice
done

echo "rice-shell: gave up; dunst stays the notification server" >&2
exit 1
