#!/usr/bin/env bash
# kuwai-backup: your desktop's own files, snapshotted and put back.
#
#   kuwai backup                 a snapshot now (prints its path)
#   kuwai backup list            the snapshots, newest first, with what's in them
#   kuwai backup diff [NAME]     what changed since a snapshot (the newest by default)
#   kuwai backup restore NAME    put a snapshot back (a snapshot of now is taken first)
#   kuwai backup auto            what the daily timer and `kuwai promote` run: a snapshot
#                               only if something changed since the last one
#
# What: settings (~/.config/kuwai), Hyprland's files that are yours
# (~/.config/hypr: hyprland.lua, monitors.lua, user.lua, hypridle.conf),
# reminders, alarms, clipboard pins, quick notes, screen profiles (icc), the
# kuwai state (mode, channel). Not: clipboard history, caches, the repo.
# Where: ~/.local/state/kuwai/backups/<time>.tar.gz, readable by you only
# (settings can hold keys); the newest 30 kept. (searxng: its container's, not ours.)
set -euo pipefail
umask 077

STATE=${XDG_STATE_HOME:-$HOME/.local/state}
CFG=${XDG_CONFIG_HOME:-$HOME/.config}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
DIR=$STATE/kuwai/backups
KEEP=${KUWAI_BACKUP_KEEP:-30}
[[ $KEEP =~ ^[1-9][0-9]{0,5}$ ]] || { echo "kuwai-backup: retention must be a positive integer below 1000000" >&2; exit 2; }
for base in "$CFG" "$DATA" "$STATE" "${KUWAI_NOTES:-$HOME/Notes}"; do
    base=$(realpath -m -- "$base")
    case "$base" in "$HOME"|"$HOME/"*) ;; *) echo "kuwai-backup: configured paths must be under HOME" >&2; exit 2 ;; esac
done
mkdir -p "$DIR"
exec 9>"$DIR/.lock"
flock -x 9

# Paths relative to $HOME (only those that exist are taken).
paths() {
    local p
    for p in \
        "$CFG/kuwai" \
        "$CFG/hypr/hyprland.lua" "$CFG/hypr/monitors.lua" "$CFG/hypr/user.lua" "$CFG/hypr/hypridle.conf" \
        "$DATA/kuwai-data/reminders.json" "$DATA/kuwai-data/alarms.json" "$DATA/kuwai-data/clipboard/pins" \
        "${KUWAI_NOTES:-$HOME/Notes}/inbox.md" \
        "$DATA/kuwai-data/icc" \
        "$STATE/kuwai/state" "$STATE/kuwai/channel"; do
        if [ "${1:-}" = all ] || [ -e "$p" ]; then printf '%s\0' "${p#"$HOME"/}"; fi
    done
    return 0
}

# One number for "what's there now": changes when any file's content does.
fingerprint() {
    (cd "$HOME" && paths | while IFS= read -r -d '' p; do find "$p" -type f ! -name '*.bak' ! -name '*.bak-*' ! -path '*/searxng/*' -print0; done | sort -z | xargs -0r sha256sum) | sha256sum | cut -c1-16
}

validate_archive() {
    local allowed=()
    mapfile -d '' -t allowed < <(paths all)
    python3 - "$1" "$2" "${CFG#"$HOME"/}/kuwai/searxng" "${allowed[@]}" <<'PY'
import sys, tarfile
from pathlib import PurePosixPath
try:
    excluded = PurePosixPath(sys.argv[3])
    allowed = [PurePosixPath(p) for p in sys.argv[4:]]
    with tarfile.open(sys.argv[1], 'r:gz') as archive:
        for member in archive:
            path = PurePosixPath(member.name)
            if path.is_absolute() or '..' in path.parts or not (member.isfile() or member.isdir()):
                raise ValueError('unsafe member')
            if path == excluded or excluded in path.parents or not any(path == p or p in path.parents for p in allowed):
                raise ValueError('member outside backup scope')
            tarfile.data_filter(member, sys.argv[2])
except (OSError, ValueError, tarfile.TarError):
    print('kuwai-backup: refusing an unsafe or invalid snapshot', file=sys.stderr)
    sys.exit(1)
PY
}

archives() {
    python3 - "$DIR" "${1:-all}" <<'PY'
import os, sys
from pathlib import Path
items = sorted(Path(sys.argv[1]).glob('*.tar.gz'), key=lambda p: (p.stat().st_mtime_ns, p.name), reverse=True)
if sys.argv[2] == 'first':
    items = items[:1]
for item in items:
    sys.stdout.buffer.write(os.fsencode(item) + b'\0')
PY
}

snap() {   # $1 = why (shown in list)
    local name stamp index=0 temporary hash
    stamp=$(date +%Y%m%d-%H%M%S); name=$stamp
    while [ -e "$DIR/$name.tar.gz" ]; do index=$((index + 1)); name="$stamp-$index"; done
    local out=$DIR/$name.tar.gz
    hash=$(fingerprint)
    temporary=$(mktemp "$DIR/.snapshot.XXXXXX")
    # Files and folders only, listed one by one: a link in scope is kuwai's
    # own file linked in (hypr/hypridle.conf) or another tool's folder
    # (kuwai/searxng), not yours; the fingerprint skips links too, and the
    # check below refuses a snapshot holding one.
    if ! (cd "$HOME" && paths | while IFS= read -r -d '' p; do
              find "$p" \( -path "${CFG#"$HOME"/}/kuwai/searxng" -o -name '*.bak' -o -name '*.bak-*' \) -prune -o \( -type f -o -type d \) -print0
          done | tar -czf "$temporary" --no-recursion --null --verbatim-files-from --files-from=-) || ! validate_archive "$temporary" "$HOME"; then
        rm -f -- "$temporary"; return 1
    fi
    mv -- "$temporary" "$out"
    printf '%s\t%s\n' "$hash" "${1:-by hand}" >"$DIR/$name.info"
    # Keep the newest $KEEP.
    local kept=0 old
    while IFS= read -r -d '' old; do
        kept=$((kept + 1))
        if [ "$kept" -gt "$KEEP" ]; then rm -f -- "$old" "${old%.tar.gz}.info"; fi
    done < <(archives)
    printf '%s\n' "$out"
}

newest() { local first; if IFS= read -r -d '' first < <(archives first); then printf '%s\n' "$first"; fi; }
resolve() {   # NAME (with or without .tar.gz), or the newest
    local n=${1:-}
    [ -z "$n" ] && { newest; return; }
    n=${n%.tar.gz}; n=${n##*/}
    [[ $n =~ ^[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]] || { echo "not a snapshot name: $1" >&2; exit 2; }
    [ -f "$DIR/$n.tar.gz" ] || { echo "no snapshot $n (kuwai backup list)" >&2; exit 1; }
    printf '%s\n' "$DIR/$n.tar.gz"
}

case ${1:-now} in
    now|"") snap "by hand" ;;
    auto)
        last=$(newest)
        if [ -n "$last" ] && [ "$(cut -f1 "${last%.tar.gz}.info" 2>/dev/null)" = "$(fingerprint)" ]; then
            echo "no change since $(basename "${last%.tar.gz}")"
        else
            snap "${2:-automatic}"
        fi ;;
    list)
        found=0
        while IFS= read -r -d '' f; do
            found=1
            n=$(basename "${f%.tar.gz}")
            why=$(cut -f2 "${f%.tar.gz}.info" 2>/dev/null || echo "")
            printf '%s  %6s  %s\n' "$n" "$(du -h "$f" | cut -f1)" "$why"
        done < <(archives)
        [ $found = 1 ] || echo "no snapshots yet (kuwai backup)" ;;
    diff)
        f=$(resolve "${2:-}"); [ -n "$f" ] || { echo "no snapshots yet" >&2; exit 1; }
        tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
        validate_archive "$f" "$tmp"
        tar -xzf "$f" -C "$tmp"
        (cd "$HOME" && paths all) | while IFS= read -r -d '' p; do
            if [ -e "$tmp/$p" ]; then diff -ru -x '*.bak*' -x searxng --label "$(basename "${f%.tar.gz}")/$p" --label "now/$p" "$tmp/$p" "$HOME/$p" || true
            elif [ -e "$HOME/$p" ]; then echo "new since then: ~/$p"; fi
        done ;;
    restore)
        f=$(resolve "${2:?which one? kuwai backup list}")
        tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
        cp -- "$f" "$tmp/restore.tar.gz"
        validate_archive "$tmp/restore.tar.gz" "$HOME"
        before=$(snap "before restoring $(basename "${f%.tar.gz}")")
        # Only paths the snapshot holds, only under $HOME, no links or ..
        tar -xzf "$tmp/restore.tar.gz" -C "$HOME" --no-same-owner --overwrite
        echo "restored $(basename "${f%.tar.gz}") (what was there is in $before)"
        echo "reload: hyprctl reload  (settings apply by themselves)" ;;
    -h|--help|help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "kuwai backup [now|list|diff [NAME]|restore NAME|auto]" >&2; exit 2 ;;
esac
