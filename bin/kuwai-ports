#!/usr/bin/env -S python3 -I
"""Local servers you started: listening TCP ports whose process works in a folder of yours.

  kuwai-ports    print rows for listening TCP ports as JSON, by port

Each row names the port, host, process, project, pid, start time, age, memory,
CPU and the coding agent or terminal it was started from. `start` is the
kernel's start time, so stopping it later can check it's still the same one.
Listeners and their owners come from /proc: net/tcp and net/tcp6 name the
socket inodes, and each process's fd links name the sockets it holds.
"""
import hashlib
import ipaddress
import json
import os
import re

HOME = os.path.realpath(os.path.expanduser("~"))
PROC = os.environ.get("KUWAI_PROC", "/proc")
SKIP = re.compile(r"^(t3code|antigravity|chrome|chromium|firefox|zen|electron|code|cursor|windsurf|devin|discord|slack|spotify|steam|"
                  r"syncthing|kdeconnectd|Hyprland|qs|quickshell|kitty|ghostty|systemd.*|pipewire.*|wireplumber|obs|zapzap|"
                  r"language_server.*|gopls|rust-analyzer|tsserver|vscode.*|claude|codex|opencode|kittymux.*)$", re.I)

AGENTS = [(re.compile(r"^claude$|claude-code", re.I), "Claude"), (re.compile(r"^codex", re.I), "Codex"),
          (re.compile(r"^opencode", re.I), "OpenCode"), (re.compile(r"cursor-agent|^cursor$", re.I), "Cursor"),
          (re.compile(r"^gemini", re.I), "Gemini"), (re.compile(r"^grok", re.I), "Grok"), (re.compile(r"^devin", re.I), "Devin"),
          (re.compile(r"^kiro", re.I), "Kiro"), (re.compile(r"antigravity", re.I), "Antigravity"), (re.compile(r"t3code|t3-code", re.I), "T3 Code")]
SERVERS = [(r"next(/dist/bin/next)?\b.*\bdev\b", "next dev"), (r"next\b.*\bstart\b", "next start"), (r"\bvite\b", "vite"),
           (r"\bastro\b.*\bdev\b", "astro dev"), (r"\bnuxt\b", "nuxt dev"), (r"\bremix\b", "remix dev"),
           (r"wrangler\b.*\bdev\b", "wrangler dev"), (r"\bstorybook\b", "storybook"), (r"\buvicorn\b", "uvicorn"),
           (r"\bgunicorn\b", "gunicorn"), (r"manage\.py\s+runserver", "django"), (r"\bflask\b", "flask"),
           (r"-m\s+http\.server", "python http.server"), (r"\bjupyter", "jupyter"), (r"\brails\s+s", "rails"), (r"cargo\s+run|\btrunk\b", "cargo run")]
DAEMONS = re.compile(r"^(postgres|redis-server|redis|docker-proxy)$", re.I)
TERMINALS = [(re.compile(r"^kitty$", re.I), "Kitty"), (re.compile(r"^ghostty$", re.I), "Ghostty"),
             (re.compile(r"^(wezterm|wezterm-gui)$", re.I), "WezTerm"), (re.compile(r"^alacritty$", re.I), "Alacritty"),
             (re.compile(r"^foot$", re.I), "Foot"), (re.compile(r"^konsole$", re.I), "Konsole")]
TICK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")


def root(proc=None):
    return proc or PROC


def stat_info(pid, proc=None):
    with open(os.path.join(root(proc), str(pid), "stat")) as f:
        st = f.read()
    rest = st[st.rindex(")") + 2:].split()
    return {"name": st[st.index("(") + 1:st.rindex(")")], "ppid": int(rest[1]), "ticks": int(rest[11]) + int(rest[12]),
            "start": int(rest[19]), "rss": int(rest[21]) * PAGE}


def stat(pid, proc=None):
    s = stat_info(pid, proc)
    return s["name"], s["ppid"], s["start"]


def argv(pid, proc=None):
    try:
        with open(os.path.join(root(proc), str(pid), "cmdline"), "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def what(pid, name, proc=None):
    cmd = " ".join(argv(pid, proc))[:400]
    for pat, label in SERVERS:
        if re.search(pat, cmd):
            return label
    for runner in ("bun", "npm", "pnpm", "yarn", "deno"):
        m = re.search(r"\b" + runner + r"\s+(?:run\s+)?([\w:-]+)", cmd)
        if m and m.group(1) not in ("x", "exec"):
            return runner + " " + m.group(1)
    return name


def agent(pid, proc=None):
    seen = 0
    while pid > 1 and seen < 40:
        seen += 1
        try:
            name, ppid, _ = stat(pid, proc)
        except (OSError, ValueError, IndexError):
            return ""
        a = argv(pid, proc)
        base = os.path.basename(a[0]) if a else ""
        script = os.path.basename(a[1]) if len(a) > 1 and base in ("node", "bun", "python3", "python") else ""
        for pat, label in AGENTS:
            if pat.search(name) or pat.search(base) or (script and pat.search(script)):
                return label
        pid = ppid
    return ""


def uptime(proc=None):
    try:
        with open(os.path.join(root(proc), "uptime")) as f:
            return float(f.read().split()[0])
    except (OSError, ValueError, IndexError):
        return 0.0


def project(cwd):
    p = cwd
    while p.startswith(HOME) and p != HOME:
        if os.path.exists(os.path.join(p, ".git")):
            return os.path.basename(p)
        p = os.path.dirname(p)
    return os.path.basename(cwd)


def ipv4(hexaddr):
    raw = bytes.fromhex(hexaddr)
    return str(ipaddress.IPv4Address(raw[::-1]))


def ipv6(hexaddr):
    raw = bytes.fromhex(hexaddr)
    return str(ipaddress.IPv6Address(b"".join(raw[i:i + 4][::-1] for i in range(0, 32, 4))))


def address(hexaddr, family):
    try:
        return ipv4(hexaddr) if family == "tcp" else ipv6(hexaddr)
    except (ValueError, TypeError):
        return ""


def loopback(host):
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def sockets(proc=None):
    out = {}
    for family in ("tcp", "tcp6"):
        try:
            with open(os.path.join(root(proc), "net", family)) as f:
                lines = f.read().splitlines()
        except OSError:
            continue
        for line in lines[1:]:
            parts = line.split()
            if len(parts) < 10 or parts[3] != "0A":
                continue
            try:
                hexaddr, hexport = parts[1].rsplit(":", 1)
                port = int(hexport, 16)
            except ValueError:
                continue
            inode = parts[9]
            if not inode.isdigit() or inode == "0" or not 0 < port < 65536:
                continue
            host = address(hexaddr, family)
            out[inode] = {"port": port, "host": host, "local": loopback(host)}
    return out


def socket_owners(inodes, proc=None):
    owners = {}
    if not inodes:
        return owners
    try:
        pids = os.listdir(root(proc))
    except OSError:
        return owners
    for d in pids:
        if not d.isdigit():
            continue
        fddir = os.path.join(root(proc), d, "fd")
        try:
            fds = os.listdir(fddir)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(os.path.join(fddir, fd))
            except OSError:
                continue
            if not target.startswith("socket:[") or not target.endswith("]"):
                continue
            inode = target[8:-1]
            if inode in inodes:
                owners.setdefault(inode, []).append(int(d))
    return owners


def memory_bytes(pid, proc=None, stat_row=None):
    try:
        with open(os.path.join(root(proc), str(pid), "smaps_rollup")) as f:
            for line in f:
                if line.startswith("Pss:"):
                    return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    if stat_row is not None:
        return stat_row["rss"]
    try:
        return stat_info(pid, proc)["rss"]
    except (OSError, ValueError, IndexError):
        return 0


def unit_words(unit):
    base = re.sub(r"\.(scope|service)$", "", unit)
    base = re.sub(r"^(app|run)-", "", base)
    base = re.sub(r"@[^@]*$", "", base)
    base = re.sub(r"-(?:[0-9a-fA-F]{6,}|[0-9]+)$", "", base)
    return re.sub(r"\\x([0-9a-fA-F]{2})", lambda m: chr(int(m.group(1), 16)), base)


def pretty_app(app):
    app = re.sub(r"\.desktop$", "", app)
    word = app.split(".")[-1] if app.count(".") >= 2 else app
    word = word.split("-")[0] if word.split("-")[0].lower() in ("org", "com", "io") and len(word.split("-")) > 1 else word
    return word[:1].upper() + word[1:] if word else ""


def cgroup_app(pid, proc=None):
    try:
        with open(os.path.join(root(proc), str(pid), "cgroup")) as f:
            text = f.read()
    except OSError:
        return ""
    units = re.findall(r"/((?:app|run)-[^/\s]+\.(?:scope|service))", text)
    for unit in reversed(units):
        if unit.startswith("run-"):
            continue
        name = pretty_app(unit_words(unit))
        if name:
            return name
    return ""


def parent_app(pid, proc=None):
    own = pid
    seen = 0
    while pid > 1 and seen < 40:
        seen += 1
        try:
            name, ppid, _ = stat(pid, proc)
        except (OSError, ValueError, IndexError):
            break
        if pid != own:
            for pat, label in TERMINALS:
                if pat.search(name):
                    return label
        pid = ppid
    return cgroup_app(own, proc)


def state_path(proc=None):
    if os.environ.get("KUWAI_PORTS_STATE"):
        return os.environ["KUWAI_PORTS_STATE"]
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    base = os.path.join(runtime, "kuwai", "ports") if runtime else os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "kuwai", "ports"
    )
    key = hashlib.sha1(os.path.realpath(root(proc)).encode()).hexdigest()[:12]
    return os.path.join(base, "cpu-" + key + ".json")


def cpu_percents(samples, proc=None, up=None):
    up = uptime(proc) if up is None else up
    path = state_path(proc)
    before = {}
    try:
        with open(path) as f:
            raw = json.load(f)
        if isinstance(raw, dict):
            before = raw
    except (OSError, ValueError):
        pass
    now = {}
    out = {}
    for pid, s in samples.items():
        ident = str(pid) + ":" + str(s["start"])
        now[ident] = {"pid": pid, "start": s["start"], "t": up, "ticks": s["ticks"]}
        old = before.get(ident)
        if old and up > old.get("t", 0) and s["ticks"] >= old.get("ticks", 0):
            out[pid] = round(max(0.0, (s["ticks"] - old["ticks"]) * 100 / ((up - old["t"]) * TICK)), 1)
        else:
            lived = max(0.1, up - s["start"] / TICK)
            out[pid] = round(max(0.0, s["ticks"] * 100 / (lived * TICK)), 1)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(now, f, separators=(",", ":"))
        os.replace(tmp, path)
    except OSError:
        pass
    return out


def candidate(pid, proc, up):
    try:
        info = stat_info(pid, proc)
    except (OSError, ValueError, IndexError):
        return None
    name = re.sub(r"-MainThread$", "", info["name"])
    if SKIP.match(name):
        return None
    daemon = bool(DAEMONS.match(name))
    try:
        cwd = os.path.realpath(os.readlink(os.path.join(root(proc), str(pid), "cwd")))
    except OSError:
        if not daemon:
            return None
        cwd = ""
    if not daemon and not cwd.startswith(HOME + os.sep):
        return None
    return {"proc": name, "what": what(pid, name, proc), "project": project(cwd) if cwd else name, "pid": pid,
            "start": info["start"], "age": max(0, int(up - info["start"] / TICK)), "agent": agent(pid, proc),
            "parentApp": parent_app(pid, proc), "memBytes": memory_bytes(pid, proc, info), "ticks": info["ticks"]}


def pick_host(hosts):
    for host in hosts:
        if host and not loopback(host):
            return host
    return hosts[0] if hosts else ""


def scan(proc=None):
    listens = sockets(proc)
    owners = socket_owners(set(listens), proc)
    ports = {}
    for inode, s in listens.items():
        p = ports.setdefault(s["port"], {"inodes": [], "hosts": [], "local": True})
        p["inodes"].append(inode)
        p["hosts"].append(s["host"])
        p["local"] = p["local"] and s["local"]
    up = uptime(proc)
    out = []
    samples = {}
    rows_by_port = []
    for port, p in ports.items():
        rows = []
        for inode in p["inodes"]:
            for pid in sorted(owners.get(inode, [])):
                row = candidate(pid, proc, up)
                if row and all(row["pid"] != old["pid"] for old in rows):
                    rows.append(row)
        if not rows:
            continue
        row = rows[0]
        row.update({"port": port, "host": pick_host(p["hosts"]), "local": p["local"]})
        samples[row["pid"]] = {"start": row["start"], "ticks": row.pop("ticks")}
        rows_by_port.append(row)
    cpus = cpu_percents(samples, proc, up)
    for row in rows_by_port:
        row["cpu"] = cpus.get(row["pid"], 0.0)
        out.append(row)
    return sorted(out, key=lambda r: r["port"])


def main():
    print(json.dumps(scan()))


if __name__ == "__main__":
    main()
