#!/usr/bin/env bash
# kuwai-migrate: move what kuwai kept under its old name (rice) to kuwai. Safe to
# run any number of times; kuwai-shell runs it before it starts the shell.
#
#   folders  ~/.local/state/rice, ~/.cache/rice, ~/.config/rice: each entry moves
#            into the kuwai folder beside it (one that is already there wins and
#            the old copy stays, said once), then the old folder becomes a link to
#            the new one, so anything still reading the old path finds the data.
#   runtime  $XDG_RUNTIME_DIR/rice → kuwai (a link, every login: it is a tmpfs),
#            for programs started with the old path in their environment
#            (voxtype's VOXTYPE_OSD_HOST=%t/rice/voxtype-host.pid).
#   units    user units linked as rice-NAME (auth, backup, clipboard, feeds) are
#            linked again as kuwai-NAME from this copy, enabled as they were,
#            and started again if they were running.
# Root's parts (the login screen, rice-wake) move when you run their installers
# again (greeter/install, system/install); until then they keep working as they are.
set -u
ROOT=${KUWAI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
said() { printf 'kuwai-migrate: %s\n' "$*" >&2; }

folder() {   # base
    local old="$1/rice" new="$1/kuwai" e
    [ -d "$old" ] && [ ! -L "$old" ] || return 0
    mkdir -p "$new" || return 1
    for e in "$old"/* "$old"/.[!.]*; do
        [ -e "$e" ] || [ -L "$e" ] || continue
        if [ -e "$new/${e##*/}" ] || [ -L "$new/${e##*/}" ]; then
            said "kept $e: $new/${e##*/} is already there"
        else
            mv -- "$e" "$new/" || said "couldn't move $e"
        fi
    done
    if rmdir -- "$old" 2>/dev/null; then
        ln -s kuwai "$old" && said "moved $old to $new"
    fi
}
folder "${XDG_STATE_HOME:-$HOME/.local/state}"
folder "${XDG_CACHE_HOME:-$HOME/.cache}"
folder "${XDG_CONFIG_HOME:-$HOME/.config}"

if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    rt="$XDG_RUNTIME_DIR"
    mkdir -p "$rt/kuwai"
    if [ -d "$rt/rice" ] && [ ! -L "$rt/rice" ]; then
        for e in "$rt/rice"/*; do [ -e "$e" ] && [ ! -e "$rt/kuwai/${e##*/}" ] && mv -- "$e" "$rt/kuwai/"; done
        rm -rf -- "$rt/rice"
    fi
    [ -e "$rt/rice" ] || ln -s kuwai "$rt/rice"
fi

units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if command -v systemctl >/dev/null && [ -d "$units" ]; then
    changed=0
    for f in "$units"/rice-*.service "$units"/rice-*.timer; do
        [ -L "$f" ] || continue
        old=${f##*/}; new="kuwai-${old#rice-}"
        src="$ROOT/systemd/$new"
        [ -f "$src" ] || { said "no $src for $old; left as it is"; continue; }
        enabled=0; active=0
        systemctl --user is-enabled --quiet "$old" 2>/dev/null && enabled=1
        systemctl --user is-active --quiet "$old" 2>/dev/null && active=1
        systemctl --user disable --now "$old" >/dev/null 2>&1
        rm -f -- "$f"
        systemctl --user link "$src" >/dev/null 2>&1 || { said "couldn't link $src"; continue; }
        [ "$enabled" = 1 ] && systemctl --user enable "$new" >/dev/null 2>&1
        [ "$active" = 1 ] && systemctl --user start "$new" >/dev/null 2>&1
        said "$old is now $new"
        changed=1
    done
    [ "$changed" = 1 ] && systemctl --user daemon-reload
fi
exit 0
