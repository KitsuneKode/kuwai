#!/usr/bin/env bash
set -u
ROOT=${KUWAI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
said() { printf 'kuwai-migrate: %s\n' "$*" >&2; }

merge() {
    local old="$1" new="$2" e n
    for e in "$old"/* "$old"/.[!.]*; do
        [ -e "$e" ] || [ -L "$e" ] || continue
        n="$new/${e##*/}"
        if [ -d "$e" ] && [ ! -L "$e" ] && [ -d "$n" ] && [ ! -L "$n" ]; then
            merge "$e" "$n"
            rmdir -- "$e" 2>/dev/null || said "kept $e: some of it is already in $n"
        elif [ "$(readlink -- "$n")" = "$e" ]; then
            :
        elif [ -e "$n" ] || [ -L "$n" ]; then
            case "${e##*/}" in *.lock) rm -f -- "$e" ;; *) said "kept $e: $n is already there" ;; esac
        elif ! mv -- "$e" "$new/" 2>/dev/null; then
            ln -s -- "$e" "$n" && said "linked $n to $e (not movable without root)"
        fi
    done
}

folder() {
    local old="$1/rice" new="$1/${2:-kuwai}"
    [ -d "$old" ] && [ ! -L "$old" ] || return 0
    mkdir -p "$new" || return 1
    merge "$old" "$new"
    if rmdir -- "$old" 2>/dev/null; then
        ln -s "${2:-kuwai}" "$old" && said "moved $old to $new"
    fi
    return 0
}

data_rescue() {
    local stable="$1/kuwai" data="$1/kuwai-data" e
    [ -e "$stable/.git" ] || return 0
    mkdir -p "$data" || return 1
    for e in screensavers alarms.json reminders.json clipboard aur sandbox icc cutout; do
        [ -e "$stable/$e" ] || continue
        [ -z "$(git -C "$stable" ls-files -- "$e" 2>/dev/null | head -n 1)" ] || continue
        if [ -e "$data/$e" ]; then merge "$stable/$e" "$data/$e"; rmdir -- "$stable/$e" 2>/dev/null
        else mv -- "$stable/$e" "$data/" && said "moved $e out of the stable copy into $data"; fi
    done
    if [ -L "$1/rice" ] && [ "$(readlink -- "$1/rice")" = kuwai ]; then
        ln -sfn kuwai-data "$1/rice"
    fi
}
folder "${XDG_STATE_HOME:-$HOME/.local/state}"
folder "${XDG_CACHE_HOME:-$HOME/.cache}"
folder "${XDG_CONFIG_HOME:-$HOME/.config}"
folder "${XDG_DATA_HOME:-$HOME/.local/share}" kuwai-data
data_rescue "${XDG_DATA_HOME:-$HOME/.local/share}"

if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    rt="$XDG_RUNTIME_DIR"
    mkdir -p "$rt/kuwai"
    if [ -d "$rt/rice" ] && [ ! -L "$rt/rice" ]; then
        for e in "$rt/rice"/*; do [ -e "$e" ] && [ ! -e "$rt/kuwai/${e##*/}" ] && mv -- "$e" "$rt/kuwai/"; done
        rm -rf -- "$rt/rice"
    fi
    [ -e "$rt/rice" ] || ln -s kuwai "$rt/rice"
fi

units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
if command -v systemctl >/dev/null && [ -d "$units" ]; then
    changed=0
    for f in "$units"/rice-*.service "$units"/rice-*.timer; do
        [ -L "$f" ] || continue
        old=${f##*/}; new="kuwai-${old#rice-}"
        src="$ROOT/systemd/$new"
        [ -f "$src" ] || { said "no $src for $old; left as it is"; continue; }
        enabled=0; active=0
        systemctl --user is-enabled --quiet "$old" 2>/dev/null && enabled=1
        systemctl --user is-active --quiet "$old" 2>/dev/null && active=1
        systemctl --user disable --now "$old" >/dev/null 2>&1
        rm -f -- "$f"
        systemctl --user link "$src" >/dev/null 2>&1 || { said "couldn't link $src"; continue; }
        [ "$enabled" = 1 ] && systemctl --user enable "$new" >/dev/null 2>&1
        [ "$active" = 1 ] && systemctl --user start "$new" >/dev/null 2>&1
        said "$old is now $new"
        changed=1
    done
    [ "$changed" = 1 ] && systemctl --user daemon-reload
fi
exit 0
