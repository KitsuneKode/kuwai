#!/usr/bin/env bash
set -u
QUIET=0; SHOTS=0; SOAK=0
for a in "$@"; do case $a in --quiet) QUIET=1 ;; --shots) SHOTS=1 ;; --soak) SOAK=1 ;; esac; done
BUDGET=${KUWAI_MEM_BUDGET_MB:-450}
fail=0
ok()   { [ $QUIET = 1 ] || printf '  ✓ %s\n' "$1"; }
bad()  { printf '  ✗ %s\n' "$1"; fail=1; }

read -r pid root < <(qs list --all --json 2>/dev/null | jq -r '.[] | select(.config_path | endswith("/shell/shell.qml")) | "\(.pid) \(.config_path | sub("/shell/shell.qml$"; ""))"' | head -1)
[ -n "${pid:-}" ] || { bad "no shell running"; exit 1; }
[ $QUIET = 1 ] || echo "kuwai-check: shell $pid from $root"

log=$(readlink -f /run/user/$(id -u)/quickshell/by-pid/$pid 2>/dev/null)/log.qslog
if [ -r "$log" ]; then
    last=$(strings "$log" | grep -nE "Configuration Loaded|Failed to load configuration" | tail -1)
    case $last in
        *Loaded*) ok "load: configuration loaded" ;;
        *)        bad "load: the last reload failed ($(strings "$log" | grep -m1 -A1 'Failed to load' | tail -1 | cut -c1-120))" ;;
    esac
else
    bad "load: no log for pid $pid"
fi

if systemctl --user cat kuwai-shell.service >/dev/null 2>&1; then
    if [ "$(systemctl --user show -p MainPID --value kuwai-shell.service 2>/dev/null)" = "$pid" ]; then
        ok "unit: kept running by kuwai-shell.service"
    else
        bad "unit: this shell was started outside kuwai-shell.service, so nothing restarts it (kuwai restart)"
    fi
fi

descends() {
    local a=$1
    while [ -n "$a" ] && [ "$a" -gt 1 ] 2>/dev/null; do
        [ "$a" = "$pid" ] && return 0
        a=$(ps -o ppid= -p "$a" 2>/dev/null | tr -d ' ')
    done
    return 1
}
orph=""
for p in $(pgrep -f '^systemd-inhibit .*--who=kuwai' ; pgrep -f 'gdbus monitor --system --dest org.freedesktop.login1'); do
    descends "$p" || orph="$orph $p"
done
if [ -z "$orph" ]; then ok "orphans: none"; else bad "orphans: helpers left by an earlier shell:$orph (kill them)"; fi

expected='^(udevadm monitor |bun [^ ]*/kuwai-usage --watch|(bun|node) [^ ]*/kuwai-spend --watch|sh -c setpriv --pdeathsig KILL -- gdbus monitor --system --dest org\.freedesktop\.login1|systemd-inhibit .*--who=kuwai|pactl subscribe|[^ ]*/voxtype-audio-bridge|mpvpaper -l top |qs -p [^ ]*/shell-saver)'
open_ui=$(hyprctl layers -j 2>/dev/null | jq -r '[.. | objects | select(.namespace?) | .namespace] | map(select(test("^kuwai-(assistant|island)$"))) | length' 2>/dev/null)
stray=""
for c in $(pgrep -P "$pid"); do
    cmd=$(tr '\0' ' ' < /proc/$c/cmdline 2>/dev/null)
    [ -z "$cmd" ] && continue
    printf '%s' "$cmd" | grep -qE "$expected" && continue
    if printf '%s' "$cmd" | grep -q 'kuwai-render'; then [ "${open_ui:-0}" -gt 0 ] && continue; fi
    up=$(ps -o etimes= -p "$c" 2>/dev/null | tr -d ' ')
    [ -n "$up" ] && [ "$up" -lt 30 ] && ! printf '%s' "$cmd" | grep -qE 'brightness-client|kuwai-render' && continue
    stray="$stray
      $c (${up:-?} s): $(printf '%s' "$cmd" | cut -c1-110)"
done
if [ -z "$stray" ]; then ok "helpers: only the expected ones"; else bad "helpers: children the shell shouldn't keep:$stray"; fi

leak=$(grep -rnE 'command: *\[.*("subscribe"|"monitor"|"--watch"|"watch"|"-F"|"--serve"|while :)' "$root/shell" --include='*.qml' 2>/dev/null | grep -v pdeathsig | grep -v '"hyprctl", "monitors"')
for f in $(grep -rlE 'while :|while true;' "$root/shell" --include='*.qml' 2>/dev/null); do
    late=$(awk -v f="$f" '/command: *\[/ { cmd = $0; at = NR } /while :|while true;/ && at && NR - at < 15 && cmd !~ /pdeathsig/ { print f ":" NR }' "$f")
    [ -n "$late" ] && leak="${leak:+$leak
}$late"
done
if [ -z "$leak" ]; then ok "pdeathsig: every streaming helper dies with the shell"; else bad "pdeathsig: helpers that would outlive a restart:
$(printf '%s\n' "$leak" | sed "s|$root/||" | cut -c1-140 | sed 's/^/      /')"; fi

if [ -r "$log" ]; then
    pw=$(strings "$log" | grep -cE 'Pointer\.qml.*Unable to assign')
    [ "$pw" = 0 ] && ok "warnings: no Pointer.qml binding warnings" || bad "warnings: $pw Pointer.qml 'Unable to assign' in the log"
fi

owner=$(jq -r '.idleOwner // "shell"' "${XDG_CONFIG_HOME:-$HOME/.config}/kuwai/settings.json" 2>/dev/null)
guards=$(systemd-inhibit --list --no-pager 2>/dev/null | grep -c "Lock the screen before sleeping")
if [ "$owner" = shell ]; then
    [ "$guards" = 1 ] && ok "idle: one sleep guard" || bad "idle: $guards sleep guards (want 1)"
    pgrep -x hypridle >/dev/null && bad "idle: hypridle runs beside the shell's idle" || ok "idle: hypridle off"
else
    ok "idle: handed to hypridle"
fi

anon=$(awk '/Pss_Anon/ {print int($2/1024)}' /proc/$pid/smaps_rollup 2>/dev/null)
mem_why=""
if command -v hyprctl >/dev/null; then
    lw=$(hyprctl layers -j 2>/dev/null | jq -r '[.. | objects | select(.namespace? and .w > 1) | .namespace] | (if index("kuwai.wallpaper") and (index("kuwai.screensaver") | not) then "playing" else "" end)' 2>/dev/null)
    if [ "$lw" = playing ]; then BUDGET=$((BUDGET + 750)); mem_why=", a live wallpaper is playing in the shell: about 700 MB of this is its players'"; fi
fi
if [ -n "$anon" ] && [ "$anon" -le "$BUDGET" ]; then ok "memory: ${anon} MB (budget $BUDGET$mem_why)"; else bad "memory: ${anon:-?} MB over the $BUDGET MB budget$mem_why"; fi

age=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
[ -n "$age" ] && [ "$age" -lt 15 ] && sleep $((15 - age))
cpu_budget=5; cpu_why="at rest"
if command -v playerctl >/dev/null && playerctl -a status 2>/dev/null | grep -qx Playing; then cpu_budget=8; cpu_why="with music playing"; fi
working=$("$root/bin/kuwai-t3" 2>/dev/null | jq -r '.running // 0' 2>/dev/null)
if [ "${working:-0}" -gt 0 ] 2>/dev/null && [ "$cpu_budget" -lt 10 ]; then cpu_budget=10; cpu_why="while agents work (the island's T3 ring steps every 3 s)"; fi
if command -v voxtype >/dev/null && ! voxtype status 2>/dev/null | head -n 1 | grep -qx idle; then cpu_budget=35; cpu_why="while dictating"; fi
if command -v hyprctl >/dev/null && hyprctl layers -j 2>/dev/null | jq -e '[.. | objects | select(.namespace? and (.namespace | test("^kuwai\\.(screensaver|saver-film|wallpaper)$")) and .w > 1)] | length > 0' >/dev/null 2>&1; then
    cpu_budget=40; cpu_why="with a film on screen (screensaver or live wallpaper)"
fi
tck=$(getconf CLK_TCK); samples=""
t0=$(awk '{print $14+$15}' /proc/$pid/stat)
for _ in 1 2 3 4 5; do
    sleep 1; t1=$(awk '{print $14+$15}' /proc/$pid/stat)
    samples="$samples $(( (t1 - t0) * 100 / tck ))"; t0=$t1
done
set -- $(printf '%s\n' $samples | sort -n); cpu=$3; worst=$5
[ "$cpu" -lt "$cpu_budget" ] && ok "cpu: ${cpu}% $cpu_why (median of 5 s; worst second ${worst}%)" || bad "cpu: ${cpu}% $cpu_why, median of 5 s (want < $cpu_budget; seconds:$samples)"

broken=""
for f in $(cd "$root/shell" && find modules components -name '*.qml' | sort); do
    r=$(qs ipc -p "$root/shell" call test compile "$f" </dev/null 2>&1)
    [ "$r" = ok ] || broken="$broken
      $f: $(printf '%s' "$r" | head -1 | cut -c1-160)"
done
if [ -z "$broken" ]; then ok "compile: every module and component"; else bad "compile:$broken"; fi

if [ $SOAK = 1 ]; then
    [ $QUIET = 1 ] || echo "  soak: the screensaver 10 × (start, 10 s, stop), ~2.5 min; any key ends it early"
    pss() { awk '/Pss_Anon/ {print int($2/1024)}' /proc/$pid/smaps_rollup; }
    before=$(pss); worst=0; ended=0
    for i in $(seq 1 10); do
        "$root/bin/kuwai" screensaver start >/dev/null 2>&1
        sleep 2
        t0=$(awk '{print $14+$15}' /proc/$pid/stat); sleep 6; t1=$(awk '{print $14+$15}' /proc/$pid/stat)
        c=$(( (t1 - t0) * 100 / $(getconf CLK_TCK) / 6 )); [ "$c" -gt "$worst" ] && worst=$c
        sleep 2
        "$root/bin/kuwai" screensaver stop >/dev/null 2>&1
        sleep 3
    done
    sleep 10
    after=$(pss); grew=$((after - before))
    [ "$grew" -le 25 ] && ok "soak: memory ${before} → ${after} MB over 10 runs" || bad "soak: memory grew ${grew} MB over 10 runs (${before} → ${after})"
    [ "$worst" -lt 5 ] && ok "soak: the shell at ${worst}% CPU at most while it played" || bad "soak: the shell at ${worst}% CPU while it played (want < 5; the decoder is mpv's own)"
fi

KUWAI_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if out=$("$KUWAI_ROOT/bin/kuwai-tokens" --check 2>&1); then ok "$out"; else bad "tokens went up: $out (use Theme tokens)"; fi
if out=$("$KUWAI_ROOT/bin/kuwai-comments" --check 2>&1); then ok "$out"; else bad "comments went up: $out (run /delete-comment)"; fi
if out=$("$KUWAI_ROOT/bin/kuwai-layers" --check 2>&1); then ok "$out"; else bad "layers went up: $out (components cannot import services/modules)"; fi
if out=$("$KUWAI_ROOT/bin/kuwai-hyde-ratchet" --check 2>&1); then ok "$out"; else bad "hyde references went up: $out"; fi

if [ $SHOTS = 1 ]; then
    commit=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)
    dir=${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/shots/$commit
    mkdir -p "$dir"
    T() { qs ipc -p "$root/shell" call test "$@" </dev/null >/dev/null 2>&1; }
    snap() {
        sleep "${2:-0.9}"
        hyprctl monitors -j | jq -r '.[] | "\(.name) \(.x) \(.y) \(.width) \(.height) \(.scale)"' |
        while read -r name x y w h sc; do
            lw=$(awk -v w="$w" -v s="$sc" 'BEGIN{printf "%d", w/s}')
            grim -g "$(( x + lw / 2 - 420 )),$y 840x160" "$dir/$1-$name.png" 2>/dev/null
        done
    }
    T clear;                                   snap rest
    T moment focus "Focus" "On";               snap moment
    T clear; T alert warn "CPU at 95 °C";      snap alert-warn
    T alert crit "Battery at 3 %";             snap alert-crit
    T clear; T agents 3 0;                     snap agents-working
    T agents 3 2;                              snap agents-waiting
    T clear; T timer 300 "test pizza";         snap timer
    T clear
    n=$(ls "$dir" | wc -l)
    [ "$n" -gt 0 ] && ok "shots: $n in $dir" || bad "shots: none saved (grim?)"
fi

exit $fail
