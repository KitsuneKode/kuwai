#!/usr/bin/env bash
set -u
DIR="${T3_USERDATA:-$HOME/.t3/userdata}"
DB="$DIR/statev2.sqlite"
none() { printf '{"alive":false,"running":0,"waiting":0,"finished":0,"items":[]}\n'; exit 0; }
busy() { printf '{"alive":true,"error":"query"}\n'; exit 0; }
is_server() {
  local pid=$1 started btime ticks hz
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  started=$(jq -r '.startedAt // empty' "$DIR/server-runtime.json" 2>/dev/null)
  [ -n "$started" ] || return 0
  started=$(date -d "$started" +%s 2>/dev/null) || return 0
  btime=$(awk '/^btime/ {print $2}' /proc/stat 2>/dev/null)
  ticks=$(sed 's/.*) //' "/proc/$pid/stat" 2>/dev/null | awk '{print $20}')
  hz=$(getconf CLK_TCK 2>/dev/null)
  [[ "$btime$ticks$hz" =~ ^[0-9]+$ ]] || return 0
  [ $((btime + ticks / hz)) -le $((started + 120)) ]
}

if [ "${1:-}" = "reply" ]; then
  id="${2:-}"
  case "$id" in ''|*[!A-Za-z0-9:_.-]*) echo '{}'; exit 0 ;; esac
  [ -r "$DB" ] || { echo '{}'; exit 0; }
  out=$(timeout 3 sqlite3 -readonly -json -cmd ".timeout 2000" "file:$DB?mode=ro" "
    select substr(json_extract(payload_json, '\$.text'), 1, 4000) as text, updated_at as at
    from orchestration_v2_projection_messages
    where thread_id = '$id' and role = 'assistant' and coalesce(json_extract(payload_json, '\$.text'), '') != ''
    order by updated_at desc limit 1;" 2>/dev/null) || out=""
  [ -n "$out" ] || out="[]"
  jq -c '.[0] // {}' <<<"$out" 2>/dev/null || echo '{}'
  exit 0
fi

pid=$(jq -r '.pid // empty' "$DIR/server-runtime.json" 2>/dev/null) || none
is_server "$pid" || none
[ -r "$DB" ] || none

rows=$(timeout 3 sqlite3 -readonly -json -cmd ".timeout 2000" "file:$DB?mode=ro" "
  with th as (
    select t.thread_id as thread, coalesce(t.title, '') as title, t.payload_json as pj
    from orchestration_v2_projection_threads t
    where t.thread_id not like 'thread:%' and t.deleted_at is null and t.archived_at is null
      and json_extract(t.payload_json, '\$.settledAt') is null
      and coalesce(json_extract(t.payload_json, '\$.settledOverride'), '') != 'settled'
      and json_extract(t.payload_json, '\$.delegatedFrom') is null
      and coalesce(json_extract(t.payload_json, '\$.lineage.sideChat'), 0) != 1
      and coalesce(json_extract(t.payload_json, '\$.lineage.relationshipToParent'), '') != 'subagent'
      and coalesce(json_extract(t.payload_json, '\$.snoozedUntil'), '') <= strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
  active as (
    select r.thread_id as thread, r.run_id as run, r.status as status, r.provider as provider,
           coalesce(json_extract(r.payload_json, '\$.workStartedAt'), json_extract(r.payload_json, '\$.startedAt'), r.requested_at) as at,
           row_number() over (partition by r.thread_id order by r.ordinal desc, r.run_id desc) as n
    from orchestration_v2_projection_runs r
    where r.status in ('preparing','starting','running','waiting')
      and coalesce(json_extract(r.payload_json, '\$.silent'), 0) != 1),
  latest as (
    select r.thread_id as thread, r.run_id as run, r.status as status, r.provider as provider, r.completed_at as at,
           row_number() over (partition by r.thread_id
                              order by r.completed_at is null desc, r.completed_at desc, r.ordinal desc) as n
    from orchestration_v2_projection_runs r
    where r.status != 'queued'
      and not (r.status = 'cancelled' and json_extract(r.payload_json, '\$.startedAt') is null)
      and coalesce(json_extract(r.payload_json, '\$.silent'), 0) != 1)
  select th.thread, th.title,
         a.status as active, a.at as active_at, coalesce(a.provider, l.provider) as provider,
         l.status as latest, l.at as latest_at,
         json_extract(th.pj, '\$.lastVisitedAt') as visited,
         (select count(*) from orchestration_v2_projection_runtime_requests q
           where q.thread_id = th.thread and q.status = 'pending') as asks,
         (select count(*) from orchestration_v2_projection_runtime_requests q
           where q.thread_id = th.thread and q.status = 'pending' and q.kind = 'user_input') as questions,
         (select count(*) from json_each(th.pj, '\$.guestShare.messages') g
           where json_extract(g.value, '\$.status') = 'pending') as guests,
         case when a.status = 'running'
           and exists (select 1 from orchestration_v2_projection_turn_items ti
                        where ti.thread_id = a.thread and ti.run_id = a.run and ti.status in ('running','waiting')
                          and ti.type = 'dynamic_tool'
                          and (json_extract(ti.payload_json, '\$.toolName') glob '*t3_thread_wait'
                               or (json_extract(ti.payload_json, '\$.toolName') glob '*delegate_task'
                                   and json_extract(ti.payload_json, '\$.input.mode') = 'wait')))
           and not exists (select 1 from orchestration_v2_projection_turn_items ti
                        where ti.thread_id = a.thread and ti.run_id = a.run and ti.status in ('running','waiting')
                          and ti.type in ('command_execution','dynamic_tool','subagent','file_change','file_search','web_search','compaction')
                          and not (ti.type = 'subagent' and json_extract(ti.payload_json, '\$.origin') = 'app_owned')
                          and not (ti.type = 'dynamic_tool'
                                   and (json_extract(ti.payload_json, '\$.toolName') glob '*t3_thread_wait'
                                        or (json_extract(ti.payload_json, '\$.toolName') glob '*delegate_task'
                                            and json_extract(ti.payload_json, '\$.input.mode') = 'wait'))))
           then 1 else 0 end as blocked,
         (select json_extract(ti.payload_json, '\$.failure.class') from orchestration_v2_projection_turn_items ti
           where l.status = 'failed' and ti.thread_id = l.thread and ti.run_id = l.run
             and ti.type = 'error' and ti.status = 'failed'
           order by ti.updated_at desc limit 1) as failure,
         json_extract(th.pj, '\$.modelSelection.model') as model,
         (select json_extract(o.value, '\$.value') from json_each(th.pj, '\$.modelSelection.options') o
           where json_extract(o.value, '\$.id') = 'reasoningEffort') as effort,
         (select pp.title from projection_projects pp where pp.project_id = json_extract(th.pj, '\$.projectId')) as project
  from th
  left join active a on a.thread = th.thread and a.n = 1
  left join latest l on l.thread = th.thread and l.n = 1
  where a.status is not null
     or exists (select 1 from orchestration_v2_projection_runtime_requests q
                 where q.thread_id = th.thread and q.status = 'pending')
     or exists (select 1 from json_each(th.pj, '\$.guestShare.messages') g
                 where json_extract(g.value, '\$.status') = 'pending')
     or (l.status in ('completed','failed') and l.at >= strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-3 days'));" 2>/dev/null) || busy
[ -n "$rows" ] || rows="[]"
env_id=$(tr -cd 'A-Za-z0-9-' < "$DIR/environment-id" 2>/dev/null)
jq -cn --argjson rows "$rows" --arg env "$env_id" '
  def state:
    if (.asks // 0) > 0 or (.guests // 0) > 0 then "waiting"
    elif .active == "running" and .blocked == 1 then "blocked"
    elif .active != null then "running"
    elif .latest == "failed" and ((.visited == null) or (.latest_at > .visited)) then
      (if .failure == "usage_limit" then "limited" else "failed" end)
    elif .latest == "completed" and ((.visited == null) or (.latest_at > .visited)) then "completed"
    else null end;
  [$rows[] | . + {s: state} | select(.s != null)] as $all
  | ($all | map(select(.s == "waiting"))) as $wait
  | ($all | map(select(.s == "running" or .s == "blocked"))) as $run
  # Every finished thread not yet opened is counted (the pill shows ✓N);
  # the newest 24 come as rows (the panel list scrolls). The count was
  # the length of the rows, capped at 8: past eight the pill said ✓8 for good.
  | ($all | map(select(.s == "completed" or .s == "failed" or .s == "limited")) | sort_by(.latest_at) | reverse) as $ended
  | ($ended | .[0:24]) as $done
  | {alive: true, env: $env,
     running: ($run | map(select(.s == "running")) | length),
     waiting: ($wait | length),
     finished: ($ended | length),
     items: ([($wait + ($run | sort_by(.active_at) | reverse))[0:16][]
              | {status: (if .s == "blocked" then "running" else .s end), blocked: (.s == "blocked"),
                 # Why it needs you: something to approve, a question to answer, or a message from a guest.
                 ask: (if .s != "waiting" then null elif ((.asks // 0) - (.questions // 0)) > 0 then "approval"
                       elif (.questions // 0) > 0 then "question" else "request" end),
                 provider, title: (.title | .[0:80]), thread, at: .active_at, model, effort, project}]
            + [$done[] | {status: (if .s == "limited" then "failed" else .s end), limited: (.s == "limited"),
                 provider, title: (.title | .[0:80]), thread, at: .latest_at, model, effort, project}])}' 2>/dev/null || none
