#!/usr/bin/env bash
set -u

usage() {
cat <<'KUWAI_USAGE'
Control the running kuwai.

  kuwai start|restart        (re)start the shell, take over notifications
  kuwai stop                 stop it (dunst takes notifications back)
  kuwai status               is it running, since when, its last lines (kuwai-shell.service)
  kuwai logs                 follow the shell's log
  kuwai demo [--step]        a 45 s tour of the island with pretend agents (for trying it, or recording)
  kuwai notifs <cmd>         dnd | dnd-on | dnd-off | mute-on | mute-off | clear | hide | open | last | count | waybar
  kuwai feeds [status|gmail-setup|gmail-forget|logs]   GitHub and Gmail notifications (bin/kuwai-feeds)
  kuwai capsule set NAME --text T [--glyph G] [--tone green|orange|red] [--ttl S] [--url U | --run CMD…] | clear NAME | list
                             a capsule of your own beside the island (bin/kuwai-ext)
  kuwai collect [clipboard|feeds on|off]  what kuwai collects in the background; with no arguments, what it does now
  kuwai center [notifications|controls|sound] [pointer]   toggle the center (the notch grown);
                            agents opens the island's Agents panel
  kuwai assistant [here|open] toggle the AI assistant; `here` opens it about the focused window
  kuwai bar [island|waybar]  which top bar: kuwai's island or HyDE's Waybar
  kuwai lock [--wait]        lock with kuwai's lock screen (--wait: until it is locked; hyprlock if the shell is down)
  kuwai fade [start|stop]    darken the screens before the idle lock
  kuwai timer 10m [label]    a timer in the island (cancel · list)
  kuwai pomodoro             start/stop 25/5 focus cycles
  kuwai remind in 20m tea    a reminder ("at 5 call mum", "tomorrow 9am x"; list · clear)
  kuwai look <cmd>           standalone wallpaper & palette engine (bin/kuwai-look)
  kuwai webapp <cmd>         install/remove/list standalone web apps (bin/kuwai-webapp)
  kuwai export [file]        export or diff a portable machine manifest (bin/kuwai-profile)
  kuwai promote              validate dev HEAD and fast-forward stable (with auto-rollback)
  kuwai rollback             revert stable to the previous promoted commit (stable-prev)
  kuwai update-self          update stable to origin's newest release tag (signed by a key in release-signers when it lists any;
                             a tag that moves is refused; --ref REF follows another on purpose), validate, migrate, restart
  kuwai version              the version, the commit stable runs, and the channel
  kuwai release vX.Y.Z       tag main's HEAD as a release, signed with ~/.ssh/kuwai_release (KUWAI_RELEASE_KEY);
                             checked against release-signers; pushing the tag is left to you
KUWAI_USAGE
}

KUWAI="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SHELL_DIR="$KUWAI/shell"
# shellcheck source=lib/hyde.sh
. "$KUWAI/lib/hyde.sh"

ipc() {
    local dir=$SHELL_DIR st="${XDG_DATA_HOME:-$HOME/.local/share}/kuwai/shell"
    if [ "$dir" != "$st" ] && [ -f "$st/shell.qml" ] && ! qs ipc -p "$dir" show >/dev/null 2>&1; then dir=$st; fi
    qs ipc -p "$dir" call "$@" 2>/dev/null
}

COLLECT="${XDG_CONFIG_HOME:-$HOME/.config}/kuwai/collect.conf"
collect() {
    local what=$1 state=$2 unit
    if [ -z "$what" ]; then
        echo "clipboard  $(sed -n 's/^clipboard=//p' "$COLLECT" 2>/dev/null | tail -1 || true)  text and images you copy, kept by cliphist until you clear them"
        echo "feeds      $(sed -n 's/^feeds=//p' "$COLLECT" 2>/dev/null | tail -1 || true)  GitHub notifications (your gh login) and Gmail (kuwai feeds gmail-setup)"
        return 0
    fi
    case $what in clipboard) unit=kuwai-clipboard.service ;; feeds) unit=kuwai-feeds.service ;;
        *) echo "usage: kuwai collect [clipboard|feeds on|off]" >&2; return 2 ;; esac
    case $state in on|off) ;; *) echo "usage: kuwai collect $what on|off" >&2; return 2 ;; esac
    mkdir -p "$(dirname "$COLLECT")"
    { grep -v "^$what=" "$COLLECT" 2>/dev/null; echo "$what=$state"; } >"$COLLECT.new" && mv -- "$COLLECT.new" "$COLLECT"
    if [ "$state" = on ]; then
        systemctl --user enable --now "$unit" 2>/dev/null || { echo "kuwai: $what is on, but it didn't start (kuwai doctor)" >&2; return 1; }
    else
        systemctl --user disable --now "$unit" 2>/dev/null
        if systemctl --user -q is-active "$unit" 2>/dev/null; then echo "kuwai: $what is set off, but it is still running" >&2; return 1; fi
    fi
    echo "$what: $state"
}

kuwai_owns_notifications() {
    local pid
    pid=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
        GetConnectionUnixProcessID s org.freedesktop.Notifications 2>/dev/null | awk '{print $2}')
    [ -n "$pid" ] && [ "$(cat /proc/"$pid"/comm 2>/dev/null)" != "dunst" ]
}

dunst_waybar() {
    if ! pgrep -x dunst >/dev/null; then
        printf '{"text":"","alt":"none","class":"none","tooltip":"Notifications starting…"}\n'
        return
    fi
    local count paused alt
    count=$(dunstctl count history 2>/dev/null || echo 0)
    paused=$(dunstctl is-paused 2>/dev/null || echo false)
    if [ "$paused" = true ]; then alt=dnd; [ "$count" -gt 0 ] && alt=dnd-notification
    else alt=none; [ "$count" -gt 0 ] && alt=notification; fi
    printf '{"text":"%s","alt":"%s","class":"%s","tooltip":"󰎟 Notifications (dunst fallback)"}\n' "$count" "$alt" "$alt"
}

SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/kuwai/settings.json"

set_setting() { "$KUWAI/bin/kuwai-settings" set "$1" "$2" >/dev/null; }

get_setting() {
    local value
    value=$("$KUWAI/bin/kuwai-settings" get "$1") || return
    jq -r '.' <<<"$value"
}

bar() {
    case ${1:-} in
        island|waybar) set_setting bar "\"$1\"" || return ;;
        apply|"") ;;
        *) echo "usage: kuwai bar [island|waybar|apply]" >&2; return 2 ;;
    esac
    local chosen
    chosen=$(get_setting bar) || return
    [ -z "${1:-}" ] && { printf '%s\n' "$chosen"; return; }
    local units="hyde-${XDG_SESSION_DESKTOP:-Hyprland}-bar.service hyde-${XDG_SESSION_DESKTOP:-Hyprland}-waybar-watcher.service"
    if [ "$chosen" = island ]; then
        # shellcheck disable=SC2086
        systemctl --user stop $units 2>/dev/null
        # shellcheck disable=SC2086
        systemctl --user mask --runtime $units >/dev/null 2>&1
        pkill -x waybar 2>/dev/null
        "$KUWAI/bin/kuwai-hyde-waybar" off 2>/dev/null
    else
        "$KUWAI/bin/kuwai-hyde-waybar" on 2>/dev/null
        # shellcheck disable=SC2086
        systemctl --user unmask --runtime $units >/dev/null 2>&1
        if ! waybar_start; then
            echo "kuwai: no Waybar here (neither HyDE's nor waybar is installed); the island is the bar" >&2
            set_setting bar '"island"' || return
        fi
    fi
    return 0
}

notifs() {
    local cmd=${1:-}
    if kuwai_owns_notifications; then
        case $cmd in
            dnd)     ipc notifs toggleDnd >/dev/null ;;
            dnd-on)  ipc notifs setDnd true ;;
            dnd-off) ipc notifs setDnd false ;;
            mute-on) ipc notifs setDndMute true ;;
            mute-off) ipc notifs setDndMute false ;;
            clear)   ipc notifs clear ;;
            hide)    ipc notifs dismissPopups ;;
            open)    ipc notifs openLatest ;;
            last)    ipc notifs showLast ;;
            count)   ipc notifs count ;;
            waybar)  ipc notifs waybar ;;
            *) echo "usage: kuwai notifs dnd|dnd-on|dnd-off|clear|hide|open|last|count|waybar" >&2; return 2 ;;
        esac
    else
        case $cmd in
            dnd)     dunstctl set-paused toggle ;;
            dnd-on)  dunstctl set-paused true ;;
            dnd-off) dunstctl set-paused false ;;
            clear)   dunstctl history-clear ;;
            hide)    dunstctl close-all ;;
            open)    dunstctl action 0 ;;
            last)    dunstctl history-pop ;;
            count)   dunstctl count history ;;
            waybar)  dunst_waybar ;;
            *) echo "usage: kuwai notifs dnd|dnd-on|dnd-off|clear|hide|open|last|count|waybar" >&2; return 2 ;;
        esac
    fi
}

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kuwai"
STABLE="${XDG_DATA_HOME:-$HOME/.local/share}/kuwai"
dev_root() {
    local d
    d=$(cat "$STATE_DIR/dev-root" 2>/dev/null)
    [ -n "$d" ] && [ -e "$d/hypr/init.lua" ] && { echo "$d"; return; }
    for d in "$HOME/Projects/kuwai" "$HOME/Projects/rice"; do [ -e "$d/hypr/init.lua" ] && { echo "$d"; return; }; done
}
set_head() { git -C "$STABLE" reset --hard --quiet "$1" 2>/dev/null && [ "$(git -C "$STABLE" rev-parse HEAD 2>/dev/null)" = "$1" ]; }
undo_migrations() {
    local done=$STATE_DIR/migrations/done n gone=()
    [ -d "$done" ] && [ -x "$STABLE/bin/kuwai-migrations" ] || return 0
    while IFS= read -r n; do
        git -C "$STABLE" cat-file -e "$1:migrations/$n" 2>/dev/null || gone+=("$n")
    done < <(find "$done" -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-*.sh' -printf '%f\n' | LC_ALL=C sort -r)
    [ ${#gone[@]} -eq 0 ] || "$STABLE/bin/kuwai-migrations" --undo "${gone[@]}"
}
undo_release() {
    if ! set_head "$1"; then
        echo "kuwai: git refused to move stable back to $1; run: git -C $STABLE reset --hard $1" >&2
        return 1
    fi
    if [ -n "$2" ]; then
        git -C "$STABLE" branch -f stable-prev "$2" 2>/dev/null
    else
        git -C "$STABLE" branch -D stable-prev >/dev/null 2>&1
    fi
    return 0
}
switch_to() {
    hyprctl reload >/dev/null 2>&1
    sleep 0.5
    if [ -n "${KUWAI_ERRS_BEFORE+x}" ]; then
        local errs; errs=$(hyprctl configerrors 2>/dev/null)
        if [ -n "$(printf '%s' "$errs" | tr -d '[:space:]')" ] && [ "$errs" != "$KUWAI_ERRS_BEFORE" ]; then
            printf 'kuwai: Hyprland reports config errors with the new stable:\n%s\n' "$errs" | sed '/^\s*$/d' >&2
            return 1
        fi
    fi
    local main
    local main dev
    main=$(systemctl --user show -p MainPID --value kuwai-shell.service 2>/dev/null)
    dev=$(dev_root)
    qs list --all --json 2>/dev/null | jq -r '.[] | select(.config_path | endswith("/shell/shell.qml")) | "\(.pid) \(.config_path | sub("/shell/shell.qml$"; ""))"' | while read -r pid root; do
        case "$root" in "$STABLE"|"${dev:-/nonexistent}") ;; *) continue ;; esac
        [ "$root" = "$1" ] || [ "$pid" = "$main" ] || kill -9 "$pid" 2>/dev/null
    done
    systemctl --user set-environment KUWAI_ROOT="$1" 2>/dev/null
    hyprctl dispatch "hl.dsp.exec_cmd('dbus-update-activation-environment --systemd PATH KUWAI_ROOT')" >/dev/null 2>&1
    sleep 0.3
    exec "$1/bin/kuwai-shell"
}

case ${1:-} in
    channel)
        mkdir -p "$STATE_DIR"
        case ${2:-} in
            stable)
                [ -d "$STABLE/.git" ] || [ -f "$STABLE/.git" ] || { echo "kuwai: no stable copy at $STABLE (git worktree add $STABLE stable)" >&2; exit 1; }
                echo stable > "$STATE_DIR/channel"; switch_to "$STABLE" ;;
            dev)
                echo dev > "$STATE_DIR/channel"; switch_to "$(dev_root)" ;;
            "") cat "$STATE_DIR/channel" 2>/dev/null || echo "dev (no channel set)" ;;
            *) echo "usage: kuwai channel [stable|dev]" >&2; exit 2 ;;
        esac ;;
    promote)
        dev=$(dev_root)
        [ -n "$dev" ] || { echo "kuwai: no dev clone found (the one install.sh ran from, ~/Projects/kuwai or ~/Projects/rice)" >&2; exit 1; }
        if [ "$(git -C "$STABLE" rev-parse HEAD 2>/dev/null)" = "$(git -C "$dev" rev-parse HEAD 2>/dev/null)" ]; then
            echo "kuwai: stable is already at $(git -C "$STABLE" log --oneline -1); nothing to promote"
            exit 0
        fi
        if [ "${2:-}" != --force ] && ! "$dev/bin/kuwai-check" --quiet; then
            echo "kuwai: kuwai-check failed (above); fix it, or kuwai promote --force" >&2
            exit 1
        fi
        if ! bak=$("$dev/bin/kuwai-backup" auto "before promote" 2>&1) && [ "${2:-}" != --force ]; then
            printf '%s\n' "$bak" >&2
            echo "kuwai: no snapshot of your files could be taken (above); fix it, or kuwai promote --force" >&2
            exit 1
        fi
        head=$(git -C "$dev" rev-parse HEAD) || exit 1
        if command -v /usr/lib/qt6/bin/qmllint >/dev/null; then
            bad=""
            for f in $(git -C "$dev" diff --name-only "$(git -C "$STABLE" rev-parse HEAD)" "$head" -- '*.qml'); do
                [ -f "$dev/$f" ] || continue
                out=$(/usr/lib/qt6/bin/qmllint --bare -I /usr/lib/qt6/qml "$dev/$f" 2>&1 | grep -E "unknown attached property scope|\[syntax\]|\[unresolved-alias\]|^Error")
                [ -n "$out" ] && bad="$bad\n$f:\n$out"
                for id in $(git -C "$dev" diff -U0 "$(git -C "$STABLE" rev-parse HEAD)" "$head" -- "$f" | sed -nE 's/^-\s*id:\s*([A-Za-z_][A-Za-z0-9_]*)\s*$/\1/p' | sort -u); do
                    git -C "$dev" show "$head:$f" | grep -qE "^\s*id:\s*$id\s*$" && continue
                    left=$(git -C "$dev" show "$head:$f" | grep -nE "(^|[^A-Za-z0-9_.\"])$id(\.|\s*[,;)}]|$)" | grep -vE '^\s*[0-9]+:\s*//' | head -3)
                    [ -n "$left" ] && bad="$bad\n$f (uses id '$id', which this promote removes):\n$left"
                done
                fin=$(git -C "$dev" diff -U0 "$(git -C "$STABLE" rev-parse HEAD)" "$head" -- "$f" | grep -E '^\+\s*(readonly\s+)?property\s+[A-Za-z_.<>]+\s+(left|right|top|bottom|horizontalCenter|verticalCenter|baseline)\s*[:;]')
                [ -n "$fin" ] && bad="$bad\n$f (a property named like an anchor line, a FINAL override; it won't load — rename it):\n$fin"
            done
            if [ -n "$bad" ]; then
                printf "kuwai: this QML wouldn't load; stable left as it is:%b\n" "$bad" >&2
                exit 1
            fi
        fi
        leak=$(git -C "$dev" grep -nE 'command: *\[.*("subscribe"|"monitor"|"--watch"|"watch"|"-F"|"--serve"|while :)' "$head" -- 'shell/*.qml' | grep -v pdeathsig | grep -v '"hyprctl", "monitors"')
        for f in $(git -C "$dev" grep -lE 'while :|while true;' "$head" -- 'shell/*.qml' | sed "s|^$head:||"); do
            late=$(git -C "$dev" show "$head:$f" | awk -v f="$f" '/command: *\[/ { cmd = $0; at = NR }
                /while :|while true;/ && at && NR - at < 15 && cmd !~ /pdeathsig/ { print f ":" NR ":" $0 }')
            [ -n "$late" ] && leak="${leak:+$leak
}$late"
        done
        if [ -n "$leak" ]; then
            printf "kuwai: these helpers would outlive a restart (start them with setpriv --pdeathsig KILL --); stable left as it is:\n%s\n" "$leak" >&2
            exit 1
        fi
        if command -v luac >/dev/null; then
            bad=""
            for f in $(git -C "$dev" ls-tree -r --name-only "$head" -- hypr | grep '\.lua$'); do
                out=$(git -C "$dev" show "$head:$f" | luac -p - 2>&1) || bad="$bad\n$f: $out"
            done
            [ -z "$bad" ] || { printf "kuwai: this Lua wouldn't parse; stable left as it is:%b\n" "$bad" >&2; exit 1; }
        fi
        "$dev/bin/kuwai-loadtest" "$head" || { echo "kuwai: stable left as it is" >&2; exit 1; }
        "$dev/bin/kuwai-loadtest" "$head" greeter.qml || { echo "kuwai: the login screen wouldn't load; stable left as it is" >&2; exit 1; }
        dirty=$(git -C "$STABLE" status --porcelain 2>/dev/null)
        if [ -n "$dirty" ]; then
            printf "kuwai: stable (%s) has changes that aren't committed; stable left as it is:\n%s\nMake them in the repo instead (or: git -C %s stash), then promote again.\n" "$STABLE" "$dirty" "$STABLE" >&2
            exit 1
        fi
        if ! why=$("$dev/bin/kuwai-migrations" --check 2>&1); then
            printf "kuwai: not promoted: %s\nStable stays at %s. (kuwai migrations --list shows what's pending.)\n" \
                "${why#kuwai-migrations: }" "$(git -C "$STABLE" log --oneline -1)" >&2
            exit 1
        fi
        prev=$(git -C "$STABLE" rev-parse HEAD)
        old_prev=$(git -C "$STABLE" rev-parse --verify -q refs/heads/stable-prev)
        git -C "$STABLE" fetch --quiet "$dev" HEAD 2>/dev/null
        git -C "$STABLE" merge --ff-only --quiet "$head" || { echo "kuwai: stable can't fast-forward to $(git -C "$dev" log --oneline -1)" >&2; exit 1; }
        git -C "$STABLE" branch -f stable-prev "$prev" 2>/dev/null || true
        echo "stable is now $(git -C "$STABLE" log --oneline -1)"
        if ! "$STABLE/bin/kuwai-migrations"; then
            undo_migrations "$prev"
            undo_release "$prev" "$old_prev" || exit 1
            echo "kuwai: a migration didn't run (above); stable back to $(git -C "$STABLE" log --oneline -1); fix it in dev and promote again" >&2
            exit 1
        fi
        git -C "$STABLE" diff --quiet "$prev" HEAD -- systemd || systemctl --user daemon-reload 2>/dev/null
        if [ "$(cat "$STATE_DIR/channel" 2>/dev/null)" = stable ]; then
            KUWAI_ERRS_BEFORE=$(hyprctl configerrors 2>/dev/null)
            if ! ( switch_to "$STABLE" ); then
                unset KUWAI_ERRS_BEFORE
                echo "kuwai: the new shell didn't load; stable back to $(git -C "$STABLE" log --oneline -1 "$prev")" >&2
                for w in $(pgrep -x bash); do
                    [ "$(tr '\0' '\n' < /proc/$w/cmdline 2>/dev/null | sed -n 4p)" = kuwai-shell-watch ] && kill "$w" 2>/dev/null
                done
                undo_migrations "$prev"
                undo_release "$prev" "$old_prev" || exit 1
                ( switch_to "$STABLE" ) && echo "kuwai: rolled back; fix it in dev and promote again" >&2
                exit 1
            fi
        elif qs list --all --json 2>/dev/null | jq -e --arg d "$STABLE/shell/shell.qml" 'any(.[]; .config_path == $d)' >/dev/null; then
            echo "kuwai: channel is dev; restarting stable's shell only"
            if ! "$STABLE/bin/kuwai-shell"; then
                echo "kuwai: the new shell didn't load; stable back to $(git -C "$STABLE" log --oneline -1 "$prev")" >&2
                for w in $(pgrep -x bash); do
                    [ "$(tr '\0' '\n' < /proc/$w/cmdline 2>/dev/null | sed -n 4p)" = kuwai-shell-watch ] && kill "$w" 2>/dev/null
                done
                undo_migrations "$prev"
                undo_release "$prev" "$old_prev" || exit 1
                "$STABLE/bin/kuwai-shell" && echo "kuwai: rolled back; fix it in dev and promote again" >&2
                exit 1
            fi
        fi ;;
    check)         shift; exec "$KUWAI/bin/kuwai-check" "$@" ;;
    demo)          shift; exec "$KUWAI/bin/kuwai-demo" "$@" ;;
    version|--version|-V)
        printf 'kuwai %s\n' "$(cat "$KUWAI/VERSION" 2>/dev/null || echo unknown)"
        if [ -e "$STABLE/.git" ]; then
            printf 'stable  %s\n' "$(git -C "$STABLE" describe --tags --always 2>/dev/null)"
        fi
        printf 'channel %s\n' "$(cat "$STATE_DIR/channel" 2>/dev/null || echo stable)" ;;
    rollback)
        [ -e "$STABLE/.git" ] || { echo "kuwai: no stable copy at $STABLE" >&2; exit 1; }
        target=$(git -C "$STABLE" rev-parse --verify refs/heads/stable-prev 2>/dev/null) || { echo "kuwai: no stable-prev rollback target recorded yet" >&2; exit 1; }
        dirty=$(git -C "$STABLE" status --porcelain 2>/dev/null)
        [ -z "$dirty" ] || { echo "kuwai: stable has uncommitted changes; refusing rollback" >&2; exit 1; }
        cur=$(git -C "$STABLE" rev-parse HEAD)
        [ "$cur" != "$target" ] || { echo "kuwai: stable is already at stable-prev ($target)"; exit 0; }
        forward=0
        git -C "$STABLE" merge-base --is-ancestor "$cur" "$target" 2>/dev/null && forward=1
        if [ $forward = 0 ]; then
            undo_migrations "$target" || { echo "kuwai: undoing this release's migrations failed; nothing was rolled back" >&2; exit 1; }
        fi
        if ! set_head "$target"; then
            [ $forward = 0 ] && "$STABLE/bin/kuwai-migrations" >/dev/null 2>&1
            echo "kuwai: git refused to move stable to $target; nothing was rolled back" >&2
            exit 1
        fi
        if [ $forward = 1 ] && [ -x "$STABLE/bin/kuwai-migrations" ]; then
            "$STABLE/bin/kuwai-migrations" || echo "kuwai: a migration for $(git -C "$STABLE" log --oneline -1) failed; see above" >&2
        fi
        git -C "$STABLE" branch -f stable-prev "$cur" 2>/dev/null || true
        echo "stable rolled back to $(git -C "$STABLE" log --oneline -1)"
        git -C "$STABLE" diff --quiet "$cur" HEAD -- systemd || systemctl --user daemon-reload 2>/dev/null
        if [ "$(cat "$STATE_DIR/channel" 2>/dev/null)" = stable ]; then
            switch_to "$STABLE"
        fi ;;
    release)
        v=${2:-}
        [[ $v =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: kuwai release vX.Y.Z" >&2; exit 2; }
        dev=$(dev_root)
        [ -n "$dev" ] || { echo "kuwai: no dev clone found" >&2; exit 1; }
        key=${KUWAI_RELEASE_KEY:-$HOME/.ssh/kuwai_release}
        [ -f "$key.pub" ] || { echo "kuwai: no release key at $key (make one: ssh-keygen -t ed25519 -f $key)" >&2; exit 1; }
        [ "$(git -C "$dev" symbolic-ref --short HEAD 2>/dev/null)" = main ] || { echo "kuwai: releases are cut from main" >&2; exit 1; }
        [ -z "$(git -C "$dev" status --porcelain --untracked-files=no)" ] || { echo "kuwai: main has uncommitted changes" >&2; exit 1; }
        pub=$(cut -d' ' -f1,2 "$key.pub")
        git -C "$dev" show HEAD:release-signers 2>/dev/null | grep -qF "$pub" \
            || { echo "kuwai: $key.pub isn't in release-signers at HEAD; a tag it signs would be refused" >&2; exit 1; }
        git -C "$dev" -c gpg.format=ssh -c user.signingkey="$key.pub" tag -s -m "kuwai ${v#v}" "$v" HEAD || exit 1
        allowed=$(mktemp) || exit 1
        printf 'kuwai-release namespaces="git" %s\n' "$pub" >"$allowed"
        if git -C "$dev" -c gpg.ssh.allowedSignersFile="$allowed" verify-tag "$v" 2>&1 | grep -qF 'Good "git" signature for kuwai-release with'; then
            rm -f -- "$allowed"
            echo "kuwai: $v signed at $(git -C "$dev" log --oneline -1). Publish it: git -C $dev push origin $v"
        else
            rm -f -- "$allowed"
            git -C "$dev" tag -d "$v" >/dev/null
            echo "kuwai: $v didn't verify; the tag was removed" >&2
            exit 1
        fi
        ;;
    update-self)
        [ -e "$STABLE/.git" ] || { echo "kuwai: no stable copy at $STABLE" >&2; exit 1; }
        dirty=$(git -C "$STABLE" status --porcelain 2>/dev/null)
        [ -z "$dirty" ] || { echo "kuwai: stable has uncommitted changes; refusing update-self" >&2; exit 1; }
        git -C "$STABLE" remote get-url origin >/dev/null 2>&1 || { echo "kuwai: no origin remote configured in $STABLE" >&2; exit 1; }
        prev=$(git -C "$STABLE" rev-parse HEAD)
        follow=""
        [ "${2:-}" = --ref ] && follow=${3:?usage: kuwai update-self [--ref REF]}
        [ -n "${KUWAI_UPDATE_REF:-}" ] && [ -z "$follow" ] && echo "kuwai: KUWAI_UPDATE_REF is ignored now (any program can set it); say kuwai update-self --ref $KUWAI_UPDATE_REF" >&2
        if [ -n "$follow" ]; then
            ref="$follow"
            git -C "$STABLE" fetch --quiet origin || { echo "kuwai: git fetch origin failed" >&2; exit 1; }
            echo "kuwai: following $ref because you asked (--ref): not a release, not signature-checked" >&2
            target=$(git -C "$STABLE" rev-parse --verify -q "$ref^{commit}") || { echo "kuwai: $ref is not a commit" >&2; exit 1; }
        else
            remote=$(git -C "$STABLE" ls-remote --tags --refs origin 'refs/tags/v[0-9]*') || { echo "kuwai: can't list origin's release tags" >&2; exit 1; }
            ref=$(printf '%s\n' "$remote" | awk 'NF == 2 { sub("^refs/tags/", "", $2); print $2 }' | sort -V | tail -n1)
            [ -n "$ref" ] || { echo "kuwai: origin has no release tag (v*); to follow a branch on purpose: kuwai update-self --ref origin/main" >&2; exit 1; }
            want=$(printf '%s\n' "$remote" | awk -v t="refs/tags/$ref" '$2 == t { print $1 }')
            git -C "$STABLE" fetch --quiet --no-tags origin "+refs/tags/$ref:refs/kuwai/release/$ref" || { echo "kuwai: git fetch of $ref failed" >&2; exit 1; }
            [ "$(git -C "$STABLE" rev-parse "refs/kuwai/release/$ref")" = "$want" ] || { echo "kuwai: $ref changed while it was fetched; staying on $prev" >&2; exit 1; }
            pins="$STATE_DIR/release-pins"
            pinned=$(awk -v t="$ref" '$1 == t { print $2 }' "$pins" 2>/dev/null | tail -n1)
            if [ -n "$pinned" ] && [ "$pinned" != "$want" ]; then
                echo "kuwai: release $ref now points somewhere else than when this machine first saw it ($pinned → $want); staying on $prev" >&2
                exit 1
            fi
            extra="${XDG_CONFIG_HOME:-$HOME/.config}/kuwai/release-signers"
            listed=$( { git -C "$STABLE" show HEAD:release-signers 2>/dev/null; cat "$extra" 2>/dev/null; } )
            n_extra=$(grep -cvE '^\s*(#|$)' "$extra" 2>/dev/null || true)
            [ "${n_extra:-0}" -gt 0 ] && echo "kuwai: also trusting $n_extra key(s) from $extra (yours, not kuwai's)" >&2
            signers=$(printf '%s\n' "$listed" | tr -d ' ' | grep -Eio '^[0-9a-f]{40}$' | tr 'a-f' 'A-F')
            sshkeys=$(printf '%s\n' "$listed" | grep -Eo '^(ssh-ed25519|sk-ssh-ed25519@openssh\.com|ecdsa-sha2-nistp(256|384|521)|ssh-rsa) [A-Za-z0-9+/]+={0,2}')
            if [ -n "$signers$sshkeys" ]; then
                signed=0
                if [ -n "$signers" ]; then
                    sig=$(git -C "$STABLE" verify-tag --raw "refs/kuwai/release/$ref" 2>&1 | awk '$2 == "VALIDSIG" { print toupper($3); print toupper($NF) }')
                    printf '%s\n' "$sig" | grep -qxF -f <(printf '%s\n' "$signers") && signed=1
                fi
                if [ $signed = 0 ] && [ -n "$sshkeys" ]; then
                    allowed=$(mktemp) || exit 1
                    printf '%s\n' "$sshkeys" | sed 's/^/kuwai-release namespaces="git" /' >"$allowed"
                    git -C "$STABLE" -c gpg.ssh.allowedSignersFile="$allowed" verify-tag "refs/kuwai/release/$ref" 2>&1 \
                        | grep -qF 'Good "git" signature for kuwai-release with' && signed=1
                    rm -f -- "$allowed"
                fi
                [ $signed = 1 ] || { echo "kuwai: $ref isn't signed by a key in release-signers; staying on $prev" >&2; exit 1; }
            else
                echo "kuwai: no release-signers listed, so $ref is checked against origin and this machine's pins only" >&2
            fi
            [ -n "$pinned" ] || { mkdir -p "$STATE_DIR"; printf '%s %s\n' "$ref" "$want" >> "$pins"; }
            git -C "$STABLE" rev-parse --verify -q "refs/tags/$ref" >/dev/null || git -C "$STABLE" update-ref "refs/tags/$ref" "$want"
            target=$(git -C "$STABLE" rev-parse --verify -q "refs/kuwai/release/$ref^{commit}") || { echo "kuwai: $ref is not a commit" >&2; exit 1; }
        fi
        if [ "$prev" = "$target" ] || git -C "$STABLE" merge-base --is-ancestor "$target" "$prev"; then
            echo "kuwai: already up to date ($(git -C "$STABLE" log --oneline -1))"
            exit 0
        fi
        if command -v luac >/dev/null; then
            for f in $(git -C "$STABLE" ls-tree -r --name-only "$target" -- hypr | grep '\.lua$'); do
                git -C "$STABLE" show "$target:$f" | luac -p - >/dev/null || { echo "kuwai: upstream Lua failed syntax check ($f); staying on $prev" >&2; exit 1; }
            done
        fi
        "$STABLE/bin/kuwai-loadtest" "$target" || { echo "kuwai: upstream shell failed loadtest; staying on $prev" >&2; exit 1; }
        "$STABLE/bin/kuwai-loadtest" "$target" greeter.qml || { echo "kuwai: upstream greeter failed loadtest; staying on $prev" >&2; exit 1; }
        old_prev=$(git -C "$STABLE" rev-parse --verify -q refs/heads/stable-prev)
        git -C "$STABLE" merge --ff-only --quiet "$target" || { echo "kuwai: cannot fast-forward stable to $ref" >&2; exit 1; }
        git -C "$STABLE" branch -f stable-prev "$prev" 2>/dev/null || true
        if ! "$STABLE/bin/kuwai-migrations"; then
            undo_migrations "$prev"
            undo_release "$prev" "$old_prev" || exit 1
            echo "kuwai: migration failed; rolled back to $prev" >&2
            exit 1
        fi
        git -C "$STABLE" diff --quiet "$prev" HEAD -- systemd || systemctl --user daemon-reload 2>/dev/null
        echo "kuwai: updated stable to $(git -C "$STABLE" log --oneline -1)"
        if [ "$(cat "$STATE_DIR/channel" 2>/dev/null)" = stable ]; then
            KUWAI_ERRS_BEFORE=$(hyprctl configerrors 2>/dev/null)
            if ! ( switch_to "$STABLE" ); then
                unset KUWAI_ERRS_BEFORE
                undo_migrations "$prev"
                undo_release "$prev" "$old_prev" || exit 1
                ( switch_to "$STABLE" ) || true
                echo "kuwai: new shell failed to start; rolled back to $prev" >&2
                exit 1
            fi
        fi ;;
    look)          shift; exec "$KUWAI/bin/kuwai-look" "$@" ;;
    webapp)        shift; exec "$KUWAI/bin/kuwai-webapp" "$@" ;;
    export)        shift; exec "$KUWAI/bin/kuwai-profile" export "$@" ;;
    profile)       shift; exec "$KUWAI/bin/kuwai-profile" "$@" ;;
    migrations)    shift; exec "$KUWAI/bin/kuwai-migrations" "$@" ;;
    doctor)        shift; exec "$KUWAI/bin/kuwai-doctor" "$@" ;;
    start|restart) exec "$KUWAI/bin/kuwai-shell" ;;
    stop)          systemctl --user stop kuwai-shell.service kuwai-shell-broken.service 2>/dev/null
                   for pid in $(qs list -p "$SHELL_DIR" --json 2>/dev/null | jq -r ".[].pid"); do kill -9 "$pid"; done ;;
    status)        exec systemctl --user status kuwai-shell.service --no-pager ;;
    logs)          exec qs log -p "$SHELL_DIR" -f ;;
    notifs)        shift; notifs "$@" ;;
    collect)       collect "${2:-}" "${3:-}" ;;
    capsule)       shift; exec "$KUWAI/bin/kuwai-ext" capsule "$@" ;;
    providers)     exec "$KUWAI/bin/kuwai-ext" providers ;;
    feeds)         case ${2:-status} in
                       logs) exec journalctl --user -u kuwai-feeds.service -f ;;
                       *) exec "$KUWAI/bin/kuwai-feeds" "${2:-status}" ;;
                   esac ;;
    bar)           shift; bar "$@" ;;
    lock)
        if ! ipc lock lock 2>/dev/null; then
            command -v hyprlock >/dev/null || { echo "kuwai: the shell isn't answering and hyprlock isn't installed: not locked" >&2; exit 1; }
            pidof hyprlock >/dev/null || setsid -f hyprlock >/dev/null 2>&1 </dev/null
            for _ in $(seq 20); do pidof hyprlock >/dev/null && break; sleep 0.05; done
            pidof hyprlock >/dev/null || { echo "kuwai: hyprlock didn't start: not locked" >&2; exit 1; }
            if [ "${2:-}" = --wait ]; then
                echo "kuwai: fallback lock requested, but lock readiness cannot be confirmed; refusing success" >&2
                exit 1
            fi
            exit 0
        fi
        if [ "${2:-}" = --wait ]; then
            for _ in $(seq 60); do [ "$(ipc lock state)" = locked ] && exit 0; sleep 0.05; done
            exit 1
        fi ;;
    fade)          ipc fade "${2:-start}" >/dev/null 2>&1 ;;
    screensaver)   ipc screensaver "${2:-start}" ;;
    saver)
        dir="${XDG_DATA_HOME:-$HOME/.local/share}/kuwai-data/screensavers"
        case ${2:-} in
            add)
                src=${3:-}; [ -f "$src" ] || { echo "usage: kuwai saver add FILE [name]" >&2; exit 2; }
                name=${4:-$(basename "${src%.*}")}; name=$(printf '%s' "$name" | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9-')
                [ -n "$name" ] || { echo "kuwai: give it a name (letters, digits, -)" >&2; exit 2; }
                mkdir -p "$dir"
                echo "making $dir/$name.mp4 (a seamless half-speed loop)…"
                ffmpeg -nostdin -v error -y -i "$src" -filter_complex \
                    "[0:v]scale='min(2560,iw)':-2,setpts=2.0*PTS,fps=24,split[a][b];[b]reverse[r];[a][r]concat=n=2:v=1,eq=brightness=-0.03:saturation=0.9,format=yuv420p[v]" \
                    -map "[v]" -an -c:v libx264 -preset slow -crf 23 -maxrate 7M -bufsize 14M -g 48 -movflags +faststart "$dir/$name.mp4" \
                    && ffmpeg -nostdin -v error -y -ss 4 -i "$dir/$name.mp4" -frames:v 1 -vf scale=480:-2 -q:v 3 "$dir/$name.jpg" \
                    && echo "✓ $name: pick it in Themes → Screensaver (or: kuwai set screensaverClip $name; kuwai set screensaverStyle night)" ;;
            remove)
                case "${3:-}" in
                    ""|*/*|*..*) echo "usage: kuwai saver remove NAME" >&2; exit 2 ;;
                    *) rm -i -- "$dir/${3}.mp4" "$dir/${3}.jpg" ;;
                esac ;;
            ""|list)
                for f in "$dir"/*.mp4; do [ -e "$f" ] && basename "${f%.mp4}"; done ;;
            *) echo "usage: kuwai saver [list|add FILE [name]|remove NAME]" >&2; exit 2 ;;
        esac ;;
    pomodoro|pomo) ipc timer pomodoro ;;
    remind)
        case "${2:-list}" in
            list) ipc remind list ;;
            clear) ipc remind clear ;;
            *) ipc remind add "${*:2}" ;;
        esac ;;
    backup)        shift; exec "$KUWAI/bin/kuwai-backup" "$@" ;;
    settings)      ipc island settings "${2:-}" ;;
    usage)         ipc island open usage ;;
    system|vitals) ipc island open system ;;
    alarm)
        case "${2:-list}" in
            list|clear|stop|snooze) ipc alarm "${2:-list}" ;;
            *) ipc alarm add "${*:2}" ;;
        esac ;;
    note)
        if [ $# -lt 2 ]; then ipc note open; else ipc note add "${*:2}"; fi ;;
    timer)
        case ${2:-} in
            cancel) ipc timer cancel ;;
            list|"") ipc timer list ;;
            *) ipc timer start "$2" "${*:3}" ;;
        esac ;;
    set)           [ $# -eq 3 ] || { echo "usage: kuwai set KEY VALUE" >&2; exit 2; }; set_setting "$2" "$3" ;;
    get)           if [ -n "${2:-}" ]; then get_setting "$2"; else jq . "$SETTINGS" 2>/dev/null || echo '{}'; fi ;;
    blank)         ipc blank toggle ;;
    center)
        if ! qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1; then
            "$KUWAI/bin/kuwai-shell" >/dev/null 2>&1
            for _ in $(seq 20); do qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1 && break; sleep 0.1; done
        fi
        ipc center toggle "${2:-notifications}" "${3:-key}" ;;
    assistant)
        if ! qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1; then
            "$KUWAI/bin/kuwai-shell" >/dev/null 2>&1
            for _ in $(seq 20); do qs ipc -p "$SHELL_DIR" show >/dev/null 2>&1 && break; sleep 0.1; done
        fi
        case "${2:-}" in
            here) ipc assistant here ;;
            open) ipc assistant open ;;
            *)    ipc assistant toggle ;;
        esac ;;
    *) usage; exit 2 ;;
esac
