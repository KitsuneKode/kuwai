#!/usr/bin/env bash
set -euo pipefail

usage() {
cat <<'KUWAI_USAGE'
The clipboard panel's hands (shell/services/Clipboard.qml). History is
cliphist's (the wl-paste watchers keep feeding it); pins are kuwai's own
and outlive cliphist's 750-item cap.

  kuwai-clip list                 cliphist list, wide previews
  kuwai-clip text ID              the entry's text (first 64 KiB)
  kuwai-clip thumb ID EXT         decode an image entry into the cache, print its path
  kuwai-clip copy ID|pin:N        put an entry (or pin) on the clipboard
  kuwai-clip paste ID|pin:N       copy, then paste into the focused window
  kuwai-clip open ID|pin:N        open with the default app (URL, path, image, text)
  kuwai-clip delete ID            remove from history
  kuwai-clip wipe                 clear history (pins stay)
  kuwai-clip copy-text TEXT       put this text on the clipboard (edits, transforms)
  kuwai-clip paste-text TEXT      …and paste it into the focused window
KUWAI_USAGE
}

cache="${XDG_CACHE_HOME:-$HOME/.cache}/kuwai/clip"
pins="${XDG_DATA_HOME:-$HOME/.local/share}/kuwai-data/clipboard/pins"
mkdir -p "$cache/thumbs" "$cache/open" "$cache/edit" "$pins"
find "$cache/open" "$cache/edit" -type f -mmin +1440 -delete 2>/dev/null || true
find "$cache/thumbs" -type f -mtime +7 -delete 2>/dev/null || true

emit() {
    case "$1" in
        pin:*) id=${1#pin:}; case $id in ''|*/*|.*) exit 2 ;; esac; cat -- "$pins/$id" ;;
        *)     printf '%s\t\n' "$1" | cliphist decode ;;
    esac
}

ext_of() {
    case "$(file -b --mime-type "$1")" in
        image/png) echo png ;; image/jpeg) echo jpg ;; image/gif) echo gif ;;
        image/webp) echo webp ;; image/bmp) echo bmp ;; image/svg+xml) echo svg ;;
        image/tiff) echo tiff ;; text/*|application/json) echo txt ;; *) echo bin ;;
    esac
}

uris_existing() {
    while IFS= read -r line; do
        line="${line%$'\r'}"
        case "$line" in file://*) ;; *) continue ;; esac
        path=$(printf '%s' "${line#file://}" | python3 -I -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.stdin.read()))')
        [ -e "$path" ] && printf '%s\r\n' "$line"
    done
}

copy() {
    local tmp; tmp=$(mktemp "$cache/open/.copy.XXXXXX")
    emit "$1" > "$tmp"
    local mime; mime=$(file -b --mime-type "$tmp")
    if head -c 7 "$tmp" | grep -q '^file://'; then
        local list; list=$(uris_existing < "$tmp")
        if [ -n "$list" ]; then printf '%s' "$list" | wl-copy --type text/uri-list; rm -f -- "$tmp"; return; fi
    fi
    case "$mime" in
        image/*) wl-copy --type "$mime" < "$tmp" ;;
        *)       wl-copy < "$tmp" ;;
    esac
    rm -f -- "$tmp"
}

case "${1:-}" in
    list)  cliphist list -preview-width 400 ;;
    text)  emit "$2" | head -c 65536 ;;
    thumb)
        case ${2:-} in ''|*[!0-9]*) case ${2:-} in pin:*) ;; *) exit 2 ;; esac ;; esac
        case ${3:-png} in png|jpg|jpeg|gif|webp|bmp|svg|tiff|x-icon) ;; *) exit 2 ;; esac
        case ${2#pin:} in */*|.*) exit 2 ;; esac
        out="$cache/thumbs/${2#pin:}.${3:-png}"
        [ -s "$out" ] || emit "$2" > "$out"
        printf '%s\n' "$out" ;;
    copy)  copy "$2" ;;
    paste|paste-text)
        if [ "$1" = paste ]; then copy "$2"; else printf '%s' "$2" | wl-copy; fi
        hint_class=${3:-}
        hint_addr=${4:-}
        [[ "$hint_addr" =~ ^0x[0-9a-fA-F]+$ ]] || hint_addr=""
        sleep 0.08
        if [ -n "$hint_addr" ]; then
            hyprctl dispatch "hl.dsp.focus({ window = \"address:$hint_addr\" })" >/dev/null 2>&1 || true
            sleep 0.06
        fi
        active=$(hyprctl activewindow -j 2>/dev/null)
        if [ -n "$hint_addr" ] && [ "$(printf '%s' "$active" | jq -r '.address // empty' 2>/dev/null)" != "$hint_addr" ]; then
            echo "kuwai-clip: the window it was for isn't in front; left on the clipboard" >&2
            exit 3
        fi
        class=$(printf '%s' "$active" | jq -r '.class // empty' 2>/dev/null)
        class=${class:-$hint_class}
        case "${class,,}" in
            *kitty*|*ghostty*|*foot*|*alacritty*|*wezterm*|*konsole*|*terminal*|*terminator*|*tilix*|drop-term|float-term|kuwai-console|kuwai-edit|kuwai-monitor)
                wtype -M ctrl -M shift -k v -m shift -m ctrl ;;
            *)  wtype -M ctrl -k v -m ctrl ;;
        esac ;;
    open)
        tmp=$(mktemp "$cache/open/.raw.XXXXXX")
        emit "$2" > "$tmp"
        ext=$(ext_of "$tmp")
        if [ "$ext" = txt ]; then
            text=$(head -c 4096 "$tmp" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            single=$(printf '%s' "$text" | wc -l)
            if [ "$single" -eq 0 ] && [[ "$text" =~ ^(https?|ftp|mailto):[^[:space:]]+$ ]]; then
                rm -f -- "$tmp"; exec xdg-open "$text"
            fi
            path="${text#file://}"; path="${path/#\~/$HOME}"
            if [ "$single" -eq 0 ] && [ -e "$path" ]; then
                rm -f -- "$tmp"; exec xdg-open "$path"
            fi
        fi
        out="$cache/open/clip-$(date +%Y%m%d-%H%M%S).$ext"
        mv -- "$tmp" "$out"
        exec xdg-open "$out" ;;
    copy-text) printf '%s' "$2" | wl-copy ;;
    files)
        emit "$2" | head -c 65536 | THUMBS="$cache/thumbs" python3 -I -c '
import json, mimetypes, os, subprocess, sys, hashlib, urllib.parse
text = sys.stdin.read().strip()
paths = [urllib.parse.unquote(l[7:]) for l in text.splitlines() if l.startswith("file://")]
if not paths and text.startswith(("/", "~/")) and "\n" not in text:
    paths = [os.path.expanduser(text)]
out = []
for p in paths[:50]:
    e = {"path": p, "name": os.path.basename(p.rstrip("/")) or p, "exists": os.path.exists(p), "dir": os.path.isdir(p)}
    e["type"] = "folder" if e["dir"] else (mimetypes.guess_type(p)[0] or "")
    if e["exists"] and not e["dir"]:
        st = os.stat(p)
        e["size"] = st.st_size
        if e["type"] == "application/pdf" or e["type"].startswith("image/"):
            key = hashlib.sha1(f"{p}:{st.st_mtime}:110dpi".encode()).hexdigest()[:16]
            thumb = os.path.join(os.environ["THUMBS"], f"file-{key}.png")
            if not os.path.exists(thumb):
                if e["type"] == "application/pdf":
                    subprocess.run(["pdftoppm", "-png", "-r", "110", "-f", "1", "-l", "1", "-singlefile", p, thumb[:-4]], capture_output=True, timeout=10)
                else:
                    thumb = p
            if os.path.exists(thumb):
                e["preview"] = thumb
        if e["type"] == "application/pdf":
            info = subprocess.run(["pdfinfo", p], capture_output=True, text=True, timeout=5).stdout
            pages = [l.split(":", 1)[1].strip() for l in info.splitlines() if l.startswith("Pages:")]
            if pages: e["pages"] = int(pages[0])
    out.append(e)
print(json.dumps(out))
' ;;
    stamp)
        cat > /dev/null
        now=$(date +%s%3N)
        sleep 0.4
        id=$(cliphist list 2>/dev/null | head -1 | cut -f1)
        [ -n "$id" ] || exit 0
        times="$(dirname "$pins")/times.tsv"
        if ! tail -1 "$times" 2>/dev/null | grep -q "^$id	"; then
            printf '%s\t%s\n' "$id" "$now" >> "$times"
            if [ "$(wc -l < "$times" 2>/dev/null || echo 0)" -gt 1200 ]; then
                tmp_t=$(mktemp "$times.XXXXXX") && tail -n 1000 "$times" > "$tmp_t" && mv -- "$tmp_t" "$times" || rm -f -- "$tmp_t"
            fi
        fi ;;
    edit)
        dir="$cache/edit"; mkdir -p "$dir"
        find "$dir" -maxdepth 1 -name 'clip-*' -type f -mtime +7 -delete 2>/dev/null || true
        tmp=$(mktemp "$dir/.raw.XXXXXX")
        emit "$2" > "$tmp"
        ext=$(ext_of "$tmp"); [ "$ext" = txt ] && head -c 4096 "$tmp" | grep -qE '^#{1,6} |^```|^\s*[-*] \S' && ext=md
        f="$dir/clip-$(date +%Y%m%d-%H%M%S).$ext"
        mv -- "$tmp" "$f"
        before=$(sha1sum < "$f")
        editor="${KUWAI_EDITOR:-${EDITOR:-nvim}}"
        term="${KUWAI_TERMINAL:-kitty}"
        $term --class kuwai-edit --title "Clipboard · $(basename "$f")" -e $editor "$f"
        if [ "$(sha1sum < "$f")" != "$before" ]; then wl-copy < "$f"; fi ;;
    render) emit "$2" | head -c 262144 | "$(dirname "$0")/kuwai-render" ;;
    ocr)
        tmp=$(mktemp "$cache/open/.ocr.XXXXXX")
        emit "$2" > "$tmp"
        tesseract "$tmp" - 2>/dev/null | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
        rm -f -- "$tmp" ;;
    save)
        dir="$HOME/Pictures/Clipboard"; mkdir -p "$dir"
        tmp=$(mktemp "$cache/open/.save.XXXXXX")
        emit "$2" > "$tmp"
        out="$dir/clip-$(date +%Y%m%d-%H%M%S).$(ext_of "$tmp")"
        mv -- "$tmp" "$out"
        printf '%s\n' "$out" ;;
    save-as)
        dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"; mkdir -p "$dir"
        tmp=$(mktemp "$cache/open/.save.XXXXXX")
        emit "$2" > "$tmp"
        ext=$(ext_of "$tmp")
        name=$(printf '%s' "${3:-Screenshot_$(date +%Y%m%d_%H%M%S)}" | tr '/\0' '__' | sed 's/^[.-]*//')
        name="${name%.$ext}"; [ -n "$name" ] || name="Screenshot_$(date +%Y%m%d_%H%M%S)"
        out="$dir/$name.$ext"; n=2
        while [ -e "$out" ]; do out="$dir/$name-$n.$ext"; n=$((n + 1)); done
        mv -- "$tmp" "$out"
        printf '%s\n' "$out" ;;
    delete)
        printf '%s\t\n' "$2" | cliphist delete
        [[ "$2" =~ ^[0-9]+$ ]] && rm -f -- "$cache/thumbs/$2".* ;;
    wipe)
        cliphist wipe
        rm -f -- "$cache"/thumbs/* "$cache"/open/* "$cache"/open/.[!.]* "$cache"/edit/* "$cache"/edit/.[!.]* 2>/dev/null
        rm -f -- "$cache"/render/mermaid-* 2>/dev/null ;;
    pin)
        tmp=$(mktemp "$pins/.new.XXXXXX")
        emit "$2" > "$tmp"
        name="$(date +%s%N).$(ext_of "$tmp")"
        mv -- "$tmp" "$pins/$name"
        printf '%s\n' "$name" ;;
    unpin)  rm -f -- "$pins/${2##*/}" ;;
    *) usage; exit 2 ;;
esac
