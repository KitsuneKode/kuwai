#!/usr/bin/env python3
"""kuwai-saver-photos: the pictures the Photos screensaver shows, as a JSON list of paths.

  kuwai-saver-photos [FOLDER]

With a folder, its pictures (one level). Without one, the current theme's
wallpapers (asked of kuwai-themes), else the folder of the wallpaper you have now. A folder that isn't there lists nothing, and the
saver shows the still wallpaper instead. The list is capped; hidden files,
empty files and anything but a picture are left out.
"""
import json
import os
import subprocess
import sys

PICTURES = (".jpg", ".jpeg", ".png", ".webp")
LIMIT = 400
BIGGEST = 64 << 20


def home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def theme_walls():
    tool = os.path.join(os.path.dirname(os.path.realpath(__file__)), "kuwai-themes")
    try:
        done = subprocess.run([tool, "photos"], capture_output=True, text=True, timeout=10)
        listed = json.loads(done.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    if not isinstance(listed, list):
        return []
    return [p for p in listed if isinstance(p, str) and p.lower().endswith(PICTURES) and os.path.isfile(p)]


def pictures(folder):
    out = []
    try:
        names = sorted(os.listdir(folder), key=str.lower)
    except OSError:
        return out
    for name in names:
        path = os.path.join(folder, name)
        if name.startswith(".") or not name.lower().endswith(PICTURES):
            continue
        try:
            size = os.stat(path).st_size
        except OSError:
            continue
        if 0 < size <= BIGGEST and os.path.isfile(path):
            out.append(os.path.abspath(path))
        if len(out) >= LIMIT:
            break
    return out


def current_folder():
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(home(), ".local/state")
    link = os.path.join(state, "kuwai", "wallpaper")
    return os.path.dirname(os.path.realpath(link)) if os.path.exists(link) else ""


def listing(folder=""):
    if folder:
        return pictures(os.path.expanduser(folder))
    found = theme_walls()
    return found or pictures(current_folder() or os.devnull)


def main(argv):
    if len(argv) > 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    print(json.dumps(listing(argv[0] if argv else "")))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
