#!/usr/bin/env bash
set -eu
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/kuwai/crashes-seen.json"
mkdir -p "$(dirname "$STATE")"
[ -s "$STATE" ] || echo '{}' > "$STATE"
seen=$STATE
uid=$(id -u)
json=$(coredumpctl list --since "3 min ago" --json=short 2>/dev/null || true)
[ -n "$json" ] || exit 0
jq -r --argjson me "$uid" '.[] | select(.uid == $me) | [(.time // ""), (.pid // ""), (.sig // ""), (.exe // "")] | @tsv' <<<"$json" 2>/dev/null |
while IFS=$'\t' read -r time pid sig exe; do
    [ -n "$pid" ] || continue
    id="${time}-${pid}-${exe}"
    if jq -e --arg k "$id" '.[$k]' "$seen" >/dev/null 2>&1; then continue; fi
    brief=$(coredumpctl info "$pid" 2>/dev/null | head -25 | tail -20 || true)
    [ -n "$brief" ] || brief="$exe signal $sig"
    jq -cn --arg id "$id" --arg exe "$exe" --arg sig "$sig" --arg time "$time" --arg brief "$brief" \
        '{id:$id,exe:$exe,signal:$sig,time:$time,brief:$brief}'
    jq --arg k "$id" '.[$k]=true' "$seen" > "${seen}.tmp" && mv "${seen}.tmp" "$seen"
done
