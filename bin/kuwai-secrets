#!/usr/bin/env python3
"""Move API keys out of shell startup files into your login keyring.

  kuwai-secrets scan                 where keys sit in plain text (names and lines, never values)
  kuwai-secrets move NAME...         store each in the keyring, check it, then point the file at it
  kuwai-secrets list                 the keys kuwai keeps in the keyring
  kuwai-secrets run NAME... -- CMD   run CMD with those keys in its environment only
  kuwai-secrets get NAME             print one key (for $(kuwai-secrets get NAME))

Only these files are read: ~/.zshrc, ~/.zshenv, $ZDOTDIR/.zshrc, $ZDOTDIR/.zshenv,
~/.bashrc, ~/.bash_profile, ~/.profile, ~/.config/fish/config.fish.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile

SERVICE = "kuwai-env"
SECRET = re.compile(r"(?<![A-Za-z0-9_])([A-Z][A-Z0-9_]*(?:API_KEY|_KEY|TOKEN|SECRET|PASSWORD)[A-Z0-9_]*)=(\"[^\"$`]*\"|'[^']*'|[^\s\"'$`;|&\\]+)")
WHOLE = re.compile(r"^(\s*)(export\s+)?([A-Z][A-Z0-9_]*)=(\"[^\"$`]*\"|'[^']*'|[^\s\"'$`;|&\\]+)\s*$")


def files():
    home = os.path.expanduser("~")
    z = os.environ.get("ZDOTDIR") or ""
    names = [f"{home}/.zshrc", f"{home}/.zshenv", f"{home}/.bashrc", f"{home}/.bash_profile", f"{home}/.profile", f"{home}/.config/fish/config.fish"]
    if z:
        names += [f"{z}/.zshrc", f"{z}/.zshenv"]
    seen, out = set(), []
    for n in names:
        r = os.path.realpath(n)
        if os.path.isfile(r) and r not in seen:
            seen.add(r)
            out.append(n)
    return out


def unquote(v):
    return v[1:-1] if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'" else v


def found():
    out = []
    for f in files():
        try:
            lines = open(f, encoding="utf-8").read().split("\n")
        except (OSError, UnicodeDecodeError):
            continue
        for i, line in enumerate(lines, 1):
            if line.lstrip().startswith("#"):
                continue
            for m in SECRET.finditer(line):
                w = WHOLE.match(line)
                out.append({"file": f, "line": i, "name": m.group(1), "value": unquote(m.group(2)), "whole": bool(w and w.group(3) == m.group(1))})
    return out


def store(name, value):
    p = subprocess.run(["secret-tool", "store", "--label", f"kuwai: {name}", "service", SERVICE, "key", name],
                       input=value, text=True, capture_output=True, timeout=30)
    return p.returncode == 0


def lookup(name):
    p = subprocess.run(["secret-tool", "lookup", "service", SERVICE, "key", name], capture_output=True, text=True, timeout=30)
    return p.stdout if p.returncode == 0 else None


def rewrite(path, changes):
    real = os.path.realpath(path)
    lines = open(real, encoding="utf-8").read().split("\n")
    for i, name in changes:
        m = WHOLE.match(lines[i - 1])
        lines[i - 1] = f'{m.group(1)}{m.group(2) or ""}{name}="$(secret-tool lookup service {SERVICE} key {name})"'
    st = os.stat(real)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".kuwai-secrets.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            out.write("\n".join(lines))
        os.chmod(tmp, st.st_mode & 0o7777)
        os.replace(tmp, real)
    except OSError:
        os.unlink(tmp)
        raise


def cmd_scan():
    hits = found()
    if not hits:
        print("No keys in plain text in your shell startup files.")
        return 0
    for h in hits:
        how = "kuwai-secrets move " + h["name"] if h["whole"] else "inside a command: use kuwai-secrets run " + h["name"] + " -- …"
        print(f'{h["file"]}:{h["line"]}  {h["name"]}  ({how})')
    return 0


def cmd_move(names):
    if not shutil.which("secret-tool"):
        print("kuwai-secrets: needs secret-tool (libsecret) and a running keyring", file=sys.stderr)
        return 1
    hits = [h for h in found() if h["name"] in names]
    rc = 0
    for name in names:
        mine = [h for h in hits if h["name"] == name]
        if not mine:
            print(f"{name}: not found in plain text")
            continue
        if len({h["value"] for h in mine}) > 1:
            print(f"{name}: has different values in different places; nothing moved", file=sys.stderr)
            rc = 1
            continue
        value = mine[0]["value"]
        if not store(name, value) or lookup(name) != value:
            print(f"{name}: the keyring didn't keep it; nothing changed", file=sys.stderr)
            rc = 1
            continue
        whole = [h for h in mine if h["whole"]]
        inline = [h for h in mine if not h["whole"]]
        by_file = {}
        for h in whole:
            by_file.setdefault(h["file"], []).append((h["line"], name))
        for f, changes in by_file.items():
            rewrite(f, changes)
            print(f"{name}: {f} now reads it from the keyring")
        for h in inline:
            print(f'{name}: in the keyring; {h["file"]}:{h["line"]} still has it inside a command: replace the value with $(kuwai-secrets get {name}), or wrap the command in kuwai-secrets run {name} --')
    return rc


def cmd_list():
    p = subprocess.run(["secret-tool", "search", "--all", "service", SERVICE], capture_output=True, text=True, timeout=30)
    names = sorted(set(re.findall(r"^attribute\.key = (\S+)$", p.stdout + p.stderr, re.M)))
    print("\n".join(names) if names else "No keys kept by kuwai yet.")
    return 0


def cmd_run(argv):
    if "--" not in argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    cut = argv.index("--")
    names, cmd = argv[:cut], argv[cut + 1:]
    if not cmd:
        return 2
    env = dict(os.environ)
    for n in names:
        v = lookup(n)
        if v is None:
            print(f"kuwai-secrets: {n} isn't in the keyring", file=sys.stderr)
            return 1
        env[n] = v
    os.execvpe(cmd[0], cmd, env)


def main(argv):
    if not argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    c, rest = argv[0], argv[1:]
    if c == "scan":
        return cmd_scan()
    if c == "move" and rest:
        return cmd_move(rest)
    if c == "list":
        return cmd_list()
    if c == "run":
        return cmd_run(rest)
    if c == "get" and len(rest) == 1:
        v = lookup(rest[0])
        if v is None:
            return 1
        sys.stdout.write(v)
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
