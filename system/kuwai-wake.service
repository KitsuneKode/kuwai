[Unit]
Description=Rice alarms: set the RTC wake time

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/kuwai-wake-root
# It only writes the RTC.
ProtectSystem=strict
ReadWritePaths=/sys/class/rtc
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_TIME
AmbientCapabilities=
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
