#!/usr/bin/python3 -I
import os, stat, sys, time

AT = "/var/lib/kuwai-wake/at"
RTC = "/sys/class/rtc/rtc0/wakealarm"

def main():
    try:
        fd = os.open(AT, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise OSError("not a regular file")
            raw = os.read(fd, 32).decode("ascii", "strict").strip()
        finally:
            os.close(fd)
    except (OSError, UnicodeDecodeError):
        raw = "0"
    if not raw.isdigit() or len(raw) > 12:
        print("kuwai-wake: not a time; ignored", file=sys.stderr)
        return 1
    t = int(raw)
    now = int(time.time())
    with open(RTC, "w") as f:
        f.write("0")
    if t == 0:
        print("kuwai-wake: cleared")
        return 0
    if not (now + 30 <= t <= now + 8 * 86400):
        print(f"kuwai-wake: {t} is not within the next 8 days; cleared", file=sys.stderr)
        return 1
    with open(RTC, "w") as f:
        f.write(str(t))
    print(f"kuwai-wake: wake at {time.strftime('%F %T', time.localtime(t))}")
    return 0

sys.exit(main())
