#!/usr/bin/env bash
# The rice's one-time system pieces (needs sudo):
#
#   sudo system/install          alarms that wake the laptop (rice-wake)
#   sudo system/install --undo   remove them
#
# rice-wake: you own /var/lib/rice-wake/at (one number: when to wake);
# a root-owned helper reads only that number and sets the RTC. Nothing else.
set -eu
[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
USER_NAME=${SUDO_USER:?run with sudo from your account}
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

if [ "${1:-}" = --undo ]; then
    systemctl disable --now rice-wake.path 2>/dev/null || true
    rm -f /etc/systemd/system/rice-wake.path /etc/systemd/system/rice-wake.service /usr/local/libexec/rice-wake-root
    rm -rf /var/lib/rice-wake
    echo 0 > /sys/class/rtc/rtc0/wakealarm 2>/dev/null || true
    systemctl daemon-reload
    echo "rice-wake removed."
    exit 0
fi

install -D -o root -g root -m 0755 "$HERE/rice-wake-root" /usr/local/libexec/rice-wake-root
install -o root -g root -m 0644 "$HERE/rice-wake.path" "$HERE/rice-wake.service" /etc/systemd/system/
install -d -o root -g root -m 0755 /var/lib/rice-wake
[ -f /var/lib/rice-wake/at ] || echo 0 > /var/lib/rice-wake/at
chown "$USER_NAME:" /var/lib/rice-wake/at
chmod 0644 /var/lib/rice-wake/at
systemctl daemon-reload
systemctl enable --now rice-wake.path
echo "rice-wake installed: alarms now wake the laptop from sleep."
