---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogAlt?: string;
  solidHeader?: boolean;
  schemaJson?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath = "/",
  ogImage = "/og-image.png",
  ogAlt = "kuwai Hyprland desktop and Quickshell island",
  solidHeader = false,
  schemaJson
} = Astro.props;

const siteUrl = "https://kuwai.kitsunekode.in";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const fullOgImage = new URL(ogImage, siteUrl).toString();
const currentPath = Astro.url.pathname;

const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "kuwai",
      description: "An Arch Linux desktop built from a Lua Hyprland 0.57 session and a Quickshell shell.",
      inLanguage: "en-US"
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "kuwai",
      applicationCategory: "DesktopEnvironment",
      operatingSystem: "Arch Linux (Hyprland 0.57+)",
      softwareVersion: "0.1.0",
      license: "https://www.gnu.org/licenses/gpl-3.0.en.html",
      url: `${siteUrl}/`,
      downloadUrl: "https://github.com/KitsuneKode/kuwai",
      codeRepository: "https://github.com/KitsuneKode/kuwai",
      screenshot: `${siteUrl}/og-image.png`,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD"
      }
    }
  ]
};

const jsonLd = JSON.stringify(schemaJson ?? defaultSchema);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="theme-color" content="#0b0b0f">
  <meta name="color-scheme" content="dark">
  <link rel="canonical" href={canonicalUrl}>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="kuwai">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={fullOgImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogAlt}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={fullOgImage}>
  <meta name="twitter:image:alt" content={ogAlt}>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="kuwai Releases (RSS 2.0)" href="/feed.xml">
  <link rel="alternate" type="application/atom+xml" title="kuwai Releases (Atom)" href="/atom.xml">
  <link rel="author" href="/humans.txt">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body>
  <header class:list={["site-header", { "is-scrolled": solidHeader }]} id="siteHeader">
    <div class="header-inner">
      <a href="/" class="brand-wordmark" aria-label="kuwai home">
        <img src="/assets/brand/kuwai-mark.svg" alt="" width="28" height="28" class="brand-mark-img">
        <span>kuwai</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/#what-you-get">Features</a>
        <a href="/#requirements">Requirements</a>
        <a href="/#install">Install</a>
        <a href="/#security">Privacy &amp; security</a>
        <a href="/changelog/" aria-current={currentPath.startsWith("/changelog") ? "page" : undefined}>Changelog</a>
        <a href="/brand/" aria-current={currentPath.startsWith("/brand") ? "page" : undefined}>Brand</a>
        <a href="https://github.com/KitsuneKode/kuwai" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-about">
          <a href="/" class="footer-logo" aria-label="kuwai home">
            <img src="/assets/brand/kuwai-wordmark.svg" alt="kuwai" width="114" height="26">
          </a>
          <p class="footer-tagline">An Arch Linux desktop made of a Lua Hyprland 0.57 session and a Quickshell shell around a top-edge island.</p>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">On this page</h3>
          <ul class="footer-list">
            <li><a href="/#what-you-get">What you get</a></li>
            <li><a href="/#requirements">Requirements</a></li>
            <li><a href="/#install">Install</a></li>
            <li><a href="/#security">Privacy and security</a></li>
            <li><a href="/#credits">Credits and licence</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">Documentation</h3>
          <ul class="footer-list">
            <li><a href="/changelog/">Changelog</a></li>
            <li><a href="/brand/">Brand and tokens</a></li>
            <li><a href="https://github.com/KitsuneKode/kuwai/blob/main/docs/manual/README.md" target="_blank" rel="noopener noreferrer">Manual</a></li>
            <li><a href="https://github.com/KitsuneKode/kuwai/blob/main/docs/DESIGN.md" target="_blank" rel="noopener noreferrer">Design tokens</a></li>
            <li><a href="/.well-known/security.txt">Security policy</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">Repository</h3>
          <ul class="footer-list">
            <li><a href="https://github.com/KitsuneKode/kuwai" target="_blank" rel="noopener noreferrer">Source on GitHub</a></li>
            <li><a href="/feed.xml">RSS 2.0 feed</a></li>
            <li><a href="/atom.xml">Atom feed</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <span>kuwai v0.1.0 · GPL-3.0-or-later</span>
        <span>Arch Linux · Hyprland 0.57+ · Quickshell</span>
      </div>
    </div>
  </footer>

  {!solidHeader && (
    <script is:inline>
      (() => {
        const h = document.getElementById("siteHeader");
        if (!h) return;
        const sync = () => h.classList.toggle("is-scrolled", window.scrollY > 24);
        sync();
        window.addEventListener("scroll", sync, { passive: true });
      })();
    </script>
  )}
</body>
</html>
