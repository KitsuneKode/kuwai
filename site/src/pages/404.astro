---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page not found: kuwai"
  description="The page you requested could not be found."
  canonicalPath="/404"
  solidHeader={true}
>
  <main class="subpage-main">
    <section class="subpage-head">
      <div class="container">
        <h1 class="subpage-title">Page not found</h1>
        <p class="section-intro">The link you followed may be outdated or moved. Return home to inspect the Dynamic Island or read the latest releases.</p>
        <div class="hero-actions">
          <a href="/" class="btn-primary">Return home</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
