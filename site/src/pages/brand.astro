---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandSwatches from "../components/BrandSwatches.tsx";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "kuwai Brand and Design Tokens",
      url: "https://kuwai.kitsunekode.in/brand/",
      description: "SVG marks, wordmarks, and core colour tokens from shell/config/Theme.qml.",
      isPartOf: { "@id": "https://kuwai.kitsunekode.in/#website" }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://kuwai.kitsunekode.in/" },
        { "@type": "ListItem", position: 2, name: "Brand", item: "https://kuwai.kitsunekode.in/brand/" }
      ]
    }
  ]
};
---
<BaseLayout
  title="Brand and Design Tokens — kuwai"
  description="SVG marks, wordmarks, and core colour tokens from shell/config/Theme.qml."
  canonicalPath="/brand/"
  ogImage="/og-image.png"
  solidHeader={true}
  schemaJson={schema}
>
  <main class="subpage-main">
    <section class="subpage-head">
      <div class="container">
        <h1 class="subpage-title">Brand and design tokens</h1>
        <p class="section-intro">Direction A: a machined superellipse notch mark, one meaning per colour, and Geist SemiBold for the wordmark. No mascot and no decorative chrome on the clock row.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>SVG marks and wordmarks</h2>
          <p class="section-intro">Mirrored from <code>docs/brandkit/assets/</code> in the repository.</p>
        </div>

        <div class="brand-grid">
          <div class="brand-plate plate-dark">
            <img src="/assets/brand/kuwai-wordmark.svg" alt="kuwai wordmark on dark background" width="210" height="48">
            <div class="plate-bar">
              <span>Wordmark (dark)</span>
              <a href="/assets/brand/kuwai-wordmark.svg" download class="inline-link">Download SVG</a>
            </div>
          </div>

          <div class="brand-plate plate-light">
            <img src="/assets/brand/kuwai-wordmark-dark.svg" alt="kuwai wordmark on light background" width="210" height="48">
            <div class="plate-bar">
              <span>Wordmark (light)</span>
              <a href="/assets/brand/kuwai-wordmark-dark.svg" download class="inline-link">Download SVG</a>
            </div>
          </div>

          <div class="brand-plate plate-dark">
            <img src="/assets/brand/kuwai-mark-tile.svg" alt="kuwai app tile mark" width="96" height="96">
            <div class="plate-bar">
              <span>App tile</span>
              <a href="/assets/brand/kuwai-mark-tile.svg" download class="inline-link">Download SVG</a>
            </div>
          </div>

          <div class="brand-plate plate-dark">
            <img src="/assets/brand/kuwai-mark.svg" alt="kuwai notch mark" width="64" height="64">
            <div class="plate-bar">
              <span>Standalone mark (superellipse notch)</span>
              <a href="/assets/brand/kuwai-mark.svg" download class="inline-link">Download SVG</a>
            </div>
          </div>
        </div>
        <p class="section-intro">Wordmarks use Geist SemiBold at 600 weight with tight tracking, mirrored in the site CSS stack alongside the OFL webfonts in <code>site/public/fonts/</code>.</p>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <h2>One meaning per colour</h2>
          <p class="section-intro">Core semantic palette from <code>shell/config/Theme.qml</code>. Click any swatch to copy its hex value.</p>
        </div>

        <BrandSwatches client:visible />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>UI primitives</h2>
          <p class="section-intro">Every panel composes the same buttons, chips, cards, notices, meters, toggles, and tiles from <code>shell/components/ui/</code>.</p>
        </div>

        <figure class="media-frame">
          <img src="/media/primitives.png" alt="kuwai UI primitives gallery rendered from the shell" loading="lazy">
          <figcaption>Rendered directly from the shell's gallery view (<code>shell/modules/Gallery.qml</code>).</figcaption>
        </figure>
      </div>
    </section>
  </main>
</BaseLayout>
