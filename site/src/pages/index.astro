---
import BaseLayout from "../layouts/BaseLayout.astro";
import InstallBlock from "../components/InstallBlock.tsx";

const siteUrl = "https://kuwai.kitsunekode.in";

const features = [
  {
    id: "island",
    title: "The island",
    summary: "One status surface at the top edge of each screen. At rest it shows workspaces, the clock, status, and live activity such as a timer, recording, dictation, or music. Background work floats beside it in separate capsules for agents, usage limits, system news, and minimised windows. Hovering opens a glance row; clicking or pulling down grows the panel.",
    details: [
      "Privacy dots appear beside status when the microphone (orange), camera (green), or screen sharing/recording (purple) is active, naming the app on hover.",
      "Alarms, due reminders, finished timers, and connecting audio devices grow out of the notch as cards you can answer from the keyboard (Super+Ctrl+Enter).",
      "Pressing Super+Tab opens Mission Control across every workspace on the screen; Alt+Tab switches windows from the shell."
    ],
    media: [
      {
        src: "/media/clips/island-hover.webp",
        alt: "Resting on the kuwai island opens the glance row with workspaces, clock, machine status, and agents",
        caption: "Hovering the island opens the glance row (recorded live at 60 fps)."
      },
      {
        src: "/media/island/capsule-states.png",
        alt: "Capsule states: Working, Needs you, Hit a limit, and Error",
        caption: "Capsule states: working, needs you, hit a limit, and error."
      },
      {
        src: "/media/clips/island-timer.webp",
        alt: "A running timer displayed as a ring in the island",
        caption: "Timers and Pomodoro cycles run inside the island."
      },
      {
        src: "/media/tour/calendar-events.png",
        alt: "Calendar panel showing a month view and events from an iCal feed",
        caption: "Calendar panel (Super+Alt+C) with HTTPS iCal feeds."
      }
    ]
  },
  {
    id: "notifications",
    title: "Notifications",
    summary: "kuwai runs its own org.freedesktop.Notifications server with a stacked toast list, notch peeks for important or replyable alerts, and a Notification Centre (Super+N) grouped by app with search and undo clear.",
    details: [
      "Chat message bodies are hidden on passive surfaces and on the lock screen by default; while sharing your screen, non-critical bodies stay hidden everywhere.",
      "Do Not Disturb (Super+Alt+N) and screen-share mute suppress normal alerts while letting critical alerts through.",
      "Optional GitHub (via gh) and Gmail (IMAP IDLE, app password in keyring) feeds turn inbox items into notifications with inline reply and mark-as-read; off until you enable them."
    ],
    media: []
  },
  {
    id: "clipboard",
    title: "Clipboard",
    summary: "Super+V opens the clipboard shelf above the workspace, backed by cliphist. Search with fuzzy matching, inspect items in Quick Look (Space), edit text in place, run OCR on images (Ctrl+O), and keep pinned entries (Super+Shift+V) beyond the history cap.",
    details: [
      "Clipboard history is opt-in (asked during install, toggled any time with kuwai collect clipboard on|off).",
      "Password-manager entries are skipped when the app sets the password hint, and secret-shaped text is masked in the list.",
      "Markdown, code, and Mermaid diagrams render in Quick Look; deleting an entry can be undone with Ctrl+Z for a few seconds."
    ],
    media: []
  },
  {
    id: "launcher",
    title: "Launcher",
    summary: "Super+A searches desktop apps, open windows, files under home (via fd), kuwai settings, and actions in one fixed-height list ranked by frecency.",
    details: [
      "Built-in calculator handles arithmetic, percentages, units, and currencies (=), with optional qalc fallback.",
      "Prefix ! lists processes and listening ports (for example ! 3000) so you can stop your own processes without opening a terminal.",
      "Prefix + searches official Arch repositories and the AUR to install or remove packages; : searches emoji, ; searches Nerd Font glyphs; natural-language commands start timers, reminders, alarms, and quick notes."
    ],
    media: [
      {
        src: "/media/clips/launcher.webp",
        alt: "The kuwai launcher answering math as you type",
        caption: "Launcher answering calculations inline as you type."
      },
      {
        src: "/media/tour/launcher-packages.png",
        alt: "Launcher package search showing Arch repository and AUR results",
        caption: "Package search (+) across official Arch repositories and the AUR."
      }
    ]
  },
  {
    id: "controls",
    title: "Controls, sound, and displays",
    summary: "Super+Ctrl+Space opens Controls from the notch: Wi-Fi (Super+Ctrl+Alt+W), Bluetooth (Super+Alt+B), Do Not Disturb, Night Shift, Caffeine, microphone mute, Reduce Motion, display presets, brightness, and a per-app PipeWire sound mixer.",
    details: [
      "Display presets switch between Everyday, Accurate, Movie (120 Hz on external displays), Gaming, and Battery, with automatic HDR or explicit browser HDR (kuwai display hdr).",
      "HDR status in the notch reads the live signal on the wire (PQ/HLG via kuwai-hdr) rather than guessing from a toggle.",
      "The System section shows CPU, memory by app (proportional RSS so multi-process browsers count once), GPU state, and quick mode switches; Now Playing cleans browser titles and supports per-player actions."
    ],
    media: [
      {
        src: "/media/clips/sound.webp",
        alt: "Sound panel showing per-app volume sliders, outputs, and microphone level",
        caption: "Sound view: per-app streams, output switching, and live microphone level."
      },
      {
        src: "/media/tour/system-typical.png",
        alt: "System panel showing CPU, proportional memory by app, and GPU telemetry",
        caption: "System panel: CPU, proportional memory by app, and GPU."
      },
      {
        src: "/media/tour/media-playing.png",
        alt: "Now Playing panel with album art, progress bar, and transport controls",
        caption: "Now Playing panel with playback controls and seek bar."
      }
    ]
  },
  {
    id: "lock",
    title: "Lock and login",
    summary: "The session lock (Super+L) and the optional greetd login screen share the same layout, password pill, corner status, and motion.",
    details: [
      "The password pill uses no character echo: five dots pulse on each keystroke so password length is never shown, with a Caps Lock warning underneath.",
      "Power actions (Sleep, Restart, Shut Down) require holding for 0.8 seconds instead of a single click, both at login and in the session power menu (Super+Backspace).",
      "At login, greeter/sync copies only validated display and keyboard layout data; the greeter's QML and Lua code stays root-owned in /var/lib/kuwai-greeter."
    ],
    media: [
      {
        src: "/media/login/login.webp",
        alt: "kuwai greetd login screen with centred clock, user avatar, and hold-to-power row",
        caption: "Login screen on greetd (optional: sudo greeter/install)."
      },
      {
        src: "/media/login/lock.webp",
        alt: "kuwai session lock screen with blurred wallpaper, clock, and notification preview",
        caption: "Lock screen (Super+L) with private notification previews."
      }
    ]
  },
  {
    id: "looks",
    title: "Screensaver, wallpapers, and themes",
    summary: "Super+Shift+T opens Themes, Wallpapers, Live wallpapers, and Screensavers. kuwai ships 13 dark theme definitions (Kuwai Night, Aurora, Chrome Sunset, Crimson Noir, Deep Field, Earthlight, Garage, Matcha, Neon District, Pixel Dusk, Sakura Night, Violet Hour, Void) driven by its standalone kuwai-look palette engine.",
    details: [
      "Palette switches check contrast against WCAG 4.5:1 and update the shell, Hyprland borders, and terminal colours atomically; HyDE is optional.",
      "Still wallpaper changes spread out from the notch with a shader transition; live wallpapers re-encode once (kuwai-wall add) and pause when covered by windows.",
      "Screensavers run Dusk (shader), Borealis (theme-accent shader), Night (out-of-process looping film whose memory is freed on wake), Live wallpaper, or Still wallpaper."
    ],
    media: [
      {
        src: "/media/clips/themes.webp",
        alt: "Themes panel switching between palettes and wallpapers",
        caption: "Switching themes and palettes from the island."
      },
      {
        src: "/media/clips/wallpaper.webp",
        alt: "Wallpaper transition spreading from the notch across the desktop",
        caption: "Wallpaper transition growing out of the notch."
      }
    ]
  },
  {
    id: "dictation",
    title: "Dictation hooks",
    summary: "If voxtype is installed, kuwai binds dictation keys automatically (hold F9 to dictate, Super+Ctrl+D to toggle, Super+Shift+D or Escape to cancel, Super+Ctrl+Alt+D to recover a cancelled take, Super+Ctrl+E to edit a selection by voice).",
    details: [
      "The island hosts voxtype's Quickshell HUD inside the main shell when configured with VOXTYPE_OSD_HOST, avoiding a second Quickshell process.",
      "While dictating, the screensaver and idle dim wait so speaking never triggers idle lock mid-sentence.",
      "When voxtype is not installed, none of these binds are registered."
    ],
    media: []
  },
  {
    id: "agents",
    title: "Agents and usage",
    summary: "Agents, Usage, System, and Cleanup share one tabbed island strip (Alt+1 to Alt+4). Super+Shift+N opens Agents, listing kitty/kittymux panes, T3 Code threads, and desktop agents reporting through kuwai-agent-hook.",
    details: [
      "Waiting approvals get their own orange capsule beside the notch; Super+Ctrl+A jumps straight to the waiting pane or thread.",
      "Claude Code, Codex (via kittymux PermissionRequest hooks), and T3 Code (via a separate operate token) can be allowed or denied from the notch without typing keystrokes into a terminal pane.",
      "Usage tracks rate-limit windows across accounts (from T3 Code, local Devin profiles, or kittymux fallback) plus local token spend read from session logs on disk."
    ],
    media: [
      {
        src: "/media/tour/agents-typical.png",
        alt: "Agents panel listing active sessions and a waiting approval with Allow and Deny buttons",
        caption: "Agents section: active work and waiting approvals."
      },
      {
        src: "/media/tour/usage-typical.png",
        alt: "Usage panel showing remaining quota bars and reset countdowns across accounts",
        caption: "Usage section: per-account limit bars and reset times."
      }
    ]
  },
  {
    id: "updates",
    title: "Updates with AUR review",
    summary: "Software Update (Super+Ctrl+Shift+U or the island's update chip) upgrades official Arch packages together, reviews every AUR PKGBUILD diff before building as your user, and surfaces .pacnew config files afterwards.",
    details: [
      "Runs inside a detached systemd user unit (kuwai-update) with sleep inhibited, so a shell restart never interrupts an in-progress pacman transaction.",
      "AUR packages build from the exact git commit you approved; if the upstream commit changes after review, the build stops.",
      "After an upgrade, .pacnew files show a diff and save timestamped backups before replacing; critical account and disk files (passwd, shadow, group, gshadow, fstab, crypttab) are refused for automatic replacement and must be merged by hand."
    ],
    media: [
      {
        src: "/media/tour/updates-typical.png",
        alt: "Software Update panel listing Arch repository updates and AUR packages awaiting review",
        caption: "Software Update: repo updates and AUR review."
      }
    ]
  },
  {
    id: "cleanup",
    title: "Cleanup",
    summary: "The Cleanup section (Alt+4) audits unused agent skills, recoverable developer caches, and (when sweep is installed) idle build directories.",
    details: [
      "Skills: measures how many prompt tokens your sessions spend listing skills under ~/.agents/skills, ~/.claude*/skills, ~/.codex/skills, and ~/.cursor/skills that were unused for 30, 90, or 180 days. Moving them uses the freedesktop Trash with a Put back action that restores symlinks too.",
      "Caches: inspects tool caches that rebuild automatically (thumbnails, pip, uv, npm, bun, pnpm, go, yarn) and clears them with each tool's own clean command; pacman, paru, and Trash are marked check first and never cleared automatically.",
      "Settings (Super+Ctrl+I) applies changes live against a validated schema, and Settings → Shortcuts rebinds any kuwai shortcut by pressing the new chord."
    ],
    media: [
      {
        src: "/media/tour/settings-shortcuts.png",
        alt: "Settings panel on the Shortcuts page showing rebindable kuwai shortcuts",
        caption: "Settings → Shortcuts: press a new chord to rebind, or reset any row."
      }
    ]
  }
];

const rootSurface = [
  {
    component: "system/session",
    when: "Once during install (optional undo: sudo system/session --undo)",
    why: "Installs /usr/local/bin/kuwai-session and /usr/share/wayland-sessions/kuwai.desktop so kuwai appears as its own login session."
  },
  {
    component: "kuwai auth pin",
    when: "Once during install (optional undo: kuwai auth unpin)",
    why: "Copies the standalone polkit password prompt (shell-auth/) into /usr/local/share/kuwai/shell-auth owned by root, so processes running as your user cannot edit the code that reads your password."
  },
  {
    component: "kuwai-update-root",
    when: "Installed once with kuwai update install-helper, started on demand through pkexec",
    why: "Runs pacman, paccache, and validated /etc/*.pacnew actions under one prompt per operation. Operations are named in pkexec argv; AUR package files are copied into a root-only directory and verified by sha256 before pacman -U."
  },
  {
    component: "greeter/install (optional)",
    when: "Only if you replace your display manager with greetd (--undo restores the previous one)",
    why: "Installs root-owned greeter code into /var/lib/kuwai-greeter from committed git files only. Your user can write only /var/lib/kuwai-greeter/home/ (wallpaper, colours, and plain monitor/keyboard data)."
  },
  {
    component: "system/install (optional)",
    when: "Only if you want alarms that wake a sleeping laptop (--undo removes it)",
    why: "Installs /usr/local/libexec/kuwai-wake-root and a systemd path unit that reads one bounded Unix timestamp from /var/lib/kuwai-wake/at and writes /sys/class/rtc/rtc0/wakealarm."
  }
];

const dataLocations = [
  {
    what: "Clipboard history",
    defaultState: "Off by default (asked at install; kuwai collect clipboard on|off)",
    where: "Stored locally by cliphist in your home directory; pins live under ~/.local/share/kuwai. Never sent over the network."
  },
  {
    what: "GitHub and Gmail feeds",
    defaultState: "Off by default (asked at install; kuwai collect feeds on|off)",
    where: "GitHub uses your existing gh CLI login; Gmail uses an app password stored in your system keyring (secret-tool). Feed state stays in ~/.local/state/kuwai/feeds.json."
  },
  {
    what: "Local assistant (Ollama)",
    defaultState: "Off by default (Settings → Assistant)",
    where: "Chats stay in ~/.local/state/kuwai. Secret-shaped text is redacted from clipboard and selection context; optional web search runs only when you enable it."
  },
  {
    what: "Usage limits and spend",
    defaultState: "Read-only local listeners",
    where: "Reads T3 Code over localhost using a read-only token (mode 0600 or keyring), kittymux local state, or local Devin CLI profiles; spend reads local agent session logs."
  },
  {
    what: "Shell state, notifications, settings",
    defaultState: "Local only, no telemetry",
    where: "~/.config/kuwai (settings, keys, feeds config), ~/.local/state/kuwai (mode 0700: notifications, reminders, alarms, logs), and ~/.cache/kuwai (mode 0700)."
  }
];

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "kuwai",
      description: "An Arch Linux desktop built from a Lua Hyprland 0.57 session and a Quickshell shell.",
      inLanguage: "en-US"
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "kuwai",
      applicationCategory: "DesktopEnvironment",
      operatingSystem: "Arch Linux (Hyprland 0.57+)",
      softwareVersion: "0.1.0",
      license: "https://www.gnu.org/licenses/gpl-3.0.en.html",
      url: `${siteUrl}/`,
      downloadUrl: "https://github.com/KitsuneKode/kuwai",
      codeRepository: "https://github.com/KitsuneKode/kuwai",
      screenshot: `${siteUrl}/og-image.png`,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD"
      }
    }
  ]
};
---
<BaseLayout
  title="kuwai — Hyprland 0.57 desktop and Quickshell island for Arch Linux"
  description="kuwai is an Arch Linux desktop built from a Lua Hyprland 0.57 session and a Quickshell shell around a top-edge island, notifications, controls, lock screen, and AUR-reviewed updates."
  canonicalPath="/"
  ogImage="/og-image.png"
  schemaJson={homeSchema}
>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="hero-kicker tabular">v0.1.0 · Arch Linux · Hyprland 0.57+ · GPL-3.0-or-later</p>
          <h1 id="hero-title" class="hero-title">A calm Hyprland desktop built around one island</h1>
          <p class="hero-lead">
            kuwai is a desktop environment for Arch Linux made of two halves: a Hyprland 0.57 session written in Lua and a Quickshell shell built around a top-edge island. The island holds the clock, workspaces, notifications, controls, launcher, clipboard, system updates, and coding-agent status in one dark glass grammar. It installs as its own login session in <code>~/.config/kuwai/hypr/</code> without overwriting your existing <code>~/.config/hypr</code>, and every file it changes is backed up for clean removal.
          </p>
          <div class="hero-actions">
            <a href="#install" class="btn-primary">Install kuwai</a>
            <a href="https://github.com/KitsuneKode/kuwai" target="_blank" rel="noopener noreferrer" class="btn-secondary">View on GitHub</a>
            <a href="https://github.com/KitsuneKode/kuwai/blob/main/docs/manual/README.md" target="_blank" rel="noopener noreferrer" class="btn-quiet">Read the manual</a>
          </div>
        </div>

        <figure class="hero-media media-frame">
          <img
            src="/media/clips/island-hover.webp"
            alt="Recording of the kuwai island expanding on hover to show workspaces, clock, machine status, and agents"
            fetchpriority="high"
          >
          <figcaption>Recorded live on a Hyprland 0.57 session (2560×1440 at 60 fps). Every image on this page comes from the running shell or its rehearsal suite.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section" id="what-you-get" aria-labelledby="what-you-get-title">
      <div class="container">
        <div class="section-head">
          <h2 id="what-you-get-title">What you get</h2>
          <p class="section-intro">Every surface is drawn from one shared design-token file (<code>shell/config/Theme.qml</code>) and one set of UI primitives, with keyboard navigation across every panel.</p>
        </div>

        <div class="feature-toc" aria-label="Feature sections">
          {features.map((f) => (
            <a href={`#${f.id}`} class="toc-chip">{f.title}</a>
          ))}
        </div>

        <div class="feature-stack">
          {features.map((f) => (
            <article class="feature-block" id={f.id}>
              <div class="feature-copy">
                <h3>{f.title}</h3>
                <p class="feature-summary">{f.summary}</p>
                <ul class="detail-list">
                  {f.details.map((line) => <li>{line}</li>)}
                </ul>
              </div>

              {f.media.length > 0 && (
                <div class:list={["feature-media-grid", { "is-single": f.media.length === 1 }]}>
                  {f.media.map((m) => (
                    <figure class="media-frame">
                      <img src={m.src} alt={m.alt} loading="lazy">
                      <figcaption>{m.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="requirements" aria-labelledby="requirements-title">
      <div class="container">
        <div class="section-head">
          <h2 id="requirements-title">Requirements</h2>
          <p class="section-intro">kuwai targets Arch Linux and relies on packages available in the official repositories. Running <code>./install.sh --deps</code> checks what is missing and installs it with <code>pacman</code>.</p>
        </div>

        <div class="req-grid">
          <div class="info-card">
            <h3>Core</h3>
            <ul class="plain-list">
              <li><strong>Arch Linux</strong> with systemd user sessions</li>
              <li><strong>Hyprland 0.57 or newer</strong> (Lua configuration; older versions are refused by <code>install.sh</code>)</li>
              <li><strong>Quickshell</strong> with <code>qt6-multimedia</code></li>
              <li><strong>PipeWire and WirePlumber</strong> (<code>pipewire-audio</code>, <code>pipewire-pulse</code>, <code>libpulse</code>)</li>
              <li><strong>Desktop utilities</strong>: <code>awww</code>, <code>cliphist</code>, <code>wl-clipboard</code>, <code>grim</code>, <code>slurp</code>, <code>brightnessctl</code>, <code>hyprsunset</code>, <code>hyprpicker</code>, <code>playerctl</code>, <code>polkit</code>, <code>upower</code>, <code>pacman-contrib</code>, <code>jq</code>, <code>python</code>, <code>lua</code>, <code>nodejs</code>, <code>git</code>, <code>openssh</code></li>
              <li><strong>Fonts</strong>: <code>inter-font</code> (default, OFL) and <code>ttf-nerd-fonts-symbols</code>; SF Pro is used automatically if you already have it installed</li>
            </ul>
          </div>

          <div class="info-card">
            <h3>Optional</h3>
            <ul class="plain-list">
              <li><strong>Screenshots and recording</strong>: <code>satty</code> (annotation), <code>tesseract</code> (OCR), <code>gpu-screen-recorder</code> or <code>wf-recorder</code>, <code>ffmpeg</code></li>
              <li><strong>Displays and themes</strong>: <code>ddcutil</code> (external monitor brightness), <code>matugen</code> or <code>imagemagick</code> (wallpaper palettes), <code>mpv</code> / <code>mpvpaper</code> (live wallpapers)</li>
              <li><strong>Network and controls</strong>: <code>networkmanager</code> (Wi-Fi), <code>bluez-utils</code> (Bluetooth), <code>python-gobject</code> (app idle inhibition)</li>
              <li><strong>Feeds and agents</strong>: <code>github-cli</code> (GitHub feed), <code>libsecret</code> (keyring for Gmail and tokens), <code>ripgrep</code> (Cleanup panel), <code>kitty</code> / <code>kittymux</code>, <code>voxtype</code> (dictation), <code>ollama</code> (opt-in local assistant), <code>sweep</code> (idle project scan)</li>
              <li><strong>Fallbacks</strong>: <code>waybar</code>, <code>hyprlock</code>, and <code>hypridle</code> if the shell is stopped or fails to load</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="install" aria-labelledby="install-title">
      <div class="container">
        <div class="section-head">
          <h2 id="install-title">Install</h2>
          <p class="section-intro">
            kuwai writes its Hyprland entry to <code>~/.config/kuwai/hypr/</code> and runs your desktop from a separate <code>stable</code> checkout in <code>~/.local/share/kuwai</code>. Your existing <code>~/.config/hypr</code> and plain Hyprland session stay untouched.
          </p>
        </div>

        <InstallBlock client:visible />

        <div class="install-notes">
          <div class="info-card">
            <h3>Optional system steps (sudo)</h3>
            <ul class="plain-list">
              <li><code>sudo greeter/install</code> — replace SDDM or another display manager with kuwai's greetd login screen (<code>--undo</code> puts the previous manager back).</li>
              <li><code>sudo system/install</code> — install <code>kuwai-wake</code> so alarms can wake a sleeping laptop via RTC (<code>--undo</code> removes it).</li>
              <li><code>kuwai update install-helper</code> — install the root-owned update helper so a system update asks for your password once per operation.</li>
            </ul>
          </div>

          <div class="info-card">
            <h3>Updating, checking, and uninstalling</h3>
            <ul class="plain-list">
              <li><code>kuwai doctor</code> — checks Hyprland config, notification ownership, DND state, user services, and shell health.</li>
              <li><code>kuwai update-self</code> — updates <code>stable</code> to the newest signed release tag (verified against <code>release-signers</code>), runs migrations, and rolls back automatically if the shell fails to load.</li>
              <li><code>./install.sh --uninstall</code> — restores every user file and systemd unit state recorded in <code>~/.local/state/kuwai/original/</code> before the first install.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="security" aria-labelledby="security-title">
      <div class="container">
        <div class="section-head">
          <h2 id="security-title">Privacy and security</h2>
          <p class="section-intro">kuwai runs as your user session and sends no telemetry. Privileged actions are split into narrow root-owned helpers, and background data collection is off until you opt in.</p>
        </div>

        <h3 class="subhead">What runs as root and why</h3>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Component</th>
                <th>When it runs</th>
                <th>What it does</th>
              </tr>
            </thead>
            <tbody>
              {rootSurface.map((row) => (
                <tr>
                  <td><code>{row.component}</code></td>
                  <td>{row.when}</td>
                  <td>{row.why}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="subhead">What is collected and where it stays</h3>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th>Default</th>
                <th>Storage and boundary</th>
              </tr>
            </thead>
            <tbody>
              {dataLocations.map((row) => (
                <tr>
                  <td><strong>{row.what}</strong></td>
                  <td>{row.defaultState}</td>
                  <td>{row.where}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="section-footnote">
          Release tags are verified against SSH/PGP keys listed in <code>release-signers</code>, and tags that move after first sight are refused. For full details and known limitations, read <a href="https://github.com/KitsuneKode/kuwai/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="inline-link">SECURITY.md</a> and <a href="https://github.com/KitsuneKode/kuwai/blob/main/docs/manual/security.md" target="_blank" rel="noopener noreferrer" class="inline-link">docs/manual/security.md</a>.
        </p>
      </div>
    </section>

    <section class="section" id="credits" aria-labelledby="credits-title">
      <div class="container">
        <div class="section-head">
          <h2 id="credits-title">Credits and licence</h2>
