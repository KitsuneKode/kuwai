---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const releases = (await getCollection("releases")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const rendered = await Promise.all(
  releases.map(async (entry) => ({
    entry,
    rendered: await render(entry)
  }))
);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: "kuwai Changelog",
      url: "https://kuwai.kitsunekode.in/changelog/",
      description: "Release history for kuwai.",
      isPartOf: { "@id": "https://kuwai.kitsunekode.in/#website" }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://kuwai.kitsunekode.in/" },
        { "@type": "ListItem", position: 2, name: "Changelog", item: "https://kuwai.kitsunekode.in/changelog/" }
      ]
    }
  ]
};
---
<BaseLayout
  title="Changelog — kuwai"
  description="Release notes for kuwai v0.1.0, the first public release."
  canonicalPath="/changelog/"
  ogImage="/og-changelog.png"
  ogAlt="kuwai v0.1.0 release notes"
  solidHeader={true}
  schemaJson={schema}
>
  <main class="subpage-main">
    <section class="subpage-head">
      <div class="container">
        <h1 class="subpage-title">Changelog</h1>
        <p class="section-intro">Tagged releases of kuwai. Subscribe via <a href="/feed.xml" class="inline-link">RSS 2.0</a> or <a href="/atom.xml" class="inline-link">Atom</a>, or read the full <a href="https://github.com/KitsuneKode/kuwai/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer" class="inline-link">CHANGELOG.md</a> in the repository.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="changelog-stream">
          {rendered.map(({ entry, rendered: { Content } }) => (
            <article class="changelog-entry" id={entry.data.slugId}>
              <div class="changelog-date tabular">
                {entry.data.date.toISOString().slice(0, 10)}
              </div>
              <div class="changelog-body">
                <h2>{entry.data.title}</h2>
                <Content />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
