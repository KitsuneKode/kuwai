#!/usr/bin/env bash
set -eu
[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
USER_NAME=${SUDO_USER:?run with sudo from your account}
KUWAI="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
DEST=/var/lib/kuwai-greeter
KEEP=$DEST/original
YES=0; DIRTY=0; MODE=install
for a in "$@"; do
    case $a in
        --code) MODE=code ;; --undo) MODE=undo ;;
        --yes|-y) YES=1 ;; --dirty) DIRTY=1 ;;
        *) echo "usage: sudo greeter/install [--code] [--undo] [--yes] [--dirty]
  the login screen runs the committed shell/ and greeter/, never edits or links;
  --dirty installs the working tree instead (links still refused)" >&2; exit 2 ;;
    esac
done

stage_code() {
    local out=$1 rev
    if rev=$(sudo -u "$USER_NAME" git -C "$KUWAI" rev-parse HEAD 2>/dev/null); then
        if [ -n "$(sudo -u "$USER_NAME" git -C "$KUWAI" status --porcelain -- shell greeter)" ] && [ $DIRTY = 0 ]; then
            echo "shell/ or greeter/ has uncommitted changes: commit them, or pass --dirty to install the working tree" >&2
            return 1
        fi
    else
        rev=unknown
        [ $DIRTY = 1 ] || { echo "$KUWAI isn't a git checkout: pass --dirty to install it as it is" >&2; return 1; }
    fi
    if [ $DIRTY = 1 ]; then
        (cd "$KUWAI" && tar -c shell greeter) | tar -x -C "$out"
        rev="$rev+dirty"
    else
        sudo -u "$USER_NAME" git -C "$KUWAI" archive HEAD shell greeter | tar -x -C "$out"
    fi
    if [ -n "$(find "$out" ! -type f ! -type d)" ]; then
        echo "refused: links or special files in shell/ or greeter/:" >&2
        find "$out" ! -type f ! -type d >&2
        return 1
    fi
    printf '%s\n' "$rev" >"$out/code-revision"
}

STAGED=""
stage_once() {
    [ -n "$STAGED" ] && return 0
    STAGED=$(mktemp -d) || exit 1
    trap "rm -rf -- $(printf %q "$STAGED")" EXIT
    stage_code "$STAGED" || exit 1
    SUM=$(cd "$STAGED" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-64)
}

install_code() {
    stage_once
    local src=$STAGED
    install -d -m755 -o root -g root "$DEST"
    chown root:root "$DEST"; chmod 755 "$DEST"
    rsync -r --delete --no-links --chown=root:root --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r "$src/shell/" "$DEST/shell/"
    chown -R root:root "$DEST/shell"
    for f in start session-start compositor-start keys; do
        install -m755 -o root -g root "$src/greeter/$f" "$DEST/$f"
    done
    install -m644 -o root -g root "$src/greeter/hyprland.lua" "$DEST/hyprland.lua"
    install -m644 -o root -g root "$src/code-revision" "$DEST/code-revision"
    if getent group greeter >/dev/null; then
        install -d -m2750 -o "$USER_NAME" -g greeter "$DEST/home"
        chgrp greeter "$DEST/home"; chmod 2750 "$DEST/home"
    else
        install -d -m755 -o "$USER_NAME" "$DEST/home"
    fi
    for pair in user:.kuwai-user face:.face; do
        old=$DEST/${pair%%:*}; new=$DEST/home/${pair#*:}
        if [ -f "$old" ] && [ ! -L "$old" ]; then
            [ -e "$new" ] || install -m644 -o "$USER_NAME" "$old" "$new"
            rm -f "$old"
        fi
    done
    if getent group greeter >/dev/null; then
        chown -R "$USER_NAME:greeter" "$DEST/home"
        chmod -R g+rX "$DEST/home"
        runuser -u greeter -- test -r "$DEST/home/.kuwai-user" || [ ! -e "$DEST/home/.kuwai-user" ] \
            || { echo "the login screen can't read your name in $DEST/home; nothing else was changed there" >&2; exit 1; }
    else
        chown -R "$USER_NAME": "$DEST/home"
    fi
}

if [ $MODE = code ]; then
    [ -d "$DEST" ] || { echo "the login screen isn't installed: sudo $KUWAI/greeter/install" >&2; exit 1; }
    stage_once
    echo "Installing the login screen's code: $(cat "$STAGED/code-revision"), tree sha256 $SUM"
    install_code
    sudo -u "$USER_NAME" -H "$KUWAI/greeter/sync"
    echo "The login screen's code is current, and root's."
    exit 0
fi

if [ $MODE = undo ]; then
    systemctl disable greetd.service 2>/dev/null || true
    for pair in pam-greetd:/etc/pam.d/greetd greetd-config.toml:/etc/greetd/config.toml getty-tty1-override.conf:/etc/systemd/system/getty@tty1.service.d/override.conf; do
        saved=$KEEP/${pair%%:*}; target=${pair#*:}
        if [ -f "$saved" ]; then install -D -m644 "$saved" "$target"; echo "restored $target"
        elif [ -f "$saved.absent" ]; then rm -f "$target"; fi
    done
    if [ ! -f "$KEEP/pam-greetd" ] && [ -f /etc/pam.d/greetd.orig ]; then cp -f /etc/pam.d/greetd.orig /etc/pam.d/greetd; fi
    if [ ! -f "$KEEP/greetd-config.toml" ] && [ -f /etc/greetd/config.toml.orig ]; then cp -f /etc/greetd/config.toml.orig /etc/greetd/config.toml; fi
    systemctl daemon-reload
    was=$(cat "$KEEP/display-manager" 2>/dev/null || echo sddm.service)
    if [ -n "$was" ] && systemctl cat "$was" >/dev/null 2>&1; then
        systemctl enable "$was"
        echo "${was%.service} is the login again from the next boot."
    else
        echo "greetd is off. No earlier login manager to turn back on: enable one, or log in on a tty."
    fi
    rm -rf -- "$DEST"
    exit 0
fi

was=$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" 2>/dev/null || true)
stage_once
cat <<PLAN
This makes Kuwai's login screen the one this machine boots to:
  · installs greetd and rsync (pacman shows what and asks)
  · replaces /etc/pam.d/greetd and /etc/greetd/config.toml (the old ones are kept in $KEEP)
  · removes /etc/systemd/system/getty@tty1.service.d/override.conf (an autologin, if you had one; kept too)
  · copies the committed shell/ and greeter/ ($(cat "$STAGED/code-revision"), tree sha256 $SUM) to $DEST, owned by root
  · turns off ${was:-no other login manager} and turns on greetd from the next boot
Undo, all of it: sudo $KUWAI/greeter/install --undo
PLAN
if [ $YES = 0 ]; then
    printf 'Go ahead? [y/N] '
    read -r reply || reply=""
    case $reply in [yY]*) ;; *) echo "Nothing changed."; exit 0 ;; esac
fi
pacman -S --needed greetd rsync || { echo "greetd couldn't be installed, so the login screen is as it was." >&2; exit 1; }

keep() {
    if [ -e "$KEEP/$1" ] || [ -e "$KEEP/$1.absent" ]; then return 0; fi
    if [ -f "$2" ]; then install -D -m600 "$2" "$KEEP/$1"; else : >"$KEEP/$1.absent"; fi
}
install -d -m700 -o root -g root "$DEST" "$KEEP"
chmod 755 "$DEST"
keep pam-greetd /etc/pam.d/greetd
keep greetd-config.toml /etc/greetd/config.toml
keep getty-tty1-override.conf /etc/systemd/system/getty@tty1.service.d/override.conf
if [ ! -e "$KEEP/display-manager" ]; then
    dm=$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" 2>/dev/null || true)
    printf '%s\n' "$dm" >"$KEEP/display-manager"
fi

cat >/etc/pam.d/greetd <<'EOF'
#%PAM-1.0

auth        include     system-login
-auth       optional    pam_gnome_keyring.so

account     include     system-login

password    include     system-login
-password   optional    pam_gnome_keyring.so    use_authtok

session     optional    pam_keyinit.so          force revoke
session     include     system-login
-session    optional    pam_gnome_keyring.so    auto_start
EOF

install_code
sudo -u "$USER_NAME" -H "$KUWAI/greeter/sync"

install -d /etc/greetd
cat >/etc/greetd/config.toml <<EOF
[terminal]
vt = 1

[default_session]
command = "$DEST/compositor-start"
user = "greeter"
EOF

rm -f /etc/systemd/system/getty@tty1.service.d/override.conf
rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
systemctl daemon-reload

was=$(cat "$KEEP/display-manager" 2>/dev/null || true)
[ -n "$was" ] && systemctl disable "$was" 2>/dev/null || true
systemctl enable greetd.service
echo "Done. Reboot to get the login screen. Undo: sudo $KUWAI/greeter/install --undo"
