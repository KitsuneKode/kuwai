#!/usr/bin/env bash
set -eu
DEST=${KUWAI_GREETER_DIR:-/var/lib/kuwai-greeter}
KUWAI="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
H="$DEST/home"

if [ -O "$DEST" ] && [ -w "$DEST" ]; then
    echo "kuwai greeter: the login screen's code is writable by you, so nothing is copied into it; run: sudo $KUWAI/greeter/install --code" >&2
    exit 0
fi
[ -d "$H" ] && [ -w "$H" ] || exit 0

id -un >"$H/.kuwai-user"
if [ -f "$HOME/.face" ]; then cp -fL "$HOME/.face" "$H/.face"; else rm -f "$H/.face"; fi

copy() {
    [ -e "$HOME/$1" ] || return 0
    mkdir -p "$H/$(dirname "$1")"
    cp -fL "$HOME/$1" "$H/$1"
}
copy .local/state/kuwai/wallpaper
copy .local/state/kuwai/look/current/palette.json
copy .local/state/kuwai/look/state.json
copy .cache/hyde/wall.set
copy .cache/hyde/wall.dcol
copy .local/state/hyde/staterc
copy .config/kuwai/settings.json
copy .local/state/kuwai/prefs.json
copy_as() {
    [ -e "$HOME/$1" ] || return 0
    mkdir -p "$H/$(dirname "$2")"
    cp -fL "$HOME/$1" "$H/$2"
}
copy_as .config/kuwai/settings.json .config/rice/settings.json
copy_as .local/state/kuwai/prefs.json .local/state/rice/prefs.json
theme=$(sed -n 's/^HYDE_THEME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$HOME/.local/state/hyde/staterc" 2>/dev/null | head -n 1)
if [ -n "$theme" ]; then
    copy ".config/hyde/themes/$theme/theme.dcol"
    copy ".config/hyde/themes/$theme/kitty.theme"
fi
conf="$H/.config/kuwai-greeter.conf"
mkdir -p "$H/.config"
tmp=$(mktemp "$H/.config/.kuwai-greeter.XXXXXX")
hyprctl_() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null && timeout 3 hyprctl -j "$@" 2>/dev/null; }
opt() { hyprctl_ getoption "$1" | jq -r '.str // empty' 2>/dev/null || true; }
state() { sed -n "s/^$1=//p" "${XDG_STATE_HOME:-$HOME/.local/state}/kuwai/state" 2>/dev/null | head -n 1; }
layout=$(opt input:kb_layout); variant=$(opt input:kb_variant); options=$(opt input:kb_options)
if [ -z "$layout" ]; then
    layout=$(state kb_layout); variant=$(state kb_variant)
    case $(state kb_switch) in
        alt-shift) options=grp:alt_shift_toggle ;; caps) options=grp:caps_toggle ;;
        win-space) options=grp:win_space_toggle ;; ctrl-shift) options=grp:ctrl_shift_toggle ;;
        *) options= ;;
    esac
fi
{
    echo "# Written by greeter/sync at your login; read (never run) by greeter/hyprland.lua."
    if [ ${#layout} -le 64 ] && printf '%s' "$layout" | grep -Eqx '[a-z0-9_,-]+'; then
        echo "kb_layout=$layout"
        [ ${#variant} -le 64 ] && printf '%s' "$variant" | grep -Eqx '[a-z0-9_,-]+' && echo "kb_variant=$variant"
        [ ${#options} -le 64 ] && printf '%s' "$options" | grep -Eqx '[a-z0-9_,:-]+' && echo "kb_options=$options"
    fi
    hyprctl_ monitors | jq -r '
        .[]? | select((.disabled // false) | not) | select((.mirrorOf // "none") == "none")
        | ((.description // "") | sub("\\s+$"; "")) as $d
        | select($d | test("^[A-Za-z0-9][A-Za-z0-9 ._()/+&#:-]{0,119}$"))
        | select(all(.width, .height, .refreshRate, .x, .y, .scale, (.transform // 0); type == "number"))
        | select(.width >= 320 and .width <= 16384 and .height >= 200 and .height <= 16384
                 and .refreshRate >= 1 and .refreshRate <= 1000 and (.x | fabs) <= 65536 and (.y | fabs) <= 65536
                 and .scale >= 0.25 and .scale <= 4 and (.transform // 0) >= 0 and (.transform // 0) <= 7)
        | .width |= floor | .height |= floor | .x |= floor | .y |= floor
        | "monitor=\(.width)x\(.height)@\(.refreshRate * 1000 | round / 1000);\(.x);\(.y);\(.scale * 1000000 | round / 1000000);\(.transform // 0);\(if ((.currentFormat // "") | test("2101010")) then 10 else 8 end);\((.colorManagementPreset // "") | if test("^(auto|srgb|wide|edid|dcip3|dp3|adobe)$") then . else "" end);\($d)"
    ' 2>/dev/null | head -n 8
} >"$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$conf"

chmod -R a+rX "$H"
