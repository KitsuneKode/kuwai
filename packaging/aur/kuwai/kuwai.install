post_install() {
    echo ":: Kuwai is installed. Set it up for your account (not as root):"
    echo "     kuwai-setup            (kuwai-setup --dry-run shows what it does first)"
    echo "   Then pick \"Kuwai\" on the login screen."
}
post_upgrade() {
    echo ":: Kuwai updates itself in place: kuwai update-self (or Software Update)."
}
