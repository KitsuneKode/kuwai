# Maintainer: KitsuneKode
#
# kuwai: a Hyprland desktop shell (Quickshell). pacman owns everything it needs;
# the desktop itself lives in each person's home. makepkg checks the release
# tag's signature against validpgpkeys; kuwai-setup, from that tag, fetches the
# release again for each person, checks it against release-signers/ before
# anything in it runs, and runs its install.sh (which can undo itself).
pkgname=kuwai
pkgver=0.2.0
pkgrel=1
pkgdesc="A calm Hyprland desktop: a Dynamic Island, notifications, controls and an agent cockpit (Quickshell)"
arch=('any')
url="https://github.com/KitsuneKode/kuwai"
license=('GPL-3.0-or-later')
depends=(
  'awww'
  'bash'
  'brightnessctl'
  'cliphist'
  'curl'
  'diffutils'
  'file'
  'git'
  'glib2'
  'grim'
  'hyprland'
  'hyprpicker'
  'hyprsunset'
  'inter-font'
  'kitty'
  'jq'
  'libnotify'
  'libpulse'
  'lua'
  'nodejs'
  'openssh'
  'pacman-contrib'
  'pipewire-audio'
  'pipewire-pulse'
  'playerctl'
  'polkit'
  'python'
  'qt6-multimedia'
  'quickshell'
  'slurp'
  'sound-theme-freedesktop'
  'sqlite'
  'sudo'
  'ttf-nerd-fonts-symbols'
  'upower'
  'util-linux'
  'wireplumber'
  'wl-clipboard'
  'xdg-utils'
)
optdepends=(
  'matugen: wallpaper palette extraction'
  'qt6ct: Qt6 theming'
  'adw-gtk-theme: GTK3 dark theming'
  'xdg-desktop-portal-hyprland: screen sharing and portals'
  'waybar: fallback bar if the shell cannot load'
  'hyprlock: fallback lock'
  'hypridle: fallback idle daemon'
  'satty: screenshot editing'
  'tesseract: copy text from images'
  'mpv: live wallpapers'
  'mpvpaper: live wallpapers outside the shell'
  'socat: live wallpapers outside the shell'
  'imagemagick: thumbnails and fallback palette'
  'poppler: PDF previews'
  'kitty: terminal'
  'libsecret: Gmail password in keyring'
  'github-cli: GitHub notifications'
  'wtype: typing emoji into windows'
  'ydotool: tests'
  'ddcutil: external monitor brightness'
  'gpu-screen-recorder: screen recording'
  'wf-recorder: screen recording without gpu screen recorder'
  'ffmpeg: live wallpaper copies and recordings'
  'ripgrep: Cleanup panel'
  'networkmanager: Wi Fi controls'
  'bluez-utils: Bluetooth controls'
  'python-gobject: apps keeping the screen on for a video or a call'
)
makedepends=('git')
install=kuwai.install
source=("kuwai::git+https://github.com/KitsuneKode/kuwai.git#tag=v$pkgver?signed")
validpgpkeys=('7C78CB855D504BDF3E9B74AFF150E88B50720270')
sha256sums=('SKIP')

package() {
  cd "$srcdir/kuwai"
  install -Dm755 bin/kuwai-setup "$pkgdir/usr/lib/kuwai/bin/kuwai-setup"
  install -Dm755 bin/kuwai-verify "$pkgdir/usr/lib/kuwai/bin/kuwai-verify"
  install -Dm644 -t "$pkgdir/usr/lib/kuwai/release-signers" release-signers/*
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/kuwai/bin/kuwai-setup "$pkgdir/usr/bin/kuwai-setup"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
