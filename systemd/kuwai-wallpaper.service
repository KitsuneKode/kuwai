[Unit]
Description=kuwai wallpaper daemon (awww)
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/usr/bin/awww-daemon

[Service]
Type=simple
ExecStart=/usr/bin/awww-daemon --format xrgb
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
