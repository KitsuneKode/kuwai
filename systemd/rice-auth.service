# kuwai's password prompt (polkit authentication agent): shell-auth/shell.qml.
# Installed by `kuwai auth install` (a symlink into ~/.config/systemd/user).
[Unit]
Description=kuwai password prompt (polkit agent)
PartOf=graphical-session.target
After=graphical-session.target
# One agent per session: starting this one retires KDE's…
Conflicts=plasma-polkit-agent.service
# …and if this one fails for good, KDE's takes over, so there's always one.
OnFailure=plasma-polkit-agent.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# No crash handler: it writes a memory dump (which could hold what you typed)
# and relaunches on its own. systemd restarts it instead.
Environment=QS_DISABLE_CRASH_HANDLER=1
# Don't hot-reload the prompt's code from disk while it runs.
Environment=QS_DISABLE_FILE_WATCHER=1
# A small card and a dimmed backdrop: the software renderer draws it fine and
# skips loading the GPU drivers (~370 MB → ~140 MB).
Environment=QT_QUICK_BACKEND=software
ExecStart=/bin/sh -c 'exec /usr/bin/qs -p "${KUWAI_ROOT:-%h/Projects/rice}/shell-auth"'
Restart=on-failure
RestartSec=1
# 3 = another agent already owns the session: not a crash, don't retry.
RestartPreventExitStatus=3
Slice=session.slice
# Hardening. The password check runs in polkit's own helper (a system
# socket service), so this process never needs privileges of its own.
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
