# kuwai's password prompt (polkit authentication agent): shell-auth/shell.qml.
# Installed by `kuwai auth install` (a symlink into ~/.config/systemd/user).
[Unit]
Description=kuwai password prompt (polkit agent)
PartOf=graphical-session.target
After=graphical-session.target
# One agent per session: starting this one retires KDE's…
Conflicts=plasma-polkit-agent.service
# …and if this one fails for good, KDE's takes over where it's installed.
OnFailure=plasma-polkit-agent.service
# Never give up for good (2026-11-21: two `killall qs` in 18 s used up three
# tries in 60 s, KDE's agent isn't on every machine, and every pkexec then
# failed with no prompt). The wait grows instead: 1 s, then up to 30 s.
StartLimitIntervalSec=0

[Service]
# No crash handler: it writes a memory dump (which could hold what you typed)
# and relaunches on its own. systemd restarts it instead.
Environment=QS_DISABLE_CRASH_HANDLER=1
# Don't hot-reload the prompt's code from disk while it runs.
Environment=QS_DISABLE_FILE_WATCHER=1
# A small card and a dimmed backdrop: the software renderer draws it fine and
# skips loading the GPU drivers (~370 MB → ~140 MB).
Environment=QT_QUICK_BACKEND=software
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=QT_QPA_PLATFORMTHEME QT_PLUGIN_PATH QML_IMPORT_PATH QML2_IMPORT_PATH LD_PRELOAD QT_STYLE_OVERRIDE
ProtectHome=read-only
# Root's copy first (kuwai auth pin), so the code that reads your password
# isn't code your account can change; your checkout's until it's pinned.
ExecStart=/bin/sh -c 'p=/usr/local/share/kuwai/shell-auth; [ -f "$p/shell.qml" ] || p="${KUWAI_ROOT:-%h/.local/share/kuwai}/shell-auth"; exec /usr/bin/qs -p "$p"'
# Always: a plain SIGTERM (a stray `pkill qs`, 2026-11-13 00:03) is a clean
# exit, and on-failure left the session with no password prompt for 17 h:
# every update "cancelled at the password prompt" at once. `systemctl stop`
# (kuwai auth fallback) still stops it for good.
Restart=always
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
# 3 = another agent already owns the session: not a crash, don't retry.
RestartPreventExitStatus=3
Slice=session.slice
# Hardening. The password check runs in polkit's own helper (a system
# socket service), so this process never needs privileges of its own.
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
