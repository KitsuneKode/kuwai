{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  ", "key": { "width": 11 } },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "keyColor": "blue" },
    "break",
    { "type": "os", "key": "󰣇 os", "format": "{name}", "keyColor": "blue" },
    { "type": "kernel", "key": " kernel", "format": "{release}", "keyColor": "blue" },
    { "type": "packages", "key": "󰏗 packages", "format": "{all}", "keyColor": "blue" },
    { "type": "wm", "key": " wm", "format": "{pretty-name}", "keyColor": "cyan" },
    { "type": "terminal", "key": " terminal", "format": "{pretty-name}", "keyColor": "cyan" },
    { "type": "shell", "key": " shell", "format": "{pretty-name}", "keyColor": "cyan" },
    { "type": "uptime", "key": "󰅐 uptime", "keyColor": "cyan" },
    "break",
    { "type": "cpu", "key": " cpu", "format": "{name}", "keyColor": "green" },
    { "type": "gpu", "key": "󰢮 gpu", "format": "{name}", "keyColor": "green" },
    { "type": "memory", "key": " memory", "format": "{used} / {total}", "keyColor": "green" },
    { "type": "disk", "key": "󰋊 disk", "folders": "/", "format": "{size-used} / {size-total}", "keyColor": "green" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
